# ============================================================
# WooCommerce REST API — configuración para CarmayWeb (headless)
# Copia este archivo a `.env` y completa los valores.
# NUNCA subas `.env` al repositorio (ya está en .gitignore).
# ============================================================

# URL base de la API REST de WooCommerce
WC_API_URL=https://carmayoutfit.com/wp-json/wc/v3

# Claves de API (consumer key/secret) — crear en:
# WordPress → WooCommerce → Ajustes → Avanzado → API REST
# Permisos recomendados: Solo lectura
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Tiempo máximo de espera por petición (ms)
WC_TIMEOUT_MS=30000

# Límite de peticiones por segundo (respeto a Hostinger)
WC_MAX_REQUESTS_PER_SECOND=4

# Tamaño de página (máximo permitido por WooCommerce: 100)
WC_PER_PAGE=100

# Caché de disco para evitar golpear la API en cada build
# (clave `.wc-cache/` en el repo local)
WC_CACHE_ENABLED=true
WC_CACHE_TTL_MS=600000