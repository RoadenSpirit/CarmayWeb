---
import ProductPricing from './ProductPricing.astro';
import ProductBadge from './product/ProductBadge.astro';

interface Props {
  title: string;
  price: string;
  regularPrice?: string;
  priceUSD: number;
  priceCUP: number;
  cupRate: number;
  regularPriceUSD?: number;
  regularPriceCUP?: number;
  image: string;
  category: string;
  categorySlug: string;
  isTrending?: boolean;
  permalink: string;
  slug: string;
  stockQuantity?: number | null;
  isInStock?: boolean;
  revealDelayClass?: string;
  uniformHeight?: boolean;
}

const {
  title,
  price,
  regularPrice,
  priceUSD,
  priceCUP,
  cupRate,
  regularPriceUSD,
  regularPriceCUP,
  image,
  category,
  categorySlug,
  isTrending = false,
  permalink,
  slug,
  stockQuantity = null,
  isInStock = true,
  revealDelayClass = '',
  uniformHeight = false,
} = Astro.props;

const onSale = regularPriceUSD !== undefined && regularPriceUSD > priceUSD;
const discountPercent = onSale ? Math.max(0, Math.round(((regularPriceUSD! - priceUSD) / regularPriceUSD!) * 100)) : 0;
const savingsCUP = onSale ? (regularPriceCUP ?? 0) - priceCUP : 0;

// Determinación del nivel de stock
const isAvailable = isInStock ?? true;
const qty = stockQuantity ?? null;
const isSoldOut = !isAvailable || qty === 0;
const isSingleLeft = qty === 1;

// Opciones inferidas de color y talla para QuickBuy
const titleUpper = title.toUpperCase();
const colorDict: { pattern: RegExp; label: string }[] = [
  { pattern: /\b(?:NGRAS?|NEGROS?|NEGRA|NEGRO)\b/, label: 'Negro' },
  { pattern: /\b(?:BCAS?|BLANCOS?|BLANCA|BLANCO)\b/, label: 'Blanco' },
  { pattern: /\b(?:ROSADAS?|ROSADOS?|ROSA|ROS)\b/, label: 'Rosado' },
  { pattern: /\b(?:CARMELITAS?|CARMELITA)\b/, label: 'Carmelita' },
  { pattern: /\b(?:MARRON(?:ES)?|MARRÓN)\b/, label: 'Marrón' },
  { pattern: /\b(?:CAFES?|CAFÉ)\b/, label: 'Café' },
  { pattern: /\b(?:DORADOS?|DORADA)\b/, label: 'Dorado' },
  { pattern: /\b(?:BEIGES?|BEIGE)\b/, label: 'Beige' },
  { pattern: /\b(?:VERDES?|VERDE)\b/, label: 'Verde' },
  { pattern: /\b(?:AZULES?|AZUL|CELESTE)\b/, label: 'Azul' },
  { pattern: /\b(?:ROJOS?|ROJA)\b/, label: 'Rojo' },
  { pattern: /\b(?:AMARILLOS?|AMARILLA)\b/, label: 'Amarillo' },
  { pattern: /\b(?:GRISES?|GRIS)\b/, label: 'Gris' },
];

let cardColors: string[] = [];
for (const c of colorDict) {
  if (c.pattern.test(titleUpper) && !cardColors.includes(c.label)) cardColors.push(c.label);
}
const catLower = (categorySlug || '').toLowerCase();
if (cardColors.length === 0 && (catLower === 'zapatos' || catLower === 'ropa' || catLower === 'jackets')) {
  const hash = slug.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const testPalettes = [['Negro', 'Blanco'], ['Beige', 'Marrón'], ['Negro', 'Rosado'], ['Carmelita', 'Café']];
  cardColors = testPalettes[hash % testPalettes.length];
}

let cardSizes: string[] = [];
if (catLower === 'zapatos') {
  const hash = slug.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const shoeSizeSets = [['36', '37', '38', '39', '40'], ['35-36', '37-38', '39-40'], ['37', '38', '39', '40', '41'], ['38', '39', '40']];
  cardSizes = shoeSizeSets[hash % shoeSizeSets.length];
} else if (catLower === 'ropa' || catLower === 'jackets') {
  const hash = slug.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const clothingSizeSets = [['S', 'M', 'L', 'XL'], ['M', 'L', 'XL'], ['Única (S-L)'], ['S', 'M', 'L']];
  cardSizes = clothingSizeSets[hash % clothingSizeSets.length];
}

const formatCUP = (n: number) => `$${n.toLocaleString('en-US')} CUP`;
const formatUSD = (n: number) => n % 1 === 0 ? `$${n.toFixed(0)} USD` : `$${n.toFixed(2)} USD`;
---

<div 
  class={`product-card-item group relative rounded-2xl overflow-hidden flex flex-col
    bg-[#0f1120]/95 backdrop-blur-sm
    border border-white/[0.08]
    shadow-[0_4px_16px_rgba(0,0,0,0.3)]
    hover:shadow-[0_12px_32px_rgba(234,179,8,0.2)]
    hover:-translate-y-1
    transition-all duration-300
    cursor-pointer
    break-inside-avoid mb-2 sm:mb-2.5
    ${uniformHeight ? 'h-full justify-between' : 'justify-start'}
    ${revealDelayClass ? `reveal-card ${revealDelayClass}` : ''}
    ${isSoldOut ? 'opacity-85 hover:opacity-100' : ''}`}
  data-product-slug={slug}
  data-permalink={permalink}
  data-price-usd={priceUSD}
  data-price-cup={priceCUP}
  data-category-slug={categorySlug}
  data-on-sale={onSale ? 'true' : 'false'}
  data-trending={isTrending ? 'true' : 'false'}
  data-in-stock={isAvailable ? 'true' : 'false'}
>
  
  <!-- Línea superior de acento (solo en oferta) -->
  {onSale && (
    <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-rose-500 to-transparent opacity-75 z-20 pointer-events-none"></div>
  )}

  <!-- Halo dorado en hover (sutil) -->
  <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none border border-amber-500/25 z-10"></div>

  <!-- ENLACE MAESTRO: Toda la card redirige a los detalles del producto -->
  <a href={permalink} class={`card-details-link ${uniformHeight ? 'h-full flex flex-col justify-between' : 'block w-full'}`} aria-label={`Ver detalles de ${title}`}>
    
    <!-- ================= 1. FOTO PROTAGONISTA (Uniforme en Index, Adaptativa en Catálogo) ================= -->
    <div class={`relative overflow-hidden w-full bg-[#0a0c15] ${uniformHeight ? 'aspect-square shrink-0' : ''}`}>
      <img 
        src={image} 
        alt={title} 
        width="600"
        height="600"
        class={`group-hover:scale-105 transition-transform duration-500 ease-out block ${uniformHeight ? 'w-full h-full object-cover object-center' : 'w-full h-auto max-h-[380px] object-cover object-center'}`}
        loading="lazy"
      />
      
      <!-- Insignias Superiores Flotantes sobre la Imagen (Píldora Única Exclusiva) -->
      <ProductBadge 
        onSale={onSale}
        discountPercent={discountPercent}
        isTrending={isTrending}
        stockQuantity={qty}
        isSoldOut={isSoldOut}
        slug={slug}
      />

    </div>

    <!-- ================= 2. CUERPO DE LA CARD: TÍTULO PROMINENTE + PRECIOS CANÓNICOS + ACCIONES ================= -->
    <div class="p-2.5 sm:p-3 md:p-3.5 flex flex-col flex-1 justify-between gap-2.5">
      
      <div>
        <!-- Título de Producto Truncado a 1 Línea con Elipsis (Legible y Generoso en PC) -->
        <h3 class="font-bold text-white group-hover:text-amber-300 transition-colors duration-200 truncate text-sm sm:text-base lg:text-[17px] leading-snug block w-full" title={title}>
          {title}
        </h3>

        <!-- Estructura Canónica Modular de Precios:
             1. Primero precio CUP, luego precio USD con idéntico tamaño
             2. Debajo precios antiguos tachados si tiene rebaja -->
        <ProductPricing 
          priceCUP={priceCUP}
          priceUSD={priceUSD}
          regularPriceCUP={regularPriceCUP}
          regularPriceUSD={regularPriceUSD}
          onSale={onSale}
        />
      </div>

      <!-- BARRA DE ACCIONES AL PIE DE LA CARD: COMPRAR AHORA (PRIORITARIO) + CARRITO (SECUNDARIO) -->
      {isSoldOut ? (
        <button
          type="button"
          data-order-out-of-stock={title}
          class="out-of-stock-btn w-full mt-1 h-10 sm:h-11 px-3 rounded-xl bg-purple-950/70 hover:bg-purple-900 border border-purple-500/50 hover:border-amber-400 text-amber-300 font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-pointer select-none"
        >
          <span>Encargar por WhatsApp</span>
        </button>
      ) : (
        <div class="flex items-center gap-2 mt-1 w-full">
          <!-- 1. Botón Prioritario: Comprar Ahora (Dorado/Ámbar de Alta Conversión) -->
          <button
            type="button"
            data-quick-buy={JSON.stringify({
              productId: 0,
              slug: slug,
              name: title,
              image: image,
              priceUSD: priceUSD,
              priceCUP: priceCUP,
              stockQuantity: qty,
              colors: cardColors,
              sizes: cardSizes,
            })}
            class="quick-buy-btn flex-1 h-10 sm:h-11 px-3.5 rounded-xl bg-gradient-to-r from-amber-500 via-amber-400 to-yellow-500 hover:from-amber-400 hover:via-yellow-400 hover:to-yellow-300 active:scale-[0.98] text-slate-950 font-black text-xs sm:text-sm uppercase tracking-wider shadow-[0_4px_14px_rgba(234,179,8,0.3)] hover:shadow-[0_6px_20px_rgba(234,179,8,0.45)] transition-all flex items-center justify-center cursor-pointer select-none"
            title={`Comprar ${title} directamente`}
            aria-label={`Comprar ${title} directamente`}
          >
            <span>Comprar Ahora</span>
          </button>

          <!-- 2. Botón Secundario: Carrito (Tono Sutil Oscuro con SVG Original del Carrito con "+") -->
          <button
            type="button"
            data-quick-add={JSON.stringify({
              productId: 0,
              slug: slug,
              name: title,
              image: image,
              priceUSD: priceUSD,
              priceCUP: priceCUP,
            })}
            class="quick-add-btn w-10 h-10 sm:w-11 sm:h-11 shrink-0 rounded-xl bg-white/[0.05] hover:bg-white/[0.12] border border-white/10 hover:border-amber-400/50 active:scale-95 text-slate-300 hover:text-white transition-all flex items-center justify-center cursor-pointer select-none"
            title="Agregar al carrito"
            aria-label={`Agregar ${title} al carrito`}
          >
            <!-- SVG de Carrito Estilizado y Fino con Símbolo "+" -->
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5 text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2.2l.4 2M5.6 5H21l-1.6 8.5H7.5L5.6 5z" />
              <circle cx="9.5" cy="19.5" r="1.5" />
              <circle cx="17.5" cy="19.5" r="1.5" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12.5 7.5v3.5m-1.75-1.75h3.5" stroke-width="2" />
            </svg>
          </button>
        </div>
      )}

    </div>
  </a>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Quick Buy: Abre el modal autónomo de compra rápida en pantalla
    document.querySelectorAll('.quick-buy-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        try {
          const raw = JSON.parse(btn.getAttribute('data-quick-buy') || '{}');
          window.dispatchEvent(new CustomEvent('open-quick-buy', { detail: raw }));
        } catch (err) {
          console.error('Error abriendo compra rápida:', err);
        }
      });
    });

    // Quick Add con apertura transparente del CartDrawer (evita navegar al enlace de la card)
    document.querySelectorAll('.quick-add-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        try {
          const raw = JSON.parse(btn.getAttribute('data-quick-add') || '{}');
          if ((window as any).CarmayCart) {
            (window as any).CarmayCart.create({
              productId: raw.productId || 0,
              slug: raw.slug,
              name: raw.name,
              image: raw.image,
              priceUSD: raw.priceUSD,
              priceCUP: raw.priceCUP,
              quantity: 1,
            });
            window.dispatchEvent(new CustomEvent('open-carmay-cart'));
          }
        } catch (err) {
          console.error('Error en quick add:', err);
        }
      });
    });

    // Encargo de producto agotado por WhatsApp (evita navegar al enlace de la card)
    document.querySelectorAll('.out-of-stock-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const productName = btn.getAttribute('data-order-out-of-stock') || 'Producto';
        const text = `Hola Carmay Outfit 👋, me interesa encargar el producto *"${productName}"* (actualmente agotado). ¿Cuándo volverá a estar disponible?`;
        const whatsappUrl = `https://wa.me/REDACTED_PHONE_1?text=${encodeURIComponent(text)}`;
        window.open(whatsappUrl, '_blank');
      });
    });
  });
</script>

<style>
  .product-card-item {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.25s ease-out,
                border-color 0.25s ease-out;
  }
</style>
