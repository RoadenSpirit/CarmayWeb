---
interface Props {
  title: string;
  price: string;
  regularPrice?: string;
  priceUSD: number;
  priceCUP: number;
  cupRate: number;
  regularPriceUSD?: number;
  regularPriceCUP?: number;
  image: string;
  category: string;
  categorySlug: string;
  isTrending?: boolean;
  permalink: string;
  slug: string;
  stockQuantity?: number | null;
  isInStock?: boolean;
  revealDelayClass?: string;
}

const {
  title,
  price,
  regularPrice,
  priceUSD,
  priceCUP,
  cupRate,
  regularPriceUSD,
  regularPriceCUP,
  image,
  category,
  categorySlug,
  isTrending = false,
  permalink,
  slug,
  stockQuantity = null,
  isInStock = true,
  revealDelayClass = '',
} = Astro.props;

const onSale = regularPriceUSD !== undefined && regularPriceUSD > priceUSD;
const discountPercent = onSale ? Math.max(0, Math.round(((regularPriceUSD! - priceUSD) / regularPriceUSD!) * 100)) : 0;
const savingsCUP = onSale ? (regularPriceCUP ?? 0) - priceCUP : 0;

// Determinación del Nivel de Stock (1 a 4)
const isAvailable = isInStock ?? true;
const qty = stockQuantity ?? null;

let stockLevel: 1 | 2 | 3 | 4 = 1;
if (!isAvailable || qty === 0) {
  stockLevel = 4; // Agotado
} else if (qty === 1) {
  stockLevel = 3; // ¡Solo queda 1!
} else if (qty === 2 || qty === 3) {
  stockLevel = 2; // Bajo Stock (2 u 3)
} else {
  stockLevel = 1; // En Stock normal
}

const formatCUP = (n: number) => `${n.toLocaleString('en-US')} CUP`;
const formatUSD = (n: number) => n % 1 === 0 ? `$${n.toFixed(0)} USD` : `$${n.toFixed(2)} USD`;
---

<div 
  class={`product-card-item w-full h-full group relative rounded-2xl overflow-hidden flex flex-col justify-between
    bg-[#0f1120]/90 backdrop-blur-sm
    border border-white/[0.08]
    shadow-[0_4px_20px_rgba(0,0,0,0.25)]
    hover:shadow-[0_12px_36px_rgba(234,179,8,0.18)]
    hover:-translate-y-1.5
    transition-all duration-300 ease-out
    ${revealDelayClass ? `reveal-on-scroll ${revealDelayClass}` : ''}
    ${stockLevel === 4 ? 'opacity-85 hover:opacity-100' : ''}`}
  data-product-slug={slug}
  data-price-usd={priceUSD}
  data-price-cup={priceCUP}
  data-category-slug={categorySlug}
  data-on-sale={onSale ? 'true' : 'false'}
  data-trending={isTrending ? 'true' : 'false'}
  data-in-stock={isAvailable ? 'true' : 'false'}
>
  
  <!-- Línea superior de acento (solo en oferta) -->
  {onSale && (
    <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-red-500 to-transparent opacity-60 z-20"></div>
  )}

  <!-- Halo dorado en hover (sutil) -->
  <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none border border-amber-500/20"></div>

  <div>
    <!-- Contenedor de Imagen: En móvil la imagen queda 100% limpia sin tags flotantes -->
    <a href={permalink} class="block relative overflow-hidden aspect-square bg-[#0a0c15]">
      <img 
        src={image} 
        alt={title} 
        width="600"
        height="600"
        class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out opacity-100"
        loading="lazy"
      />
      
      <!-- Insignias Superiores (Solo Desktop/Tablet sm+: en móvil van en el cuerpo de la card) -->
      <div class="hidden sm:flex absolute top-3 left-3 z-10 flex-col gap-1.5 items-start">
        {isTrending && (
          <span class="inline-flex items-center gap-1 bg-gradient-to-r from-amber-500 to-rose-600 text-white text-xs font-black uppercase px-2.5 py-0.5 rounded-full shadow-md tracking-wider border border-white/20">
            🔥 Trending
          </span>
        )}
      </div>

      <!-- Píldoras de Stock (Solo Desktop/Tablet sm+: en móvil van en el cuerpo de la card) -->
      <div class="hidden sm:block absolute bottom-2.5 left-2.5 z-10">
        {stockLevel === 1 && (
          <span class="inline-flex items-center gap-1.5 bg-emerald-950/80 backdrop-blur-md text-emerald-400 text-xs font-extrabold px-3 py-0.5 rounded-full border border-emerald-500/40 shadow-lg">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>En Stock</span>
          </span>
        )}

        {stockLevel === 2 && (
          <span class="inline-flex items-center gap-1.5 bg-amber-950/80 backdrop-blur-md text-amber-300 text-xs font-extrabold px-3 py-0.5 rounded-full border border-amber-500/40 shadow-[0_0_12px_rgba(245,158,11,0.3)]">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
            <span>⚡ ¡Últimas {qty} unidades!</span>
          </span>
        )}

        {stockLevel === 3 && (
          <span class="inline-flex items-center gap-1.5 bg-gradient-to-r from-red-600 to-rose-600 text-white text-xs font-black uppercase px-3 py-0.5 rounded-full border border-red-400 shadow-[0_0_15px_rgba(220,38,38,0.4)] animate-pulse tracking-wider">
            <span>🔥 ¡SOLO QUEDA 1!</span>
          </span>
        )}

        {stockLevel === 4 && (
          <span class="inline-flex items-center gap-1.5 bg-purple-950/90 backdrop-blur-md text-amber-300 text-xs font-black uppercase px-3 py-0.5 rounded-full border border-purple-500/50 shadow-lg tracking-wider">
            <span>Agotado</span>
          </span>
        )}
      </div>
    </a>

    <!-- Contenido / Cuerpo de la Card -->
    <div class="px-3.5 sm:px-5 pt-3.5 sm:pt-4 pb-2">
      
      <a href={permalink} class="block">
        <h3 class="font-bold text-white group-hover:text-amber-300 transition-colors duration-200 line-clamp-2 text-sm sm:text-base leading-snug mb-2 sm:mb-3 drop-shadow-[0_2px_8px_rgba(255,255,255,0.05)] min-h-[2.5rem] sm:min-h-[2.85rem] flex items-start">
          {title}
        </h3>
      </a>

      <!-- Bloque de Precios con Igualdad de Jerarquía CUP y USD y Altura Fija Simétrica -->
      <a href={permalink} class="block">
        <div class="flex flex-col justify-center min-h-[4.25rem] w-full my-2.5 sm:my-3 py-2.5 px-3 rounded-xl bg-white/[0.02] border border-white/[0.06] space-y-1.5">
          
          <!-- Fila 1: Precio CUP (Con precio tachado si está en oferta) -->
          {priceCUP > 0 ? (
            <div class="flex items-baseline justify-between gap-1.5 w-full">
              <span class="text-xs sm:text-sm font-black text-slate-100 font-mono tracking-tight whitespace-nowrap">
                {formatCUP(priceCUP)}
              </span>
              {onSale && regularPriceCUP && regularPriceCUP > priceCUP && (
                <span class="text-xs text-slate-500 font-mono line-through whitespace-nowrap">
                  {formatCUP(regularPriceCUP)}
                </span>
              )}
            </div>
          ) : (
            <div class="flex items-baseline justify-between gap-1.5 w-full">
              <span class="text-xs sm:text-sm font-black text-slate-100 font-mono tracking-tight whitespace-nowrap">
                {formatUSD(priceUSD)}
              </span>
              {onSale && regularPriceUSD && regularPriceUSD > priceUSD && (
                <span class="text-xs text-slate-500 font-mono line-through whitespace-nowrap">
                  {formatUSD(regularPriceUSD)}
                </span>
              )}
            </div>
          )}

          <!-- Fila 2: Precio USD (Mismo tamaño, color y jerarquía idéntica al CUP) -->
          {priceCUP > 0 && priceUSD > 0 && (
            <div class="flex items-baseline justify-between gap-1.5 w-full border-t border-white/[0.04] pt-1">
              <span class="text-xs sm:text-sm font-black text-slate-100 font-mono tracking-tight whitespace-nowrap">
                {formatUSD(priceUSD)}
              </span>
              {onSale && regularPriceUSD && regularPriceUSD > priceUSD && (
                <span class="text-xs text-slate-500 font-mono line-through whitespace-nowrap">
                  {formatUSD(regularPriceUSD)}
                </span>
              )}
            </div>
          )}
        </div>
      </a>
    </div>

    <!-- Listón Rojo de Ahorro Responsive (Con reserva de espacio idéntico h-7 para uniformidad total) -->
    {onSale ? (
      <div class="bg-gradient-to-r from-rose-600 to-rose-700 text-white font-extrabold text-xs text-center py-1.5 px-2 w-full tracking-wider uppercase flex items-center justify-center shadow-md h-7">
        <span>Ahorras {savingsCUP > 0 ? formatCUP(savingsCUP) : formatUSD(regularPriceUSD! - priceUSD)}</span>
      </div>
    ) : (
      <div class="h-7 w-full border-t border-transparent" aria-hidden="true"></div>
    )}

    <!-- Tags / Insignias: en móvil van como últimos elementos antes de los botones con slot fijo -->
    <div class="flex sm:hidden items-center flex-wrap gap-1.5 px-3.5 sm:px-0 pt-2.5 pb-1 min-h-[1.75rem]">
      {isTrending && (
        <span class="inline-flex items-center gap-1 bg-amber-500/20 text-amber-300 border border-amber-500/40 text-xs font-black uppercase px-2 py-0.5 rounded-md tracking-wider">
          🔥 Trending
        </span>
      )}
      {stockLevel === 1 && (
        <span class="inline-flex items-center gap-1 text-emerald-400 text-xs font-bold bg-emerald-950/50 px-2 py-0.5 rounded-md border border-emerald-500/30">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>En Stock</span>
        </span>
      )}
      {stockLevel === 2 && (
        <span class="inline-flex items-center gap-1 text-amber-300 text-xs font-bold bg-amber-950/50 px-2 py-0.5 rounded-md border border-amber-500/30">
          <span>⚡ ¡Últimas {qty}!</span>
        </span>
      )}
      {stockLevel === 3 && (
        <span class="inline-flex items-center gap-1 text-rose-300 text-xs font-bold bg-rose-950/50 px-2 py-0.5 rounded-md border border-rose-500/30">
          <span>🔥 ¡Queda 1!</span>
        </span>
      )}
      {stockLevel === 4 && (
        <span class="inline-flex items-center gap-1 text-purple-300 text-xs font-bold bg-purple-950/50 px-2 py-0.5 rounded-md border border-purple-500/30">
          <span>Agotado</span>
        </span>
      )}
    </div>
  </div>

  <!-- Botones de Acción Responsive anclados al fondo (mt-auto) con Excelente Contraste -->
  <div class="px-3.5 sm:px-5 pb-3.5 sm:pb-5 pt-1.5 sm:pt-2 mt-auto">
    {stockLevel === 4 ? (
      <!-- Botón Morado de Encargo por WhatsApp -->
      <button
        type="button"
        data-order-out-of-stock={title}
        class="out-of-stock-btn w-full bg-[#1b1428] hover:bg-[#281c3d] active:scale-[0.98] text-amber-300 border border-purple-500/40 hover:border-amber-400 font-extrabold py-2.5 sm:py-3 px-3 sm:px-4 rounded-xl shadow-md transition-all duration-200 text-xs flex items-center justify-center gap-1.5 cursor-pointer"
        title="Encargar este producto por WhatsApp"
      >
        <span>💬</span>
        <span class="truncate">Encargar por WhatsApp</span>
      </button>
    ) : (
      <!-- Botones para productos En Stock: Mayor contraste en móvil fondo oscuro sólido con borde -->
      <div class="flex items-center gap-1.5 sm:gap-2">
        <a 
          href={permalink}
          class="flex-1 text-center bg-white/[0.06] hover:bg-white/[0.12] active:scale-[0.97] text-slate-200 hover:text-white font-bold py-2.5 px-2.5 rounded-xl transition-all duration-200 text-xs border border-white/15 flex items-center justify-center truncate"
        >
          Detalles
        </a>
        <button
          type="button"
          data-quick-add={JSON.stringify({
            productId: 0,
            slug: slug,
            name: title,
            image: image,
            priceUSD: priceUSD,
            priceCUP: priceCUP,
          })}
          class="quick-add-btn bg-[#181a26] hover:bg-[#222538] active:scale-[0.95] text-amber-400 hover:text-amber-300 font-extrabold py-2.5 px-3 rounded-xl border border-amber-500/40 hover:border-amber-400 shadow-[0_2px_10px_rgba(0,0,0,0.5)] transition-all duration-200 text-xs flex items-center justify-center gap-1.5 shrink-0 cursor-pointer"
          title="Agregar al carrito"
        >
          <span class="text-sm transition-transform group-active:scale-125">🛒</span>
          <span class="hidden xs:inline sm:inline text-white font-bold">Agregar</span>
        </button>
      </div>
    )}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Manejo de Quick Add
    document.querySelectorAll('.quick-add-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        try {
          const raw = JSON.parse(btn.getAttribute('data-quick-add') || '{}');
          if ((window as any).CarmayCart) {
            (window as any).CarmayCart.create({
              productId: raw.productId || 0,
              slug: raw.slug,
              name: raw.name,
              image: raw.image,
              priceUSD: raw.priceUSD,
              priceCUP: raw.priceCUP,
              quantity: 1,
            });
            window.dispatchEvent(new CustomEvent('open-carmay-cart'));
          }
        } catch (err) {
          console.error('Error en quick add:', err);
        }
      });
    });

    // Manejo de Encargar Producto Agotado por WhatsApp (Nivel 4)
    document.querySelectorAll('.out-of-stock-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const productName = btn.getAttribute('data-order-out-of-stock') || 'Producto';
        const text = `Hola Carmay Outfit 👋, me interesa encargar el producto *"${productName}"* (actualmente agotado). ¿Cuándo volverá a estar disponible?`;
        const whatsappUrl = `https://wa.me/REDACTED_PHONE_1?text=${encodeURIComponent(text)}`;
        window.open(whatsappUrl, '_blank');
      });
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.quick-add-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        try {
          const raw = JSON.parse(btn.getAttribute('data-quick-add') || '{}');
          if ((window as any).CarmayCart) {
            (window as any).CarmayCart.create({
              productId: raw.productId || 0,
              slug: raw.slug,
              name: raw.name,
              image: raw.image,
              priceUSD: raw.priceUSD,
              priceCUP: raw.priceCUP,
              quantity: 1,
            });
            window.dispatchEvent(new CustomEvent('open-carmay-cart'));
          }
        } catch (err) {
          console.error('Error en quick add:', err);
        }
      });
    });
  });
</script>
</a>