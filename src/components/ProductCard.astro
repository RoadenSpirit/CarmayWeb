---
interface Props {
  title: string;
  price: string;
  regularPrice?: string;
  priceUSD: number;
  priceCUP: number;
  cupRate: number;
  regularPriceUSD?: number;
  regularPriceCUP?: number;
  image: string;
  category: string;
  isTrending?: boolean;
  permalink: string;
}

const {
  title,
  price,
  regularPrice,
  priceUSD,
  priceCUP,
  cupRate,
  regularPriceUSD,
  regularPriceCUP,
  image,
  category,
  isTrending = false,
  permalink,
} = Astro.props;

const onSale = regularPriceUSD !== undefined && regularPriceUSD > priceUSD;
const discountPercent = onSale ? Math.max(0, Math.round(((regularPriceUSD! - priceUSD) / regularPriceUSD!) * 100)) : 0;
const savingsCUP = onSale ? (regularPriceCUP ?? 0) - priceCUP : 0;

const formatCUP = (n: number) => `${n.toLocaleString('en-US')} CUP`;
const formatUSD = (n: number) => n % 1 === 0 ? `$${n.toFixed(0)} USD` : `$${n.toFixed(2)} USD`;
---

<div class="group relative rounded-2xl overflow-hidden flex flex-col justify-between
  bg-[#0f1120]/80 backdrop-blur-sm
  border border-white/[0.08]
  shadow-[0_8px_32px_rgba(255,255,255,0.06),0_2px_60px_rgba(0,0,0,0.6),inset_0_1px_0_rgba(255,255,255,0.06)]
  hover:shadow-[0_12px_48px_rgba(234,179,8,0.12),0_2px_60px_rgba(0,0,0,0.6),inset_0_1px_0_rgba(255,255,255,0.08)]
  hover:-translate-y-1
  transition-[transform,box-shadow] duration-300 ease-out">
  
  <!-- Línea superior de acento (solo en oferta) -->
  {onSale && (
    <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-red-500 to-transparent opacity-60"></div>
  )}

  <!-- Halo dorado en hover (sutil, sin parpadeo) -->
  <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
    style="box-shadow: inset 0 0 0 1px rgba(234,179,8,0.15);"></div>

  <div>
    <!-- Contenedor de Imagen con Badge -->
    <div class="relative overflow-hidden aspect-square bg-[#0a0c15]">
      <img 
        src={image} 
        alt={title} 
        width="600"
        height="600"
        class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out opacity-90 group-hover:opacity-100"
        loading="lazy"
      />
      
      {isTrending && (
        <div class="absolute top-3.5 left-3.5 z-10">
          <span class="inline-flex items-center gap-1 bg-gradient-to-r from-yellow-500 to-rose-600 text-white text-[11px] font-black uppercase px-3.5 py-1.5 rounded-full shadow-[0_4px_15px_rgba(234,179,8,0.3)] tracking-wider border border-white/20">
            🔥 Trending
          </span>
        </div>
      )}

      {category && (
        <div class="absolute top-3.5 right-3.5 z-10">
          <span class="bg-black/70 backdrop-blur-md text-yellow-200 text-xs font-bold px-3 py-1 rounded-full border border-yellow-500/20 shadow-[0_2px_10px_rgba(0,0,0,0.5)]">
            {category}
          </span>
        </div>
      )}

      <!-- Gradiente inferior sobre imagen -->
      <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-[#0f1120] to-transparent"></div>
    </div>

    <!-- Contenido -->
    <div class="px-5 pt-4 pb-2">
      <h3 class="font-bold text-white group-hover:text-yellow-300 transition-colors duration-200 line-clamp-2 text-base sm:text-lg leading-snug mb-3 drop-shadow-[0_2px_8px_rgba(255,255,255,0.05)]">
        {title}
      </h3>

      <!-- Grid de Precios 2x2 -->
      <div class="grid grid-cols-2 gap-y-2 gap-x-4 w-full my-3 py-3 border-t border-b border-white/[0.04]">
        <!-- Fila 1: Precios actuales en naranja -->
        <div class="flex items-center justify-center text-center">
          <span class="text-base sm:text-[1.35rem] font-black text-orange-500 whitespace-nowrap drop-shadow-[0_2px_10px_rgba(249,115,22,0.2)]">
            {formatCUP(priceCUP)}
          </span>
        </div>
        <div class="flex items-center justify-center text-center">
          <span class="text-base sm:text-[1.35rem] font-black text-orange-500 whitespace-nowrap drop-shadow-[0_2px_10px_rgba(249,115,22,0.2)]">
            {formatUSD(priceUSD)}
          </span>
        </div>

        <!-- Fila 2: Precios viejos (solo si está en oferta) -->
        <div class="flex items-center justify-center text-center min-h-[1.25rem]">
          {onSale ? (
            <span class="text-sm text-gray-500 font-medium line-through whitespace-nowrap">
              {formatCUP(regularPriceCUP ?? 0)}
            </span>
          ) : (
            <span class="block h-4"></span>
          )}
        </div>
        <div class="flex items-center justify-center text-center min-h-[1.25rem]">
          {onSale ? (
            <span class="text-sm text-gray-500 font-medium line-through whitespace-nowrap">
              {formatUSD(regularPriceUSD ?? 0)}
            </span>
          ) : (
            <span class="block h-4"></span>
          )}
        </div>
      </div>
    </div>

    <!-- Listón Rojo de Ahorro -->
    {onSale && (
      <div class="bg-red-600/90 text-white font-extrabold text-xs text-center h-9 w-full tracking-wider uppercase flex items-center justify-center shadow-[0_4px_15px_rgba(220,38,38,0.2)]">
        <span>AHORRAS ${savingsCUP.toLocaleString('en-US')} CUP / ${(regularPriceUSD! - priceUSD) % 1 === 0 ? `$${(regularPriceUSD! - priceUSD).toFixed(0)}` : `$${(regularPriceUSD! - priceUSD).toFixed(2)}`} USD</span>
      </div>
    )}
  </div>

  <!-- Botón de Acción -->
  <div class="px-5 pb-5 pt-2">
    <a 
      href={permalink}
      class="block w-full text-center bg-gradient-to-r from-purple-700 to-purple-900 hover:from-yellow-600 hover:to-yellow-800 text-white font-extrabold py-3 px-5 rounded-xl shadow-[0_4px_15px_rgba(168,85,247,0.2),inset_0_1px_0_rgba(255,255,255,0.1)] hover:shadow-[0_6px_25px_rgba(234,179,8,0.25),inset_0_1px_0_rgba(255,255,255,0.15)] transition-all duration-300 text-sm border border-white/[0.06]"
    >
      Ver Detalles
    </a>
  </div>
</div>