---
interface Props {
  title: string;
  price: string;
  regularPrice?: string;
  priceUSD: number;
  priceCUP: number;
  cupRate: number;
  regularPriceUSD?: number;
  regularPriceCUP?: number;
  image: string;
  category: string;
  categorySlug: string;
  isTrending?: boolean;
  permalink: string;
  slug: string;
  stockQuantity?: number | null;
  isInStock?: boolean;
}

const {
  title,
  price,
  regularPrice,
  priceUSD,
  priceCUP,
  cupRate,
  regularPriceUSD,
  regularPriceCUP,
  image,
  category,
  categorySlug,
  isTrending = false,
  permalink,
  slug,
  stockQuantity = null,
  isInStock = true,
} = Astro.props;

const onSale = regularPriceUSD !== undefined && regularPriceUSD > priceUSD;
const discountPercent = onSale ? Math.max(0, Math.round(((regularPriceUSD! - priceUSD) / regularPriceUSD!) * 100)) : 0;
const savingsCUP = onSale ? (regularPriceCUP ?? 0) - priceCUP : 0;

// Determinación del Nivel de Stock (1 a 4)
const isAvailable = isInStock ?? true;
const qty = stockQuantity ?? null;

let stockLevel: 1 | 2 | 3 | 4 = 1;
if (!isAvailable || qty === 0) {
  stockLevel = 4; // Agotado
} else if (qty === 1) {
  stockLevel = 3; // ¡Solo queda 1!
} else if (qty === 2 || qty === 3) {
  stockLevel = 2; // Bajo Stock (2 u 3)
} else {
  stockLevel = 1; // En Stock normal
}

const formatCUP = (n: number) => `${n.toLocaleString('en-US')} CUP`;
const formatUSD = (n: number) => n % 1 === 0 ? `$${n.toFixed(0)} USD` : `$${n.toFixed(2)} USD`;
---

<div 
  class={`product-card-item group relative rounded-2xl overflow-hidden flex flex-col justify-between
    bg-[#0f1120]/90 backdrop-blur-sm
    border border-white/[0.08]
    shadow-[0_4px_20px_rgba(0,0,0,0.25)]
    hover:shadow-[0_6px_25px_rgba(234,179,8,0.15)]
    hover:-translate-y-1
    transition-[transform,box-shadow,opacity] duration-300 ease-out
    ${stockLevel === 4 ? 'opacity-85 hover:opacity-100' : ''}`}
  data-product-slug={slug}
  data-price-usd={priceUSD}
  data-price-cup={priceCUP}
  data-category-slug={categorySlug}
  data-on-sale={onSale ? 'true' : 'false'}
  data-trending={isTrending ? 'true' : 'false'}
  data-in-stock={isAvailable ? 'true' : 'false'}
>
  
  <!-- Línea superior de acento (solo en oferta) -->
  {onSale && (
    <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-red-500 to-transparent opacity-60 z-20"></div>
  )}

  <!-- Halo dorado en hover (sutil) -->
  <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
    style="box-shadow: inset 0 0 0 1px rgba(234,179,8,0.15);"></div>

  <div>
    <!-- Contenedor de Imagen con Badge de Categoría y Píldora de Stock (Nivel 1 a 4) -->
    <a href={permalink} class="block relative overflow-hidden aspect-square bg-[#0a0c15]">
      <img 
        src={image} 
        alt={title} 
        width="600"
        height="600"
        class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out opacity-100"
        loading="lazy"
      />
      
      <!-- Insignias Superiores (Trending / Descuento) -->
      <div class="absolute top-3.5 left-3.5 z-10 flex flex-col gap-1.5 items-start">
        {isTrending && (
          <span class="inline-flex items-center gap-1 bg-gradient-to-r from-yellow-500 to-rose-600 text-white text-[10px] font-black uppercase px-3 py-1 rounded-full shadow-[0_4px_15px_rgba(234,179,8,0.3)] tracking-wider border border-white/20">
            🔥 Trending
          </span>
        )}
      </div>

      <!-- Categoría -->
      {category && (
        <div class="absolute top-3.5 right-3.5 z-10">
          <span class="bg-black/70 backdrop-blur-md text-yellow-200 text-[11px] font-bold px-3 py-1 rounded-full border border-yellow-500/20 shadow-[0_2px_10px_rgba(0,0,0,0.5)]">
            {category}
          </span>
        </div>
      )}

      <!-- Píldoras de Stock de 4 Niveles (esquina inferior izquierda sobre imagen) -->
      <div class="absolute bottom-3 left-3 z-10">
        {stockLevel === 1 && (
          <span class="inline-flex items-center gap-1.5 bg-emerald-950/80 backdrop-blur-md text-emerald-400 text-[10px] font-extrabold px-3 py-1 rounded-full border border-emerald-500/40 shadow-lg">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>En Stock</span>
          </span>
        )}

        {stockLevel === 2 && (
          <span class="inline-flex items-center gap-1.5 bg-amber-950/80 backdrop-blur-md text-amber-300 text-[10px] font-extrabold px-3 py-1 rounded-full border border-amber-500/40 shadow-[0_0_12px_rgba(245,158,11,0.3)]">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
            <span>⚡ ¡Últimas {qty} unidades!</span>
          </span>
        )}

        {stockLevel === 3 && (
          <span class="inline-flex items-center gap-1.5 bg-gradient-to-r from-red-600 to-rose-600 text-white text-[10px] font-black uppercase px-3 py-1 rounded-full border border-red-400 shadow-[0_0_15px_rgba(220,38,38,0.4)] animate-pulse tracking-wider">
            <span>🔥 ¡SOLO QUEDA 1! Última oportunidad</span>
          </span>
        )}

        {stockLevel === 4 && (
          <span class="inline-flex items-center gap-1.5 bg-purple-950/90 backdrop-blur-md text-amber-300 text-[10px] font-black uppercase px-3 py-1 rounded-full border border-purple-500/50 shadow-lg tracking-wider">
            <span>Agotado • Opción Encargar</span>
          </span>
        )}
      </div>
    </a>

    <!-- Contenido -->
    <div class="px-5 pt-4 pb-2">
      <a href={permalink} class="block">
        <h3 class="font-bold text-white group-hover:text-yellow-300 transition-colors duration-200 line-clamp-2 text-base sm:text-lg leading-snug mb-3 drop-shadow-[0_2px_8px_rgba(255,255,255,0.05)]">
          {title}
        </h3>
      </a>

      <!-- Grid de Precios 2x2 -->
      <a href={permalink} class="block">
        <div class="grid grid-cols-2 gap-y-2 gap-x-4 w-full my-3 py-3 border-t border-b border-white/[0.04]">
          <!-- Fila 1: Precios actuales en naranja -->
          <div class="flex items-center justify-center text-center">
            <span class="text-base sm:text-[1.35rem] font-black text-orange-500 whitespace-nowrap drop-shadow-[0_2px_10px_rgba(249,115,22,0.2)]">
              {formatCUP(priceCUP)}
            </span>
          </div>
          <div class="flex items-center justify-center text-center">
            <span class="text-base sm:text-[1.35rem] font-black text-orange-500 whitespace-nowrap drop-shadow-[0_2px_10px_rgba(249,115,22,0.2)]">
              {formatUSD(priceUSD)}
            </span>
          </div>

          <!-- Fila 2: Precios viejos (solo si está en oferta) -->
          <div class="flex items-center justify-center text-center min-h-[1.25rem]">
            {onSale ? (
              <span class="text-sm text-gray-500 font-medium line-through whitespace-nowrap">
                {formatCUP(regularPriceCUP ?? 0)}
              </span>
            ) : (
              <span class="block h-4"></span>
            )}
          </div>
          <div class="flex items-center justify-center text-center min-h-[1.25rem]">
            {onSale ? (
              <span class="text-sm text-gray-500 font-medium line-through whitespace-nowrap">
                {formatUSD(regularPriceUSD ?? 0)}
              </span>
            ) : (
              <span class="block h-4"></span>
            )}
          </div>
        </div>
      </a>
    </div>

    <!-- Listón Rojo de Ahorro -->
    {onSale && (
      <div class="bg-red-600/90 text-white font-extrabold text-xs text-center h-9 w-full tracking-wider uppercase flex items-center justify-center shadow-[0_4px_15px_rgba(220,38,38,0.2)]">
        <span>AHORRAS ${savingsCUP.toLocaleString('en-US')} CUP / ${(regularPriceUSD! - priceUSD) % 1 === 0 ? `$${(regularPriceUSD! - priceUSD).toFixed(0)}` : `$${(regularPriceUSD! - priceUSD).toFixed(2)}`} USD</span>
      </div>
    )}
  </div>

  <!-- Botones de Acción -->
  <div class="px-5 pb-5 pt-2">
    {stockLevel === 4 ? (
      <!-- Botón Morado de Encargo por WhatsApp (para Nivel 4: Agotados) -->
      <button
        type="button"
        data-order-out-of-stock={title}
        class="out-of-stock-btn w-full bg-purple-900/90 hover:bg-purple-800 text-amber-300 border border-purple-500/50 hover:border-amber-400 font-extrabold py-3 px-4 rounded-xl shadow-[0_4px_15px_rgba(109,30,104,0.4)] hover:shadow-[0_6px_25px_rgba(234,179,8,0.3)] transition-all duration-300 text-xs flex items-center justify-center gap-2 cursor-pointer"
        title="Encargar este producto por WhatsApp"
      >
        <span>💬</span>
        <span>Encargar por WhatsApp</span>
      </button>
    ) : (
      <!-- Botones para productos En Stock (Ver Detalles + Agregar Rápido) -->
      <div class="flex gap-2">
        <a 
          href={permalink}
          class="flex-1 text-center bg-white/5 hover:bg-white/10 text-slate-200 font-bold py-2.5 px-3 rounded-xl transition-all duration-200 text-xs border border-white/[0.08] flex items-center justify-center"
        >
          Ver Detalles
        </a>
        <button
          type="button"
          data-quick-add={JSON.stringify({
            productId: 0,
            slug: slug,
            name: title,
            image: image,
            priceUSD: priceUSD,
            priceCUP: priceCUP,
          })}
          class="quick-add-btn bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-white font-extrabold py-2.5 px-3.5 rounded-xl shadow-[0_4px_15px_rgba(249,115,22,0.25)] hover:shadow-[0_6px_25px_rgba(249,115,22,0.35)] transition-all duration-300 text-xs border border-white/10 flex items-center justify-center gap-1 cursor-pointer"
          title="Agregar rápidamente al carrito"
        >
          <span>🛒</span>
          <span>Agregar</span>
        </button>
      </div>
    )}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Manejo de Quick Add
    document.querySelectorAll('.quick-add-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        try {
          const raw = JSON.parse(btn.getAttribute('data-quick-add') || '{}');
          if ((window as any).CarmayCart) {
            (window as any).CarmayCart.create({
              productId: raw.productId || 0,
              slug: raw.slug,
              name: raw.name,
              image: raw.image,
              priceUSD: raw.priceUSD,
              priceCUP: raw.priceCUP,
              quantity: 1,
            });
            window.dispatchEvent(new CustomEvent('open-carmay-cart'));
          }
        } catch (err) {
          console.error('Error en quick add:', err);
        }
      });
    });

    // Manejo de Encargar Producto Agotado por WhatsApp (Nivel 4)
    document.querySelectorAll('.out-of-stock-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const productName = btn.getAttribute('data-order-out-of-stock') || 'Producto';
        const text = `Hola Carmay Outfit 👋, me interesa encargar el producto *"${productName}"* (actualmente agotado). ¿Cuándo volverá a estar disponible?`;
        const whatsappUrl = `https://wa.me/REDACTED_PHONE_1?text=${encodeURIComponent(text)}`;
        window.open(whatsappUrl, '_blank');
      });
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.quick-add-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
