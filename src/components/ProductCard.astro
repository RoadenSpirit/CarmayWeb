---
interface Props {
  title: string;
  price: string;
  regularPrice?: string;
  priceUSD: number;
  priceCUP: number;
  cupRate: number;
  regularPriceUSD?: number;
  regularPriceCUP?: number;
  image: string;
  category: string;
  isTrending?: boolean;
  permalink: string;
}

const {
  title,
  price,
  regularPrice,
  priceUSD,
  priceCUP,
  cupRate,
  regularPriceUSD,
  regularPriceCUP,
  image,
  category,
  isTrending = false,
  permalink,
} = Astro.props;

const onSale = regularPriceUSD !== undefined && regularPriceUSD > priceUSD;
const discountPercent = onSale ? Math.max(0, Math.round(((regularPriceUSD! - priceUSD) / regularPriceUSD!) * 100)) : 0;
const savingsCUP = onSale ? (regularPriceCUP ?? 0) - priceCUP : 0;

const formatCUP = (n: number) => `${n.toLocaleString('en-US')} CUP`;
const formatUSD = (n: number) => `$${n.toFixed(2)} USD`;
---

<div class="group glass-card glass-card-hover rounded-3xl overflow-hidden shadow-2xl flex flex-col justify-between transition-all duration-300">
  <div>
    <!-- Contenedor de Imagen con Badge -->
    <div class="relative overflow-hidden aspect-square bg-gray-900">
      <img 
        src={image} 
        alt={title} 
        width="600"
        height="600"
        class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100"
        loading="lazy"
      />
      
      {isTrending && (
        <div class="absolute top-3.5 left-3.5 z-10">
          <span class="inline-flex items-center gap-1 bg-gradient-to-r from-amber-500 to-rose-600 text-white text-[11px] font-black uppercase px-3.5 py-1.5 rounded-full shadow-lg tracking-wider border border-white/20">
            🔥 Trending
          </span>
        </div>
      )}

      {category && (
        <div class="absolute top-3.5 right-3.5 z-10">
          <span class="bg-black/70 backdrop-blur-md text-purple-200 text-xs font-bold px-3 py-1 rounded-full border border-white/10 shadow-md">
            {category}
          </span>
        </div>
      )}
    </div>

    <!-- Contenido -->
    <div class="p-6">
      <h3 class="font-bold text-white group-hover:text-amber-300 transition-colors line-clamp-2 text-base sm:text-lg leading-snug mb-4">
        {title}
      </h3>

      <!-- Grid de Precios 2x2 centrado horizontal y verticalmente -->
      <div class="grid grid-cols-2 gap-y-1.5 gap-x-6 w-full my-4">
        <!-- Fila 1: Precios actuales en naranja -->
        <div class="flex items-center justify-center text-center">
          <span class="text-lg sm:text-xl font-black text-orange-500 whitespace-nowrap">
            {formatCUP(priceCUP)}
          </span>
        </div>
        <div class="flex items-center justify-center text-center">
          <span class="text-lg sm:text-xl font-black text-orange-500 whitespace-nowrap">
            {formatUSD(priceUSD)}
          </span>
        </div>

        <!-- Fila 2: Precios viejos (solo si está en oferta) -->
        <div class="flex items-center justify-center text-center min-h-[1.25rem]">
          {onSale ? (
            <span class="text-xs sm:text-sm text-gray-500 font-medium line-through whitespace-nowrap">
              {formatCUP(regularPriceCUP ?? 0)}
            </span>
          ) : (
            <span class="block h-5"></span>
          )}
        </div>
        <div class="flex items-center justify-center text-center min-h-[1.25rem]">
          {onSale ? (
            <span class="text-xs sm:text-sm text-gray-500 font-medium line-through whitespace-nowrap">
              {formatUSD(regularPriceUSD ?? 0)}
            </span>
          ) : (
            <span class="block h-5"></span>
          )}
        </div>
      </div>
    </div>

    <!-- Listón Rojo de Ahorro de extremo a extremo -->
    {onSale ? (
      <div class="bg-red-600 text-white font-extrabold text-xs sm:text-sm text-center h-10 w-full tracking-wider uppercase flex items-center justify-center shadow-md">
        <span>AHORRAS ${savingsCUP.toLocaleString('en-US')} CUP / $${(regularPriceUSD! - priceUSD).toFixed(2)} USD</span>
      </div>
    ) : (
      <div class="h-10 w-full"></div>
    )}
  </div>

  <!-- Botón de Acción -->
  <div class="p-6 pt-4">
    <a 
      href={permalink}
      class="block w-full text-center bg-gradient-to-r from-purple-700 to-purple-900 hover:from-amber-500 hover:to-orange-500 text-white font-extrabold py-3.5 px-5 rounded-2xl shadow-xl transition-all duration-300 text-sm sm:text-base focus-visible:ring-2 focus-visible:ring-purple-500"
    >
      Ver Detalles &amp; Comprar
    </a>
  </div>
</div>
