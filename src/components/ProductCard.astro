---
interface Props {
  title: string;
  price: string;
  regularPrice?: string;
  image: string;
  category: string;
  isTrending?: boolean;
  permalink: string;
}

const { title, price, regularPrice, image, category, isTrending = false, permalink } = Astro.props;
---

<div class="group bg-white rounded-2xl overflow-hidden border border-purple-100/80 shadow-md hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
  <div>
    <!-- Contenedor de Imagen con Badge -->
    <div class="relative overflow-hidden aspect-square bg-gray-100">
      <img 
        src={image} 
        alt={title} 
        class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
      
      {isTrending && (
        <div class="absolute top-3 left-3 z-10">
          <span class="inline-flex items-center gap-1 bg-gradient-to-r from-amber-500 to-rose-600 text-white text-[10px] font-black uppercase px-3 py-1 rounded-full shadow-md tracking-wider border border-white/80">
            🔥 Trending
          </span>
        </div>
      )}

      <div class="absolute top-3 right-3 z-10">
        <span class="bg-white/90 backdrop-blur-md text-purple-900 text-xs font-bold px-2.5 py-1 rounded-full shadow-sm">
          {category}
        </span>
      </div>
    </div>

    <!-- Contenido -->
    <div class="p-5">
      <h3 class="font-bold text-gray-900 group-hover:text-purple-900 transition-colors line-clamp-2 text-sm sm:text-base mb-2">
        {title}
      </h3>

      <div class="flex items-baseline gap-2 mt-2">
        <span class="text-lg sm:text-xl font-extrabold text-purple-900">
          {price}
        </span>
        {regularPrice && (
          <span class="text-xs sm:text-sm text-gray-400 line-through">
            {regularPrice}
          </span>
        )}
      </div>
    </div>
  </div>

  <!-- Botón de Acción -->
  <div class="p-5 pt-0">
    <a 
      href={permalink}
      class="block w-full text-center bg-gradient-to-r from-purple-900 to-purple-700 hover:from-orange-500 hover:to-amber-500 text-white font-bold py-3 px-4 rounded-xl shadow-md hover:shadow-lg transition-all duration-300 text-sm"
    >
      Ver Detalles & Comprar
    </a>
  </div>
</div>
