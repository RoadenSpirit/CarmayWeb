---
// ProductCard.astro: Estilo Pinterest / Temu optimizado
// 1. Imagen protagonista vertical (aspect-[4/5]).
// 2. Título truncado en 1 sola línea para generar intriga.
// 3. Grid 2x2 para precios CUP y USD con precios tachados debajo (sin duplicar porcentaje de ahorro).
// 4. Toda la card conduce a la ficha del producto (/producto/${slug}/).
// 5. Botón al final de la card: texto "Agregar" + SVG del carrito tradicional.
interface Props {
  title: string;
  price: string;
  regularPrice?: string;
  priceUSD: number;
  priceCUP: number;
  cupRate: number;
  regularPriceUSD?: number;
  regularPriceCUP?: number;
  image: string;
  category: string;
  categorySlug: string;
  isTrending?: boolean;
  permalink: string;
  slug: string;
  stockQuantity?: number | null;
  isInStock?: boolean;
  revealDelayClass?: string;
}

const {
  title,
  price,
  regularPrice,
  priceUSD,
  priceCUP,
  cupRate,
  regularPriceUSD,
  regularPriceCUP,
  image,
  category,
  categorySlug,
  isTrending = false,
  permalink,
  slug,
  stockQuantity = null,
  isInStock = true,
  revealDelayClass = '',
} = Astro.props;

const onSale = regularPriceUSD !== undefined && regularPriceUSD > priceUSD;
const discountPercent = onSale ? Math.max(0, Math.round(((regularPriceUSD! - priceUSD) / regularPriceUSD!) * 100)) : 0;

const isAvailable = isInStock ?? true;
const qty = stockQuantity ?? null;
const isSoldOut = !isAvailable || qty === 0;
const isSingleLeft = qty === 1;

const formatCUP = (n: number) => `$${n.toLocaleString('en-US')} CUP`;
const formatUSD = (n: number) => n % 1 === 0 ? `$${n.toFixed(0)} USD` : `$${n.toFixed(2)} USD`;
---

<div 
  class={`product-card-item group relative rounded-2xl overflow-hidden flex flex-col justify-between bg-[#0f1120]/95 border border-white/[0.08] hover:border-amber-400/50 shadow-[0_4px_16px_rgba(0,0,0,0.3)] hover:shadow-[0_12px_32px_rgba(234,179,8,0.2)] hover:-translate-y-1 transition-all duration-300 ${revealDelayClass ? `reveal-card ${revealDelayClass}` : ''} ${isSoldOut ? 'opacity-85 hover:opacity-100' : ''}`}
  data-product-slug={slug}
  data-price-usd={priceUSD}
  data-price-cup={priceCUP}
  data-category-slug={categorySlug}
  data-on-sale={onSale ? 'true' : 'false'}
  data-trending={isTrending ? 'true' : 'false'}
  data-in-stock={isAvailable ? 'true' : 'false'}
>
  <!-- Halo dorado interactivo -->
  <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none border border-amber-500/30 z-10"></div>

  <!-- ================= 1. IMAGEN PROTAGONISTA LIMPIA CON BADGE FLOTANTE ================= -->
  <div class="relative overflow-hidden aspect-[4/5] bg-[#090b12] w-full">
    <a href={permalink} class="block w-full h-full" aria-label={`Ver detalles de ${title}`}>
      <img 
        src={image} 
        alt={title} 
        width="600"
        height="750"
        class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out"
        loading="lazy"
      />
    </a>

    <!-- Badge único prioritario sobre la imagen -->
    <div class="absolute top-2.5 left-2.5 z-20 flex flex-col gap-1 items-start pointer-events-none">
      {onSale && discountPercent > 0 ? (
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-rose-600 text-white shadow-md">
          -{discountPercent}%
        </span>
      ) : isSingleLeft ? (
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-extrabold uppercase tracking-wider bg-amber-500 text-slate-950 shadow-md">
          ¡Última!
        </span>
      ) : isSoldOut ? (
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-purple-950/90 text-amber-300 border border-purple-500/40 shadow-md">
          Agotado
        </span>
      ) : null}
    </div>
  </div>

  <!-- ================= 2. CONTENIDO CONDENSADO: TÍTULO EN 1 LÍNEA + GRID PRECIOS 2X2 DESTACADOS ================= -->
  <div class="p-2.5 sm:p-3 flex-1 flex flex-col justify-between select-none">
    <!-- Enlace a Detalles: Título truncado en 1 sola línea para intriga -->
    <a href={permalink} class="block mb-2" title={title}>
      <h3 class="font-bold text-white group-hover:text-amber-300 transition-colors duration-200 truncate text-xs sm:text-sm leading-snug">
        {title}
      </h3>
    </a>

    <!-- Grid 2x2 para Precios CUP y USD con fondos distintivos y NUNCA truncados -->
    <div class="grid grid-cols-2 gap-2 items-stretch pt-1 border-t border-white/[0.06]">
      
      <!-- Columna 1: Precio CUP (Moneda Reina: fondo cálido y tipografía en ámbar/oro brillante) -->
      <div class="p-2 rounded-xl bg-amber-400/[0.08] border border-amber-400/25 flex flex-col justify-center">
        <span class="text-sm sm:text-base font-black text-amber-300 font-mono tracking-tight block whitespace-normal break-words leading-none">
          {priceCUP > 0 ? formatCUP(priceCUP) : formatUSD(priceUSD)}
        </span>
        {onSale && (regularPriceCUP || regularPriceUSD) && (
          <span class="text-xs text-amber-200/50 font-mono line-through block mt-1 leading-none">
            {priceCUP > 0 && regularPriceCUP ? formatCUP(regularPriceCUP) : formatUSD(regularPriceUSD!)}
          </span>
        )}
      </div>

      <!-- Columna 2: Precio USD (Divisa secundaria: fondo esmeralda y tipografía verde) -->
      <div class="p-2 rounded-xl bg-emerald-500/[0.08] border border-emerald-500/25 flex flex-col justify-center text-right sm:text-left">
        <span class="text-xs sm:text-sm font-extrabold text-emerald-400 font-mono tracking-tight block whitespace-normal break-words leading-none">
          {formatUSD(priceUSD)}
        </span>
        {onSale && regularPriceUSD && regularPriceUSD > priceUSD && (
          <span class="text-xs text-emerald-500/50 font-mono line-through block mt-1 leading-none">
            {formatUSD(regularPriceUSD)}
          </span>
        )}
      </div>

    </div>
  </div>

  <!-- ================= 3. BOTÓN AL FINAL DE LA CARD: FINO, ESTILIZADO Y NO INVASIVO ================= -->
  <div class="px-2.5 sm:px-3 pb-2.5 sm:pb-3 pt-0">
    {isSoldOut ? (
      <button
        type="button"
        data-order-out-of-stock={title}
        class="out-of-stock-btn w-full min-h-[42px] py-2 px-3 rounded-xl bg-purple-950/40 hover:bg-purple-900 border border-purple-500/40 hover:border-amber-400 text-purple-200 hover:text-white font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-sm active:scale-95 transition-all cursor-pointer"
        title="Encargar este producto por WhatsApp"
      >
        <span>Encargar</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
        </svg>
      </button>
    ) : (
      <button
        type="button"
        data-quick-add={JSON.stringify({
          productId: 0,
          slug: slug,
          name: title,
          image: image,
          priceUSD: priceUSD,
          priceCUP: priceCUP,
        })}
        class="quick-add-btn group/btn w-full min-h-[42px] py-2 px-3 rounded-xl bg-white/[0.03] hover:bg-gradient-to-tr hover:from-amber-500 hover:to-yellow-400 border border-amber-400/35 hover:border-transparent text-amber-300 hover:text-slate-950 font-extrabold text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-sm hover:shadow-[0_4px_16px_rgba(234,179,8,0.35)] active:scale-[0.97] transition-all duration-200 cursor-pointer"
        title="Agregar al carrito"
      >
        <span>Agregar</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400 group-hover/btn:text-slate-950 transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l2.4 12.4a2 2 0 002 1.6h7.7a2 2 0 002-1.6L21 7H6" />
          <circle cx="9" cy="20" r="1.5" />
          <circle cx="17" cy="20" r="1.5" />
        </svg>
      </button>
    )}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Quick Add con apertura transparente del CartDrawer
    document.querySelectorAll('.quick-add-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        try {
          const raw = JSON.parse(btn.getAttribute('data-quick-add') || '{}');
          if ((window as any).CarmayCart) {
            (window as any).CarmayCart.create({
              productId: raw.productId || 0,
              slug: raw.slug,
              name: raw.name,
              image: raw.image,
              priceUSD: raw.priceUSD,
              priceCUP: raw.priceCUP,
              quantity: 1,
            });
            window.dispatchEvent(new CustomEvent('open-carmay-cart'));
          }
        } catch (err) {
          console.error('Error en quick add:', err);
        }
      });
    });

    // Encargo de producto agotado por WhatsApp
    document.querySelectorAll('.out-of-stock-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const productName = btn.getAttribute('data-order-out-of-stock') || 'Producto';
        const text = `Hola Carmay Outfit 👋, me interesa encargar el producto *"${productName}"* (actualmente agotado). ¿Cuándo volverá a estar disponible?`;
        const whatsappUrl = `https://wa.me/REDACTED_PHONE_1?text=${encodeURIComponent(text)}`;
        window.open(whatsappUrl, '_blank');
      });
    });
  });
</script>

<style>
  .product-card-item {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.25s ease-out,
                border-color 0.25s ease-out;
  }
</style>
