---
// Componente de Tienda Física & Entrega Diaria Garantizada (StoreBanner.astro)
// Reutilizable en index.astro y tienda.astro justo después de las cards de categorías.
---

<section class="py-4 sm:py-6 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="rounded-3xl p-6 sm:p-10 border border-purple-200/90 bg-gradient-to-r from-purple-50 via-white to-purple-50 dark:border-purple-600/30 dark:bg-gradient-to-r dark:from-purple-950/70 dark:via-[#111322] dark:to-purple-950/70 backdrop-blur-xl shadow-md dark:shadow-[0_16px_50px_rgba(0,0,0,0.5)] reveal-blur-fade transition-colors">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Columna 1: Sello de Garantía y Mensajería a Domicilio (7 cols) -->
      <div class="lg:col-span-7 flex flex-col sm:flex-row items-center sm:items-start gap-5 text-center sm:text-left">
        <!-- Sello fotográfico oficial -->
        <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl overflow-hidden border border-amber-400/40 shrink-0 shadow-lg p-1 bg-white dark:bg-white/5">
          <img 
            src="/envio-garantizado.webp" 
            alt="Sello de Envío Garantizado el Mismo Día" 
            width="96" 
            height="96" 
            class="w-full h-full object-contain rounded-xl"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="space-y-2">
          <div class="inline-flex items-center gap-1.5 text-xs font-black uppercase tracking-wider text-amber-600 dark:text-amber-400 bg-amber-500/10 px-3 py-1 rounded-full border border-amber-500/20 dark:border-amber-500/30">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
            </svg>
            <span>Entrega Diaria Garantizada</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white" style="font-family: 'Outfit', sans-serif;">
            Tu pedido en la puerta de tu casa el mismo día
          </h3>
          <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm leading-relaxed">
            Al contratar nuestro servicio de mensajería en Camagüey, aseguramos que tu compra llegue a tus manos <strong class="text-slate-900 dark:text-white font-semibold">el mismo día</strong>. Rápido, seguro y confiable.
          </p>
        </div>
      </div>

      <!-- Columna 2: Tienda Física y Horarios (5 cols) -->
      <div class="lg:col-span-5 flex flex-col justify-center gap-3 p-4 sm:p-5 rounded-2xl bg-white/90 border border-slate-200/90 dark:bg-white/[0.03] dark:border-white/[0.08] shadow-sm">
        <div class="flex items-center justify-between gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400 inline-flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 9l1.5-5h15L21 9M4 9v11h16V9M4 9h16M9 20v-6h6v6" />
            </svg>
            <span>Tienda Física</span>
          </span>
          <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">Camagüey, Cuba</span>
        </div>

        <a 
          href="https://maps.google.com/?q=Avellaneda+260,+Camaguey,+Cuba"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs sm:text-sm text-slate-800 dark:text-white font-semibold leading-snug hover:text-amber-600 dark:hover:text-amber-400 transition-colors inline-flex items-center gap-1.5 min-h-[44px] py-1"
          title="Ver ubicación en Google Maps"
        >
          <span>Avellaneda No. 260 entre San Esteban y San Martín</span>
          <span class="text-amber-500 dark:text-amber-400 text-xs">&nearr;</span>
        </a>

        <div class="flex items-center justify-between text-xs sm:text-xs text-slate-600 dark:text-slate-300 pt-1 border-t border-slate-200/70 dark:border-white/[0.06] gap-2 flex-wrap">
          <span>Lunes a Viernes: <strong class="text-slate-900 dark:text-white font-mono">8:30 AM – 4:30 PM</strong></span>
          <span>Sábados: <strong class="text-slate-900 dark:text-white font-mono">8:30 AM – 2:00 PM</strong></span>
        </div>

        <div class="pt-2 flex items-center justify-between gap-3">
          <a 
            href="/contact/" 
            class="min-h-[44px] inline-flex items-center gap-1.5 text-xs font-bold text-amber-400 hover:text-yellow-300 transition-colors"
          >
            <span>Ver detalles y horarios</span>
            <span>&rarr;</span>
          </a>
          <a 
            href="https://wa.me/5363791924?text=Hola%20Carmay%20Outfit,%20quisiera%20hacer%20un%20pedido%20a%20domicilio" 
            target="_blank"
            class="min-h-[44px] inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/40 text-emerald-300 text-xs font-bold transition-all shadow-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
            </svg>
            <span>WhatsApp</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
