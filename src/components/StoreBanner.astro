---
// Componente de Tienda Física & Entrega Diaria Garantizada (StoreBanner.astro)
// Reutilizable en index.astro y tienda.astro justo después de las cards de categorías.
---

<section class="py-10 sm:py-14 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="rounded-3xl p-6 sm:p-10 border border-purple-600/30 bg-gradient-to-r from-purple-950/70 via-[#111322] to-purple-950/70 backdrop-blur-xl shadow-[0_16px_50px_rgba(0,0,0,0.5)] reveal-blur-fade">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Columna 1: Sello de Garantía y Mensajería a Domicilio (7 cols) -->
      <div class="lg:col-span-7 flex flex-col sm:flex-row items-center sm:items-start gap-5 text-center sm:text-left">
        <!-- Sello fotográfico oficial -->
        <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl overflow-hidden border border-amber-400/40 shrink-0 shadow-lg p-1 bg-white/5">
          <img 
            src="/envio-garantizado.jpg" 
            alt="Sello de Envío Garantizado el Mismo Día" 
            width="96" 
            height="96" 
            class="w-full h-full object-contain rounded-xl"
            loading="lazy"
          />
        </div>

        <div class="space-y-2">
          <div class="inline-flex items-center gap-1.5 text-xs font-black uppercase tracking-wider text-amber-400 bg-amber-500/10 px-3 py-1 rounded-full border border-amber-500/30">
            <span>🚀 Entrega Diaria Garantizada</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-black text-white" style="font-family: 'Outfit', sans-serif;">
            Tu pedido en la puerta de tu casa el mismo día
          </h3>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
            Al contratar nuestro servicio de mensajería en Camagüey, aseguramos que tu compra llegue a tus manos <strong class="text-white font-semibold">el mismo día</strong>. Rápido, seguro y confiable.
          </p>
        </div>
      </div>

      <!-- Columna 2: Tienda Física y Horarios (5 cols) -->
      <div class="lg:col-span-5 flex flex-col justify-center gap-3 p-4 sm:p-5 rounded-2xl bg-white/[0.03] border border-white/[0.08]">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-400">🏛️ Tienda Física</span>
          <span class="text-[11px] text-slate-400 font-medium">Camagüey, Cuba</span>
        </div>

        <p class="text-xs sm:text-sm text-white font-semibold leading-snug">
          Avellaneda No. 260 entre San Esteban y San Martín
        </p>

        <div class="flex items-center justify-between text-[11px] sm:text-xs text-slate-300 pt-1 border-t border-white/[0.06]">
          <span>Lunes a Viernes: <strong class="text-white font-mono">8:30 AM – 4:30 PM</strong></span>
          <span>Sábados: <strong class="text-white font-mono">8:30 AM – 2:00 PM</strong></span>
        </div>

        <div class="pt-2 flex items-center justify-between gap-3">
          <a 
            href="/contact" 
            class="text-xs font-bold text-amber-400 hover:text-yellow-300 transition-colors flex items-center gap-1"
          >
            <span>Ver detalles y contacto</span>
            <span>&rarr;</span>
          </a>
          <a 
            href="https://wa.me/5363791924?text=Hola%20Carmay%20Outfit,%20quisiera%20hacer%20un%20pedido%20a%20domicilio" 
            target="_blank"
            class="px-3 py-1.5 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/40 text-emerald-300 text-xs font-bold transition-all"
          >
            WhatsApp &rarr;
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
