---
import ProductCard from './ProductCard.astro';
import type { ProductCardData } from '../api/models/Product.js';

interface Props {
  title: string;
  subtitle: string;
  products: ProductCardData[];
}

const { title, subtitle, products } = Astro.props;
---

<section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 reveal-on-scroll">
    <div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        {title}
      </h2>
      <p class="text-amber-400 font-bold text-xs sm:text-sm uppercase tracking-widest block mt-2">{subtitle}</p>
    </div>
    <a href="/tienda/" class="mt-4 md:mt-0 inline-flex items-center gap-2 min-h-[44px] text-amber-400 font-bold hover:text-yellow-300 transition-colors text-sm sm:text-base group">
      <span>Ver todo el Catálogo</span>
      <span class="group-hover:translate-x-1 transition-transform duration-200">&rarr;</span>
    </a>
  </div>

  <!-- Rejilla con items-stretch para garantizar alturas idénticas y simétricas en las cards del Home -->
  <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-4 lg:gap-6 items-stretch">
    {products.map((product, idx) => (
      <div class={`reveal-card reveal-delay-${Math.min(idx + 1, 4)} h-full flex flex-col`}>
        <ProductCard {...product} uniformHeight={true} />
      </div>
    ))}
  </div>
</section>
