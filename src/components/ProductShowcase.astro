---
import ProductCard from './ProductCard.astro';

interface Props {
  title: string;
  subtitle: string;
  products: Array<{
    title: string;
    price: string;
    regularPrice?: string;
    image: string;
    category: string;
    isTrending?: boolean;
    permalink: string;
  }>;
}

const { title, subtitle, products } = Astro.props;
---

<section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
    <div>
      <span class="text-amber-400 font-bold text-xs uppercase tracking-widest block mb-2">{subtitle}</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        {title}
      </h2>
    </div>
    <a href="https://carmayoutfit.com/products/" target="_blank" class="mt-4 md:mt-0 inline-flex items-center gap-2 text-purple-300 font-bold hover:text-amber-400 transition-colors text-sm">
      <span>Ver todo en WordPress</span>
      <span>&rarr;</span>
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {products.map(product => (
      <ProductCard {...product} />
    ))}
  </div>
</section>
