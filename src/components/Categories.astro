---
const categories = [
  {
    name: "Calzado",
    image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=600&q=80",
    count: "Ver Colección",
    slug: "zapatos"
  },
  {
    name: "Ropa",
    image: "https://images.unsplash.com/photo-1489987707025-afc232f7ea0f?auto=format&fit=crop&w=600&q=80",
    count: "Moda Actual",
    slug: "ropa"
  },
  {
    name: "Bolsos y Mochilas",
    image: "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=600&q=80",
    count: "Estilo & Confort",
    slug: "jackets"
  },
  {
    name: "Tecnología",
    image: "https://images.unsplash.com/photo-1593359677879-a4bb92f829d1?auto=format&fit=crop&w=600&q=80",
    count: "Innovación & Poder",
    slug: "tecnologia"
  },
  {
    name: "Accesorios",
    image: "https://images.unsplash.com/photo-1523293182086-7651a899d37f?auto=format&fit=crop&w=600&q=80",
    count: "Detalles Únicos",
    slug: "accesorios"
  }
];
---

<section class="py-6 sm:py-8 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center max-w-2xl mx-auto mb-5 sm:mb-6 reveal-on-scroll">
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
      Nuestras Categorías Principales
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 xl:grid-cols-5 gap-4 sm:gap-5 justify-center">
    {categories.map((cat, idx) => (
      <a 
        href={`/tienda/${cat.slug}/`}
        class={`group relative overflow-hidden rounded-2xl sm:rounded-3xl aspect-[16/9] sm:aspect-[4/3] md:aspect-[3/4] glass-card flex flex-col justify-end p-4 sm:p-5 md:p-6 border border-white/10 hover:border-amber-500/50 transition-all duration-500 shadow-md hover:shadow-xl hover:-translate-y-1.5 reveal-scale reveal-delay-${Math.min((idx % 4) + 1, 4)}`}
      >
        <!-- Imagen de fondo -->
        <img 
          src={cat.image} 
          alt={cat.name}
          width="450"
          height="600"
          class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 opacity-60 group-hover:opacity-85"
          loading="lazy"
        />

        <!-- Overlay con gradiente oscuro -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#0f0e17] via-[#0f0e17]/40 to-transparent"></div>

        <!-- Contenido -->
        <div class="relative z-10">
          <h3 class="text-lg sm:text-xl md:text-2xl font-black text-white group-hover:text-amber-300 transition-colors leading-tight">
            {cat.name}
          </h3>
          <span class="text-xs sm:text-sm font-extrabold text-amber-400 tracking-wider uppercase block mt-1">{cat.count}</span>
        </div>
      </a>
    ))}
  </div>
</section>
