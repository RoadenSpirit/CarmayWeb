---
// ProductBadge.astro: Píldoras múltiples acumulables de alto gancho comercial con microcopia variada
interface Props {
  onSale?: boolean;
  discountPercent?: number;
  isTrending?: boolean;
  stockQuantity?: number | null;
  isSoldOut?: boolean;
  slug?: string;
}

const {
  onSale = false,
  discountPercent = 0,
  isTrending = false,
  stockQuantity = null,
  isSoldOut = false,
  slug = '',
} = Astro.props;

// Generador determinista de microcopia variada por producto
const hash = slug.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);

const singleLeftPhrases = [
  "¡Última!",
  "Solo queda 1",
  "Única disponible",
  "¡Solo 1!"
];

const lowStockPhrases = [
  stockQuantity ? `¡Quedan ${stockQuantity}!` : "Pocas unidades",
  "Pocas existencias",
  "Casi agotado",
  "Stock limitado"
];

const singleLeftText = singleLeftPhrases[hash % singleLeftPhrases.length];
const lowStockText = lowStockPhrases[hash % lowStockPhrases.length];

const isSingle = stockQuantity === 1;
const isLow = stockQuantity === 2 || stockQuantity === 3;
---

<div class="absolute top-2.5 left-2.5 z-20 flex flex-col gap-1 items-start pointer-events-none select-none">
  {isSoldOut ? (
    <!-- Producto Agotado -->
    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-purple-950/90 text-amber-300 border border-purple-500/40 shadow-md">
      Agotado
    </span>
  ) : (
    <>
      <!-- 1. Gancho de Descuento (Rojo de alto impacto) -->
      {onSale && discountPercent > 0 && (
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-rose-600 text-white shadow-md">
          -{discountPercent}%
        </span>
      )}

      <!-- 2. Gancho de Tendencia / Popularidad (Dorado) -->
      {isTrending && (
        <span class="inline-flex items-center gap-1 bg-gradient-to-r from-amber-500 to-rose-600 text-white text-xs font-black uppercase px-2 py-0.5 rounded-full shadow-md tracking-wider">
          <span>Trending</span>
        </span>
      )}

      <!-- 3. Gancho de Urgencia de Stock: Última Unidad (Ámbar intenso) -->
      {isSingle && (
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-extrabold uppercase tracking-wider bg-amber-500 text-slate-950 shadow-md">
          {singleLeftText}
        </span>
      )}

      <!-- 4. Gancho de Urgencia de Stock: Pocas Existencias (Ámbar suave con borde) -->
      {isLow && (
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-950/80 text-amber-300 border border-amber-500/40 shadow-md">
          {lowStockText}
        </span>
      )}
    </>
  )}
</div>
