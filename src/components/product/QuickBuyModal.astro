---
// QuickBuyModal.astro: Modal ultra simplificado de compra inmediata
---

<div
  id="quick-buy-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-md transition-all duration-200 opacity-0 pointer-events-none"
  aria-modal="true"
  role="dialog"
  aria-labelledby="qb-title"
>
  <!-- Caja del Modal Compacta y Fluida -->
  <div
    id="quick-buy-content"
    class="relative w-full max-w-sm bg-[#0f1120] border border-white/15 rounded-3xl p-5 sm:p-6 shadow-[0_20px_60px_rgba(0,0,0,0.85)] scale-95 transition-all duration-200 overflow-hidden"
  >
    <!-- Botón Cerrar (SVG Puro) -->
    <button
      id="quick-buy-close"
      type="button"
      class="absolute top-3.5 right-3.5 w-8 h-8 rounded-full bg-white/5 border border-white/10 hover:bg-white/15 text-slate-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer z-10"
      aria-label="Cerrar ventana de compra rápida"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- 1. Imagen Protagonista (Respeta 100% su relación de aspecto original) -->
    <div class="w-full h-56 sm:h-60 rounded-2xl overflow-hidden bg-[#080a12] border border-white/10 mb-4 flex items-center justify-center p-2">
      <img
        id="qb-image"
        src=""
        alt=""
        class="max-h-full max-w-full w-auto h-auto object-contain rounded-xl drop-shadow-lg"
      />
    </div>

    <!-- 2. Nombre del Producto -->
    <h3 id="qb-title" class="font-extrabold text-white text-base sm:text-lg leading-snug truncate text-center mb-3"></h3>

    <!-- 3. Precios Dinámicos según la Cantidad (CUP Naranja #f97316 y USD Esmeralda) -->
    <div class="rounded-2xl bg-white/[0.03] border border-white/[0.06] p-3 text-center mb-4">
      <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-1">Total a Pagar</span>
      <div class="flex items-baseline justify-center gap-2">
        <span id="qb-price-cup" class="text-xl sm:text-2xl font-black text-[#f97316] font-mono tracking-tight"></span>
        <span class="text-slate-500 font-bold">/</span>
        <span id="qb-price-usd" class="text-sm sm:text-base font-bold text-emerald-400 font-mono"></span>
      </div>
    </div>

    <!-- 4. Selector de Cantidad interactivo (+ / -) -->
    <div class="flex items-center justify-between bg-black/40 border border-white/10 rounded-2xl p-2 mb-5">
      <span class="text-xs font-bold text-slate-300 uppercase tracking-wider pl-2">Cantidad</span>
      <div class="flex items-center gap-1.5">
        <button
          type="button"
          id="qb-qty-minus"
          class="w-9 h-9 rounded-xl bg-white/5 hover:bg-white/15 border border-white/10 text-white flex items-center justify-center transition-colors cursor-pointer select-none active:scale-95"
          aria-label="Restar una unidad"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" />
          </svg>
        </button>
        <span id="qb-qty-display" class="text-sm font-black text-white font-mono px-3 min-w-[2.2rem] text-center">1</span>
        <button
          type="button"
          id="qb-qty-plus"
          class="w-9 h-9 rounded-xl bg-white/5 hover:bg-white/15 border border-white/10 text-white flex items-center justify-center transition-colors cursor-pointer select-none active:scale-95"
          aria-label="Sumar una unidad"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
        </button>
      </div>
    </div>

    <!-- 5. Botones de Acción: Comprar Ahora (Principal) + Agregar al Carrito (Secundario sutil) -->
    <div class="flex flex-col gap-2.5">
      <!-- Botón Principal: Comprar Ahora -->
      <button
        type="button"
        id="qb-buy-now-btn"
        class="w-full py-3.5 px-5 rounded-2xl bg-gradient-to-r from-amber-500 via-amber-400 to-yellow-500 hover:from-amber-400 hover:via-yellow-400 hover:to-yellow-300 active:scale-[0.98] text-slate-950 font-black text-sm uppercase tracking-wider shadow-[0_4px_16px_rgba(234,179,8,0.35)] hover:shadow-[0_6px_22px_rgba(234,179,8,0.45)] transition-all flex items-center justify-center gap-2 cursor-pointer select-none"
      >
        <span>Comprar Ahora</span>
      </button>

      <!-- Botón Secundario Sutil: Ver Más Detalles -->
      <a
        id="qb-view-more-link"
        href="#"
        class="w-full py-2.5 px-4 rounded-xl bg-white/[0.04] hover:bg-white/[0.09] border border-white/10 text-slate-300 hover:text-white font-semibold text-xs tracking-wider transition-all flex items-center justify-center gap-1.5 select-none"
      >
        <span>Ver Más Detalles</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-400 group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('quick-buy-modal');
    const content = document.getElementById('quick-buy-content');
    const closeBtn = document.getElementById('quick-buy-close');

    const imgEl = document.getElementById('qb-image');
    const titleEl = document.getElementById('qb-title');
    const priceCupEl = document.getElementById('qb-price-cup');
    const priceUsdEl = document.getElementById('qb-price-usd');
    const qtyDisplay = document.getElementById('qb-qty-display');

    const qtyMinus = document.getElementById('qb-qty-minus');
    const qtyPlus = document.getElementById('qb-qty-plus');

    const buyNowBtn = document.getElementById('qb-buy-now-btn');
    const viewMoreLink = document.getElementById('qb-view-more-link');

    let currentProduct = null;
    let currentQty = 1;

    function updatePrices() {
      if (!currentProduct) return;
      if (qtyDisplay) qtyDisplay.textContent = String(currentQty);

      const totalCUP = (currentProduct.priceCUP || 0) * currentQty;
      const totalUSD = (currentProduct.priceUSD || 0) * currentQty;

      if (priceCupEl) {
        priceCupEl.textContent = `$${totalCUP.toLocaleString('en-US')} CUP`;
      }
      if (priceUsdEl) {
        priceUsdEl.textContent = `$${totalUSD % 1 === 0 ? totalUSD.toFixed(0) : totalUSD.toFixed(2)} USD`;
      }
    }

    function openModal(data) {
      currentProduct = data;
      currentQty = 1;

      if (imgEl) {
        imgEl.src = data.image || '';
        imgEl.alt = data.name || 'Producto';
      }
      if (titleEl) {
        titleEl.textContent = data.name || '';
      }
      if (viewMoreLink && data.slug) {
        viewMoreLink.href = `/producto/${data.slug}/`;
      }

      updatePrices();

      if (modal && content) {
        modal.classList.remove('hidden', 'pointer-events-none');
        modal.classList.add('flex');
        requestAnimationFrame(() => {
          modal.classList.remove('opacity-0');
          modal.classList.add('opacity-100');
          content.classList.remove('scale-95');
          content.classList.add('scale-100');
        });
        document.body.style.overflow = 'hidden';
      }
    }

    function closeModal() {
      if (modal && content) {
        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0');
        content.classList.remove('scale-100');
        content.classList.add('scale-95');
        setTimeout(() => {
          modal.classList.add('hidden', 'pointer-events-none');
          modal.classList.remove('flex');
          document.body.style.overflow = '';
        }, 200);
      }
    }

    qtyMinus?.addEventListener('click', () => {
      if (currentQty > 1) {
        currentQty -= 1;
        updatePrices();
      }
    });

    qtyPlus?.addEventListener('click', () => {
      const maxStock = currentProduct?.stockQuantity || 10;
      if (currentQty < maxStock) {
        currentQty += 1;
        updatePrices();
      }
    });

    closeBtn?.addEventListener('click', closeModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Escuchar evento global desde cualquier card o detalle de producto
    window.addEventListener('open-quick-buy', (e) => {
      if (e.detail) openModal(e.detail);
    });

    // 1. Acción: Comprar Ahora directo a WhatsApp sin formularios
    buyNowBtn?.addEventListener('click', () => {
      if (!currentProduct) return;

      const totalCUP = (currentProduct.priceCUP || 0) * currentQty;
      const totalUSD = (currentProduct.priceUSD || 0) * currentQty;
      const formattedTotalCUP = `$${totalCUP.toLocaleString('en-US')} CUP`;
      const formattedTotalUSD = `$${totalUSD % 1 === 0 ? totalUSD.toFixed(0) : totalUSD.toFixed(2)} USD`;

      const msg = `👋 *Hola Carmay Outfit, deseo comprar este producto:*\n\n` +
        `🛍️ *Producto:* *${currentProduct.name}*\n` +
        `📦 *Cantidad:* ${currentQty}\n` +
        `💰 *Total:* ${formattedTotalCUP} / ${formattedTotalUSD}\n\n` +
        `¿Podrían confirmarme la disponibilidad para coordinar la entrega?`;

      const waUrl = `https://wa.me/REDACTED_PHONE_1?text=${encodeURIComponent(msg)}`;
      window.open(waUrl, '_blank');
      closeModal();
    });

    // 2. Acción: Enlace a detalles del producto
    viewMoreLink?.addEventListener('click', () => {
      closeModal();
    });
  });
</script>
