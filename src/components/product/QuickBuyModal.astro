---
// QuickBuyModal.astro: Modal de Compra Rápida Directa en Pantalla con Despacho Autónomo por WhatsApp
---

<div
  id="quick-buy-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-3 sm:p-4 bg-black/80 backdrop-blur-md transition-all duration-300 opacity-0 pointer-events-none"
  aria-modal="true"
  role="dialog"
  aria-labelledby="quick-buy-title"
>
  <!-- Caja del Modal -->
  <div
    id="quick-buy-content"
    class="relative w-full max-w-lg bg-[#0f1120] border border-white/15 rounded-3xl p-5 sm:p-7 shadow-[0_20px_60px_rgba(0,0,0,0.8)] overflow-hidden scale-95 transition-all duration-300 max-h-[90vh] overflow-y-auto scrollbar-hide"
  >
    <!-- Botón Cerrar (SVG puro) -->
    <button
      id="quick-buy-close"
      type="button"
      class="absolute top-4 right-4 w-9 h-9 rounded-full bg-white/5 border border-white/10 hover:bg-white/15 text-slate-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer z-10"
      aria-label="Cerrar modal de compra rápida"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Estado 1: Formulario de Compra Rápida -->
    <div id="quick-buy-form-wrapper">
      <div class="flex items-center gap-2 mb-4">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-400/10 text-amber-400 border border-amber-400/20">
          Compra Rápida
        </span>
        <span class="text-xs text-slate-400">Sin pasar por el carrito</span>
      </div>

      <!-- Resumen del Producto Seleccionado -->
      <div class="flex items-center gap-3.5 p-3 rounded-2xl bg-white/[0.03] border border-white/[0.06] mb-5">
        <img
          id="qb-image"
          src=""
          alt=""
          class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl object-cover bg-black border border-white/10 shrink-0"
        />
        <div class="flex-1 min-w-0">
          <h3 id="qb-title" class="text-sm sm:text-base font-extrabold text-white truncate"></h3>
          <div class="mt-1 flex items-baseline gap-2">
            <span id="qb-price-cup" class="text-sm font-black text-[#f97316] font-mono"></span>
            <span class="text-xs text-slate-500">/</span>
            <span id="qb-price-usd" class="text-xs font-bold text-emerald-400 font-mono"></span>
          </div>
          <span id="qb-stock-label" class="text-[11px] font-mono text-slate-400 block mt-0.5"></span>
        </div>
      </div>

      <form id="quick-buy-form" class="space-y-4">
        <!-- Selector Opcional de Color -->
        <div id="qb-color-section" class="hidden">
          <div class="flex items-center justify-between mb-1.5">
            <label class="text-xs font-bold text-slate-300 uppercase tracking-wider">
              Color <span class="text-[11px] font-normal text-slate-400 normal-case">(opcional)</span>
            </label>
            <span id="qb-selected-color-label" class="text-xs font-mono font-bold text-amber-400"></span>
          </div>
          <div id="qb-color-options" class="flex flex-wrap gap-2"></div>
        </div>

        <!-- Selector Opcional de Talla -->
        <div id="qb-size-section" class="hidden">
          <div class="flex items-center justify-between mb-1.5">
            <label class="text-xs font-bold text-slate-300 uppercase tracking-wider">
              Talla <span class="text-[11px] font-normal text-slate-400 normal-case">(opcional)</span>
            </label>
            <span id="qb-selected-size-label" class="text-xs font-mono font-bold text-amber-400"></span>
          </div>
          <div id="qb-size-options" class="flex flex-wrap gap-2"></div>
        </div>

        <!-- Selector de Cantidad interactivo con SVGs puros -->
        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
            Cantidad
          </label>
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-1.5 bg-black/40 rounded-xl p-1 border border-white/10">
              <button
                type="button"
                id="qb-qty-minus"
                class="w-9 h-9 rounded-lg flex items-center justify-center text-slate-300 hover:text-amber-400 hover:bg-white/10 transition-colors cursor-pointer"
                aria-label="Restar una unidad"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" />
                </svg>
              </button>
              <span id="qb-qty-display" class="text-sm font-black text-white font-mono px-3 min-w-[2rem] text-center">1</span>
              <button
                type="button"
                id="qb-qty-plus"
                class="w-9 h-9 rounded-lg flex items-center justify-center text-slate-300 hover:text-amber-400 hover:bg-white/10 transition-colors cursor-pointer"
                aria-label="Sumar una unidad"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
              </button>
            </div>
            <div class="text-xs text-slate-400">
              Total: <strong id="qb-total-display" class="text-[#f97316] font-mono text-sm block"></strong>
            </div>
          </div>
        </div>

        <!-- Datos del Cliente para el Despacho Automático -->
        <div class="pt-3 border-t border-white/[0.06] space-y-3">
          <div>
            <label for="qb-client-name" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
              Tu Nombre Completo <span class="text-amber-400">*</span>
            </label>
            <input
              type="text"
              id="qb-client-name"
              required
              placeholder="Ej. Carlos Pérez"
              class="w-full bg-black/40 border border-white/10 rounded-xl px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all"
            />
          </div>

          <div>
            <label for="qb-client-phone" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
              WhatsApp de Contacto <span class="text-amber-400">*</span>
            </label>
            <div class="flex items-center">
              <span class="inline-flex items-center px-3 py-2.5 rounded-l-xl border border-r-0 border-white/10 bg-white/5 text-slate-400 text-xs font-mono font-bold">
                +53
              </span>
              <input
                type="tel"
                id="qb-client-phone"
                required
                placeholder="51234567"
                maxlength="10"
                class="w-full bg-black/40 border border-white/10 rounded-r-xl px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all font-mono"
              />
            </div>
            <p class="text-[11px] text-slate-400 mt-1">Aquí recibirás el comprobante oficial de tu pedido de forma automática.</p>
          </div>

          <div>
            <label for="qb-client-notes" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
              Dirección de Entrega o Nota <span class="text-xs font-normal text-slate-400 normal-case">(opcional)</span>
            </label>
            <input
              type="text"
              id="qb-client-notes"
              placeholder="Ej. Reparto Centro o Recojo en tienda"
              class="w-full bg-black/40 border border-white/10 rounded-xl px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all"
            />
          </div>
        </div>

        <div id="qb-error-msg" class="hidden p-3 rounded-xl bg-red-900/40 border border-red-500/30 text-red-300 text-xs font-semibold text-center"></div>

        <!-- Botón de Confirmación -->
        <button
          type="submit"
          id="qb-submit-btn"
          class="w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-amber-500 via-orange-600 to-amber-600 hover:from-amber-400 hover:to-orange-500 text-white font-black text-sm uppercase tracking-wider shadow-[0_6px_25px_rgba(249,115,22,0.35)] hover:shadow-[0_8px_35px_rgba(249,115,22,0.5)] transition-all transform hover:-translate-y-0.5 border border-white/10 cursor-pointer flex items-center justify-center gap-2 mt-4"
        >
          <span class="inline-flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Confirmar Compra
          </span>
        </button>
      </form>
    </div>

    <!-- Estado 2: Confirmación Exitosa -->
    <div id="quick-buy-success" class="hidden py-8 text-center flex-col items-center">
      <div class="w-16 h-16 rounded-full bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400 mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h3 class="text-xl font-extrabold text-white mb-2">¡Pedido Confirmado!</h3>
      <p class="text-xs sm:text-sm text-slate-300 max-w-sm mx-auto leading-relaxed mb-6">
        Nuestro sistema automatizado ha enviado los detalles de tu ticket directamente a tu WhatsApp. En breve un dependiente se comunicará para coordinar la entrega.
      </p>
      <button
        type="button"
        id="qb-finish-btn"
        class="py-3 px-8 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer border border-white/15"
      >
        Entendido y Cerrar
      </button>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('quick-buy-modal');
    const content = document.getElementById('quick-buy-content');
    const closeBtn = document.getElementById('quick-buy-close');
    const form = document.getElementById('quick-buy-form');
    const formWrapper = document.getElementById('quick-buy-form-wrapper');
    const successWrapper = document.getElementById('quick-buy-success');
    const finishBtn = document.getElementById('qb-finish-btn');
    const submitBtn = document.getElementById('qb-submit-btn');
    const errorBox = document.getElementById('qb-error-msg');

    const imgEl = document.getElementById('qb-image');
    const titleEl = document.getElementById('qb-title');
    const priceCupEl = document.getElementById('qb-price-cup');
    const priceUsdEl = document.getElementById('qb-price-usd');
    const stockLabel = document.getElementById('qb-stock-label');
    const totalDisplay = document.getElementById('qb-total-display');

    const colorSection = document.getElementById('qb-color-section');
    const colorOptionsEl = document.getElementById('qb-color-options');
    const selectedColorLabel = document.getElementById('qb-selected-color-label');

    const sizeSection = document.getElementById('qb-size-section');
    const sizeOptionsEl = document.getElementById('qb-size-options');
    const selectedSizeLabel = document.getElementById('qb-selected-size-label');

    const qtyMinus = document.getElementById('qb-qty-minus');
    const qtyPlus = document.getElementById('qb-qty-plus');
    const qtyDisplay = document.getElementById('qb-qty-display');

    let currentProduct = null;
    let currentQty = 1;
    let selectedColor = null;
    let selectedSize = null;

    function openModal(data) {
      currentProduct = data;
      currentQty = 1;
      selectedColor = null;
      selectedSize = null;

      if (formWrapper) formWrapper.classList.remove('hidden');
      if (successWrapper) successWrapper.classList.add('hidden');
      if (errorBox) errorBox.classList.add('hidden');
      if (form) form.reset();

      if (imgEl) {
        imgEl.src = data.image || '';
        imgEl.alt = data.name || 'Producto';
      }
      if (titleEl) titleEl.textContent = data.name || '';
      if (priceCupEl) priceCupEl.textContent = `$${(data.priceCUP || 0).toLocaleString('en-US')} CUP`;
      if (priceUsdEl) priceUsdEl.textContent = `$${(data.priceUSD || 0).toFixed(2)} USD`;
      if (stockLabel) {
        stockLabel.textContent = data.stockQuantity ? `Stock disponible: ${data.stockQuantity} unidades` : 'Stock disponible';
      }

      // Renderizar colores si existen
      if (colorSection && colorOptionsEl) {
        const colors = Array.isArray(data.colors) ? data.colors : [];
        if (colors.length > 0) {
          colorSection.classList.remove('hidden');
          selectedColorLabel.textContent = '';
          colorOptionsEl.innerHTML = colors.map((col, idx) => `
            <button
              type="button"
              data-qb-color="${col}"
              data-qb-color-idx="${idx}"
              class="qb-color-btn px-3.5 py-1.5 rounded-xl border border-white/10 bg-white/5 text-slate-300 hover:border-amber-400/50 hover:text-amber-400 text-xs font-semibold transition-all cursor-pointer"
            >
              ${col}
            </button>
          `).join('');

          colorOptionsEl.querySelectorAll('.qb-color-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const col = btn.getAttribute('data-qb-color');
              if (selectedColor === col) {
                // Deseleccionar (toggle)
                selectedColor = null;
                btn.classList.remove('border-amber-400', 'bg-amber-400/10', 'text-amber-400', 'shadow-[0_0_10px_rgba(234,179,8,0.2)]');
                btn.classList.add('border-white/10', 'bg-white/5', 'text-slate-300');
                if (selectedColorLabel) selectedColorLabel.textContent = '';
              } else {
                // Seleccionar
                selectedColor = col;
                colorOptionsEl.querySelectorAll('.qb-color-btn').forEach(b => {
                  b.classList.remove('border-amber-400', 'bg-amber-400/10', 'text-amber-400', 'shadow-[0_0_10px_rgba(234,179,8,0.2)]');
                  b.classList.add('border-white/10', 'bg-white/5', 'text-slate-300');
                });
                btn.classList.remove('border-white/10', 'bg-white/5', 'text-slate-300');
                btn.classList.add('border-amber-400', 'bg-amber-400/10', 'text-amber-400', 'shadow-[0_0_10px_rgba(234,179,8,0.2)]');
                if (selectedColorLabel) selectedColorLabel.textContent = col;
              }
            });
          });
        } else {
          colorSection.classList.add('hidden');
        }
      }

      // Renderizar tallas si existen
      if (sizeSection && sizeOptionsEl) {
        const sizes = Array.isArray(data.sizes) ? data.sizes : [];
        if (sizes.length > 0) {
          sizeSection.classList.remove('hidden');
          selectedSizeLabel.textContent = '';
          sizeOptionsEl.innerHTML = sizes.map(sz => `
            <button
              type="button"
              data-qb-size="${sz}"
              class="qb-size-btn px-3.5 py-1.5 rounded-xl border border-white/10 bg-white/5 text-slate-300 hover:border-amber-400/50 hover:text-amber-400 text-xs font-semibold transition-all cursor-pointer"
            >
              ${sz}
            </button>
          `).join('');

          sizeOptionsEl.querySelectorAll('.qb-size-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const sz = btn.getAttribute('data-qb-size');
              if (selectedSize === sz) {
                // Deseleccionar (toggle)
                selectedSize = null;
                btn.classList.remove('border-amber-400', 'bg-amber-400/10', 'text-amber-400', 'shadow-[0_0_10px_rgba(234,179,8,0.2)]');
                btn.classList.add('border-white/10', 'bg-white/5', 'text-slate-300');
                if (selectedSizeLabel) selectedSizeLabel.textContent = '';
              } else {
                // Seleccionar
                selectedSize = sz;
                sizeOptionsEl.querySelectorAll('.qb-size-btn').forEach(b => {
                  b.classList.remove('border-amber-400', 'bg-amber-400/10', 'text-amber-400', 'shadow-[0_0_10px_rgba(234,179,8,0.2)]');
                  b.classList.add('border-white/10', 'bg-white/5', 'text-slate-300');
                });
                btn.classList.remove('border-white/10', 'bg-white/5', 'text-slate-300');
                btn.classList.add('border-amber-400', 'bg-amber-400/10', 'text-amber-400', 'shadow-[0_0_10px_rgba(234,179,8,0.2)]');
                if (selectedSizeLabel) selectedSizeLabel.textContent = `Talla ${sz}`;
              }
            });
          });
        } else {
          sizeSection.classList.add('hidden');
        }
      }

      updateTotals();

      if (modal && content) {
        modal.classList.remove('hidden', 'pointer-events-none');
        modal.classList.add('flex');
        requestAnimationFrame(() => {
          modal.classList.remove('opacity-0');
          modal.classList.add('opacity-100');
          content.classList.remove('scale-95');
          content.classList.add('scale-100');
        });
        document.body.style.overflow = 'hidden';
      }
    }

    function closeModal() {
      if (modal && content) {
        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0');
        content.classList.remove('scale-100');
        content.classList.add('scale-95');
        setTimeout(() => {
          modal.classList.add('hidden', 'pointer-events-none');
          modal.classList.remove('flex');
          document.body.style.overflow = '';
        }, 250);
      }
    }

    function updateTotals() {
      if (!currentProduct) return;
      if (qtyDisplay) qtyDisplay.textContent = String(currentQty);
      const totalCUP = (currentProduct.priceCUP || 0) * currentQty;
      const totalUSD = (currentProduct.priceUSD || 0) * currentQty;
      if (totalDisplay) {
        totalDisplay.textContent = `$${totalCUP.toLocaleString('en-US')} CUP / $${totalUSD.toFixed(2)} USD`;
      }
    }

    qtyMinus?.addEventListener('click', () => {
      if (currentQty > 1) {
        currentQty -= 1;
        updateTotals();
      }
    });

    qtyPlus?.addEventListener('click', () => {
      const maxStock = currentProduct?.stockQuantity || 10;
      if (currentQty < maxStock) {
        currentQty += 1;
        updateTotals();
      }
    });

    closeBtn?.addEventListener('click', closeModal);
    finishBtn?.addEventListener('click', closeModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Escuchar evento global para abrir compra rápida
    window.addEventListener('open-quick-buy', (e) => {
      if (e.detail) openModal(e.detail);
    });

    // Envío del formulario de compra rápida autónoma
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentProduct) return;

      const nameInput = document.getElementById('qb-client-name');
      const phoneInput = document.getElementById('qb-client-phone');
      const notesInput = document.getElementById('qb-client-notes');

      const clientName = nameInput ? nameInput.value.trim() : '';
      const rawPhone = phoneInput ? phoneInput.value.trim().replace(/\D/g, '') : '';
      const notes = notesInput ? notesInput.value.trim() : '';

      if (!clientName || !rawPhone || rawPhone.length < 8) {
        if (errorBox) {
          errorBox.textContent = 'Por favor ingresa tu nombre y un número de teléfono válido.';
          errorBox.classList.remove('hidden');
        }
        return;
      }

      if (errorBox) errorBox.classList.add('hidden');

      const fullClientPhone = rawPhone.startsWith('53') ? rawPhone : `53${rawPhone}`;
      const totalCUP = (currentProduct.priceCUP || 0) * currentQty;
      const totalUSD = (currentProduct.priceUSD || 0) * currentQty;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
          <span class="inline-flex items-center gap-2">
            <svg class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v3a5 5 0 00-5 5H4z"></path>
            </svg>
            Procesando Compra...
          </span>
        `;
      }

      // Construcción del Mensaje Automatizado
      let msg = `👋 *¡Hola ${clientName}! Gracias por tu compra rápida en Carmay Outfit*\n\n`;
      msg += `✅ Tu pedido directo ha sido *recibido con éxito*. En breve te contactaremos por este chat para definir la entrega.\n\n`;
      msg += `📋 *TICKET DE COMPRA INMEDIATA:*\n`;
      msg += `━━━━━━━━━━━━━━━━━━━━━\n`;
      msg += `👤 *CLIENTE:* ${clientName} (+${fullClientPhone})\n`;
      if (notes) msg += `📍 *NOTA/ENTREGA:* ${notes}\n`;
      msg += `\n🛍️ *PRODUCTO:* *${currentProduct.name}*\n`;
      if (selectedColor) msg += `   • Color: ${selectedColor}\n`;
      if (selectedSize) msg += `   • Talla: ${selectedSize}\n`;
      msg += `   • Cantidad: ${currentQty}\n`;
      msg += `   • Subtotal: ${totalCUP.toLocaleString('en-US')} CUP / $${totalUSD.toFixed(2)} USD\n\n`;
      msg += `━━━━━━━━━━━━━━━━━━━━━\n`;
      msg += `💰 *TOTAL A PAGAR:* ${totalCUP.toLocaleString('en-US')} CUP / $${totalUSD.toFixed(2)} USD\n`;
      msg += `💵 *OPCIONES DE PAGO:* A coordinar al confirmar la entrega\n\n`;
      msg += `📍 *Carmay Outfit* — Avellaneda No. 260, Camagüey.`;

      try {
        const API_URL = 'https://ia.carmayn8n.cloud/api/wa/send';
        const API_KEY = 'REDACTED_BAILEYS_API_KEY';

        // 1. Mensaje automático al cliente
        await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-api-key': API_KEY },
          body: JSON.stringify({ chatId: fullClientPhone, message: msg }),
        });

        // 2. Notificación a la administración (+REDACTED_PHONE_1)
        await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-api-key': API_KEY },
          body: JSON.stringify({
            chatId: 'REDACTED_PHONE_1',
            message: `⚡ *NUEVA COMPRA RÁPIDA DESDE LA WEB*\n\n` + msg,
          }),
        });

        // Mostrar vista de éxito
        if (formWrapper) formWrapper.classList.add('hidden');
        if (successWrapper) successWrapper.classList.remove('hidden');
      } catch (err) {
        console.error('Error procesando compra rápida:', err);
        if (errorBox) {
          errorBox.textContent = 'Hubo un error procesando el pedido. Por favor intenta nuevamente.';
          errorBox.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = `
            <span class="inline-flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
