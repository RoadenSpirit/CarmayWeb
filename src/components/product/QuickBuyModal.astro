---
// QuickBuyModal.astro: Modal ultra simplificado de compra inmediata con despacho automático por WhatsApp
---

<div
  id="quick-buy-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-md transition-all duration-200 opacity-0 pointer-events-none"
  aria-modal="true"
  role="dialog"
  aria-labelledby="qb-title"
>
  <!-- Caja del Modal Compacta y Fluida -->
  <div
    id="quick-buy-content"
    class="relative w-full max-w-sm bg-[#0f1120] border border-white/15 rounded-3xl p-5 sm:p-6 shadow-[0_20px_60px_rgba(0,0,0,0.85)] scale-95 transition-all duration-200 overflow-hidden"
  >
    <!-- Botón Cerrar (SVG Puro) -->
    <button
      id="quick-buy-close"
      type="button"
      class="absolute top-3.5 right-3.5 w-8 h-8 rounded-full bg-white/5 border border-white/10 hover:bg-white/15 text-slate-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer z-10"
      aria-label="Cerrar ventana de compra rápida"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- ESTADO 1: Formulario Rápido (Solo Teléfono, sin fricción) -->
    <div id="qb-main-view">
      <!-- 1. Imagen Protagonista (Respeta 100% su relación de aspecto original) -->
      <div class="w-full h-48 sm:h-52 rounded-2xl overflow-hidden bg-[#080a12] border border-white/10 mb-3 flex items-center justify-center p-2">
        <img
          id="qb-image"
          src=""
          alt=""
          class="max-h-full max-w-full w-auto h-auto object-contain rounded-xl drop-shadow-lg"
        />
      </div>

      <!-- 2. Nombre del Producto -->
      <h3 id="qb-title" class="font-extrabold text-white text-sm sm:text-base leading-snug truncate text-center mb-2.5"></h3>

      <!-- 3. Precios Dinámicos según la Cantidad (CUP Naranja #f97316 y USD Esmeralda) -->
      <div class="rounded-2xl bg-white/[0.03] border border-white/[0.06] p-2.5 text-center mb-3">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Total a Pagar</span>
        <div class="flex items-baseline justify-center gap-2">
          <span id="qb-price-cup" class="text-lg sm:text-xl font-black text-[#f97316] font-mono tracking-tight"></span>
          <span class="text-slate-500 font-bold">/</span>
          <span id="qb-price-usd" class="text-xs sm:text-sm font-bold text-emerald-400 font-mono"></span>
        </div>
      </div>

      <!-- 4. Selector de Cantidad interactivo (+ / -) -->
      <div class="flex items-center justify-between bg-black/40 border border-white/10 rounded-2xl p-1.5 mb-3.5">
        <span class="text-xs font-bold text-slate-300 uppercase tracking-wider pl-2.5">Cantidad</span>
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            id="qb-qty-minus"
            class="w-8 h-8 rounded-xl bg-white/5 hover:bg-white/15 border border-white/10 text-white flex items-center justify-center transition-colors cursor-pointer select-none active:scale-95"
            aria-label="Restar una unidad"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" />
            </svg>
          </button>
          <span id="qb-qty-display" class="text-sm font-black text-white font-mono px-2.5 min-w-[2rem] text-center">1</span>
          <button
            type="button"
            id="qb-qty-plus"
            class="w-8 h-8 rounded-xl bg-white/5 hover:bg-white/15 border border-white/10 text-white flex items-center justify-center transition-colors cursor-pointer select-none active:scale-95"
            aria-label="Sumar una unidad"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
          </button>
        </div>
      </div>

      <!-- 5. Campo de Teléfono (Único dato requerido para enviarle el ticket a su WhatsApp) -->
      <div class="mb-3">
        <label for="qb-phone" class="block text-[11px] font-bold text-slate-300 uppercase tracking-wider mb-1.5 text-left">
          Tu WhatsApp para recibir el ticket <span class="text-amber-400">*</span>
        </label>
        <div class="flex items-center">
          <span class="inline-flex items-center px-3 py-2 rounded-l-xl border border-r-0 border-white/10 bg-white/5 text-slate-400 text-xs font-mono font-bold">
            +53
          </span>
          <input
            type="tel"
            id="qb-phone"
            required
            placeholder="5xxxxxxx"
            maxlength="10"
            class="w-full bg-black/40 border border-white/10 rounded-r-xl px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all font-mono"
          />
        </div>
        <p class="text-[10px] text-slate-400 mt-1 text-left">Te enviaremos automáticamente tu comprobante a este número.</p>
      </div>

      <div id="qb-error-msg" class="hidden mb-3 p-2.5 rounded-xl bg-red-900/40 border border-red-500/30 text-red-300 text-xs font-semibold text-center"></div>

      <!-- 6. Botones de Acción: Comprar Ahora (Principal) + Ver Más Detalles (Secundario sutil) -->
      <div class="flex flex-col gap-2">
        <!-- Botón Principal: Confirmar Compra -->
        <button
          type="button"
          id="qb-buy-now-btn"
          class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-amber-500 via-amber-400 to-yellow-500 hover:from-amber-400 hover:via-yellow-400 hover:to-yellow-300 active:scale-[0.98] text-slate-950 font-black text-xs sm:text-sm uppercase tracking-wider shadow-[0_4px_16px_rgba(234,179,8,0.35)] hover:shadow-[0_6px_22px_rgba(234,179,8,0.45)] transition-all flex items-center justify-center gap-2 cursor-pointer select-none"
        >
          <span class="inline-flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Confirmar Compra
          </span>
        </button>

        <!-- Botón Secundario Sutil: Ver Más Detalles -->
        <a
          id="qb-view-more-link"
          href="#"
          class="w-full py-2 px-3 rounded-xl bg-white/[0.04] hover:bg-white/[0.09] border border-white/10 text-slate-300 hover:text-white font-semibold text-xs tracking-wider transition-all flex items-center justify-center gap-1.5 select-none"
        >
          <span>Ver Más Detalles</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    <!-- ESTADO 2: Confirmación Exitosa Directa en Pantalla -->
    <div id="qb-success-view" class="hidden py-6 text-center flex-col items-center">
      <div class="w-14 h-14 rounded-full bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400 mb-3 mx-auto">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h4 class="text-lg font-extrabold text-white mb-1.5">¡Pedido Confirmado!</h4>
      <p class="text-xs text-slate-300 leading-relaxed max-w-xs mx-auto mb-5">
        Te acabamos de enviar el comprobante de tu compra directamente a tu WhatsApp. En breve un dependiente se comunicará contigo para coordinar la entrega.
      </p>
      <button
        type="button"
        id="qb-done-btn"
        class="py-2.5 px-6 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer border border-white/15"
      >
        Entendido y Cerrar
      </button>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('quick-buy-modal');
    const content = document.getElementById('quick-buy-content');
    const closeBtn = document.getElementById('quick-buy-close');
    const mainView = document.getElementById('qb-main-view');
    const successView = document.getElementById('qb-success-view');
    const doneBtn = document.getElementById('qb-done-btn');
    const errorBox = document.getElementById('qb-error-msg');

    const imgEl = document.getElementById('qb-image');
    const titleEl = document.getElementById('qb-title');
    const priceCupEl = document.getElementById('qb-price-cup');
    const priceUsdEl = document.getElementById('qb-price-usd');
    const qtyDisplay = document.getElementById('qb-qty-display');
    const phoneInput = document.getElementById('qb-phone');

    const qtyMinus = document.getElementById('qb-qty-minus');
    const qtyPlus = document.getElementById('qb-qty-plus');

    const buyNowBtn = document.getElementById('qb-buy-now-btn');
    const viewMoreLink = document.getElementById('qb-view-more-link');

    let currentProduct = null;
    let currentQty = 1;

    function updatePrices() {
      if (!currentProduct) return;
      if (qtyDisplay) qtyDisplay.textContent = String(currentQty);

      const totalCUP = (currentProduct.priceCUP || 0) * currentQty;
      const totalUSD = (currentProduct.priceUSD || 0) * currentQty;

      if (priceCupEl) {
        priceCupEl.textContent = `$${totalCUP.toLocaleString('en-US')} CUP`;
      }
      if (priceUsdEl) {
        priceUsdEl.textContent = `$${totalUSD % 1 === 0 ? totalUSD.toFixed(0) : totalUSD.toFixed(2)} USD`;
      }
    }

    function openModal(data) {
      currentProduct = data;
      currentQty = 1;

      if (mainView) mainView.classList.remove('hidden');
      if (successView) successView.classList.add('hidden');
      if (errorBox) errorBox.classList.add('hidden');
      if (phoneInput) phoneInput.value = '';

      if (imgEl) {
        imgEl.src = data.image || '';
        imgEl.alt = data.name || 'Producto';
      }
      if (titleEl) {
        titleEl.textContent = data.name || '';
      }
      if (viewMoreLink && data.slug) {
        viewMoreLink.href = `/producto/${data.slug}/`;
      }

      updatePrices();

      if (modal && content) {
        modal.classList.remove('hidden', 'pointer-events-none');
        modal.classList.add('flex');
        requestAnimationFrame(() => {
          modal.classList.remove('opacity-0');
          modal.classList.add('opacity-100');
          content.classList.remove('scale-95');
          content.classList.add('scale-100');
        });
        document.body.style.overflow = 'hidden';
      }
    }

    function closeModal() {
      if (modal && content) {
        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0');
        content.classList.remove('scale-100');
        content.classList.add('scale-95');
        setTimeout(() => {
          modal.classList.add('hidden', 'pointer-events-none');
          modal.classList.remove('flex');
          document.body.style.overflow = '';
        }, 200);
      }
    }

    qtyMinus?.addEventListener('click', () => {
      if (currentQty > 1) {
        currentQty -= 1;
        updatePrices();
      }
    });

    qtyPlus?.addEventListener('click', () => {
      const maxStock = currentProduct?.stockQuantity || 10;
      if (currentQty < maxStock) {
        currentQty += 1;
        updatePrices();
      }
    });

    closeBtn?.addEventListener('click', closeModal);
    doneBtn?.addEventListener('click', closeModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Escuchar evento global desde cualquier card o detalle de producto
    window.addEventListener('open-quick-buy', (e) => {
      if (e.detail) openModal(e.detail);
    });

    // Acción: Enlace a detalles del producto
    viewMoreLink?.addEventListener('click', () => {
      closeModal();
    });

    // ACCIÓN PRINCIPAL: Confirmar Compra -> Envío automático sin abrir WhatsApp
    buyNowBtn?.addEventListener('click', async () => {
      if (!currentProduct) return;

      const rawPhone = phoneInput ? phoneInput.value.trim().replace(/\D/g, '') : '';
      if (!rawPhone || rawPhone.length < 8) {
        if (errorBox) {
          errorBox.textContent = 'Por favor ingresa un número de WhatsApp válido (8 dígitos).';
          errorBox.classList.remove('hidden');
        }
        if (phoneInput) phoneInput.focus();
        return;
      }

      if (errorBox) errorBox.classList.add('hidden');

      const fullClientPhone = rawPhone.startsWith('53') ? rawPhone : `53${rawPhone}`;
      const totalCUP = (currentProduct.priceCUP || 0) * currentQty;
      const totalUSD = (currentProduct.priceUSD || 0) * currentQty;
      const formattedTotalCUP = `$${totalCUP.toLocaleString('en-US')} CUP`;
      const formattedTotalUSD = `$${totalUSD % 1 === 0 ? totalUSD.toFixed(0) : totalUSD.toFixed(2)} USD`;

      buyNowBtn.disabled = true;
      buyNowBtn.innerHTML = `
        <span class="inline-flex items-center gap-2">
          <svg class="animate-spin w-4 h-4 text-slate-950" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v3a5 5 0 00-5 5H4z"></path>
          </svg>
          Procesando Pedido...
        </span>
      `;

      // Mensaje Automatizado que el gestor enviará al cliente
      const customerMsg = `👋 *¡Hola! Gracias por tu compra en Carmay Outfit*\n\n` +
        `✅ Tu pedido directo ha sido *registrado con éxito*. En breve te contactaremos por este chat para coordinar los detalles y la entrega.\n\n` +
        `📋 *TICKET DE COMPRA INMEDIATA:*\n` +
        `━━━━━━━━━━━━━━━━━━━━━\n` +
        `📱 *WhatsApp:* +${fullClientPhone}\n` +
        `🛍️ *Producto:* *${currentProduct.name}*\n` +
        `📦 *Cantidad:* ${currentQty}\n` +
        `💰 *Total:* ${formattedTotalCUP} / ${formattedTotalUSD}\n` +
        `💵 *Opciones de Pago:* A coordinar al confirmar\n\n` +
        `━━━━━━━━━━━━━━━━━━━━━\n` +
        `📍 *Carmay Outfit* — Avellaneda No. 260, Camagüey.`;

      try {
        const API_URL = 'https://ia.carmayn8n.cloud/api/wa/send';
        const API_KEY = 'REDACTED_BAILEYS_API_KEY';

        // 1. Enviar ticket automáticamente al WhatsApp del cliente
        await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-api-key': API_KEY },
          body: JSON.stringify({ chatId: fullClientPhone, message: customerMsg }),
        });

        // 2. Notificar inmediatamente a la administración (+REDACTED_PHONE_1)
        await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-api-key': API_KEY },
          body: JSON.stringify({
            chatId: 'REDACTED_PHONE_1',
            message: `⚡ *NUEVA COMPRA RÁPIDA DESDE LA WEB*\n\n` + customerMsg,
          }),
        });

        // Mostrar pantalla de confirmación exitosa dentro del mismo modal
        if (mainView) mainView.classList.add('hidden');
        if (successView) successView.classList.remove('hidden');
      } catch (err) {
        console.error('Error enviando orden rápida por Baileys API:', err);
        if (errorBox) {
          errorBox.textContent = 'Ocurrió un error al registrar el pedido. Intenta nuevamente.';
          errorBox.classList.remove('hidden');
        }
      } finally {
        buyNowBtn.disabled = false;
        buyNowBtn.innerHTML = `
          <span class="inline-flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Confirmar Compra
          </span>
        `;
      }
    });
  });
</script>
