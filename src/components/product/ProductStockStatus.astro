---
// ProductStockStatus.astro: Estado de disponibilidad física en tienda (En Stock, Pocas unidades, Agotado)
interface Props {
  isInStock?: boolean;
  isLowStock?: boolean;
  stockQuantity?: number | null;
}

const {
  isInStock = true,
  isLowStock = false,
  stockQuantity = null,
} = Astro.props;
---

<div class="flex items-center gap-2 select-none">
  {isInStock ? (
    <>
      <span class="w-3 h-3 rounded-full bg-green-500 shadow-[0_0_10px_rgba(34,197,94,0.4)]"></span>
      <span class="text-green-400 font-semibold text-sm">
        {isLowStock ? `¡Últimas ${stockQuantity} unidades!` : 'En Stock'}
      </span>
    </>
  ) : (
    <>
      <span class="w-3 h-3 rounded-full bg-red-500 shadow-[0_0_10px_rgba(239,68,68,0.4)]"></span>
      <span class="text-red-400 font-semibold text-sm">Agotado</span>
    </>
  )}
</div>
