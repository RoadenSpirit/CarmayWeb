---
// ProductPricing.astro: Componente atómico y modular para la visualización de precios.
// REGLA INMUTABLE:
// 1. Fila Activa: Primero precio CUP, luego precio USD con ESTRICTA IGUALDAD de tamaño y peso.
// 2. Fila Inferior: Si tiene rebaja, los precios antiguos tachados aparecen debajo de los precios activos.
interface Props {
  priceCUP: number;
  priceUSD: number;
  regularPriceCUP?: number;
  regularPriceUSD?: number;
  onSale?: boolean;
}

const {
  priceCUP,
  priceUSD,
  regularPriceCUP,
  regularPriceUSD,
  onSale = false,
} = Astro.props;

const formatCUP = (n: number) => `$${n.toLocaleString('en-US')} CUP`;
const formatUSD = (n: number) => n % 1 === 0 ? `$${n.toFixed(0)} USD` : `$${n.toFixed(2)} USD`;

const hasRegularPrices = Boolean(
  onSale && (
    (regularPriceCUP && regularPriceCUP > priceCUP) ||
    (regularPriceUSD && regularPriceUSD > priceUSD)
  )
);
---

<div class="product-pricing-block mt-2 select-none">
  <!-- ================= FILA 1: PRECIOS ACTIVOS (PRIMERO CUP, LUEGO USD) ================= -->
  <!-- Estricta igualdad de jerarquía visual y tamaño: text-sm sm:text-base md:text-lg lg:text-xl font-black -->
  <div class="flex items-baseline justify-between gap-x-3.5 sm:gap-x-5 gap-y-1 flex-wrap w-full">
    
    <!-- 1. Primero Precio CUP (Moneda local principal) -->
    <span class="text-sm sm:text-base md:text-lg lg:text-xl font-black text-amber-300 font-mono tracking-tight whitespace-nowrap">
      {priceCUP > 0 ? formatCUP(priceCUP) : formatUSD(priceUSD)}
    </span>

    <!-- 2. Luego Precio USD (Exactamente el mismo tamaño y jerarquía que CUP) -->
    {priceCUP > 0 && priceUSD > 0 && (
      <span class="text-sm sm:text-base md:text-lg lg:text-xl font-black text-emerald-400 font-mono tracking-tight whitespace-nowrap ml-auto">
        {formatUSD(priceUSD)}
      </span>
    )}
  </div>

  <!-- ================= FILA 2: PRECIOS ANTIGUOS TACHADOS (DEBAJO, SOLO SI TIENE REBAJA) ================= -->
  {hasRegularPrices && (
    <div class="mt-1 flex items-baseline gap-2 text-xs sm:text-sm font-mono text-slate-400/90 line-through">
      {regularPriceCUP && regularPriceCUP > priceCUP && (
        <span>{formatCUP(regularPriceCUP)}</span>
      )}
      {regularPriceUSD && regularPriceUSD > priceUSD && (
        <span>{formatUSD(regularPriceUSD)}</span>
      )}
    </div>
  )}
</div>
