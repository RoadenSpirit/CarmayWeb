---
// Buscador con Estilo Original Fino Restaurado (SearchBar.astro)
// Proporciones ligeras, píldora translúcida bg-black/35 con borde blanco sutil
// y panel flotante de autocompletado en rejilla.
---

<div class="relative z-50 w-full min-w-0">
  <form id="subnav-search-form" class="flex items-center gap-1.5 sm:gap-2 w-full min-h-[44px] rounded-full border border-white/20 bg-black/35 backdrop-blur-md pl-3.5 pr-1 focus-within:border-amber-400/50 focus-within:bg-black/50 focus-within:shadow-[0_0_20px_rgba(234,179,8,0.15)] transition-all">
    <input
      type="text"
      id="subnav-search-input"
      placeholder="Tenemos lo que necesitas, búscalo..."
      class="flex-1 min-w-0 bg-transparent text-white placeholder-white/60 text-xs sm:text-sm font-semibold focus:outline-none truncate min-h-[44px] py-2.5"
      autocomplete="off"
      aria-label="Buscar productos"
    />
    <button
      type="button"
      id="subnav-search-clear"
      class="hidden flex shrink-0 w-11 h-11 min-w-[44px] min-h-[44px] items-center justify-center text-white/70 hover:text-white cursor-pointer transition-colors"
      title="Limpiar"
      aria-label="Limpiar búsqueda"
    >
      <span class="w-7 h-7 rounded-full flex items-center justify-center hover:bg-white/10">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </span>
    </button>
    <button
      type="submit"
      class="shrink-0 w-11 h-11 min-w-[44px] min-h-[44px] flex items-center justify-center text-white cursor-pointer transition-all"
      title="Buscar"
      aria-label="Buscar"
    >
      <span class="w-8 h-8 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center transition-all">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </span>
    </button>
  </form>

  <!-- Panel desplegable de resultados original -->
  <div id="subnav-search-panel" class="hidden absolute left-0 sm:left-1/2 sm:-translate-x-1/2 w-[92vw] sm:w-[580px] md:w-[680px] lg:w-[760px] max-w-[95vw] top-full mt-2 bg-[#0c0e17] rounded-3xl border border-white/15 shadow-[0_25px_70px_rgba(0,0,0,0.95)] p-4 sm:p-6 max-h-[75vh] overflow-y-auto z-50 scrollbar-hide space-y-4"></div>
</div>

<script>
  import { SearchEngine } from '../utils/searchEngine';

  if (typeof window !== 'undefined') {
    (window as any).SearchEngine = SearchEngine;
    window.dispatchEvent(new CustomEvent('carmay-engine-ready'));
  }

  function initSearchBar() {
    const input = document.getElementById('subnav-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('subnav-search-clear');
    const panel = document.getElementById('subnav-search-panel');
    const form = document.getElementById('subnav-search-form');

    let engineInstance: SearchEngine | null = null;
    let currentQuery = '';

    function getEngine(): SearchEngine | null {
      if (engineInstance) return engineInstance;
      const dataEl = document.getElementById('catalog-data');
      try {
        const rawData = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
        engineInstance = new SearchEngine(rawData);
      } catch (e) {
        console.error('Error indexando catálogo:', e);
        engineInstance = new SearchEngine([]);
      }
      return engineInstance;
    }

    function getCatalogData(): any[] {
      const dataEl = document.getElementById('catalog-data');
      try {
        return dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
      } catch (e) {
        return [];
      }
    }

    function createProductMiniCard(item: any): string {
      const priceCUPFormatted = Number(item.priceCUP || 0).toLocaleString('en-US');
      const priceUSD = Number(item.priceUSD || 0);
      const priceUSDFormatted = priceUSD % 1 === 0 ? `$${priceUSD.toFixed(0)}` : `$${priceUSD.toFixed(2)}`;

      return `
        <a href="/producto/${item.slug}/" class="group relative rounded-2xl overflow-hidden flex flex-col justify-between bg-[#0f1120] border border-white/10 hover:border-amber-400/50 hover:shadow-[0_8px_24px_rgba(234,179,8,0.18)] p-3 transition-all duration-200">
          <div class="aspect-square rounded-xl overflow-hidden bg-black/60 mb-2.5 relative">
            <img 
              src="${item.primaryImage}" 
              alt="${item.name}" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
              loading="lazy" 
            />
            <span class="absolute top-2 right-2 bg-black/85 backdrop-blur-md text-amber-300 text-xs px-2 py-0.5 rounded-full border border-amber-400/30 font-bold uppercase tracking-wider">
              ${item.category}
            </span>
          </div>
          <div class="flex-1 flex flex-col justify-between">
            <h5 class="font-bold text-white text-xs line-clamp-2 leading-snug group-hover:text-amber-300 transition-colors">
              ${item.name}
            </h5>
            <div class="text-xs font-black text-amber-400 mt-2 flex items-center justify-between gap-1 flex-wrap">
              <span>$${priceCUPFormatted} CUP</span>
              <span class="text-emerald-400 font-extrabold text-xs">$${priceUSDFormatted} USD</span>
            </div>
          </div>
        </a>
      `;
    }

    function renderSearch(query: string) {
      if (!query || query.length < 2) {
        if (panel) {
          panel.innerHTML = '';
          panel.classList.add('hidden');
        }
        return;
      }
      const se = getEngine();
      const results = se ? se.search(query) : [];

      if (results.length === 0) {
        const catalog = getCatalogData();
        const sampleRecommended = catalog.slice(0, 3);
        const whatsappMsg = `Hola Carmay Outfit 👋, me interesa encargar el producto *"${query}"* que estuve buscando en su sitio web pero no encontré en el catálogo activo. ¿Tienen disponibilidad o fecha de llegada?`;

        panel!.innerHTML = `
          <div class="space-y-6 text-center py-2">
            <div class="max-w-md mx-auto space-y-2.5">
              <div class="w-14 h-14 rounded-full bg-purple-900/30 border border-purple-500/30 flex items-center justify-center mx-auto text-amber-400 shadow-inner">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
              <h4 class="text-base sm:text-lg font-extrabold text-white">
                No encontramos productos con "<span class="text-amber-400">${query}</span>"
              </h4>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                ¡Pero no te preocupes! Podemos encargarlo y traértelo especialmente para ti a través de nuestro canal de atención directa.
              </p>
              <div class="pt-2">
                <a 
                  href="https://wa.me/REDACTED_PHONE_1?text=${encodeURIComponent(whatsappMsg)}" 
                  target="_blank"
                  class="inline-flex items-center gap-2 min-h-[44px] px-5 py-3 rounded-xl bg-gradient-to-r from-purple-700 to-purple-900 hover:from-amber-500 hover:to-orange-600 text-white font-extrabold text-xs uppercase tracking-wider shadow-lg shadow-purple-900/40 hover:shadow-orange-500/30 border border-purple-500/40 hover:border-amber-400 transition-all cursor-pointer"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                  </svg>
                  <span>Encargar por WhatsApp lo que buscas</span>
                </a>
              </div>
            </div>

            ${sampleRecommended.length > 0 ? `
              <div class="pt-4 border-t border-white/10 text-left">
                <span class="text-xs font-bold text-amber-400 uppercase tracking-widest block mb-3 text-center sm:text-left inline-flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z" />
                  </svg>
                  <span>Productos recomendados para ti</span>
                </span>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  ${sampleRecommended.map((item: any) => createProductMiniCard(item)).join('')}
                </div>
              </div>
            ` : ''}
          </div>
        `;
        panel!.classList.remove('hidden');
        return;
      }

      const displayResults = results.slice(0, 6);
      const encodedQ = encodeURIComponent(query);

      panel!.innerHTML = `
        <div class="space-y-4">
          <div class="flex items-center justify-between pb-2 border-b border-white/10">
            <span class="text-xs font-bold text-slate-300">
              ${results.length} ${results.length === 1 ? 'coincidencia encontrada' : 'coincidencias encontradas'}
            </span>
            <span class="text-xs text-amber-400 font-mono">Búsqueda en tiempo real</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            ${displayResults.map((item: any) => createProductMiniCard(item)).join('')}
          </div>

          ${results.length > 6 ? `
            <div class="pt-3 border-t border-white/10 text-center">
              <a href="/tienda/?s=${encodedQ}" class="inline-flex items-center justify-center gap-2 w-full min-h-[44px] py-3.5 rounded-xl bg-gradient-to-r from-amber-500/15 via-amber-400/20 to-amber-500/15 hover:from-amber-500/30 hover:to-amber-500/30 border border-amber-400/30 text-amber-300 font-extrabold text-xs uppercase tracking-wider transition-all shadow-[0_2px_12px_rgba(234,179,8,0.1)]">
                <span>Ver los ${results.length} productos en el catálogo &rarr;</span>
              </a>
            </div>
          ` : ''}
        </div>
      `;
      panel!.classList.remove('hidden');
    }

    let debounceTimer: any = null;
    input?.addEventListener('input', () => {
      const q = input.value.trim();
      currentQuery = q;

      if (clearBtn) {
        clearBtn.classList.toggle('hidden', q.length === 0);
      }

      window.dispatchEvent(new CustomEvent('carmay-search', { detail: { query: q } }));

      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        renderSearch(q);
      }, 150);
    });

    clearBtn?.addEventListener('click', () => {
      if (input) {
        input.value = '';
        input.focus();
      }
      clearBtn.classList.add('hidden');
      if (panel) {
        panel.innerHTML = '';
        panel.classList.add('hidden');
      }
      window.dispatchEvent(new CustomEvent('carmay-search', { detail: { query: '' } }));
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input?.value.trim();
      if (q) {
        window.location.href = `/tienda/?s=${encodeURIComponent(q)}`;
      }
    });

    document.addEventListener('click', (e) => {
      if (!form?.contains(e.target as Node) && !panel?.contains(e.target as Node)) {
        panel?.classList.add('hidden');
      }
    });

    input?.addEventListener('focus', () => {
      if (input.value.trim().length >= 2) {
        renderSearch(input.value.trim());
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSearchBar);
  } else {
    initSearchBar();
  }
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>
