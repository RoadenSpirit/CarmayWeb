---
// Botón Circular Flotante del Carrito (FloatingCartBtn.astro)
// Se oculta inteligentemente al hacer scroll hacia abajo para no tapar contenido
// y reaparece de forma fluida al detenerse o al hacer scroll hacia arriba.
---

<div id="floating-cart-wrapper" class="fixed bottom-5 right-5 sm:bottom-7 sm:right-7 z-[75] transition-all duration-300 ease-out transform translate-y-0 opacity-100">
  <button
    id="floating-cart-fab"
    type="button"
    class="relative flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-gradient-to-tr from-amber-500 via-yellow-400 to-amber-300 text-slate-950 font-black shadow-[0_8px_30px_rgba(234,179,8,0.45)] hover:shadow-[0_12px_40px_rgba(234,179,8,0.65)] hover:scale-105 active:scale-95 transition-all duration-200 border-2 border-white/40 cursor-pointer"
    aria-label="Ver carrito de compras"
    title="Ver carrito de compras"
    data-cart-open
  >
    <!-- Ícono Carrito Tradicional -->
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-7 sm:h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.3">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l2.4 12.4a2 2 0 002 1.6h7.7a2 2 0 002-1.6L21 7H6" />
      <circle cx="9" cy="20" r="1.5" />
      <circle cx="17" cy="20" r="1.5" />
    </svg>

    <!-- Badge Contador Reactivo -->
    <span
      id="floating-cart-badge"
      class="absolute -top-1 -right-1 min-w-[22px] h-5.5 px-1.5 rounded-full bg-gradient-to-r from-red-600 to-orange-500 text-white text-xs font-black flex items-center justify-center shadow-lg border-2 border-[#090b11] transition-transform duration-200"
    >
      0
    </span>
  </button>
</div>

<script>
  import { CartCRUD } from '../utils/cartStore';

  function initFloatingCart() {
    const wrapper = document.getElementById('floating-cart-wrapper');
    const badge = document.getElementById('floating-cart-badge');
    const fab = document.getElementById('floating-cart-fab');

    // 1. Manejo reactivo del contador
    function syncBadge() {
      const { totalUnits } = CartCRUD.getTotals();
      if (badge) {
        badge.textContent = String(totalUnits);
        badge.classList.add('scale-125');
        setTimeout(() => badge.classList.remove('scale-125'), 200);
      }
    }

    window.addEventListener('carmay-cart-changed', syncBadge);
    syncBadge();

    // 2. Control de ocultación en scroll continuo (hide-on-scroll)
    let lastScrollY = window.scrollY;
    let scrollStopTimer: any = null;
    let isHidden = false;

    function handleScroll() {
      const currentScrollY = window.scrollY;
      const diff = currentScrollY - lastScrollY;

      // Si scrollea hacia abajo con suficiente intención (> 60px del top)
      if (diff > 8 && currentScrollY > 80 && !isHidden) {
        wrapper?.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
        isHidden = true;
      } else if (diff < -8 && isHidden) {
        // Al scrollear hacia arriba, reaparece de inmediato
        wrapper?.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
        isHidden = false;
      }

      lastScrollY = currentScrollY;

      // Al detener el scroll durante 350ms, reaparece suavemente
      clearTimeout(scrollStopTimer);
      scrollStopTimer = setTimeout(() => {
        if (isHidden) {
          wrapper?.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
          isHidden = false;
        }
      }, 350);
    }

    window.addEventListener('scroll', handleScroll, { passive: true });

    // 3. Abrir el drawer al hacer clic
    fab?.addEventListener('click', (e) => {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('open-carmay-cart'));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFloatingCart);
  } else {
    initFloatingCart();
  }
</script>
