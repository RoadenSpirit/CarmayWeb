---
// Botón Circular Flotante del Carrito (FloatingCartBtn.astro)
// Animación Peek-a-boo V43.1: En scroll se desplaza 35px a la derecha con opacidad 0.4.
// Regresa suavemente a los 2 segundos o cuando el dedo/cursor se acerca a menos de 80px del borde.
// Exclusivo para móvil (md:hidden), en desktop se usa el carrito de la cabecera.
---

<div id="carmay-floating-cart" role="button" aria-label="Ver carrito de compras" tabindex="0">
  <div class="carmay-fab-inner">
    <!-- Ícono Carrito Tradicional Fino, Legible y Ampliado en PC -->
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 md:w-8 md:h-8 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.3">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l2.4 12.4a2 2 0 002 1.6h7.7a2 2 0 002-1.6L21 7H6" />
      <circle cx="9" cy="20" r="1.5" />
      <circle cx="17" cy="20" r="1.5" />
    </svg>

    <!-- Badge Contador Reactivo -->
    <span
      id="floating-cart-badge"
      class="absolute -top-1 -right-1 md:-top-1.5 md:-right-1.5 min-w-[22px] md:min-w-[28px] h-5.5 md:h-7 px-1.5 md:px-2 rounded-full bg-gradient-to-r from-red-600 to-orange-500 text-white text-xs md:text-sm font-black flex items-center justify-center shadow-lg border-2 border-white dark:border-[#090b11] transition-transform duration-200 pointer-events-none"
    >
      0
    </span>
  </div>
</div>

<style>
  :root {
    --carmay-purple: #6d1e68;
    --carmay-bottom: 85px;
    --carmay-hide-x: 95px;
    --carmay-anim-speed: 0.35s;
  }

  /* 1. Botón Disparador Flotante (Accesible en todo momento de navegación) */
  #carmay-floating-cart {
    position: fixed;
    bottom: var(--carmay-bottom);
    right: 15px;
    width: 58px;
    height: 58px;
    background: linear-gradient(135deg, #f59e0b, #eab308);
    border: 2px solid #fff;
    border-radius: 50%;
    z-index: 75;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 !important;
    margin: 0 !important;
    box-shadow: 0 4px 24px rgba(234, 179, 8, 0.45);
    cursor: pointer;
    user-select: none;
    transition: opacity var(--carmay-anim-speed) ease, transform var(--carmay-anim-speed) cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.2s ease;
  }

  #carmay-floating-cart:hover {
    transform: scale(1.08);
    box-shadow: 0 8px 30px rgba(234, 179, 8, 0.6);
  }

  #carmay-floating-cart:active {
    transform: scale(0.92);
  }

  .carmay-fab-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  /* 2. Ocultamiento Completo Hacia la Derecha en Scroll (Solo en Móvil) */
  #carmay-floating-cart.carmay-scrolling {
    opacity: 0 !important;
    transform: translateX(var(--carmay-hide-x)) scale(0.85) !important;
    pointer-events: none !important;
  }

  /* En pantallas medianas y grandes: Ampliado, imponente y con glow de alta conversión */
  @media (min-width: 769px) {
    #carmay-floating-cart {
      bottom: 32px;
      right: 32px;
      width: 76px;
      height: 76px;
      border: 3px solid #ffffff;
      box-shadow: 0 10px 36px rgba(234, 179, 8, 0.55), 0 0 20px rgba(245, 158, 11, 0.35);
    }

    #carmay-floating-cart:hover {
      transform: scale(1.1);
      box-shadow: 0 14px 44px rgba(234, 179, 8, 0.75), 0 0 28px rgba(245, 158, 11, 0.5);
    }
  }
</style>

<script>
  import { CartCRUD } from '../utils/cartStore';

  function initPeekABooCart() {
    const btn = document.getElementById('carmay-floating-cart');
    const badge = document.getElementById('floating-cart-badge');
    let scrollTimer: any = null;

    // 1. Sincronización reactiva del contador
    function syncBadge() {
      const { totalUnits } = CartCRUD.getTotals();
      if (badge) {
        badge.textContent = String(totalUnits);
        badge.classList.add('scale-125');
        setTimeout(() => badge.classList.remove('scale-125'), 200);
      }
    }

    window.addEventListener('carmay-cart-changed', syncBadge);
    syncBadge();

    // 2. EFECTO PEEK-A-BOO (2 SEGUNDOS DE OCULTACIÓN LATERAL)
    window.addEventListener('scroll', () => {
      if (window.innerWidth <= 768 && btn) {
        btn.classList.add('carmay-scrolling');

        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
          btn.classList.remove('carmay-scrolling');
        }, 2000);
      }
    }, { passive: true });

    // 3. DETECTOR DE PROXIMIDAD (Si el dedo/ratón se acerca a < 80px del borde derecho)
    function checkProximity(xPos: number) {
      const screenWidth = window.innerWidth;
      if (screenWidth <= 768 && screenWidth - xPos < 80 && btn) {
        btn.classList.remove('carmay-scrolling');
      }
    }

    window.addEventListener('mousemove', (e) => {
      checkProximity(e.pageX);
    }, { passive: true });

    window.addEventListener('touchstart', (e) => {
      const touch = e.touches ? e.touches[0] : null;
      if (touch) {
        checkProximity(touch.pageX);
      }
    }, { passive: true });

    // 4. Apertura del Carrito al pulsar
    btn?.addEventListener('click', (e) => {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('open-carmay-cart'));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPeekABooCart);
  } else {
    initPeekABooCart();
  }
</script>
