---
// SubNavbar: Buscador (izquierda) + Carrusel de valor (derecha)
// Se integra dentro del <header> sticky para estar SIEMPRE visible al hacer scroll.
// El índice de catálogo se lee de <script id="catalog-data"> inyectado por el Layout.
// Carrusel migrado del PHP original (5 mensajes) con diseño neo-dark premium.
---

<div id="subnav" class="border-t border-white/[0.08] bg-white/[0.015] shadow-[inset_0_1px_0_rgba(255,255,255,0.02)]">
  <div class="subnav-inner">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 sm:py-2.5">
      <!-- En móvil (flex-col-reverse): El carrusel de mensajes arriba y el buscador siempre como ÚLTIMO elemento. En desktop (sm:flex-row): buscador izquierda, carrusel derecha -->
      <div class="subnav-items flex flex-col-reverse sm:flex-row items-stretch sm:items-center gap-2 sm:gap-4">

      <!-- ===== BUSCADOR (En móvil es el último elemento inferior por flex-col-reverse, en desktop 55% a la izquierda) ===== -->
      <div class="flex-1 sm:flex-[3] min-w-0">
        <div class="relative">
          <form id="subnav-search-form" class="flex items-center gap-2 w-full rounded-full border border-white/20 bg-black/35 backdrop-blur-md px-3.5 py-2 focus-within:border-amber-400/50 focus-within:bg-black/50 focus-within:shadow-[0_0_20px_rgba(234,179,8,0.15)] transition-all">
            <input
              type="text"
              id="subnav-search-input"
              placeholder="Tenemos lo que necesitas, búscalo..."
              class="flex-1 min-w-0 bg-transparent text-white placeholder-white/60 text-sm font-semibold focus:outline-none truncate"
              autocomplete="off"
              aria-label="Buscar productos"
            />
            <button
              type="button"
              id="subnav-search-clear"
              class="hidden shrink-0 text-white/70 hover:text-white text-sm font-bold p-1 cursor-pointer transition-colors"
              title="Limpiar"
              aria-label="Limpiar búsqueda"
            >
              ✕
            </button>
            <button
              type="submit"
              class="shrink-0 w-8 h-8 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center text-white transition-all cursor-pointer"
              title="Buscar"
              aria-label="Buscar"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </button>
          </form>

          <!-- Panel desplegable de resultados -->
          <div id="subnav-search-panel" class="hidden absolute left-0 sm:w-[620px] lg:w-[700px] max-w-[92vw] top-full mt-3 bg-[#12141c]/98 backdrop-blur-2xl rounded-2xl border border-white/20 shadow-[0_20px_60px_rgba(0,0,0,0.9)] p-4 sm:p-5 max-h-[75vh] overflow-y-auto z-50 scrollbar-hide"></div>
        </div>
      </div>

      <!-- ===== CARRUSEL DE VALOR (Auto-ajustado milimétricamente al texto más largo con CSS Grid Overlap) ===== -->
      <div class="flex-shrink-0 w-fit max-w-full flex justify-center sm:justify-end">
        <div class="carousel-container relative overflow-hidden h-9 rounded-lg border border-white/15 bg-black/25 backdrop-blur-md px-3 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)]">
          
          <!-- Grid wrapper donde todos los items comparten la misma celda (1/1) determinando el tamaño exacto sin desperdicio -->
          <div class="carousel-grid h-full items-center">

            <!-- 1. Envío a Domicilio -->
            <div class="carousel-item flex items-center gap-2 text-white opacity-0 pointer-events-none transition-all duration-300">
              <span class="w-6 h-6 rounded-full bg-sky-400/15 border border-sky-400/40 flex items-center justify-center text-sky-300 shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M8 16h.01M12 12h.01M12 16h.01M16 12h.01M16 16h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
              </span>
              <p class="font-bold text-xs sm:text-sm leading-tight whitespace-nowrap">Envío a Domicilio en Camagüey</p>
            </div>

            <!-- 2. WhatsApp 24/7 -->
            <div class="carousel-item flex items-center gap-2 text-white opacity-0 pointer-events-none transition-all duration-300">
              <span class="w-6 h-6 rounded-full bg-emerald-400/15 border border-emerald-400/40 flex items-center justify-center text-emerald-300 shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                </svg>
              </span>
              <p class="font-bold text-xs sm:text-sm leading-tight whitespace-nowrap">WhatsApp: Respuesta Inmediata</p>
            </div>

            <!-- 3. Precios Imbatibles -->
            <div class="carousel-item flex items-center gap-2 text-white opacity-0 pointer-events-none transition-all duration-300">
              <span class="w-6 h-6 rounded-full bg-purple-400/15 border border-purple-400/40 flex items-center justify-center text-purple-300 shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </span>
              <p class="font-bold text-xs sm:text-sm leading-tight whitespace-nowrap">Precios Imbatibles • CUP y USD</p>
            </div>

            <!-- 4. Catálogo Nuevo -->
            <div class="carousel-item flex items-center gap-2 text-white opacity-0 pointer-events-none transition-all duration-300">
              <span class="w-6 h-6 rounded-full bg-amber-400/15 border border-amber-400/40 flex items-center justify-center text-amber-300 shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                </svg>
              </span>
              <p class="font-bold text-xs sm:text-sm leading-tight whitespace-nowrap">Catálogo Actualizado Cada Semana</p>
            </div>

            <!-- 5. Ofertas y Rifas -->
            <div class="carousel-item flex items-center gap-2 text-white opacity-0 pointer-events-none transition-all duration-300">
              <span class="w-6 h-6 rounded-full bg-rose-400/15 border border-rose-400/40 flex items-center justify-center text-rose-300 shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
                </svg>
              </span>
              <p class="font-bold text-xs sm:text-sm leading-tight whitespace-nowrap">Ofertas y Rifas Sorpresa</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Bundled Script: motor de búsqueda global -->
<script>
  import { SearchEngine } from '../utils/searchEngine';
  if (typeof window !== 'undefined') {
    (window as any).SearchEngine = SearchEngine;
  }
</script>

<script is:inline>
  (function () {
    // ====== MOTOR DE BÚSQUEDA (lee índice global del Layout) ======
    const input = document.getElementById('subnav-search-input');
    const clearBtn = document.getElementById('subnav-search-clear');
    const panel = document.getElementById('subnav-search-panel');
    const engine = window.SearchEngine;
    const items = Array.from(document.querySelectorAll('.carousel-item'));

    let engineInstance = null;
    let currentQuery = '';
    let intervalId = null;

    function getEngine() {
      if (engineInstance) return engineInstance;
      if (!engine) return null;
      const dataEl = document.getElementById('catalog-data');
      try {
        const rawData = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
        engineInstance = new engine(rawData);
      } catch (e) {
        console.error('Error indexando catálogo:', e);
        engineInstance = new engine([]);
      }
      return engineInstance;
    }

    function getCatalogData() {
      const dataEl = document.getElementById('catalog-data');
      try {
        return dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
      } catch (e) {
        return [];
      }
    }

    function renderSearch(query) {
      if (!query || query.length < 2) {
        if (panel) {
          panel.innerHTML = '';
          panel.classList.add('hidden');
        }
        return;
      }
      const se = getEngine();
      const results = se ? se.search(query) : [];

      if (results.length === 0) {
        const catalog = getCatalogData();
        const sampleRecommended = catalog.slice(0, 3);
        const encodedQ = encodeURIComponent(query);
        const whatsappMsg = `Hola Carmay Outfit 👋, me interesa encargar el producto *"${query}"* que estuve buscando en su sitio web pero no encontré en el catálogo activo. ¿Tienen disponibilidad o fecha de llegada?`;

        panel.innerHTML = `
          <div class="space-y-5 text-center py-2">
            <div class="max-w-md mx-auto space-y-2.5">
              <div class="w-14 h-14 rounded-full bg-purple-900/30 border border-purple-500/30 flex items-center justify-center text-2xl mx-auto text-amber-400 shadow-inner">
                🔎
              </div>
              <h4 class="text-sm sm:text-base font-extrabold text-white">
                No encontramos coincidencias exactas para <span class="text-amber-300">"${query}"</span>
              </h4>
              <p class="text-xs text-slate-300 leading-relaxed">
                Lo que buscas no está disponible en este momento en el catálogo, pero puedes solicitarnos un encargo especial o explorar estas sugerencias populares.
              </p>
              <div class="pt-1.5">
                <a 
                  href="https://wa.me/REDACTED_PHONE_1?text=${encodeURIComponent(whatsappMsg)}" 
                  target="_blank"
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-purple-700 to-purple-900 hover:from-amber-500 hover:to-orange-600 text-white font-extrabold text-xs uppercase tracking-wider shadow-lg shadow-purple-900/40 hover:shadow-orange-500/30 border border-purple-500/40 hover:border-amber-400 transition-all"
                >
                  <span>💬 Encargar por WhatsApp lo que buscas</span>
                </a>
              </div>
            </div>

            ${sampleRecommended.length > 0 ? `
              <div class="pt-4 border-t border-white/[0.08] text-left">
                <span class="text-[11px] font-bold text-amber-400 uppercase tracking-widest block mb-3 text-center sm:text-left">
                  ⭐ Productos sugeridos para ti
                </span>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                  ${sampleRecommended.map(p => `
                    <a href="/producto/${p.slug}/" class="group flex items-center gap-2.5 rounded-xl bg-white/[0.03] border border-white/[0.06] hover:border-amber-400/40 hover:bg-white/[0.06] p-2.5 transition-all">
                      <img src="${p.primaryImage}" alt="${p.name}" class="w-12 h-12 object-cover rounded-lg bg-black/40 shrink-0 border border-white/[0.06] group-hover:scale-105 transition-transform" />
                      <div class="flex-1 min-w-0">
                        <h6 class="font-bold text-white text-xs truncate group-hover:text-amber-300 transition-colors leading-tight">
                          ${p.name}
                        </h6>
                        <div class="text-[11px] font-bold text-slate-300 mt-1">
                          <span class="text-orange-400">${p.priceCUP.toLocaleString('en-US')} CUP</span>
                        </div>
                      </div>
                      <span class="text-white/30 group-hover:text-amber-300 text-xs pr-1">→</span>
                    </a>
                  `).join('')}
                </div>
              </div>
            ` : ''}
          </div>`;
      } else {
        const topResults = results.slice(0, 8);
        const encodedQ = encodeURIComponent(query);
        panel.innerHTML = `
          <div class="flex items-center justify-between pb-3 mb-3 border-b border-white/[0.12]">
            <h4 class="text-sm font-extrabold text-white">
              Resultados para <span class="text-amber-300">"${query}"</span>
            </h4>
            <span class="text-xs font-bold text-amber-400 bg-amber-400/10 px-3 py-1 rounded-full border border-amber-400/20">
              ${results.length} ${results.length === 1 ? 'coincidencia' : 'coincidencias'}
            </span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">${topResults.map(item => `
            <a href="/producto/${item.slug}/" class="group relative rounded-xl overflow-hidden flex items-center gap-3 bg-white/[0.04] border border-white/[0.08] hover:border-amber-400/50 hover:bg-white/[0.08] p-2.5 transition-all">
              <img src="${item.primaryImage}" alt="${item.name}" class="w-13 h-13 object-cover rounded-lg bg-black/40 shrink-0 border border-white/[0.08] group-hover:scale-105 transition-transform" />
              <div class="flex-1 min-w-0">
                <span class="text-[10px] font-bold text-amber-400/90 uppercase tracking-wider inline-block">
                  ${item.category}
                </span>
                <h5 class="font-bold text-white text-xs truncate group-hover:text-amber-300 transition-colors leading-tight">
                  ${item.name}
                </h5>
                <div class="text-[11px] font-bold mt-1">
                  <span class="text-orange-400 font-black">${item.priceCUP.toLocaleString('en-US')} CUP</span>
                  <span class="text-white/40"> · </span>
                  <span class="text-white/80 font-bold">$${item.priceUSD % 1 === 0 ? item.priceUSD.toFixed(0) : item.priceUSD.toFixed(2)} USD</span>
                </div>
              </div>
              <span class="shrink-0 text-amber-400/50 group-hover:text-amber-300 group-hover:translate-x-0.5 transition-all text-sm pr-1">→</span>
            </a>`).join('')}
          </div>
          <div class="mt-3.5 pt-2.5 border-t border-white/10 text-center">
            <a href="/tienda/?s=${encodedQ}" class="inline-flex items-center justify-center gap-2 w-full py-2 rounded-xl bg-amber-400/10 hover:bg-amber-400/20 text-amber-300 font-bold text-xs transition-colors">
              <span>Ver todos los ${results.length} productos en la tienda</span>
              <span>→</span>
            </a>
          </div>`;
      }
      if (panel) panel.classList.remove('hidden');
    }

    let debounce = null;
    if (input) {
      // Inicializar con parámetro de URL si existe (?s= o ?q=)
      const urlParams = new URLSearchParams(window.location.search);
      const initialQuery = (urlParams.get('s') || urlParams.get('q') || '').trim();
      if (initialQuery) {
        input.value = initialQuery;
        currentQuery = initialQuery;
        if (clearBtn) clearBtn.classList.remove('hidden');
      }

      input.addEventListener('input', () => {
        clearTimeout(debounce);
        currentQuery = input.value.trim();
        if (clearBtn) clearBtn.classList.toggle('hidden', currentQuery.length === 0);
        debounce = setTimeout(() => {
          renderSearch(currentQuery);
          // Si estamos en catálogo o tienda, notificar para filtrado en vivo de las tarjetas
          window.dispatchEvent(new CustomEvent('carmay-search', { detail: { query: currentQuery } }));
        }, 140);
      });
    }

    document.getElementById('subnav-search-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = currentQuery.trim();
      const isTienda = window.location.pathname.startsWith('/tienda');

      if (!q) {
        if (isTienda) {
          window.dispatchEvent(new CustomEvent('carmay-search', { detail: { query: '' } }));
        }
        return;
      }

      if (isTienda) {
        // En tienda: ocultar dropdown para ver el catálogo y sincronizar la URL sin recargar
        if (panel) panel.classList.add('hidden');
        const params = new URLSearchParams(window.location.search);
        params.set('s', q);
        window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
        window.dispatchEvent(new CustomEvent('carmay-search', { detail: { query: q } }));

        // Desplazarse suavemente al catálogo si está fuera de pantalla
        const prodSection = document.getElementById('productos-section');
        if (prodSection) {
          const rect = prodSection.getBoundingClientRect();
          if (rect.top > 200 || rect.top < -100) {
            prodSection.scrollIntoView({ behavior: 'smooth' });
          }
        }
      } else {
        // En cualquier otra página (Home, Contacto, Carrito): navegar a la tienda con el término
        window.location.href = `/tienda/?s=${encodeURIComponent(q)}`;
      }
    });

    clearBtn?.addEventListener('click', () => {
      if (input) input.value = '';
      currentQuery = '';
      clearBtn.classList.add('hidden');
      renderSearch('');
      input?.focus();

      window.dispatchEvent(new CustomEvent('carmay-search', { detail: { query: '' } }));

      if (window.location.pathname.startsWith('/tienda')) {
        const params = new URLSearchParams(window.location.search);
        params.delete('s');
        params.delete('q');
        const newSearch = params.toString() ? `?${params.toString()}` : '';
        window.history.replaceState({}, '', `${window.location.pathname}${newSearch}`);
      }
    });

    document.addEventListener('click', (e) => {
      const t = e.target;
      if (panel && !panel.contains(t) && !input?.contains(t)) {
        panel.classList.add('hidden');
      }
    });

    // ====== CARRUSEL DE VALOR (5 mensajes, auto-rotación) ======
    function pauseCarousel() {
      if (intervalId) {
        clearInterval(intervalId);
        intervalId = null;
      }
    }

    function resumeCarousel() {
      if (intervalId || items.length < 2) return;
      intervalId = setInterval(() => {
        const current = items.findIndex((el) => el.style.opacity === '1' || !el.style.opacity);
        show((current + 1) % items.length);
      }, 4500);
    }

    function show(n) {
      items.forEach((el, i) => {
        const active = i === n;
        el.style.opacity = active ? '1' : '0';
        el.style.pointerEvents = active ? 'auto' : 'none';
        el.style.transform = active ? 'translateY(0)' : 'translateY(6px)';
        el.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
      });
    }

    if (items.length > 1) {
      show(0);
      resumeCarousel();

      const container = items[0].parentElement;
      if (container) {
        container.addEventListener('mouseenter', pauseCarousel);
        container.addEventListener('mouseleave', resumeCarousel);
      }
    } else if (items.length === 1) {
      show(0);
    }
  })();
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

  /* CSS Grid Overlap: Todos los items comparten la celda 1/1, forzando al padre a medir exactamente lo que mide el texto más largo */
  .carousel-grid {
    display: inline-grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
    width: max-content;
    max-width: 100%;
  }

  .carousel-item {
    grid-area: 1 / 1 / 2 / 2;
    width: max-content;
    max-width: 100%;
  }
</style>
