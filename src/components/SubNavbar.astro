---
// SubNavbar.astro: Carrusel de valor superior unificado (Desktop y Móvil)
// Se ubica en la parte superior del header para comunicar beneficios clave de forma rotativa.
---

<div id="subnav" class="border-b border-slate-200/80 bg-slate-50/95 dark:border-white/[0.08] dark:bg-black/40 backdrop-blur-md relative z-30 transition-colors">
  <!-- Línea decorativa sutil con brillo tenue -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-amber-400/25 to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-1.5 sm:py-2">
    <!-- Carrusel de Valor Centrado y Fluido -->
    <div class="w-full flex justify-center items-center">
      <div class="carousel-container relative overflow-hidden h-7 sm:h-8 w-full max-w-2xl flex items-center justify-center">
        <div class="carousel-grid h-full items-center justify-center">

          <!-- Mensaje 1: Envíos -->
          <div class="carousel-item flex items-center justify-center gap-2 text-slate-800 dark:text-white opacity-0 pointer-events-none transition-all duration-300">
            <span class="w-5 h-5 rounded-full bg-sky-500/10 border border-sky-500/30 dark:bg-sky-400/20 dark:border-sky-400/40 flex items-center justify-center text-sky-600 dark:text-sky-300 shrink-0">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.6a1 1 0 01.9.6l1.4 2a1 1 0 01.1.7V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
              </svg>
            </span>
            <p class="font-extrabold text-xs sm:text-sm text-slate-800 dark:text-slate-100 leading-tight whitespace-nowrap">
              Envíos garantizados el mismo día en <span class="text-amber-600 dark:text-amber-400">Camagüey</span>
            </p>
          </div>

          <!-- Mensaje 2: WhatsApp -->
          <div class="carousel-item flex items-center justify-center gap-2 text-slate-800 dark:text-white opacity-0 pointer-events-none transition-all duration-300">
            <span class="w-5 h-5 rounded-full bg-emerald-500/10 border border-emerald-500/30 dark:bg-emerald-400/20 dark:border-emerald-400/40 flex items-center justify-center text-emerald-600 dark:text-emerald-300 shrink-0">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
              </svg>
            </span>
            <p class="font-extrabold text-xs sm:text-sm text-slate-800 dark:text-slate-100 leading-tight whitespace-nowrap">
              Atención Directa: <span class="text-emerald-400 font-extrabold">Respuesta Inmediata por WhatsApp</span>
            </p>
          </div>

          <!-- Mensaje 3: Monedas -->
          <div class="carousel-item flex items-center justify-center gap-2 text-slate-800 dark:text-white opacity-0 pointer-events-none transition-all duration-300">
            <span class="w-5 h-5 rounded-full bg-purple-500/10 border border-purple-500/30 dark:bg-purple-400/20 dark:border-purple-400/40 flex items-center justify-center text-purple-600 dark:text-purple-300 shrink-0">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
            <p class="font-extrabold text-xs sm:text-sm text-slate-800 dark:text-slate-100 leading-tight whitespace-nowrap">
              Precios Claros y Flexibles en <span class="text-[#f97316]">CUP</span> y <span class="text-emerald-600 dark:text-emerald-400">USD</span>
            </p>
          </div>

          <!-- Mensaje 4: Calidad -->
          <div class="carousel-item flex items-center justify-center gap-2 text-slate-800 dark:text-white opacity-0 pointer-events-none transition-all duration-300">
            <span class="w-5 h-5 rounded-full bg-amber-500/10 border border-amber-500/30 dark:bg-amber-400/20 dark:border-amber-400/40 flex items-center justify-center text-amber-600 dark:text-amber-300 shrink-0">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
            <p class="font-extrabold text-xs sm:text-sm text-slate-800 dark:text-slate-100 leading-tight whitespace-nowrap">
              Garantía y Confianza: <span class="text-amber-600 dark:text-amber-300">Probamos el 100% de Equipos</span>
            </p>
          </div>

          <!-- Mensaje 5: Tienda Física -->
          <div class="carousel-item flex items-center justify-center gap-2 text-slate-800 dark:text-white opacity-0 pointer-events-none transition-all duration-300">
            <span class="w-5 h-5 rounded-full bg-rose-500/10 border border-rose-500/30 dark:bg-rose-400/20 dark:border-rose-400/40 flex items-center justify-center text-rose-600 dark:text-rose-300 shrink-0">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 9l1.5-5h15L21 9M4 9v11h16V9M4 9h16M9 20v-6h6v6" />
              </svg>
            </span>
            <p class="font-extrabold text-xs sm:text-sm text-slate-800 dark:text-slate-100 leading-tight whitespace-nowrap">
              Visítanos en Tienda Física: <span class="text-amber-600 dark:text-amber-400">Calle Avellaneda No. 260</span>
            </p>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Línea decorativa sutil inferior -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent pointer-events-none"></div>
</div>

<style>
  .carousel-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
    width: 100%;
  }

  .carousel-item {
    grid-column: 1;
    grid-row: 1;
    transform: translateY(10px);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .carousel-item.active {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .carousel-item.exit {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-10px);
  }
</style>

<script>
  function initTopValueCarousel() {
    const items = document.querySelectorAll('#subnav .carousel-item');
    if (!items.length) return;

    let currentIndex = 0;
    let timer: any = null;

    items[0].classList.add('active');

    function nextSlide() {
      const current = items[currentIndex];
      currentIndex = (currentIndex + 1) % items.length;
      const next = items[currentIndex];

      current.classList.remove('active');
      current.classList.add('exit');

      next.classList.remove('exit');
      next.classList.add('active');

      setTimeout(() => {
        current.classList.remove('exit');
      }, 400);
    }

    function startTimer() {
      if (timer) clearInterval(timer);
      timer = setInterval(nextSlide, 3500);
    }

    startTimer();

    // Pausar al pasar el ratón
    const subnav = document.getElementById('subnav');
    if (subnav) {
      subnav.addEventListener('mouseenter', () => clearInterval(timer));
      subnav.addEventListener('mouseleave', startTimer);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTopValueCarousel);
  } else {
    initTopValueCarousel();
  }
</script>
