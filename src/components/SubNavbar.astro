---
// SubNavbar: Carrusel de mensajes de valor centrado (Piso 2)
// Se pliega y expande al hacer scroll con CSS Grid Puro.
// Tipografía aumentada para legibilidad móvil impecable.
---

<div id="subnav" class="border-t border-white/[0.08] bg-white/[0.015] shadow-[inset_0_1px_0_rgba(255,255,255,0.02)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 sm:py-2.5">
    
    <!-- Contenedor Centrado Absoluto del Carrusel -->
    <div class="flex justify-center items-center w-full">
      <div class="carousel-container relative overflow-hidden h-9 rounded-full border border-amber-400/25 bg-black/40 backdrop-blur-md px-4 shadow-[0_2px_12px_rgba(234,179,8,0.08)]">
        
        <!-- Grid wrapper donde todos los items comparten la misma celda determinando tamaño perfecto -->
        <div class="carousel-grid h-full items-center">

          <!-- 1. Envío a Domicilio -->
          <div class="carousel-item flex items-center justify-center gap-2 text-white opacity-0 pointer-events-none transition-all duration-300">
            <span class="w-6 h-6 rounded-full bg-sky-400/20 border border-sky-400/40 flex items-center justify-center text-sky-300 shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.6a1 1 0 01.9.6l1.4 2a1 1 0 01.1.7V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
              </svg>
            </span>
            <p class="font-extrabold text-xs sm:text-sm text-slate-100 leading-tight whitespace-nowrap">
              Envíos el mismo día en <span class="text-amber-400">Camagüey</span>
            </p>
          </div>

          <!-- 2. WhatsApp Soporte Directo -->
          <div class="carousel-item flex items-center justify-center gap-2 text-white opacity-0 pointer-events-none transition-all duration-300">
            <span class="w-6 h-6 rounded-full bg-emerald-400/20 border border-emerald-400/40 flex items-center justify-center text-emerald-300 shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
              </svg>
            </span>
            <p class="font-extrabold text-xs sm:text-sm text-slate-100 leading-tight whitespace-nowrap">
              Atención Directa: <span class="text-emerald-400">Respuesta Rápida por WhatsApp</span>
            </p>
          </div>

          <!-- 3. Precios Transparentes CUP y USD -->
          <div class="carousel-item flex items-center justify-center gap-2 text-white opacity-0 pointer-events-none transition-all duration-300">
            <span class="w-6 h-6 rounded-full bg-purple-400/20 border border-purple-400/40 flex items-center justify-center text-purple-300 shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
            <p class="font-extrabold text-xs sm:text-sm text-slate-100 leading-tight whitespace-nowrap">
              Precios Claros en <span class="text-amber-400">CUP</span> y <span class="text-emerald-400">USD</span>
            </p>
          </div>

          <!-- 4. Productos 100% Verificados -->
          <div class="carousel-item flex items-center justify-center gap-2 text-white opacity-0 pointer-events-none transition-all duration-300">
            <span class="w-6 h-6 rounded-full bg-amber-400/20 border border-amber-400/40 flex items-center justify-center text-amber-300 shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
            <p class="font-extrabold text-xs sm:text-sm text-slate-100 leading-tight whitespace-nowrap">
              Garantía: <span class="text-amber-300">Probamos el 100% de los Productos</span>
            </p>
          </div>

          <!-- 5. Tienda Física Oficial -->
          <div class="carousel-item flex items-center justify-center gap-2 text-white opacity-0 pointer-events-none transition-all duration-300">
            <span class="w-6 h-6 rounded-full bg-rose-400/20 border border-rose-400/40 flex items-center justify-center text-rose-300 shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 9l1.5-5h15L21 9M4 9v11h16V9M4 9h16M9 20v-6h6v6" />
              </svg>
            </span>
            <p class="font-extrabold text-xs sm:text-sm text-slate-100 leading-tight whitespace-nowrap">
              Local en <span class="text-amber-400">Calle Avellaneda No. 260</span>
            </p>
          </div>

        </div>
      </div>
    </div>

  </div>
</div>

<script>
  function initValueCarousel() {
    const items = Array.from(document.querySelectorAll('.carousel-item')) as HTMLElement[];
    let intervalId: any = null;
    let currentIdx = 0;

    function show(n: number) {
      items.forEach((el, i) => {
        const active = i === n;
        el.style.opacity = active ? '1' : '0';
        el.style.pointerEvents = active ? 'auto' : 'none';
        el.style.transform = active ? 'translateY(0)' : 'translateY(6px)';
        el.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
      });
    }

    function resumeCarousel() {
      if (intervalId) clearInterval(intervalId);
      intervalId = setInterval(() => {
        currentIdx = (currentIdx + 1) % items.length;
        show(currentIdx);
      }, 4200);
    }

    function pauseCarousel() {
      if (intervalId) clearInterval(intervalId);
    }

    if (items.length > 1) {
      show(0);
      resumeCarousel();

      const container = items[0].closest('.carousel-container');
      if (container) {
        container.addEventListener('mouseenter', pauseCarousel);
        container.addEventListener('mouseleave', resumeCarousel);
      }
    } else if (items.length === 1) {
      show(0);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initValueCarousel);
  } else {
    initValueCarousel();
  }
</script>

<style>
  .carousel-grid {
    display: inline-grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
    width: max-content;
    max-width: 100%;
  }

  .carousel-item {
    grid-area: 1 / 1 / 2 / 2;
    width: max-content;
    max-width: 100%;
  }
</style>
