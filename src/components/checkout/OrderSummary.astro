---
// OrderSummary.astro: Resumen del ticket, selección de moneda (CUP/USD), métodos de pago y totales
---

<div class="bg-white border border-slate-200/90 shadow-xl text-slate-900 dark:bg-[#0f1120]/95 dark:border-white/[0.08] dark:shadow-[0_12px_40px_rgba(0,0,0,0.6)] dark:text-white backdrop-blur-sm rounded-3xl p-6 sm:p-8 sticky top-28 space-y-6 transition-colors">
  
  <div class="pb-4 border-b border-slate-200 dark:border-white/[0.06] flex items-center justify-between">
    <h3 class="text-xl font-extrabold text-slate-950 dark:text-white">Resumen del Ticket</h3>
    <span id="ticket-items-count" class="text-xs font-bold text-amber-700 dark:text-amber-400 bg-amber-500/10 px-3 py-1 rounded-full border border-amber-500/20">
      0 ítems
    </span>
  </div>

  <!-- Lista de Ítems del Pedido -->
  <div id="ticket-items-list" class="space-y-3 max-h-60 overflow-y-auto pr-1 scrollbar-hide">
    <!-- Renderizado dinámico de ítems -->
  </div>

  <!-- Selector de Moneda de Pago -->
  <div class="pt-4 border-t border-slate-200 dark:border-white/[0.06]">
    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2.5">
      Moneda de Pago
    </label>
    <div class="grid grid-cols-2 gap-3">
      <button 
        type="button" 
        data-currency="CUP"
        class="currency-btn min-h-[44px] py-3 px-4 rounded-xl border-2 font-black text-sm uppercase tracking-wider transition-all flex items-center justify-center gap-2 border-amber-500 bg-amber-500/10 text-amber-800 dark:border-amber-400 dark:bg-amber-400/10 dark:text-amber-400 shadow-[0_0_15px_rgba(234,179,8,0.2)]"
      >
        <span>CUP</span>
      </button>
      <button 
        type="button" 
        data-currency="USD"
        class="currency-btn min-h-[44px] py-3 px-4 rounded-xl border-2 font-black text-sm uppercase tracking-wider transition-all flex items-center justify-center gap-2 border-slate-200 bg-slate-100 text-slate-600 hover:border-amber-500 hover:text-slate-900 dark:border-white/10 dark:bg-white/5 dark:text-slate-400 dark:hover:border-amber-400/50 dark:hover:text-amber-400"
      >
        <span>USD</span>
      </button>
    </div>
  </div>

  <!-- Nota de Coordinación de Pago (Sin métodos explícitos) -->
  <div class="pt-2 p-3.5 rounded-xl bg-slate-100/90 border border-slate-200 dark:bg-white/[0.02] dark:border-white/[0.06] flex items-center gap-3">
    <div class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-600 dark:text-amber-400 shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <p class="text-xs text-slate-700 dark:text-slate-300 leading-snug">
      Las opciones de pago se coordinan directamente al confirmar tu pedido.
    </p>
  </div>

  <!-- Desglose de Totales -->
  <div class="pt-4 border-t border-slate-200 dark:border-white/[0.06] space-y-2 bg-slate-50 border border-slate-200/90 dark:bg-black/20 dark:border-white/[0.04] p-4 rounded-2xl shadow-sm">
    <div class="flex justify-between items-center text-xs text-slate-500 dark:text-slate-400">
      <span>Subtotal:</span>
      <span id="ticket-subtotal" class="font-bold text-slate-900 dark:text-white font-mono">0 CUP</span>
    </div>
    <div class="flex justify-between items-center text-xs text-slate-500 dark:text-slate-400">
      <span>Entrega:</span>
      <span id="ticket-delivery" class="font-semibold text-slate-700 dark:text-slate-300">Recogida en Tienda</span>
    </div>
    <div class="flex justify-between items-center text-sm pt-2 border-t border-slate-200 dark:border-white/[0.06]">
      <span class="font-black text-slate-900 dark:text-white">TOTAL A PAGAR:</span>
      <span id="ticket-total" class="text-xl font-black text-[#ea580c] dark:text-orange-500 drop-shadow-sm font-mono">0 CUP</span>
    </div>
  </div>

  <!-- Mensajes de Error de Validación -->
  <div id="checkout-error" class="hidden p-3 rounded-xl bg-red-900/40 border border-red-500/30 text-red-300 text-xs font-semibold text-center">
    Por favor, completa todos los campos obligatorios.
  </div>

  <!-- Botón de Acción Principal -->
  <button
    type="button"
    id="submit-order-btn"
    class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-amber-500 via-orange-600 to-amber-600 hover:from-amber-400 hover:to-orange-500 text-white font-black text-base uppercase tracking-wider shadow-[0_6px_25px_rgba(249,115,22,0.35)] hover:shadow-[0_8px_35px_rgba(249,115,22,0.5)] transition-all transform hover:-translate-y-0.5 border border-white/10 cursor-pointer flex items-center justify-center gap-2"
  >
    <span class="inline-flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
      </svg>
      Completar por WhatsApp
    </span>
  </button>
  
  <p class="text-xs text-slate-500 dark:text-slate-400 text-center leading-relaxed">
    Al confirmar, nuestro sistema enviará el resumen de tu orden directo a tu WhatsApp.
  </p>
</div>
