---
---

<!-- Backdrop overlay -->
<div id="cart-overlay" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-[80] hidden opacity-0 transition-opacity duration-300"></div>

<!-- Panel Lateral Deslizante del Carrito (Slide-Over Right Drawer) -->
<aside id="cart-drawer" class="fixed top-0 right-0 h-full w-full sm:w-[420px] bg-[#0e1019]/95 backdrop-blur-2xl border-l border-white/10 z-[90] transform translate-x-full transition-transform duration-300 ease-out flex flex-col shadow-[-10px_0_40px_rgba(0,0,0,0.8)]">
  
  <!-- Encabezado del Panel -->
  <div class="p-5 sm:p-6 border-b border-white/10 flex items-center justify-between bg-black/20">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
      </div>
      <div>
        <h3 class="font-extrabold text-white text-lg leading-snug">Tu Carrito</h3>
        <span id="cart-count-subtitle" class="text-xs text-slate-400">0 productos seleccionados</span>
      </div>
    </div>

    <!-- Botón Cerrar -->
    <button id="cart-close-btn" class="flex items-center justify-center w-10 h-10 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white transition-colors" aria-label="Cerrar carrito">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Contenido: Lista de Productos -->
  <div id="cart-items-container" class="flex-1 overflow-y-auto p-5 sm:p-6 space-y-4 scrollbar-hide">
    <!-- Renderizado dinámico vía JavaScript -->
  </div>

  <!-- Vista Vacía (Template) -->
  <div id="cart-empty-view" class="hidden flex-1 flex flex-col items-center justify-center p-6 text-center">
    <div class="w-20 h-20 rounded-full bg-purple-900/20 border border-purple-500/20 flex items-center justify-center text-purple-400 text-3xl mb-4">
      🛒
    </div>
    <h4 class="font-bold text-white text-lg mb-2">Tu carrito está vacío</h4>
    <p class="text-xs text-slate-400 max-w-xs mb-6">Explora nuestro catálogo y agrega tus prendas y accesorios favoritos.</p>
    <a href="/tienda/" class="px-6 py-3 rounded-xl bg-gradient-to-r from-amber-500 to-orange-600 text-white font-extrabold text-xs uppercase tracking-wider shadow-lg shadow-orange-600/20 hover:from-amber-400 hover:to-orange-500 transition-all">
      Ver Catálogo de Productos
    </a>
  </div>

  <!-- Pie del Panel: Totales y Botón de Checkout por WhatsApp -->
  <div id="cart-footer" class="p-5 sm:p-6 border-t border-white/10 bg-black/40 space-y-4">
    <!-- Totales -->
    <div class="bg-white/[0.03] rounded-2xl p-4 border border-white/[0.06] space-y-2">
      <div class="flex items-center justify-between text-xs text-slate-400">
        <span>Total en CUP:</span>
        <span id="cart-total-cup" class="text-base font-black text-orange-500">0 CUP</span>
      </div>
      <div class="flex items-center justify-between text-xs text-slate-400 pt-1 border-t border-white/[0.04]">
        <span>Total en USD:</span>
        <span id="cart-total-usd" class="text-base font-black text-orange-500">$0 USD</span>
      </div>
    </div>

    <!-- Botón Principal: WhatsApp -->
    <button id="cart-checkout-btn" class="w-full py-4 px-5 rounded-2xl bg-gradient-to-r from-yellow-600 to-yellow-700 hover:from-yellow-500 hover:to-yellow-500 text-white font-extrabold text-sm uppercase tracking-wider shadow-[0_4px_20px_rgba(234,179,8,0.3)] hover:shadow-[0_6px_25px_rgba(234,179,8,0.4)] transition-all flex items-center justify-center gap-2 border border-yellow-500/20">
      <span>💬 Confirmar Pedido por WhatsApp</span>
    </button>

    <!-- Vaciar Carrito -->
    <div class="text-center">
      <button id="cart-clear-btn" class="text-xs text-slate-500 hover:text-red-400 transition-colors font-medium">
        Vaciar Carrito
      </button>
    </div>
  </div>

</aside>

<script>
  import { CartStore, type CartItem } from '../utils/cartStore';

  // Exponer CartStore globalmente en window
  if (typeof window !== 'undefined') {
    (window as any).CartStore = CartStore;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const overlay = document.getElementById('cart-overlay');
    const drawer = document.getElementById('cart-drawer');
    const closeBtn = document.getElementById('cart-close-btn');
    const itemsContainer = document.getElementById('cart-items-container');
    const emptyView = document.getElementById('cart-empty-view');
    const footer = document.getElementById('cart-footer');
    const countSubtitle = document.getElementById('cart-count-subtitle');
    const totalCupEl = document.getElementById('cart-total-cup');
    const totalUsdEl = document.getElementById('cart-total-usd');
    const checkoutBtn = document.getElementById('cart-checkout-btn');
    const clearBtn = document.getElementById('cart-clear-btn');

    function openCart() {
      if (overlay && drawer) {
        overlay.classList.remove('hidden');
        setTimeout(() => overlay.classList.remove('opacity-0'), 10);
        drawer.classList.remove('translate-x-full');
        drawer.classList.add('translate-x-0');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeCart() {
      if (overlay && drawer) {
        overlay.classList.add('opacity-0');
        drawer.classList.remove('translate-x-0');
        drawer.classList.add('translate-x-full');
        setTimeout(() => {
          overlay.classList.add('hidden');
          document.body.style.overflow = '';
        }, 300);
      }
    }

    function renderCart() {
      const items = CartStore.getItems();
      const totalUnits = CartStore.getTotalUnits();
      const { totalCUP, totalUSD } = CartStore.getTotals();

      if (countSubtitle) {
        countSubtitle.textContent = `${totalUnits} ${totalUnits === 1 ? 'producto seleccionado' : 'productos seleccionados'}`;
      }

      if (items.length === 0) {
        if (itemsContainer) itemsContainer.classList.add('hidden');
        if (footer) footer.classList.add('hidden');
        if (emptyView) emptyView.classList.remove('hidden');
        return;
      }

      if (emptyView) emptyView.classList.add('hidden');
      if (itemsContainer) itemsContainer.classList.remove('hidden');
      if (footer) footer.classList.remove('hidden');

      if (totalCupEl) totalCupEl.textContent = `${totalCUP.toLocaleString('en-US')} CUP`;
      if (totalUsdEl) totalUsdEl.textContent = totalUSD % 1 === 0 ? `$${totalUSD.toFixed(0)} USD` : `$${totalUSD.toFixed(2)} USD`;

      if (itemsContainer) {
        itemsContainer.innerHTML = items.map(item => `
          <div class="bg-white/[0.04] rounded-2xl p-3.5 border border-white/[0.06] flex gap-3.5 items-center relative group">
            <a href="/producto/${item.slug}/" class="w-16 h-16 rounded-xl overflow-hidden bg-black shrink-0 border border-white/10">
              <img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover" />
            </a>
            
            <div class="flex-1 min-w-0">
              <a href="/producto/${item.slug}/" class="font-bold text-white text-xs sm:text-sm truncate block hover:text-amber-400 transition-colors">
                ${item.name}
              </a>
              
              <div class="flex flex-wrap items-center gap-1.5 mt-1">
                ${item.color ? `<span class="text-[10px] bg-purple-900/50 text-amber-300 px-2 py-0.5 rounded-md border border-purple-700/50 font-semibold">${item.color}</span>` : ''}
                ${item.size ? `<span class="text-[10px] bg-amber-400/10 text-amber-400 px-2 py-0.5 rounded-md border border-amber-400/20 font-semibold">Talla ${item.size}</span>` : ''}
              </div>

              <div class="text-[11px] font-extrabold text-orange-400 mt-1">
                ${(item.priceCUP * item.quantity).toLocaleString('en-US')} CUP / ${(item.priceUSD * item.quantity) % 1 === 0 ? `$${(item.priceUSD * item.quantity).toFixed(0)}` : `$${(item.priceUSD * item.quantity).toFixed(2)}`} USD
              </div>
            </div>

            <!-- Controles de Cantidad -->
            <div class="flex items-center gap-1 bg-black/40 rounded-lg p-1 border border-white/10">
              <button data-action="minus" data-id="${item.id}" class="w-6 h-6 rounded flex items-center justify-center text-slate-300 hover:text-amber-400 hover:bg-white/10 text-xs font-bold transition-colors">&minus;</button>
              <span class="text-xs font-bold text-white px-1.5">${item.quantity}</span>
              <button data-action="plus" data-id="${item.id}" class="w-6 h-6 rounded flex items-center justify-center text-slate-300 hover:text-amber-400 hover:bg-white/10 text-xs font-bold transition-colors">+</button>
            </div>

            <!-- Eliminar -->
            <button data-action="remove" data-id="${item.id}" class="text-slate-500 hover:text-red-400 p-1 text-sm transition-colors" title="Eliminar del carrito">
              🗑️
            </button>
          </div>
        `).join('');

        // Listeners en ítems
        itemsContainer.querySelectorAll('button[data-action]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const target = e.currentTarget as HTMLButtonElement;
            const action = target.getAttribute('data-action');
            const id = target.getAttribute('data-id');
            if (!id) return;

            if (action === 'minus') CartStore.updateQuantity(id, -1);
            if (action === 'plus') CartStore.updateQuantity(id, 1);
            if (action === 'remove') CartStore.removeItem(id);
          });
        });
      }
    }

    // Eventos globales
    closeBtn?.addEventListener('click', closeCart);
    overlay?.addEventListener('click', closeCart);

    clearBtn?.addEventListener('click', () => {
      if (confirm('¿Estás seguro de que deseas vaciar el carrito?')) {
        CartStore.clearCart();
      }
    });

    checkoutBtn?.addEventListener('click', () => {
      const items = CartStore.getItems();
      if (items.length === 0) return;

      const { totalCUP, totalUSD } = CartStore.getTotals();
      let text = `🛒 *NUEVO PEDIDO - CARMAY OUTFIT*\n\n`;
      items.forEach((i, idx) => {
        text += `${idx + 1}. *${i.name}*\n`;
        if (i.color) text += `   • Color: ${i.color}\n`;
        if (i.size) text += `   • Talla: ${i.size}\n`;
        text += `   • Cantidad: ${i.quantity}\n`;
        text += `   • Subtotal: ${ (i.priceCUP * i.quantity).toLocaleString('en-US') } CUP / $${ (i.priceUSD * i.quantity).toFixed(2) } USD\n\n`;
      });

      text += `━━━━━━━━━━━━━━━━━━━━━\n`;
      text += `💰 *TOTAL FINAL:* ${totalCUP.toLocaleString('en-US')} CUP / $${totalUSD.toFixed(2)} USD\n\n`;
      text += `📍 *Lugar de Entrega / Recogida:* Avellaneda No. 260, Camagüey`;

      const whatsappUrl = `https://wa.me/53REDACTED_PHONE_1?text=${encodeURIComponent(text)}`;
      window.open(whatsappUrl, '_blank');
    });

    // Escuchar actualización del carrito
    window.addEventListener('carmay-cart-updated', renderCart);
    window.addEventListener('open-carmay-cart', openCart);

    // Render inicial
    renderCart();
  });
</script>
