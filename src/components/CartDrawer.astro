---
---

<!-- Backdrop overlay: oscuro y sin blur para enfoque claro -->
<div id="cart-overlay" class="fixed inset-0 bg-black/70 z-[80] hidden opacity-0 transition-opacity duration-300"></div>

<!-- Panel Lateral estilo glass oscuro con duración intermedia para mayor suavidad -->
<aside id="cart-drawer" class="fixed top-0 right-0 h-full w-full sm:w-[380px] bg-[#0e1019] border-l border-white/10 z-[90] transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col shadow-[-4px_0_25px_rgba(0,0,0,0.5)]">
  
  <!-- Encabezado del Panel -->
  <div class="p-5 sm:p-6 border-b border-white/10 flex items-center justify-between bg-black/20">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l2.4 12.4a2 2 0 002 1.6h7.7a2 2 0 002-1.6L21 7H6" />
          <circle cx="9" cy="20" r="1.5" />
          <circle cx="17" cy="20" r="1.5" />
        </svg>
      </div>
      <div>
        <h3 class="font-extrabold text-white text-lg leading-snug">Tu Carrito</h3>
        <span id="cart-count-subtitle" class="text-xs text-slate-400">0 productos seleccionados</span>
      </div>
    </div>

    <!-- Botón Cerrar -->
    <button id="cart-close-btn" class="flex items-center justify-center w-11 h-11 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white transition-colors cursor-pointer" aria-label="Cerrar carrito">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Contenido: Lista de Productos -->
  <div id="cart-items-container" class="flex-1 overflow-y-auto p-5 sm:p-6 space-y-4 scrollbar-hide">
    <!-- Renderizado dinámico -->
  </div>

  <!-- Vista Vacía (Template) -->
  <div id="cart-empty-view" class="hidden flex-1 flex flex-col items-center justify-center p-6 text-center">
    <div class="w-20 h-20 rounded-full bg-purple-900/20 border border-purple-500/20 flex items-center justify-center text-purple-400 mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l2.4 12.4a2 2 0 002 1.6h7.7a2 2 0 002-1.6L21 7H6" />
        <circle cx="9" cy="20" r="1.5" />
        <circle cx="17" cy="20" r="1.5" />
      </svg>
    </div>
    <h4 class="font-bold text-white text-lg mb-2">Tu carrito está vacío</h4>
    <p class="text-xs text-slate-400 max-w-xs mb-6">Explora nuestro catálogo y agrega tus prendas y accesorios favoritos.</p>
    <a href="/tienda/" class="min-h-[44px] inline-flex items-center px-6 py-3 rounded-xl bg-gradient-to-r from-amber-500 to-orange-600 text-white font-extrabold text-xs uppercase tracking-wider shadow-lg shadow-orange-600/20 hover:from-amber-400 hover:to-orange-500 transition-all">
      Ver Catálogo de Productos
    </a>
  </div>

  <!-- Pie del Panel: Totales y Botón de Checkout por WhatsApp -->
  <div id="cart-footer" class="p-5 sm:p-6 border-t border-white/10 bg-black/40 space-y-4">
    <!-- Totales -->
    <div class="bg-white/[0.03] rounded-2xl p-4 border border-white/[0.06] space-y-2">
      <div class="flex items-center justify-between text-xs text-slate-400">
        <span>Total en CUP:</span>
        <span id="cart-total-cup" class="text-base font-black text-orange-500">0 CUP</span>
      </div>
      <div class="flex items-center justify-between text-xs text-slate-400 pt-1 border-t border-white/[0.04]">
        <span>Total en USD:</span>
        <span id="cart-total-usd" class="text-base font-black text-orange-500">$0 USD</span>
      </div>
    </div>

    <!-- Botón Principal: Finalizar Pedido -->
    <a href="/finalizar-pedido/" id="cart-checkout-btn" class="w-full min-h-[44px] py-4 px-5 rounded-2xl bg-gradient-to-r from-yellow-600 to-yellow-700 hover:from-yellow-500 hover:to-yellow-500 text-white font-extrabold text-sm uppercase tracking-wider shadow-[0_4px_20px_rgba(234,179,8,0.3)] hover:shadow-[0_6px_25px_rgba(234,179,8,0.4)] transition-all flex items-center justify-center gap-2 border border-yellow-500/20 cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
      </svg>
      <span>Finalizar Pedido</span>
    </a>

    <!-- Botón Secundario: Seguir Comprando (Cierra el drawer suavemente) -->
    <button
      type="button"
      data-cart-close
      class="w-full min-h-[44px] py-3 px-4 rounded-xl border border-white/10 hover:border-amber-400/40 bg-white/[0.03] hover:bg-white/[0.08] text-slate-300 hover:text-white font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-pointer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <span>Seguir Comprando</span>
    </button>

    <!-- Vaciar Carrito -->
    <div class="text-center pt-1">
      <button id="cart-clear-btn" class="min-h-[44px] px-3 py-2 text-xs text-slate-500 hover:text-red-400 transition-colors font-medium cursor-pointer">
        Vaciar Carrito
      </button>
    </div>
  </div>

</aside>

<script>
  import { CartCRUD } from '../utils/cartStore';

  // Exponer CartCRUD globalmente en window.CarmayCart
  if (typeof window !== 'undefined') {
    (window as any).CarmayCart = CartCRUD;
  }

  function openCart() {
    const overlay = document.getElementById('cart-overlay');
    const drawer = document.getElementById('cart-drawer');
    if (overlay && drawer) {
      overlay.classList.remove('hidden');
      overlay.style.opacity = '0';
      drawer.classList.remove('translate-x-full');
      drawer.style.transform = 'translateX(100%)';
      document.body.style.overflow = 'hidden';

      requestAnimationFrame(() => {
        overlay.style.opacity = '1';
        drawer.style.transform = 'translateX(0)';
      });
    }
  }

  function closeCart() {
    const overlay = document.getElementById('cart-overlay');
    const drawer = document.getElementById('cart-drawer');
    if (overlay && drawer) {
      overlay.style.opacity = '0';
      drawer.style.transform = 'translateX(100%)';
      setTimeout(() => {
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
      }, 300);
    }
  }

  function renderCart() {
    const { totalUnits, totalCUP, totalUSD, items } = CartCRUD.getTotals();
    const countSubtitle = document.getElementById('cart-count-subtitle');
    const itemsContainer = document.getElementById('cart-items-container');
    const emptyView = document.getElementById('cart-empty-view');
    const footer = document.getElementById('cart-footer');
    const totalCupEl = document.getElementById('cart-total-cup');
    const totalUsdEl = document.getElementById('cart-total-usd');

    if (countSubtitle) {
      countSubtitle.textContent = `${totalUnits} ${totalUnits === 1 ? 'producto seleccionado' : 'productos seleccionados'}`;
    }

    if (items.length === 0) {
      if (itemsContainer) itemsContainer.classList.add('hidden');
      if (footer) footer.classList.add('hidden');
      if (emptyView) emptyView.classList.remove('hidden');
      return;
    }

    if (emptyView) emptyView.classList.add('hidden');
    if (itemsContainer) itemsContainer.classList.remove('hidden');
    if (footer) footer.classList.remove('hidden');

    if (totalCupEl) totalCupEl.textContent = `${totalCUP.toLocaleString('en-US')} CUP`;
    if (totalUsdEl) totalUsdEl.textContent = totalUSD % 1 === 0 ? `$${totalUSD.toFixed(0)} USD` : `$${totalUSD.toFixed(2)} USD`;

    if (itemsContainer) {
      itemsContainer.innerHTML = items.map(item => `
        <div class="bg-white/[0.04] rounded-2xl p-3.5 border border-white/[0.06] flex flex-wrap gap-3 items-center relative group">
          <a href="/producto/${item.slug}/" class="w-16 h-16 rounded-xl overflow-hidden bg-black shrink-0 border border-white/10">
            <img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover" />
          </a>
          
          <div class="flex-1 min-w-0">
            <a href="/producto/${item.slug}/" class="font-bold text-white text-xs sm:text-sm truncate block hover:text-amber-400 transition-colors">
              ${item.name}
            </a>
            
            <div class="flex flex-wrap items-center gap-1.5 mt-1">
              ${item.color ? `<span class="text-xs bg-purple-900/50 text-amber-300 px-2 py-0.5 rounded-md border border-purple-700/50 font-semibold">${item.color}</span>` : ''}
              ${item.size ? `<span class="text-xs bg-amber-400/10 text-amber-400 px-2 py-0.5 rounded-md border border-amber-400/20 font-semibold">Talla ${item.size}</span>` : ''}
            </div>

            <div class="text-xs font-extrabold text-orange-400 mt-1">
              ${(item.priceCUP * item.quantity).toLocaleString('en-US')} CUP / ${(item.priceUSD * item.quantity) % 1 === 0 ? `$${(item.priceUSD * item.quantity).toFixed(0)}` : `$${(item.priceUSD * item.quantity).toFixed(2)}`} USD
            </div>

            <!-- Enlace explícito para ver detalles de la ficha -->
            <a href="/producto/${item.slug}/" class="inline-flex items-center gap-1 text-xs text-amber-400/90 hover:text-amber-300 font-bold mt-1 transition-colors">
              <span>Ver ficha y detalles</span>
              <span class="text-xs">&rarr;</span>
            </a>
          </div>

          <!-- Fila de controles: Cantidad (CRUD) + Eliminar -->
          <div class="w-full flex items-center justify-between gap-2 pt-2 border-t border-white/[0.06]">
            <div class="flex items-center gap-1 bg-black/40 rounded-xl p-1 border border-white/10">
              <button data-cart-item-minus="${item.id}" class="w-11 h-11 rounded-lg flex items-center justify-center text-slate-300 hover:text-amber-400 hover:bg-white/10 text-sm font-bold transition-colors cursor-pointer" aria-label="Restar uno">&minus;</button>
              <span class="text-sm font-bold text-white px-2 min-w-[2rem] text-center">${item.quantity}</span>
              <button data-cart-item-plus="${item.id}" class="w-11 h-11 rounded-lg flex items-center justify-center text-slate-300 hover:text-amber-400 hover:bg-white/10 text-sm font-bold transition-colors cursor-pointer" aria-label="Sumar uno">+</button>
            </div>

            <!-- Eliminar (CRUD) -->
            <button data-cart-item-delete="${item.id}" class="w-11 h-11 flex items-center justify-center rounded-xl text-slate-500 hover:text-red-400 hover:bg-red-500/10 transition-colors cursor-pointer" title="Eliminar del carrito" aria-label="Eliminar del carrito">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.9 12.1A2 2 0 0116.1 21H7.9a2 2 0 01-2-1.9L5 7m5 4v6m4-6v6M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3M4 7h16" />
              </svg>
            </button>
          </div>
        </div>
      `).join('');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const closeBtn = document.getElementById('cart-close-btn');
    const overlay = document.getElementById('cart-overlay');
    const clearBtn = document.getElementById('cart-clear-btn');
    const checkoutBtn = document.getElementById('cart-checkout-btn');

    closeBtn?.addEventListener('click', closeCart);
    overlay?.addEventListener('click', closeCart);

    clearBtn?.addEventListener('click', () => {
      if (confirm('¿Estás seguro de que deseas vaciar el carrito?')) {
        CartCRUD.clear();
      }
    });

    // EVENT DELEGATION GLOBAL para todo el documento
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      // Cerrar / Abrir
      if (target.closest('[data-cart-open]')) {
        openCart();
      }
      if (target.closest('[data-cart-close]')) {
        closeCart();
      }

      // Decrementar
      const minusBtn = target.closest('[data-cart-item-minus]');
      if (minusBtn) {
        const id = minusBtn.getAttribute('data-cart-item-minus');
        if (id) CartCRUD.changeQuantity(id, -1);
      }

      // Incrementar
      const plusBtn = target.closest('[data-cart-item-plus]');
      if (plusBtn) {
        const id = plusBtn.getAttribute('data-cart-item-plus');
        if (id) CartCRUD.changeQuantity(id, 1);
      }

      // Eliminar
      const deleteBtn = target.closest('[data-cart-item-delete]');
      if (deleteBtn) {
        const id = deleteBtn.getAttribute('data-cart-item-delete');
        if (id) CartCRUD.delete(id);
      }
    });

    // Escuchar eventos custom
    window.addEventListener('carmay-cart-changed', renderCart);
    window.addEventListener('open-carmay-cart', openCart);

    // Render inicial
    renderCart();
  });
</script>
