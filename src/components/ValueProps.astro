---
const values = [
  {
    icon: "🚚",
    title: "Envíos y Entregas",
    description: "Coordinación rápida de entregas y recogida en tienda."
  },
  {
    icon: "💵",
    title: "Pago Local Flexible",
    description: "Efectivo en tienda, transferencia CUP o USD."
  },
  {
    icon: "🛡️",
    title: "Garantía y Calidad",
    description: "Productos seleccionados y verificados uno a uno."
  },
  {
    icon: "💬",
    title: "Atención Exprés",
    description: "Soporte directo y personalizado por WhatsApp."
  }
];
---

<section class="py-12 bg-[#13111c] border-y border-purple-950/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {values.map(item => (
        <div class="glass-card glass-card-hover p-6 rounded-2xl flex items-start gap-4 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-purple-900/40 border border-purple-700/50 flex items-center justify-center text-2xl shrink-0">
            {item.icon}
          </div>
          <div>
            <h3 class="font-bold text-white text-base mb-1">{item.title}</h3>
            <p class="text-xs text-gray-400 leading-relaxed">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
