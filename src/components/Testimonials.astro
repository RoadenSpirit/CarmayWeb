---
const testimonials = [
  {
    name: "Yamilé C.",
    location: "Camagüey",
    comment: "Excelente atención y los zapatos Ipanema llegaron súper rápido a domicilio. La mejor tienda de toda la calle Avellaneda.",
    facebookUrl: "https://www.facebook.com/carmayoutfittiendaonline"
  },
  {
    name: "Carlos M.",
    location: "La Habana",
    comment: "Compré mi televisión Smart y mi estación de energía EcoFlow, el proceso fue sumamente transparente y el envío rápido. Muy recomendado en Cuba.",
    facebookUrl: "https://www.facebook.com/carmayoutfittiendaonline"
  },
  {
    name: "Diana R.",
    location: "Camagüey",
    comment: "Me encanta la calidad de la ropa y el trato tan amable de los gestores por WhatsApp. ¡Ya tengo mis favoritos guardados!",
    facebookUrl: "https://www.facebook.com/carmayoutfittiendaonline"
  }
];
---

<section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center max-w-2xl mx-auto mb-16">
    <span class="text-amber-400 font-bold text-xs uppercase tracking-widest block mb-2">Opiniones Reales</span>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
      Lo que dicen nuestros clientes
    </h2>
    <p class="text-gray-400 text-sm mt-2">
      Testimonios 100% reales verificables en nuestra página oficial de Facebook.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {testimonials.map(t => (
      <div class="glass-card glass-card-hover p-8 rounded-3xl flex flex-col justify-between border border-white/10 relative shadow-xl">
        <div class="absolute top-6 right-6 text-amber-400 text-xl">★★★★★</div>
        
        <p class="text-gray-300 text-sm sm:text-base italic leading-relaxed mb-8">
          "{t.comment}"
        </p>

        <div class="flex items-center justify-between pt-4 border-t border-white/10">
          <div>
            <h4 class="font-bold text-white text-sm">{t.name}</h4>
            <span class="text-xs text-gray-400">{t.location}</span>
          </div>

          <a 
            href={t.facebookUrl} 
            target="_blank" 
            class="text-xs text-purple-400 hover:text-amber-400 font-bold flex items-center gap-1 transition-colors bg-purple-950/60 px-3 py-1.5 rounded-full border border-purple-800/40"
          >
            <span>Ver en Facebook</span>
            <span>&nearr;</span>
          </a>
        </div>
      </div>
    ))}
  </div>
</section>
