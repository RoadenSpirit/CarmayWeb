---
const testimonials = [
  {
    name: "Yamilé C.",
    location: "Camagüey",
    comment: "Excelente atención y los zapatos Ipanema llegaron súper rápido a domicilio. La mejor tienda de toda la calle Avellaneda.",
    facebookUrl: "https://www.facebook.com/carmayoutfittiendaonline"
  },
  {
    name: "Carlos M.",
    location: "La Habana",
    comment: "Compré mi televisión Smart y mi estación de energía EcoFlow, el proceso fue sumamente transparente y el envío rápido. Muy recomendado en Cuba.",
    facebookUrl: "https://www.facebook.com/carmayoutfittiendaonline"
  },
  {
    name: "Diana R.",
    location: "Camagüey",
    comment: "Me encanta la calidad de la ropa y el trato tan amable de los gestores por WhatsApp. ¡Ya tengo mis favoritos guardados!",
    facebookUrl: "https://www.facebook.com/carmayoutfittiendaonline"
  }
];
---

<section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center max-w-2xl mx-auto mb-16 reveal-on-scroll">
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
      Lo que dicen nuestros clientes
    </h2>
    <p class="text-amber-400 font-bold text-xs sm:text-sm uppercase tracking-widest block mt-2 mb-1">Opiniones Reales</p>
    <p class="text-slate-300 text-sm sm:text-base mt-2">
      Testimonios 100% reales verificables en nuestra página oficial de Facebook.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {testimonials.map((t, idx) => (
      <div class={`bg-[#121522]/95 backdrop-blur-xl p-7 sm:p-8 rounded-3xl flex flex-col justify-between border border-purple-500/20 hover:border-amber-400/40 relative shadow-[0_8px_30px_rgba(0,0,0,0.5)] transition-all duration-300 hover:-translate-y-1.5 ${idx === 0 ? 'reveal-slide-right' : idx === 2 ? 'reveal-slide-left' : 'reveal-scale'} reveal-delay-${idx + 1}`}>
        
        <!-- Contenido del comentario -->
        <div class="space-y-4">
          <!-- Comentario con comillas sutiles -->
          <p class="text-slate-100 text-sm sm:text-base leading-relaxed font-normal">
            "{t.comment}"
          </p>

          <!-- Estrellas debajo del comentario, con mayor tamaño y orden natural -->
          <div class="flex items-center gap-1 text-amber-400 text-2xl tracking-widest pt-1" aria-label="5 de 5 estrellas">
            ★★★★★
          </div>
        </div>

        <!-- Footer con autor y botón a Facebook -->
        <div class="flex items-center justify-between pt-6 mt-6 border-t border-white/10">
          <div>
            <h4 class="font-bold text-white text-base sm:text-lg">{t.name}</h4>
            <span class="text-xs sm:text-sm text-amber-400 font-medium inline-flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              <span>{t.location}</span>
            </span>
          </div>

          <a 
            href={t.facebookUrl} 
            target="_blank" 
            class="min-h-[44px] inline-flex items-center gap-1.5 text-xs text-purple-200 hover:text-white font-bold transition-all bg-gradient-to-r from-purple-800 to-purple-900 hover:from-amber-600 hover:to-amber-700 px-4 py-3 rounded-full border border-purple-500/40 shadow-sm"
          >
            <span>Facebook</span>
            <span class="text-amber-300">&nearr;</span>
          </a>
        </div>
      </div>
    ))}
  </div>
</section>
