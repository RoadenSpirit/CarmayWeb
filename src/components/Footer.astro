<footer class="bg-[#090b12] text-white pt-16 pb-12 border-t border-purple-900/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 pb-12 border-b border-white/10 items-start">
      
      <!-- Columna 1: Marca & Eslogan -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-14 h-14 flex items-center justify-center shrink-0">
            <img src="/logo.png" alt="Carmay Outfit" class="w-full h-full object-contain filter drop-shadow-[0_2px_12px_rgba(234,179,8,0.3)]" />
          </div>
          <span class="text-xl font-black tracking-tight text-white">
            CARMAY OUTFIT
          </span>
        </div>
        <p class="text-sm text-slate-300 leading-relaxed">
          Moda, calzado y tecnología de vanguardia en Camagüey, Cuba.
        </p>
      </div>

      <!-- Columna 2: Enlaces rápidos de Navegación -->
      <div class="space-y-4">
        <h4 class="text-xs font-black uppercase tracking-widest text-amber-400">
          Navegación
        </h4>
        <ul class="space-y-3 text-sm text-slate-300">
          <li>
            <a href="/" class="hover:text-amber-400 transition-colors flex items-center gap-2">
              <span class="text-amber-400 text-xs">›</span> Inicio
            </a>
          </li>
          <li>
            <a href="/tienda/" class="hover:text-amber-400 transition-colors flex items-center gap-2">
              <span class="text-amber-400 text-xs">›</span> Catálogo de Tienda
            </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-amber-400 transition-colors flex items-center gap-2">
              <span class="text-amber-400 text-xs">›</span> Contáctanos
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Contacto Físico Oficial -->
      <div class="space-y-4">
        <h4 class="text-xs font-black uppercase tracking-widest text-amber-400">
          Tienda Física
        </h4>
        <p class="text-sm text-slate-300 leading-relaxed">
          Avellaneda No. 260 entre San Esteban y San Martín, Camagüey, Cuba.
        </p>
        <div class="pt-1 space-y-2 text-sm">
          <div class="flex items-center gap-2 text-white font-medium">
            <span class="text-amber-400 text-sm">📞</span>
            <span>Teléfono: (+53) 63791924</span>
          </div>
          <div class="flex items-center gap-2 text-slate-300">
            <span class="text-purple-400 text-sm">✉️</span>
            <span>Correo: <a href="mailto:carmaytienda@gmail.com" class="hover:text-amber-400 transition-colors underline-offset-4 hover:underline">carmaytienda@gmail.com</a></span>
          </div>
        </div>
      </div>

      <!-- Columna 4: Horario Oficial -->
      <div class="space-y-4">
        <h4 class="text-xs font-black uppercase tracking-widest text-amber-400">
          Horario Comercial
        </h4>
        <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-4 space-y-2 text-sm text-slate-300">
          <div class="flex items-start gap-2">
            <span class="text-amber-400 mt-0.5">🕒</span>
            <p class="leading-relaxed">
              Nuestra tienda abre sus puertas de <strong class="text-white">lunes a viernes</strong> (8:30 AM a 4:30 PM) y los <strong class="text-white">sábados</strong> (8:30 AM a 2:00 PM).
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- Pie inferior de copyright y legales -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
      <p>&copy; 2026 Carmay Outfit. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-amber-400 transition-colors">Política de Privacidad</a>
        <a href="#" class="hover:text-amber-400 transition-colors">Términos del Servicio</a>
      </div>
    </div>
  </div>
</footer>
