---
---

<footer class="bg-[#090b12] text-white pt-16 pb-12 border-t border-purple-900/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 pb-12 border-b border-white/10 items-start">
      
      <!-- Columna 1: Marca & Eslogan -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-14 h-14 flex items-center justify-center shrink-0">
            <img src="/logo.png" alt="Carmay Outfit" class="w-full h-full object-contain filter drop-shadow-[0_2px_12px_rgba(234,179,8,0.3)]" />
          </div>
          <span class="text-xl font-black tracking-tight text-white">
            CARMAY OUTFIT
          </span>
        </div>
        <p class="text-sm text-slate-300 leading-relaxed">
          Moda, calzado y tecnología de vanguardia en Camagüey, Cuba.
        </p>
      </div>

      <!-- Columna 2: Enlaces rápidos de Navegación -->
      <div class="space-y-4">
        <h4 class="text-xs font-black uppercase tracking-widest text-amber-400">
          Navegación
        </h4>
        <ul class="space-y-1 text-sm text-slate-300">
          <li>
            <a href="/" class="hover:text-amber-400 transition-colors flex items-center gap-2 min-h-[44px]">
              <span class="text-amber-400 text-xs">›</span> Inicio
            </a>
          </li>
          <li>
            <a href="/tienda/" class="hover:text-amber-400 transition-colors flex items-center gap-2 min-h-[44px]">
              <span class="text-amber-400 text-xs">›</span> Catálogo
            </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-amber-400 transition-colors flex items-center gap-2 min-h-[44px]">
              <span class="text-amber-400 text-xs">›</span> Contáctanos
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Contacto Físico Oficial -->
      <div class="space-y-4">
        <h4 class="text-xs font-black uppercase tracking-widest text-amber-400">
          Tienda Física
        </h4>
        <p class="text-sm text-slate-300 leading-relaxed">
          <a href="https://maps.google.com/?q=Avellaneda+260,+Camaguey,+Cuba" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition-colors underline-offset-4 hover:underline inline-flex items-center min-h-[44px] py-1">
            Avellaneda No. 260 entre San Esteban y San Martín, Camagüey, Cuba.
          </a>
        </p>
        <div class="pt-1 space-y-2 text-sm">
          <div class="flex items-center gap-2 text-white font-medium">
            <span class="text-amber-400 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.95.68l1.5 4.5a1 1 0 01-.5 1.2l-2.26 1.13a11 11 0 005.5 5.5l1.13-2.26a1 1 0 011.2-.5l4.5 1.5a1 1 0 01.68.95V19a2 2 0 01-2 2h-1C9.72 21 3 14.28 3 6V5z" />
              </svg>
            </span>
            <span>Teléfono: (+53) 63791924</span>
          </div>
          <div class="flex items-center gap-2 text-slate-300">
            <span class="text-purple-400 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 7l9 6 9-6" />
              </svg>
            </span>
            <span>Correo: <a href="mailto:carmaytienda@gmail.com" class="hover:text-amber-400 transition-colors underline-offset-4 hover:underline inline-flex min-h-[44px] items-center">carmaytienda@gmail.com</a></span>
          </div>
        </div>
      </div>

      <!-- Columna 4: Horario Oficial -->
      <div class="space-y-4">
        <h4 class="text-xs font-black uppercase tracking-widest text-amber-400">
          Horario Comercial
        </h4>
        <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-4 space-y-2 text-sm text-slate-300">
          <div class="flex items-start gap-2">
            <span class="text-amber-400 shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="9" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2" />
              </svg>
            </span>
            <p class="leading-relaxed">
              Nuestra tienda abre sus puertas de <strong class="text-white">lunes a viernes</strong> (8:30 AM a 4:30 PM) y los <strong class="text-white">sábados</strong> (8:30 AM a 2:00 PM).
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- Pie inferior de copyright y legales -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
      <p>&copy; 2026 Carmay Outfit. Todos los derechos reservados.</p>
      <div class="flex gap-2 sm:gap-6">
        <a href="#" class="hover:text-amber-400 transition-colors inline-flex items-center min-h-[44px] px-1">Política de Privacidad</a>
        <a href="#" class="hover:text-amber-400 transition-colors inline-flex items-center min-h-[44px] px-1">Términos del Servicio</a>
      </div>
    </div>
  </div>
</footer>
