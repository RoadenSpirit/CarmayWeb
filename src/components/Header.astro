---
import CartDrawer from './CartDrawer.astro';
import SubNavbar from './SubNavbar.astro';
import SearchBar from './SearchBar.astro';
import FloatingCartBtn from './FloatingCartBtn.astro';

interface Props {
  showCategoryBar?: boolean;
  activeCategory?: string;
}

const { showCategoryBar = false, activeCategory = '' } = Astro.props;

const storeCategories = [
  { name: "Calzado", slug: "zapatos" },
  { name: "Ropa", slug: "ropa" },
  { name: "Bolsos y Mochilas", slug: "jackets" },
  { name: "Tecnología", slug: "tecnologia" },
  { name: "Accesorios", slug: "accesorios" }
];
---

<header 
  id="main-header" 
  class="sticky top-0 z-50 backdrop-blur-2xl backdrop-saturate-[180%] bg-[#0c0e17]/90 border-b border-white/[0.12] shadow-[0_8px_32px_rgba(0,0,0,0.6),inset_0_1px_0_rgba(255,255,255,0.12)]"
>
  <!-- Scroll progress bar -->
  <div id="scroll-progress" class="absolute top-0 left-0 h-[2px] bg-gradient-to-r from-yellow-500 via-yellow-400 to-yellow-600 w-0 transition-all duration-75 z-50"></div>

  <!-- Línea inferior de acento amarillo -->
  <div id="header-accent-line" class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-yellow-500/30 to-transparent pointer-events-none"></div>

  <!-- ================= PISO SUPERIOR: CARRUSEL DE VALOR ================= -->
  <div id="header-top-value-bar" class="relative z-30">
    <SubNavbar />
  </div>

  <!-- ================= PISO PRINCIPAL: LOGO + MENÚ DE NAVEGACIÓN + BUSCADOR ================= -->
  <div id="header-main-nav" class="relative z-20">
    <div class="relative max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-18 sm:h-20 flex items-center justify-between gap-3 sm:gap-4 lg:gap-6">
      
      <!-- 1. Logo a la izquierda -->
      <div class="flex items-center shrink-0">
        <a href="/" class="flex items-center group">
          <div class="w-14 h-14 sm:w-16 sm:h-16 md:w-20 md:h-20 flex items-center justify-center group-hover:scale-105 transition-transform">
            <img src="/logo.png" alt="Carmay Outfit" class="w-full h-full object-contain filter drop-shadow-[0_2px_12px_rgba(234,179,8,0.35)]" />
          </div>
        </a>
      </div>

      <!-- 2. Menú de Navegación en Desktop (Logo + Menú + Buscador) -->
      <nav class="hidden md:flex items-center gap-1.5 lg:gap-2 p-1.5 rounded-full bg-white/[0.03] border border-white/[0.08] shadow-[0_4px_24px_rgba(0,0,0,0.35)] backdrop-blur-md shrink-0">
        <a 
          href="/" 
          class="px-4 py-1.5 rounded-full text-xs lg:text-sm font-bold text-slate-200 hover:text-amber-300 hover:bg-white/[0.06] transition-all"
        >
          Inicio
        </a>
        <a 
          href="/tienda/" 
          class="px-4 py-1.5 rounded-full text-xs lg:text-sm font-bold text-slate-200 hover:text-amber-300 hover:bg-white/[0.06] transition-all"
        >
          Catálogo
        </a>
        <a 
          href="/contact" 
          class="px-4 py-1.5 rounded-full text-xs lg:text-sm font-bold text-slate-200 hover:text-amber-300 hover:bg-white/[0.06] transition-all"
        >
          Contáctanos
        </a>
      </nav>

      <!-- 3. Buscador Integrado (A la derecha en desktop; central en móvil) -->
      <div class="flex-1 md:max-w-xs lg:max-w-sm min-w-0">
        <SearchBar />
      </div>

      <!-- 4. En Móvil: Botón Hamburguesa -->
      <button id="mobile-menu-btn" class="md:hidden flex items-center justify-center w-11 h-11 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 hover:border-amber-400/40 transition-all cursor-pointer shrink-0" aria-label="Abrir menú de navegación">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>
  </div>

  <!-- ================= BARRA LIGERA DE CATEGORÍAS (Acceso Rápido Fino y Moderno) ================= -->
  {showCategoryBar && (
    <nav id="categorias-navbar" class="border-t border-white/[0.08] bg-white/[0.015] shadow-[inset_0_1px_0_rgba(255,255,255,0.02)] relative z-10 overflow-x-auto scrollbar-hide py-1">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-start sm:justify-center gap-2 py-1 min-w-max">
          <a
            href="/tienda/"
            class={`text-xs font-bold tracking-wide transition-all min-h-[44px] inline-flex items-center px-4 py-2.5 rounded-full border ${
              !activeCategory 
                ? 'text-yellow-400 bg-yellow-400/10 border-yellow-400/40 shadow-[0_0_12px_rgba(234,179,8,0.15)]' 
                : 'text-slate-300 border-white/10 hover:text-yellow-400 hover:bg-white/[0.04]'
            }`}
          >
            Todos
          </a>
          {storeCategories.map((cat) => (
            <a
              href={`/tienda/${cat.slug}/`}
              class={`text-xs font-bold tracking-wide transition-all min-h-[44px] inline-flex items-center px-4 py-2.5 rounded-full border whitespace-nowrap ${
                cat.slug === activeCategory 
                  ? 'text-yellow-400 bg-yellow-400/10 border-yellow-400/40 shadow-[0_0_12px_rgba(234,179,8,0.15)]' 
                  : 'text-slate-300 border-white/10 hover:text-yellow-400 hover:bg-white/[0.04]'
              }`}
            >
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    </nav>
  )}
</header>

<!-- Drawer Móvil -->
<div id="mobile-menu-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] hidden opacity-0 transition-opacity duration-300"></div>
<div id="mobile-menu-drawer" class="fixed top-0 right-0 h-full w-72 bg-[#0e1019]/95 backdrop-blur-2xl border-l border-white/10 z-[70] transform translate-x-full transition-transform duration-300 ease-out">
  <!-- Botón Cerrar -->
  <div class="flex items-center justify-end p-5">
    <button id="mobile-menu-close" class="flex items-center justify-center w-11 h-11 rounded-lg border border-white/10 bg-white/5 hover:bg-white/10 transition-colors" aria-label="Cerrar menú">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Logo en drawer -->
  <div class="px-6 pb-6 border-b border-white/10">
    <a href="/" class="flex items-center gap-3.5">
      <img src="/logo.png" alt="Carmay Outfit" class="w-16 h-16 object-contain drop-shadow-[0_2px_10px_rgba(234,179,8,0.3)]" />
      <span class="text-xl font-black text-white tracking-tight">CARMAY OUTFIT</span>
    </a>
  </div>

  <!-- Enlaces de navegación -->
  <nav class="flex flex-col p-6 gap-2 overflow-y-auto max-h-[calc(100vh-180px)] scrollbar-hide">
    <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-xl text-white font-bold hover:bg-white/5 hover:text-yellow-400 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      Inicio
    </a>
    <a href="/tienda/" class="flex items-center gap-3 px-4 py-3 rounded-xl text-white font-bold hover:bg-white/5 hover:text-yellow-400 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l2.4 12.4a2 2 0 002 1.6h7.7a2 2 0 002-1.6L21 7H6" />
        <circle cx="9" cy="20" r="1.5" />
        <circle cx="17" cy="20" r="1.5" />
      </svg>
      Catálogo
    </a>

    <!-- SECCIÓN CATEGORÍAS DENTRO DEL MENÚ MÓVIL -->
    <div class="my-2 pt-3 pb-1 border-t border-b border-white/10">
      <span class="text-xs font-black uppercase tracking-widest text-amber-400/90 px-4 mb-2 block">
        Categorías
      </span>
      <div class="flex flex-col gap-1 pl-2">
        <a href="/tienda/zapatos/" class="flex items-center gap-2.5 px-3 py-3 min-h-[44px] rounded-lg text-sm font-semibold text-slate-300 hover:text-amber-300 hover:bg-white/5 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 14h13a3 3 0 003-3c0-1.5-2-2.5-4-3L9 6C7 6 5 7 4 9v5zm0 0v3a1 1 0 001 1h12a1 1 0 001-1v-2M4 14c1.5 0 3 .5 4 1.5" />
          </svg>
          <span>Calzado</span>
        </a>
        <a href="/tienda/ropa/" class="flex items-center gap-2.5 px-3 py-3 min-h-[44px] rounded-lg text-sm font-semibold text-slate-300 hover:text-amber-300 hover:bg-white/5 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l5 3 5 2-2 4h-2v9H6v-9H4l-2-4 5-2 5-3z" />
          </svg>
          <span>Ropa</span>
        </a>
        <a href="/tienda/jackets/" class="flex items-center gap-2.5 px-3 py-3 min-h-[44px] rounded-lg text-sm font-semibold text-slate-300 hover:text-amber-300 hover:bg-white/5 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 7a6 6 0 0112 0v2l2 2v10H4V11l2-2V7zM9 7V5a3 3 0 016 0v2" />
          </svg>
          <span>Bolsos y Mochilas</span>
        </a>
        <a href="/tienda/tecnologia/" class="flex items-center gap-2.5 px-3 py-3 min-h-[44px] rounded-lg text-sm font-semibold text-slate-300 hover:text-amber-300 hover:bg-white/5 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
          </svg>
          <span>Tecnología</span>
        </a>
        <a href="/tienda/accesorios/" class="flex items-center gap-2.5 px-3 py-3 min-h-[44px] rounded-lg text-sm font-semibold text-slate-300 hover:text-amber-300 hover:bg-white/5 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="7" cy="13" r="3.5" />
            <circle cx="17" cy="13" r="3.5" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 12.5h3M3.5 11l1.5-2h3M14 9h3l1.5 2M10.5 13H7" />
          </svg>
          <span>Accesorios</span>
        </a>
      </div>
    </div>

    <button id="mobile-drawer-cart-btn" class="flex items-center gap-3 px-4 py-3 rounded-xl text-amber-400 font-bold hover:bg-white/5 transition-colors w-full text-left cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l2.4 12.4a2 2 0 002 1.6h7.7a2 2 0 002-1.6L21 7H6" />
        <circle cx="9" cy="20" r="1.5" />
        <circle cx="17" cy="20" r="1.5" />
      </svg>
      <span>Ver Mi Carrito</span>
      <span id="mobile-cart-badge" class="ml-auto bg-orange-500 text-white text-xs px-2 py-0.5 rounded-full font-extrabold">0</span>
    </button>

    <a href="/contact" class="flex items-center gap-3 px-4 py-3 rounded-xl text-white font-bold hover:bg-white/5 hover:text-yellow-400 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
      Contáctanos
    </a>
  </nav>

  <!-- Info tienda en drawer -->
  <div class="absolute bottom-0 left-0 right-0 p-6 border-t border-white/10 bg-[#090b12]">
    <p class="text-xs text-slate-400 mb-1">Visítanos en:</p>
    <a href="https://maps.google.com/?q=Avellaneda+260,+Camaguey,+Cuba" target="_blank" rel="noopener noreferrer" class="text-xs text-amber-400 hover:text-yellow-300 font-medium transition-colors block mb-2 underline-offset-4 hover:underline">
      Avellaneda No. 260, Camagüey
    </a>
    <p class="text-xs text-slate-400">WhatsApp: <a href="https://wa.me/REDACTED_PHONE_1" class="text-white hover:text-yellow-400">+REDACTED_PHONE_1</a></p>
  </div>
</div>

<!-- Drawer del Carrito Lateral -->
<CartDrawer />

<!-- Botón Circular Flotante del Carrito (Accesible en todo momento de navegación) -->
<FloatingCartBtn />

<script>
  import { CartCRUD } from '../utils/cartStore';

  document.addEventListener('DOMContentLoaded', () => {
    // Referencias DOM
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenuClose = document.getElementById('mobile-menu-close');
    const mobileMenuDrawer = document.getElementById('mobile-menu-drawer');
    const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
    const mobileCartBtn = document.getElementById('mobile-drawer-cart-btn');
    const mobileCartBadge = document.getElementById('mobile-cart-badge');
    const scrollProgress = document.getElementById('scroll-progress');

    // Barra de progreso de lectura en scroll
    window.addEventListener('scroll', () => {
      if (scrollProgress) {
        const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (totalHeight > 0) {
          const progress = (window.scrollY / totalHeight) * 100;
          scrollProgress.style.width = `${progress}%`;
        }
      }
    }, { passive: true });

    // Sincronización del badge en el menú drawer móvil
    function updateBadge() {
      const { totalUnits } = CartCRUD.getTotals();
      if (mobileCartBadge) {
        mobileCartBadge.textContent = String(totalUnits);
      }
    }

    function openMobileMenu() {
      if (!mobileMenuDrawer || !mobileMenuOverlay) return;
      mobileMenuOverlay.classList.remove('hidden');
      requestAnimationFrame(() => {
        mobileMenuOverlay.classList.remove('opacity-0');
        mobileMenuDrawer.classList.remove('translate-x-full');
        document.body.style.overflow = 'hidden';
      });
    }

    function closeMobileMenu() {
      if (!mobileMenuDrawer || !mobileMenuOverlay) return;
      mobileMenuOverlay.classList.add('opacity-0');
      mobileMenuDrawer.classList.add('translate-x-full');
      document.body.style.overflow = '';
      setTimeout(() => {
        mobileMenuOverlay.classList.add('hidden');
      }, 300);
    }

    // Eventos táctiles y de clic para apertura/cierre de hamburguesa
    mobileMenuBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      openMobileMenu();
    });

    mobileMenuClose?.addEventListener('click', (e) => {
      e.preventDefault();
      closeMobileMenu();
    });

    mobileMenuOverlay?.addEventListener('click', (e) => {
      e.preventDefault();
      closeMobileMenu();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMobileMenu();
    });

    mobileCartBtn?.addEventListener('click', () => {
      closeMobileMenu();
      setTimeout(() => {
        window.dispatchEvent(new CustomEvent('open-carmay-cart'));
      }, 350);
    });

    window.addEventListener('carmay-cart-changed', updateBadge);
    updateBadge();

    // ====== SMART STICKY HEADER (HEADROOM PATTERN CON TRANSFORM GPU) ======
    // Principio: NUNCA mutar la altura del header (0 reflows, 0 vibración).
    // Se anima exclusivamente transform: translateY(-100%) en la GPU.
    const headerEl = document.getElementById('main-header');
    let lastScrollY = window.scrollY || 0;
    let isHeaderHidden = false;
    let scrollTicking = false;
    const SCROLL_THRESHOLD = 90; // No ocultar en la zona superior de la pantalla
    const SCROLL_TOLERANCE = 8;  // Ignorar micro-vibraciones menores a 8px

    function updateStickyHeader() {
      const currentScrollY = window.scrollY || 0;
      const scrollDiff = currentScrollY - lastScrollY;

      // Si el menú móvil está abierto, mantener siempre visible
      if (mobileMenuDrawer && !mobileMenuDrawer.classList.contains('translate-x-full')) {
        headerEl?.classList.remove('is-hidden');
        isHeaderHidden = false;
        lastScrollY = currentScrollY;
        scrollTicking = false;
        return;
      }

      // 1. Cerca del inicio de la página: SIEMPRE visible
      if (currentScrollY <= SCROLL_THRESHOLD) {
        if (isHeaderHidden) {
          headerEl?.classList.remove('is-hidden');
          isHeaderHidden = false;
        }
        lastScrollY = currentScrollY;
        scrollTicking = false;
        return;
      }

      // 2. Si el movimiento es muy pequeño, ignorar
      if (Math.abs(scrollDiff) < SCROLL_TOLERANCE) {
        scrollTicking = false;
        return;
      }

      // 3. Scroll hacia abajo: ocultar suavemente hacia arriba
      if (scrollDiff > 0 && !isHeaderHidden) {
        headerEl?.classList.add('is-hidden');
        isHeaderHidden = true;
      }
      // 4. Scroll hacia arriba: reaparecer de inmediato
      else if (scrollDiff < 0 && isHeaderHidden) {
        headerEl?.classList.remove('is-hidden');
        isHeaderHidden = false;
      }

      lastScrollY = currentScrollY;
      scrollTicking = false;
    }

    window.addEventListener('scroll', () => {
      if (!scrollTicking) {
        window.requestAnimationFrame(updateStickyHeader);
        scrollTicking = true;
      }
    }, { passive: true });
  });
</script>

<style>
  /* Animación Sticky Acelerada por Hardware (0 Layout Shifts / 0 Vibración) */
  #main-header {
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  #main-header.is-hidden {
    transform: translateY(-100%);
  }
</style>
