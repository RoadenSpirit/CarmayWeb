---
import CartDrawer from './CartDrawer.astro';
import SubNavbar from './SubNavbar.astro';

interface Props {
  showCategoryBar?: boolean;
  activeCategory?: string;
}

const { showCategoryBar = false, activeCategory = '' } = Astro.props;

const storeCategories = [
  { name: "Calzado", slug: "zapatos" },
  { name: "Ropa", slug: "ropa" },
  { name: "Bolsos y Mochilas", slug: "jackets" },
  { name: "Tecnología", slug: "tecnologia" },
  { name: "Accesorios", slug: "accesorios" }
];
---

<header class="sticky top-0 z-50 backdrop-blur-2xl backdrop-saturate-[180%] bg-[#0c0e17]/85 border-b border-white/[0.12] shadow-[0_8px_32px_rgba(0,0,0,0.6),inset_0_1px_0_rgba(255,255,255,0.12)]">
  <!-- Scroll progress bar -->
  <div id="scroll-progress" class="absolute top-0 left-0 h-[2px] bg-gradient-to-r from-yellow-500 via-yellow-400 to-yellow-600 w-0 transition-all duration-75 z-50"></div>

  <!-- Línea inferior de acento amarillo -->
  <div id="header-accent-line" class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-yellow-500/30 to-transparent" style="transition: opacity 0.3s ease-out"></div>

  <!-- ================= PISO 1: MENÚ PRINCIPAL (SIEMPRE FIJO) ================= -->
  <div id="header-main-nav" class="relative z-20">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 sm:h-20 flex items-center justify-between">
      
      <!-- Izquierda: Logo -->
      <div class="flex items-center">
        <a href="/" class="flex items-center group">
          <div class="w-24 h-24 sm:w-28 sm:h-28 flex items-center justify-center group-hover:scale-105 transition-transform">
            <img src="/logo.png" alt="Carmay Outfit" class="w-full h-full object-contain filter drop-shadow-[0_2px_12px_rgba(234,179,8,0.35)]" />
          </div>
        </a>
      </div>

      <!-- CENTRO ABSOLUTO EXACTO DE LA PANTALLA: Enlaces de Navegación entre páginas -->
      <!-- Anclado matemáticamente a left-1/2 -translate-x-1/2 para no ser empujado jamás por el logo o botones -->
      <nav class="hidden md:flex items-center gap-1.5 lg:gap-2 absolute left-1/2 -translate-x-1/2 p-1.5 rounded-full bg-white/[0.03] border border-white/[0.08] shadow-[0_4px_24px_rgba(0,0,0,0.35)] backdrop-blur-md">
        <a 
          href="/" 
          class="px-4 py-1.5 rounded-full text-sm font-bold text-slate-200 hover:text-amber-300 hover:bg-white/[0.06] transition-all"
        >
          Inicio
        </a>
        <a 
          href="/tienda/" 
          class="px-4 py-1.5 rounded-full text-sm font-bold text-slate-200 hover:text-amber-300 hover:bg-white/[0.06] transition-all"
        >
          Tienda
        </a>
        <a 
          href="/contact" 
          class="px-4 py-1.5 rounded-full text-sm font-bold text-slate-200 hover:text-amber-300 hover:bg-white/[0.06] transition-all"
        >
          Contacto
        </a>
      </nav>

      <!-- Derecha: Botón Carrito + WhatsApp + Hamburguesa Móvil -->
      <div class="flex items-center gap-3">
        <!-- Ícono Carrito de Compras -->
        <button id="header-cart-btn" class="relative flex items-center justify-center w-10 h-10 sm:w-11 sm:h-11 rounded-full border border-amber-500/30 bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 hover:scale-105 transition-all shadow-[0_2px_12px_rgba(234,179,8,0.2)] cursor-pointer" aria-label="Ver carrito">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <!-- Badge Contador -->
          <span id="header-cart-count" class="absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-gradient-to-r from-red-600 to-orange-500 text-white text-[10px] font-black flex items-center justify-center shadow-lg border border-white/20">
            0
          </span>
        </button>

        <!-- Píldora sutil: Atención al Cliente -->
        <a 
          href="https://wa.me/REDACTED_PHONE_1" 
          target="_blank" 
          class="inline-flex items-center gap-2 p-2 sm:px-4 sm:py-2 rounded-full border border-white/10 bg-white/[0.04] hover:bg-white/[0.08] hover:border-amber-400/40 text-slate-300 hover:text-white transition-all text-xs sm:text-sm font-medium shadow-sm hover:shadow-md"
          title="Contactar con Atención al Cliente"
          aria-label="Atención al Cliente por WhatsApp"
        >
          <!-- SVG Customer Support -->
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 18v-6a9 9 0 0118 0v6" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3zM3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 16v1a2 2 0 01-2 2h-5" />
          </svg>
          <span class="hidden sm:inline whitespace-nowrap">Atención al cliente</span>
        </a>

        <!-- Botón Hamburguesa (solo móvil) -->
        <button id="mobile-menu-btn" class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg border border-white/10 bg-white/5 hover:bg-white/10 transition-colors" aria-label="Abrir menú">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- ================= PISO 2: MENÚ DE CATEGORÍAS (SIEMPRE FIJO, EN TIENDA / CATÁLOGO) ================= -->
  {showCategoryBar && (
    <nav id="categorias-navbar" class="hidden md:block border-t border-white/[0.08] bg-white/[0.015] shadow-[inset_0_1px_0_rgba(255,255,255,0.02)] relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-center gap-1.5 py-2">
          {storeCategories.map((cat, i) => (
            <div class="flex items-center">
              {i > 0 && <div class="h-3.5 mx-1.5" style="width: 1px; background: linear-gradient(to bottom, transparent, rgba(234,179,8,0.3), transparent);"></div>}
              <a
                href={`/tienda/${cat.slug}/`}
                class={`text-xs sm:text-sm font-bold tracking-wide transition-all px-3 py-1 rounded-lg ${
                  cat.slug === activeCategory 
                    ? 'text-yellow-400 bg-yellow-400/10 border border-yellow-400/30 shadow-[0_0_12px_rgba(234,179,8,0.15)]' 
                    : 'text-slate-300 hover:text-yellow-400 hover:bg-white/[0.04]'
                }`}
              >
                {cat.name}
              </a>
            </div>
          ))}
        </div>
      </div>
    </nav>
  )}

  <!-- ================= PISO 3: MENÚ BUSCADOR + CARRUSEL (ÚLTIMO, COLAPSABLE AL SCROLL) ================= -->
  <div id="subnav-collapsible" class="subnav-grid">
    <div class="subnav-grid-inner">
      <SubNavbar />
    </div>
  </div>
</header>

<!-- Drawer Móvil -->
<div id="mobile-menu-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] hidden opacity-0 transition-opacity duration-300"></div>
<div id="mobile-menu-drawer" class="fixed top-0 right-0 h-full w-72 bg-[#0e1019]/95 backdrop-blur-2xl border-l border-white/10 z-[70] transform translate-x-full transition-transform duration-300 ease-out">
  <!-- Botón Cerrar -->
  <div class="flex items-center justify-end p-5">
    <button id="mobile-menu-close" class="flex items-center justify-center w-10 h-10 rounded-lg border border-white/10 bg-white/5 hover:bg-white/10 transition-colors" aria-label="Cerrar menú">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Logo en drawer -->
  <div class="px-6 pb-6 border-b border-white/10">
    <a href="/" class="flex items-center gap-3">
      <img src="/logo.png" alt="Carmay Outfit" class="w-12 h-12 object-contain" />
      <span class="text-lg font-extrabold text-white">CARMAY OUTFIT</span>
    </a>
  </div>

  <!-- Enlaces de navegación -->
  <nav class="flex flex-col p-6 gap-2 overflow-y-auto max-h-[calc(100vh-180px)] scrollbar-hide">
    <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-xl text-white font-bold hover:bg-white/5 hover:text-yellow-400 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      Inicio
    </a>
    <a href="/tienda/" class="flex items-center gap-3 px-4 py-3 rounded-xl text-white font-bold hover:bg-white/5 hover:text-yellow-400 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
      </svg>
      Tienda (Todo el Catálogo)
    </a>

    <!-- SECCIÓN CATEGORÍAS DENTRO DEL MENÚ MÓVIL -->
    <div class="my-2 pt-3 pb-1 border-t border-b border-white/10">
      <span class="text-[10px] font-black uppercase tracking-widest text-amber-400/90 px-4 mb-2 block">
        Categorías
      </span>
      <div class="flex flex-col gap-1 pl-2">
        <a href="/tienda/zapatos/" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-semibold text-slate-300 hover:text-amber-300 hover:bg-white/5 transition-colors">
          <span class="text-xs">👟</span>
          <span>Calzado</span>
        </a>
        <a href="/tienda/ropa/" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-semibold text-slate-300 hover:text-amber-300 hover:bg-white/5 transition-colors">
          <span class="text-xs">👗</span>
          <span>Ropa</span>
        </a>
        <a href="/tienda/jackets/" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-semibold text-slate-300 hover:text-amber-300 hover:bg-white/5 transition-colors">
          <span class="text-xs">🎒</span>
          <span>Bolsos y Mochilas</span>
        </a>
        <a href="/tienda/tecnologia/" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-semibold text-slate-300 hover:text-amber-300 hover:bg-white/5 transition-colors">
          <span class="text-xs">⚡</span>
          <span>Tecnología</span>
        </a>
        <a href="/tienda/accesorios/" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-semibold text-slate-300 hover:text-amber-300 hover:bg-white/5 transition-colors">
          <span class="text-xs">🕶️</span>
          <span>Accesorios</span>
        </a>
      </div>
    </div>

    <button id="mobile-drawer-cart-btn" class="flex items-center gap-3 px-4 py-3 rounded-xl text-amber-400 font-bold hover:bg-white/5 transition-colors w-full text-left cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
      </svg>
      <span>Ver Mi Carrito</span>
      <span id="mobile-cart-badge" class="ml-auto bg-orange-500 text-white text-xs px-2 py-0.5 rounded-full font-extrabold">0</span>
    </button>
    <a href="/contact" class="flex items-center gap-3 px-4 py-3 rounded-xl text-white font-bold hover:bg-white/5 hover:text-yellow-400 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
      Contacto
    </a>
  </nav>

  <!-- Botón WhatsApp / Atención al Cliente en drawer -->
  <div class="px-6 pb-6">
    <a href="https://wa.me/REDACTED_PHONE_1" target="_blank" class="flex items-center justify-center gap-2.5 w-full bg-white/[0.06] hover:bg-white/[0.1] text-slate-200 hover:text-white px-5 py-3 rounded-xl text-sm font-medium transition-all border border-white/10 shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 18v-6a9 9 0 0118 0v6" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3zM3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 16v1a2 2 0 01-2 2h-5" />
      </svg>
      <span>Atención al cliente</span>
    </a>
  </div>
</div>

<!-- Componente Panel Lateral Deslizante -->
<CartDrawer />

<script>
  import { CartCRUD } from '../utils/cartStore';

  // Expone la altura real del header (fila principal + SubNavbar) como var CSS
  // para que los navbars fijos y paddings de las páginas queden siempre debajo.
  function syncHeaderHeight() {
    const header = document.querySelector('header');
    if (header) {
      document.documentElement.style.setProperty('--headerh', header.offsetHeight + 'px');
    }
  }
  window.addEventListener('load', syncHeaderHeight);
  window.addEventListener('resize', syncHeaderHeight);
  document.addEventListener('DOMContentLoaded', syncHeaderHeight);

  function updateBadge() {
    const { totalUnits } = CartCRUD.getTotals();
    const countEl = document.getElementById('header-cart-count');
    const mobileCountEl = document.getElementById('mobile-cart-badge');

    function animateBadge(el: HTMLElement | null) {
      if (!el) return;
      el.textContent = String(totalUnits);
      el.classList.add('scale-125', 'brightness-125');
      setTimeout(() => {
        el.classList.remove('scale-125', 'brightness-125');
      }, 250);
    }

    animateBadge(countEl);
    animateBadge(mobileCountEl);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const cartBtn = document.getElementById('header-cart-btn');
    const mobileCartBtn = document.getElementById('mobile-drawer-cart-btn');
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenuClose = document.getElementById('mobile-menu-close');
    const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
    const mobileMenuDrawer = document.getElementById('mobile-menu-drawer');

    function openMobileMenu() {
      if (!mobileMenuDrawer || !mobileMenuOverlay) return;
      mobileMenuOverlay.classList.remove('hidden');
      requestAnimationFrame(() => {
        mobileMenuOverlay.classList.remove('opacity-0');
        mobileMenuDrawer.classList.remove('translate-x-full');
        document.body.style.overflow = 'hidden';
      });
    }

    function closeMobileMenu() {
      if (!mobileMenuDrawer || !mobileMenuOverlay) return;
      mobileMenuOverlay.classList.add('opacity-0');
      mobileMenuDrawer.classList.add('translate-x-full');
      document.body.style.overflow = '';
      setTimeout(() => {
        mobileMenuOverlay.classList.add('hidden');
      }, 300);
    }

    // Eventos táctiles y de clic para apertura/cierre de hamburguesa
    mobileMenuBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      openMobileMenu();
    });

    mobileMenuClose?.addEventListener('click', (e) => {
      e.preventDefault();
      closeMobileMenu();
    });

    mobileMenuOverlay?.addEventListener('click', (e) => {
      e.preventDefault();
      closeMobileMenu();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMobileMenu();
    });

    cartBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-carmay-cart'));
    });

    mobileCartBtn?.addEventListener('click', () => {
      closeMobileMenu();
      setTimeout(() => {
        window.dispatchEvent(new CustomEvent('open-carmay-cart'));
      }, 350);
    });

    window.addEventListener('carmay-cart-changed', updateBadge);
    updateBadge();

    // ====== COLAPSO SUAVE DEL SUBNAV (BUSCADOR/CARRUSEL) AL SCROLL ======
    // El Piso 1 (Menú Principal) y el Piso 2 (Categorías) permanecen SIEMPRE fijos.
    // Solo el Piso 3 (SubNavbar) colapsa hacia arriba, eliminando cualquier vibración.
    const subnavCollapsible = document.getElementById('subnav-collapsible');
    let isTransitioning = false;
    let transitionTimer: any = null;
    const TOP_DEADZONE = 80; // Dentro de los primeros 80px siempre expandido

    function lockTransition() {
      isTransitioning = true;
      if (transitionTimer) clearTimeout(transitionTimer);
      transitionTimer = setTimeout(() => {
        isTransitioning = false;
        syncHeaderHeight();
      }, 480); // Duración de transición + margen seguro
    }

    function collapseSubnav() {
      if (!subnavCollapsible || subnavCollapsible.classList.contains('is-collapsed')) return;
      subnavCollapsible.classList.add('is-collapsed');
      lockTransition();
    }

    function expandSubnav() {
      if (!subnavCollapsible || !subnavCollapsible.classList.contains('is-collapsed')) return;
      subnavCollapsible.classList.remove('is-collapsed');
      lockTransition();
    }

    // 1. Detección por Rueda del Ratón (Desktop):
    // deltaY da la intención directa del usuario antes del reflow y NO produce bucles de layout
    window.addEventListener('wheel', (e) => {
      if (isTransitioning) return;
      const currentY = window.scrollY;

      if (currentY <= TOP_DEADZONE) {
        expandSubnav();
        return;
      }

      if (e.deltaY > 15) {
        collapseSubnav();
      } else if (e.deltaY < -15) {
        expandSubnav();
      }
    }, { passive: true });

    // 2. Detección por Gesto Táctil (Móvil):
    let touchStartY = 0;
    window.addEventListener('touchstart', (e) => {
      touchStartY = e.touches[0].clientY;
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
      if (isTransitioning) return;
      const currentY = window.scrollY;
      const touchCurrentY = e.touches[0].clientY;
      const dy = touchStartY - touchCurrentY; // dy > 0: arrastre hacia arriba (pantalla baja)

      if (currentY <= TOP_DEADZONE) {
        expandSubnav();
        return;
      }

      if (dy > 20) {
        collapseSubnav();
      } else if (dy < -20) {
        expandSubnav();
      }
    }, { passive: true });

    // 3. Respaldo para cuando el scroll vuelve a la cima
    window.addEventListener('scroll', () => {
      if (window.scrollY <= TOP_DEADZONE) {
        expandSubnav();
      }
    }, { passive: true });
  });
</script>

<style>
  /* Animación CSS Grid Row Interpolation con GPU Easing para el Piso 3 */
  .subnav-grid {
    display: grid;
    grid-template-rows: 1fr;
    opacity: 1;
    transition: grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.38s ease-out;
    will-change: grid-template-rows, opacity;
  }

  .subnav-grid.is-collapsed {
    grid-template-rows: 0fr;
    opacity: 0;
    pointer-events: none;
  }

  .subnav-grid-inner {
    min-height: 0;
    overflow: visible;
  }

  .subnav-grid.is-collapsed > .subnav-grid-inner {
    overflow: hidden;
  }
</style>