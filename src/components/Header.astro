---
---

<header class="sticky top-0 z-50 backdrop-blur-xl bg-[#0e1019]/85 border-b border-white/[0.08] shadow-[0_4px_30px_rgba(0,0,0,0.5)] transition-all duration-300">
  <!-- Scroll progress bar -->
  <div id="scroll-progress" class="absolute top-0 left-0 h-[2px] bg-gradient-to-r from-yellow-500 via-yellow-400 to-yellow-600 w-0 transition-all duration-75 z-50"></div>

  <!-- Línea inferior de acento amarillo -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-yellow-500/30 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 sm:h-24 flex items-center justify-between">
    
    <!-- Logo -->
    <a href="/" class="flex items-center group">
      <div class="w-28 h-28 sm:w-32 sm:h-32 flex items-center justify-center group-hover:scale-105 transition-transform">
        <img src="/logo.png" alt="Carmay Outfit" class="w-full h-full object-contain filter drop-shadow-[0_2px_12px_rgba(234,179,8,0.35)]" />
      </div>
    </a>

    <!-- Navegación Escritorio -->
    <nav class="hidden md:flex items-center gap-8 text-base sm:text-lg font-bold">
      <a href="/" class="text-slate-200 hover:text-yellow-400 hover:underline hover:underline-offset-8 hover:decoration-yellow-400 hover:decoration-2 transition-all drop-shadow-[0_1px_4px_rgba(255,255,255,0.05)]">Inicio</a>
      <a href="/store/" class="text-slate-200 hover:text-yellow-400 hover:underline hover:underline-offset-8 hover:decoration-yellow-400 hover:decoration-2 transition-all drop-shadow-[0_1px_4px_rgba(255,255,255,0.05)]">Tienda</a>
      <a href="/contact" class="text-slate-200 hover:text-yellow-400 hover:underline hover:underline-offset-8 hover:decoration-yellow-400 hover:decoration-2 transition-all drop-shadow-[0_1px_4px_rgba(255,255,255,0.05)]">Contacto</a>
    </nav>

    <!-- Botón WhatsApp -->
    <div class="flex items-center gap-3">
      <a href="https://wa.me/53REDACTED_PHONE_1" target="_blank" class="inline-flex items-center gap-2 bg-gradient-to-r from-yellow-600 to-yellow-700 hover:from-yellow-500 hover:to-yellow-500 text-white px-4 sm:px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold shadow-[0_4px_15px_rgba(234,179,8,0.25),inset_0_1px_0_rgba(255,255,255,0.15)] hover:shadow-[0_6px_25px_rgba(234,179,8,0.35)] hover:-translate-y-0.5 transition-all border border-yellow-500/20">
        <span>💬 WhatsApp</span>
      </a>
    </div>

  </div>
</header>

<script>
  // Scroll progress bar
  window.addEventListener('scroll', function() {
    const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
    const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const progress = (scrollTop / scrollHeight) * 100;
    const progressBar = document.getElementById('scroll-progress');
    if (progressBar) progressBar.style.width = progress + '%';
  });
</script>