---
import CartDrawer from './CartDrawer.astro';
import SubNavbar from './SubNavbar.astro';
import SearchBar from './SearchBar.astro';
import FloatingCartBtn from './FloatingCartBtn.astro';
import CategoryNav from './header/CategoryNav.astro';
import MobileDrawer from './header/MobileDrawer.astro';

interface Props {
  showCategoryBar?: boolean;
  activeCategory?: string;
}

const { showCategoryBar = false, activeCategory = '' } = Astro.props;
---

<header 
  id="main-header" 
  class="sticky top-0 z-50 backdrop-blur-2xl backdrop-saturate-[180%] bg-[#0c0e17]/90 border-b border-white/[0.12] shadow-[0_8px_32px_rgba(0,0,0,0.6),inset_0_1px_0_rgba(255,255,255,0.12)]"
>
  <!-- Scroll progress bar -->
  <div id="scroll-progress" class="absolute top-0 left-0 h-[2px] bg-gradient-to-r from-yellow-500 via-yellow-400 to-yellow-600 w-0 transition-all duration-75 z-50"></div>

  <!-- Línea inferior de acento amarillo -->
  <div id="header-accent-line" class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-yellow-500/30 to-transparent pointer-events-none"></div>

  <!-- ================= PISO SUPERIOR: CARRUSEL DE VALOR ================= -->
  <div id="header-top-value-bar" class="relative z-30">
    <SubNavbar />
  </div>

  <!-- ================= PISO PRINCIPAL: LOGO (IZQ) + NAVEGACIÓN (CENTRO ABSOLUTO) + BUSCADOR (DER) ================= -->
  <div id="header-main-nav" class="relative z-20">
    <div class="relative max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-18 sm:h-20 flex items-center justify-between gap-3 sm:gap-4">
      
      <!-- 1. Logo orientado a la esquina izquierda (ampliado, nítido y de gran presencia sin bordes vacíos) -->
      <div class="flex items-center shrink-0">
        <a href="/" class="flex items-center group py-1" aria-label="Carmay Outfit - Ir al Inicio">
          <img 
            src="/logo-clean.png" 
            alt="Carmay Outfit" 
            width="305" 
            height="238" 
            class="h-12 sm:h-14 md:h-[66px] w-auto object-contain group-hover:scale-105 transition-transform duration-200" 
            loading="eager"
            fetchpriority="high"
          />
        </a>
      </div>

      <!-- 2. Menú de Navegación en el CENTRO ABSOLUTO de la pantalla (Desktop) -->
      <nav class="hidden md:flex items-center gap-1.5 lg:gap-2 p-1.5 rounded-full bg-white/[0.03] border border-white/[0.08] shadow-[0_4px_24px_rgba(0,0,0,0.35)] backdrop-blur-md absolute left-1/2 -translate-x-1/2 z-30">
        <a 
          href="/" 
          class="px-4 py-1.5 rounded-full text-xs lg:text-sm font-bold text-slate-200 hover:text-amber-300 hover:bg-white/[0.06] transition-all"
        >
          Inicio
        </a>
        <a 
          href="/tienda/" 
          class="px-4 py-1.5 rounded-full text-xs lg:text-sm font-bold text-slate-200 hover:text-amber-300 hover:bg-white/[0.06] transition-all"
        >
          Catálogo
        </a>
        <a 
          href="/contact/" 
          class="px-4 py-1.5 rounded-full text-xs lg:text-sm font-bold text-slate-200 hover:text-amber-300 hover:bg-white/[0.06] transition-all"
        >
          Contáctanos
        </a>
      </nav>

      <!-- 3. Buscador Orientado a la Esquina Derecha en Desktop (Central en Móvil) -->
      <div class="flex-1 md:flex-initial md:w-72 lg:w-80 min-w-0 md:ml-auto">
        <SearchBar />
      </div>

      <!-- 4. En Móvil: Botón Hamburguesa -->
      <button id="mobile-menu-btn" class="md:hidden flex items-center justify-center w-11 h-11 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 hover:border-amber-400/40 transition-all cursor-pointer shrink-0" aria-label="Abrir menú de navegación">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>
  </div>

  <!-- ================= BARRA LIGERA DE CATEGORÍAS (Módulo Atómico) ================= -->
  {showCategoryBar && <CategoryNav activeCategory={activeCategory} />}
</header>

<!-- Drawer Móvil (Módulo Atómico) -->
<MobileDrawer />

<!-- Drawer del Carrito Lateral -->
<CartDrawer />

<!-- Botón Circular Flotante del Carrito (Accesible en todo momento de navegación) -->
<FloatingCartBtn />

<script>
  import { CartCRUD } from '../utils/cartStore';

  document.addEventListener('DOMContentLoaded', () => {
    // Referencias DOM
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenuClose = document.getElementById('mobile-menu-close');
    const mobileMenuDrawer = document.getElementById('mobile-menu-drawer');
    const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
    const mobileCartBtn = document.getElementById('mobile-drawer-cart-btn');
    const mobileCartBadge = document.getElementById('mobile-cart-badge');
    const scrollProgress = document.getElementById('scroll-progress');

    // Barra de progreso de lectura en scroll
    window.addEventListener('scroll', () => {
      if (scrollProgress) {
        const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (totalHeight > 0) {
          const progress = (window.scrollY / totalHeight) * 100;
          scrollProgress.style.width = `${progress}%`;
        }
      }
    }, { passive: true });

    // Sincronización del badge en el menú drawer móvil
    function updateBadge() {
      const { totalUnits } = CartCRUD.getTotals();
      if (mobileCartBadge) {
        mobileCartBadge.textContent = String(totalUnits);
      }
    }

    function openMobileMenu() {
      if (!mobileMenuDrawer || !mobileMenuOverlay) return;
      mobileMenuOverlay.classList.remove('hidden');
      requestAnimationFrame(() => {
        mobileMenuOverlay.classList.remove('opacity-0');
        mobileMenuDrawer.classList.remove('translate-x-full');
        document.body.style.overflow = 'hidden';
      });
    }

    function closeMobileMenu() {
      if (!mobileMenuDrawer || !mobileMenuOverlay) return;
      mobileMenuOverlay.classList.add('opacity-0');
      mobileMenuDrawer.classList.add('translate-x-full');
      document.body.style.overflow = '';
      setTimeout(() => {
        mobileMenuOverlay.classList.add('hidden');
      }, 300);
    }

    // Eventos táctiles y de clic para apertura/cierre de hamburguesa
    mobileMenuBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      openMobileMenu();
    });

    mobileMenuClose?.addEventListener('click', (e) => {
      e.preventDefault();
      closeMobileMenu();
    });

    mobileMenuOverlay?.addEventListener('click', (e) => {
      e.preventDefault();
      closeMobileMenu();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMobileMenu();
    });

    mobileCartBtn?.addEventListener('click', () => {
      closeMobileMenu();
      setTimeout(() => {
        window.dispatchEvent(new CustomEvent('open-carmay-cart'));
      }, 350);
    });

    window.addEventListener('carmay-cart-changed', updateBadge);
    updateBadge();

    // ====== SMART STICKY HEADER (HEADROOM PATTERN CON TRANSFORM GPU) ======
    // Principio: NUNCA mutar la altura del header (0 reflows, 0 vibración).
    // Se anima exclusivamente transform: translateY(-100%) en la GPU.
    const headerEl = document.getElementById('main-header');
    let lastScrollY = window.scrollY || 0;
    let isHeaderHidden = false;
    let scrollTicking = false;
    const SCROLL_THRESHOLD = 90; // No ocultar en la zona superior de la pantalla
    const SCROLL_TOLERANCE = 8;  // Ignorar micro-vibraciones menores a 8px

    function updateStickyHeader() {
      const currentScrollY = window.scrollY || 0;
      const scrollDiff = currentScrollY - lastScrollY;

      // Si el menú móvil está abierto, mantener siempre visible
      if (mobileMenuDrawer && !mobileMenuDrawer.classList.contains('translate-x-full')) {
        headerEl?.classList.remove('is-hidden');
        isHeaderHidden = false;
        lastScrollY = currentScrollY;
        scrollTicking = false;
        return;
      }

      // 1. Cerca del inicio de la página: SIEMPRE visible
      if (currentScrollY <= SCROLL_THRESHOLD) {
        if (isHeaderHidden) {
          headerEl?.classList.remove('is-hidden');
          isHeaderHidden = false;
        }
        lastScrollY = currentScrollY;
        scrollTicking = false;
        return;
      }

      // 2. Si el movimiento es muy pequeño, ignorar
      if (Math.abs(scrollDiff) < SCROLL_TOLERANCE) {
        scrollTicking = false;
        return;
      }

      // 3. Scroll hacia abajo: ocultar suavemente hacia arriba
      if (scrollDiff > 0 && !isHeaderHidden) {
        headerEl?.classList.add('is-hidden');
        isHeaderHidden = true;
      }
      // 4. Scroll hacia arriba: reaparecer de inmediato
      else if (scrollDiff < 0 && isHeaderHidden) {
        headerEl?.classList.remove('is-hidden');
        isHeaderHidden = false;
      }

      lastScrollY = currentScrollY;
      scrollTicking = false;
    }

    window.addEventListener('scroll', () => {
      if (!scrollTicking) {
        window.requestAnimationFrame(updateStickyHeader);
        scrollTicking = true;
      }
    }, { passive: true });
  });
</script>

<style>
  /* Animación Sticky Acelerada por Hardware (0 Layout Shifts / 0 Vibración) */
  #main-header {
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  #main-header.is-hidden {
    transform: translateY(-100%);
  }
</style>
