---
// FAQ.astro: Preguntas frecuentes con respuestas directas en una sola oración concisa y amena
const faqs = [
  {
    question: "¿Qué garantía tienen los productos que compro?",
    answer: "En la tienda la única garantía que ofrecemos es que los equipos son nuevos en su caja y se prueban junto a ti al momento de la compra, por lo que no se aceptan devoluciones posteriores."
  },
  {
    question: "¿Qué tipo de artículos incluye el catálogo?",
    answer: "Reunimos desde lo último en moda, calzado y accesorios de tendencia hasta tecnología de vanguardia como estaciones EcoFlow, Smart TVs y motos eléctricas probadas en tienda."
  },
  {
    question: "¿Dónde está la tienda física y cuáles son los horarios?",
    answer: "Te esperamos en Calle Avellaneda No. 260 entre San Esteban y San Martín, de lunes a viernes de 8:30 AM a 4:30 PM y sábados de 8:30 AM a 2:00 PM."
  },
  {
    question: "¿Cómo compro online y cómo son las entregas?",
    answer: "Eliges tus productos en la web, confirmas tu pedido por WhatsApp y te lo entregamos el mismo día directo a la puerta de tu casa en Camagüey o lo recoges en nuestro local."
  }
];
---

<section class="py-16 sm:py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center mb-10 sm:mb-12 reveal-on-scroll">
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight" style="font-family: 'Outfit', sans-serif;">
      Preguntas Frecuentes
    </h2>
    <p class="text-amber-400 font-bold text-xs sm:text-sm uppercase tracking-widest block mt-2">Respuestas claras y al grano</p>
  </div>

  <div class="space-y-3.5">
    {faqs.map((faq, idx) => (
      <details class={`glass-card rounded-2xl p-5 sm:p-6 border border-white/10 group transition-all duration-300 reveal-on-scroll reveal-delay-${idx + 1}`}>
        <summary class="font-bold text-white text-base sm:text-lg cursor-pointer flex items-center justify-between select-none">
          <span class="flex items-center gap-3">
            <span class="text-amber-400 font-black font-mono">0{idx + 1}.</span>
            <span>{faq.question}</span>
          </span>
          <span class="text-purple-400 group-open:rotate-180 transition-transform text-xl shrink-0 ml-2">↓</span>
        </summary>
        <p class="text-slate-200 text-sm sm:text-base mt-3 pl-8 leading-relaxed font-normal">
          {faq.answer}
        </p>
      </details>
    ))}
  </div>
</section>
