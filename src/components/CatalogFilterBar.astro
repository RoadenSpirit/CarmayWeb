---
interface Props {
  minPriceCUP?: number;
  maxPriceCUP?: number;
  totalProducts?: number;
}

const {
  minPriceCUP = 0,
  maxPriceCUP = 350000,
  totalProducts = 0
} = Astro.props;
---

<!-- Barra de Filtros Refinada: Slider Dual espacioso a ancho completo + Inputs libres en CUP + Píldoras de Tags -->
<div id="catalog-filter-bar" class="w-full bg-[#0d0f1a] border border-white/[0.08] rounded-3xl p-5 sm:p-7 shadow-[0_8px_32px_rgba(0,0,0,0.4)] mb-10">
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">

    <!-- FILA / COLUMNA 1: Píldoras de Tags Clickeables + Contador Limpio -->
    <div class="flex flex-wrap items-center gap-3">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Filtrar:</span>
      
      <!-- Píldora En Rebaja -->
      <button
        type="button"
        id="filter-tag-sale"
        class="filter-tag-btn group relative inline-flex items-center gap-2 px-4 py-3.5 rounded-2xl text-xs font-semibold transition-all duration-200 active:scale-95 border border-white/10 bg-white/[0.03] text-slate-200 hover:bg-white/[0.08] hover:border-amber-400/40 cursor-pointer select-none"
        data-active="false"
      >
        <span class="w-2 h-2 rounded-full bg-rose-500/80 group-hover:scale-125 transition-transform"></span>
        <span>En Rebaja</span>
      </button>

      <!-- Píldora Tendencias -->
      <button
        type="button"
        id="filter-tag-trending"
        class="filter-tag-btn group relative inline-flex items-center gap-2 px-4 py-3.5 rounded-2xl text-xs font-semibold transition-all duration-200 active:scale-95 border border-white/10 bg-white/[0.03] text-slate-200 hover:bg-white/[0.08] hover:border-purple-400/40 cursor-pointer select-none"
        data-active="false"
      >
        <span class="w-2 h-2 rounded-full bg-amber-400/80 group-hover:scale-125 transition-transform"></span>
        <span>Tendencias</span>
      </button>

      <!-- Píldora de Búsqueda Activa (visible dinámicamente si hay ?s= o búsqueda) -->
      <div 
        id="filter-search-badge" 
        class="hidden inline-flex items-center gap-2 px-3.5 py-1 min-h-[44px] rounded-2xl text-xs font-semibold border border-amber-400/40 bg-amber-400/10 text-amber-200 select-none shadow-[0_2px_12px_rgba(245,158,11,0.2)]"
      >
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span>Búsqueda: <strong id="filter-search-query-text" class="text-white font-bold"></strong></span>
        <button 
          type="button" 
          id="filter-search-clear-badge" 
          class="hover:text-white hover:bg-white/20 w-11 h-11 flex items-center justify-center rounded-full cursor-pointer ml-1 transition-colors" 
          title="Quitar búsqueda"
          aria-label="Quitar búsqueda"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Botón Limpiar filtros (se muestra cuando hay filtros activos) -->
      <button
        type="button"
        id="filter-reset-btn"
        class="hidden text-xs text-amber-400 hover:text-amber-300 font-semibold cursor-pointer transition-all duration-200 active:scale-95 min-h-[44px] inline-flex items-center gap-1.5 px-4 py-3 rounded-xl bg-amber-500/10 border border-amber-500/20"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span>Limpiar filtros</span>
      </button>

      <!-- Contador dinámico discreto -->
      <span id="filter-results-count" class="text-xs font-mono font-bold text-slate-400 ml-auto sm:ml-2">
        {totalProducts} productos
      </span>
    </div>

    <!-- FILA / COLUMNA 2: Selector de Presupuesto CUP Espacioso con Slider a Ancho Completo -->
    <div class="w-full lg:w-[480px] flex flex-col gap-3.5 bg-white/[0.02] border border-white/[0.06] rounded-2xl p-4 sm:p-5">
      
      <!-- Encabezado de Presupuesto con Rango Visible -->
      <div class="flex items-center justify-between gap-3">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Presupuesto (CUP)</span>
        <span id="price-range-label" class="text-xs font-mono font-black text-amber-400">
          {minPriceCUP.toLocaleString('en-US')} – {maxPriceCUP.toLocaleString('en-US')} CUP
        </span>
      </div>

      <!-- Barra de Slider Dual a Ancho Completo (Sin aplastamiento) -->
      <div class="relative flex items-center w-full h-11 px-1 my-1">
        <!-- Pista base -->
        <div class="absolute left-0 right-0 h-2 bg-white/10 rounded-full"></div>
        <!-- Pista activa iluminada en degradado morado a dorado -->
        <div 
          id="slider-track-highlight" 
          class="absolute h-2 bg-gradient-to-r from-[#6d1e68] to-[#D4AF37] rounded-full pointer-events-none" 
          style="left: 0%; right: 0%;"
        ></div>

        <!-- Manilla Slider 1: Mínimo -->
        <input 
          type="range" 
          id="price-slider-min" 
          min={minPriceCUP} 
          max={maxPriceCUP} 
          value={minPriceCUP} 
          step="500"
          class="dual-range-input absolute inset-0 w-full h-full cursor-pointer z-20"
          aria-label="Ajustar presupuesto mínimo en CUP"
        />

        <!-- Manilla Slider 2: Máximo -->
        <input 
          type="range" 
          id="price-slider-max" 
          min={minPriceCUP} 
          max={maxPriceCUP} 
          value={maxPriceCUP} 
          step="500"
          class="dual-range-input absolute inset-0 w-full h-full cursor-pointer z-20"
          aria-label="Ajustar presupuesto máximo en CUP"
        />
      </div>

      <!-- Fila de Inputs Numéricos Libres (Desde - Hasta) -->
      <div class="flex items-center justify-between gap-3 pt-1">
        <!-- Input Mínimo Libre -->
        <div class="flex-1 flex items-center gap-2 bg-[#090b11] border border-white/15 rounded-xl px-3 py-1 focus-within:border-amber-400/80 transition-colors">
          <span class="text-xs text-slate-400 font-medium">Desde:</span>
          <span class="text-xs text-slate-400 font-mono">$</span>
          <input
            type="number"
            id="price-min-input"
            value={minPriceCUP}
            step="100"
            class="w-full min-w-[44px] bg-transparent text-xs text-slate-100 font-mono font-bold focus:outline-none text-right py-3.5"
            placeholder="0"
            aria-label="Presupuesto mínimo en CUP"
          />
        </div>

        <span class="text-slate-500 font-bold text-xs">–</span>

        <!-- Input Máximo Libre -->
        <div class="flex-1 flex items-center gap-2 bg-[#090b11] border border-white/15 rounded-xl px-3 py-1 focus-within:border-amber-400/80 transition-colors">
          <span class="text-xs text-slate-400 font-medium">Hasta:</span>
          <span class="text-xs text-slate-400 font-mono">$</span>
          <input
            type="number"
            id="price-max-input"
            value={maxPriceCUP}
            step="100"
            class="w-full min-w-[44px] bg-transparent text-xs text-slate-100 font-mono font-bold focus:outline-none text-right py-3.5"
            placeholder={maxPriceCUP.toString()}
            aria-label="Presupuesto máximo en CUP"
          />
        </div>
      </div>

    </div>

  </div>
</div>

<style>
  /* Quitar spinners de inputs numéricos */
  input[type=number]::-webkit-inner-spin-button, 
  input[type=number]::-webkit-outer-spin-button { 
    -webkit-appearance: none; 
    margin: 0; 
  }
  input[type=number] {
    -moz-appearance: textfield;
  }

  /* Estilos nativos para el Slider Dual Superpuesto */
  .dual-range-input {
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    pointer-events: none;
  }

  /* Manillas amplias con excelente respuesta táctil */
  .dual-range-input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #f59e0b;
    border: 3px solid #f3f4f6;
    box-shadow: 0 4px 12px #090b11;
    cursor: grab;
    pointer-events: auto;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .dual-range-input::-webkit-slider-thumb:hover {
    transform: scale(1.15);
    background: #F5D76B;
  }

  .dual-range-input::-webkit-slider-thumb:active {
    cursor: grabbing;
    transform: scale(1.25);
    background: #D4AF37;
  }

  .dual-range-input::-moz-range-thumb {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #f59e0b;
    border: 3px solid #f3f4f6;
    box-shadow: 0 4px 12px #090b11;
    cursor: grab;
    pointer-events: auto;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .dual-range-input::-moz-range-thumb:hover {
    transform: scale(1.15);
    background: #F5D76B;
  }

  .dual-range-input::-moz-range-thumb:active {
    cursor: grabbing;
    transform: scale(1.25);
    background: #D4AF37;
  }
</style>

<!-- Script interactivo de filtrado instantáneo por CUP con Range Slider Dual y Búsqueda -->
<script>
  import { SearchEngine } from '../utils/searchEngine';

  function initCatalogFilter() {
    const tagSaleBtn = document.getElementById('filter-tag-sale');
    const tagTrendingBtn = document.getElementById('filter-tag-trending');
    const searchBadge = document.getElementById('filter-search-badge');
    const searchQueryText = document.getElementById('filter-search-query-text');
    const searchClearBadge = document.getElementById('filter-search-clear-badge');
    const minInput = document.getElementById('price-min-input') as HTMLInputElement | null;
    const maxInput = document.getElementById('price-max-input') as HTMLInputElement | null;
    const sliderMin = document.getElementById('price-slider-min') as HTMLInputElement | null;
    const sliderMax = document.getElementById('price-slider-max') as HTMLInputElement | null;
    const sliderTrack = document.getElementById('slider-track-highlight');
    const priceLabel = document.getElementById('price-range-label');
    const resetBtn = document.getElementById('filter-reset-btn');
    const countEl = document.getElementById('filter-results-count');
    const emptyStateEl = document.getElementById('filter-empty-state');
    const emptyResetBtn = document.getElementById('empty-state-reset-btn');

    const defaultSliderMin = parseFloat(sliderMin?.getAttribute('min') || '0');
    const defaultSliderMax = parseFloat(sliderMax?.getAttribute('max') || '350000');

    let filterSale = false;
    let filterTrending = false;
    let minPrice = defaultSliderMin;
    let maxPrice = defaultSliderMax;

    // Leer parámetros iniciales de URL
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('rebaja') === 'true') filterSale = true;
    if (urlParams.get('tendencia') === 'true') filterTrending = true;
    if (urlParams.get('min_cup')) minPrice = parseFloat(urlParams.get('min_cup') || '') || defaultSliderMin;
    if (urlParams.get('max_cup')) maxPrice = parseFloat(urlParams.get('max_cup') || '') || defaultSliderMax;
    let searchFilter = (urlParams.get('s') || urlParams.get('q') || '').trim();

    if (minInput) minInput.value = minPrice.toString();
    if (maxInput) maxInput.value = maxPrice.toString();
    if (sliderMin) sliderMin.value = Math.min(minPrice, defaultSliderMax).toString();
    if (sliderMax) sliderMax.value = Math.min(maxPrice, defaultSliderMax).toString();

    // Cache local de SearchEngine
    let catalogEngineInstance: SearchEngine | null = null;
    function getCatalogSearchEngine(): SearchEngine | null {
      if (catalogEngineInstance) return catalogEngineInstance;
      const dataEl = document.getElementById('catalog-data');
      if (!dataEl) return null;
      try {
        const rawData = JSON.parse(dataEl.textContent || '[]');
        catalogEngineInstance = new SearchEngine(rawData);
      } catch (e) {
        console.error('Error instanciando SearchEngine en catálogo:', e);
      }
      return catalogEngineInstance;
    }

    function getMatchingSlugs(query: string): Set<string> | null {
      if (!query || query.length < 2) return null;
      const engine = getCatalogSearchEngine();
      if (!engine) return null;
      try {
        const results = engine.search(query);
        return new Set(results.map(r => r.slug));
      } catch (e) {
        console.error('Error buscando coincidencias:', e);
        return null;
      }
    }

    function formatNumber(n: number) {
      return Number(n).toLocaleString('en-US');
    }

    function updateSliderTrack() {
      if (!sliderTrack) return;
      const clampedMin = Math.max(defaultSliderMin, Math.min(minPrice, defaultSliderMax));
      const clampedMax = Math.max(defaultSliderMin, Math.min(maxPrice, defaultSliderMax));
      
      const percentMin = ((clampedMin - defaultSliderMin) / (defaultSliderMax - defaultSliderMin)) * 100;
      const percentMax = ((clampedMax - defaultSliderMin) / (defaultSliderMax - defaultSliderMin)) * 100;
      
      sliderTrack.style.left = `${Math.max(0, Math.min(100, percentMin))}%`;
      sliderTrack.style.right = `${Math.max(0, Math.min(100, 100 - percentMax))}%`;

      if (priceLabel) {
        priceLabel.textContent = `${formatNumber(minPrice)} – ${formatNumber(maxPrice)} CUP`;
      }
    }

    function updateUI() {
      // Tag Rebajas
      if (tagSaleBtn) {
        if (filterSale) {
          tagSaleBtn.className = 'filter-tag-btn inline-flex items-center gap-2 px-4 py-3.5 rounded-2xl text-xs font-bold transition-all duration-200 border border-rose-500/60 bg-rose-500/20 text-rose-200 shadow-[0_2px_12px_rgba(244,63,94,0.25)] cursor-pointer select-none';
          tagSaleBtn.setAttribute('data-active', 'true');
        } else {
          tagSaleBtn.className = 'filter-tag-btn inline-flex items-center gap-2 px-4 py-3.5 rounded-2xl text-xs font-semibold transition-all duration-200 border border-white/10 bg-white/[0.03] text-slate-200 hover:bg-white/[0.08] hover:border-amber-400/40 cursor-pointer select-none';
          tagSaleBtn.setAttribute('data-active', 'false');
        }
      }

      // Tag Tendencias
      if (tagTrendingBtn) {
        if (filterTrending) {
          tagTrendingBtn.className = 'filter-tag-btn inline-flex items-center gap-2 px-4 py-3.5 rounded-2xl text-xs font-bold transition-all duration-200 border border-amber-500/60 bg-amber-500/20 text-amber-200 shadow-[0_2px_12px_rgba(245,158,11,0.25)] cursor-pointer select-none';
          tagTrendingBtn.setAttribute('data-active', 'true');
        } else {
          tagTrendingBtn.className = 'filter-tag-btn inline-flex items-center gap-2 px-4 py-3.5 rounded-2xl text-xs font-semibold transition-all duration-200 border border-white/10 bg-white/[0.03] text-slate-200 hover:bg-white/[0.08] hover:border-purple-400/40 cursor-pointer select-none';
          tagTrendingBtn.setAttribute('data-active', 'false');
        }
      }

      // Badge de Búsqueda
      if (searchBadge) {
        if (searchFilter && searchFilter.length >= 2) {
          searchBadge.classList.remove('hidden');
          if (searchQueryText) searchQueryText.textContent = `"${searchFilter}"`;
        } else {
          searchBadge.classList.add('hidden');
        }
      }

      // Botón Reset
      const hasActive = Boolean(searchFilter && searchFilter.length >= 2) || filterSale || filterTrending || minPrice > defaultSliderMin || maxPrice < defaultSliderMax;
      if (resetBtn) {
        resetBtn.classList.toggle('hidden', !hasActive);
      }

      updateSliderTrack();
    }

    function applyFilters() {
      const cards = Array.from(document.querySelectorAll('.product-card-item')) as HTMLElement[];
      let visible = 0;
      const matchingSlugs = searchFilter && searchFilter.length >= 2 ? getMatchingSlugs(searchFilter) : null;

      cards.forEach(card => {
        const priceCUP = parseFloat(card.getAttribute('data-price-cup') || '0');
        const onSale = card.getAttribute('data-on-sale') === 'true';
        const trending = card.getAttribute('data-trending') === 'true';
        const slug = card.getAttribute('data-product-slug') || '';

        let match = true;
        if (filterSale && !onSale) match = false;
        if (filterTrending && !trending) match = false;
        if (priceCUP < minPrice || priceCUP > maxPrice) match = false;
        if (matchingSlugs !== null && !matchingSlugs.has(slug)) match = false;

        card.style.display = match ? '' : 'none';
        if (match) visible++;
      });

      if (countEl) {
        countEl.textContent = `${visible} productos`;
      }

      // Mostrar u ocultar mensaje cuando nada coincide (Empty State)
      if (emptyStateEl) {
        emptyStateEl.classList.toggle('hidden', visible > 0);
        const titleEl = emptyStateEl.querySelector('h3');
        const descEl = emptyStateEl.querySelector('p');
        if (titleEl && descEl) {
          if (searchFilter && searchFilter.length >= 2) {
            titleEl.textContent = `No encontramos "${searchFilter}"`;
            descEl.textContent = `No hay artículos que coincidan con "${searchFilter}" y los filtros aplicados. Prueba limpiando los filtros o escríbenos para encargártelo.`;
          } else {
            titleEl.textContent = 'No encontramos productos en este rango';
            descEl.textContent = 'No hay artículos que coincidan con los filtros aplicados. Prueba ampliando tu presupuesto o limpiando los filtros para ver todo el catálogo.';
          }
        }
      }

      // Sincronizar URL en CUP y término de búsqueda
      const params = new URLSearchParams();
      if (searchFilter && searchFilter.length >= 2) params.set('s', searchFilter);
      if (filterSale) params.set('rebaja', 'true');
      if (filterTrending) params.set('tendencia', 'true');
      if (minPrice > defaultSliderMin) params.set('min_cup', minPrice.toString());
      if (maxPrice < defaultSliderMax) params.set('max_cup', maxPrice.toString());

      const newUrl = params.toString() ? `${window.location.pathname}?${params.toString()}` : window.location.pathname;
      window.history.replaceState({}, '', newUrl);

      updateUI();
    }

    // Eventos Tags
    tagSaleBtn?.addEventListener('click', () => {
      filterSale = !filterSale;
      applyFilters();
    });

    tagTrendingBtn?.addEventListener('click', () => {
      filterTrending = !filterTrending;
      applyFilters();
    });

    // Evento limpiar búsqueda desde el badge
    searchClearBadge?.addEventListener('click', () => {
      searchFilter = '';
      const subInput = document.getElementById('subnav-search-input') as HTMLInputElement | null;
      const subClear = document.getElementById('subnav-search-clear');
      if (subInput) subInput.value = '';
      if (subClear) subClear.classList.add('hidden');
      applyFilters();
    });

    // Escuchar cambios de búsqueda desde el SubNavbar en tiempo real
    window.addEventListener('carmay-search', ((e: CustomEvent) => {
      searchFilter = (e.detail?.query || '').trim();
      applyFilters();
    }) as EventListener);

    // Control de inputs numéricos libres con debounce (sin forzar números al usuario)
    let priceTimer: any = null;
    function onPriceInputChange() {
      clearTimeout(priceTimer);
      priceTimer = setTimeout(() => {
        let minVal = parseFloat(minInput?.value || '0');
        let maxVal = parseFloat(maxInput?.value || '999999');
        if (isNaN(minVal)) minVal = 0;
        if (isNaN(maxVal)) maxVal = 999999;

        minPrice = minVal;
        maxPrice = maxVal;

        if (sliderMin) sliderMin.value = Math.min(minPrice, defaultSliderMax).toString();
        if (sliderMax) sliderMax.value = Math.min(maxPrice, defaultSliderMax).toString();
        applyFilters();
      }, 250);
    }

    minInput?.addEventListener('input', onPriceInputChange);
    maxInput?.addEventListener('input', onPriceInputChange);

    // Control del Slider Mínimo
    sliderMin?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (val > maxPrice) {
        minPrice = maxPrice;
        sliderMin.value = maxPrice.toString();
      } else {
        minPrice = val;
      }
      if (minInput) minInput.value = minPrice.toString();
      updateSliderTrack();
      clearTimeout(priceTimer);
      priceTimer = setTimeout(applyFilters, 100);
    });

    // Control del Slider Máximo
    sliderMax?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (val < minPrice) {
        maxPrice = minPrice;
        sliderMax.value = minPrice.toString();
      } else {
        maxPrice = val;
      }
      if (maxInput) maxInput.value = maxPrice.toString();
      updateSliderTrack();
      clearTimeout(priceTimer);
      priceTimer = setTimeout(applyFilters, 100);
    });

    // Función global de Reset
    function resetAllFilters() {
      searchFilter = '';
      filterSale = false;
      filterTrending = false;
      minPrice = defaultSliderMin;
      maxPrice = defaultSliderMax;
      if (minInput) minInput.value = defaultSliderMin.toString();
      if (maxInput) maxInput.value = defaultSliderMax.toString();
      if (sliderMin) sliderMin.value = defaultSliderMin.toString();
      if (sliderMax) sliderMax.value = defaultSliderMax.toString();

      const subInput = document.getElementById('subnav-search-input') as HTMLInputElement | null;
      const subClear = document.getElementById('subnav-search-clear');
      if (subInput) subInput.value = '';
      if (subClear) subClear.classList.add('hidden');

      applyFilters();
    }

    resetBtn?.addEventListener('click', resetAllFilters);
    emptyResetBtn?.addEventListener('click', resetAllFilters);

    // Inicialización
    updateUI();
    applyFilters();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCatalogFilter);
  } else {
    initCatalogFilter();
  }
</script>
