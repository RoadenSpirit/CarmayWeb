---
import { woo } from '../api';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Carmay Outfit - Moda, Calzado y Tecnología en Cuba" } = Astro.props;

// Índice global del catálogo para el buscador del SubNavbar.
// Se resuelve en build (SSG) y se inyecta como JSON en cada página,
// para que la búsqueda esté disponible en TODO el sitio con un solo punto de definición.
const allProducts = await woo.products
  .getAll()
  .catch(() => []);

const searchableData = allProducts
  .filter((p) => p.hasRealImage)
  .map((p) => ({
    id: p.id,
    name: p.name,
    slug: p.slug,
    category: p.categoryName || "General",
    categorySlug: p.categorySlug,
    primaryImage: p.primaryImage,
    priceUSD: p.price,
    priceCUP: p.priceCUP,
    regularPriceUSD: p.regularPrice,
    regularPriceCUP: p.regularPriceCUP,
    isOnSale: p.isOnSale,
    stockQuantity: p.stockQuantity,
    isInStock: p.isInStock,
    isTrending: p.isTrending,
    tags: p.tags.map((t) => t.name),
  }));

const catalogJson = JSON.stringify(searchableData);
---

<!doctype html>
<html lang="es" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <slot name="head" />

    <!-- Google Fonts: Outfit, Plus Jakarta Sans & Playfair Display -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#090b11] text-gray-100 antialiased selection:bg-purple-600 selection:text-white min-h-screen flex flex-col">
    <!-- Grid overlay sutil -->
    <div class="fixed inset-0 -z-10 bg-[linear-gradient(to_right,rgba(255,255,255,0.015)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.015)_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none opacity-40"></div>
    <slot />

    <!-- Índice global del catálogo para el buscador (SubNavbar) -->
    <script id="catalog-data" type="application/json" set:html={catalogJson}></script>

    <!-- Script de Animaciones de Entrada Suave (Scroll Reveal acelerado por GPU) -->
    <script is:inline>
      (function() {
        if (typeof window === 'undefined') return;
        
        // Respetar preferencias de reducción de movimiento (Vercel Guidelines)
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) {
          document.querySelectorAll('.reveal-on-scroll').forEach(el => el.classList.add('is-revealed'));
          return;
        }

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              obs.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.05,
          rootMargin: '50px 0px 50px 0px'
        });

        function initReveals() {
          const elements = document.querySelectorAll('.reveal-on-scroll');
          elements.forEach(el => {
            // Solo revelar si está en los primeros 100px superiores del viewport de carga
            const rect = el.getBoundingClientRect();
            if (rect.top < 150) {
              el.classList.add('is-revealed');
            } else {
              observer.observe(el);
            }
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initReveals);
        } else {
          initReveals();
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  html {
    color-scheme: dark;
  }
  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background-color: #090b11;
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: 'Outfit', sans-serif;
    text-wrap: balance;
  }

  /* Animaciones Scroll Reveal con Easing Profesional de Impeccable/Vercel */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(40px) scale(0.96);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .reveal-on-scroll.is-revealed {
    opacity: 1 !important;
    transform: translateY(0) scale(1) !important;
  }

  /* Retrasos escalonados para listas de cards */
  .reveal-delay-1 { transition-delay: 120ms; }
  .reveal-delay-2 { transition-delay: 240ms; }
  .reveal-delay-3 { transition-delay: 360ms; }
  .reveal-delay-4 { transition-delay: 480ms; }

  /* Desactivar animaciones si el usuario lo prefiere */
  @media (prefers-reduced-motion: reduce) {
    .reveal-on-scroll {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  /* Neo-style glass cards */
  .neo-card {
    background: rgba(15, 17, 28, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }
  .neo-card:hover {
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  /* Neo glow line horizontal */
  .neo-line {
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(168, 85, 247, 0.4) 20%, rgba(109, 30, 104, 0.6) 50%, rgba(217, 119, 6, 0.4) 80%, transparent);
  }

  /* Neo glow section border */
  .neo-section {
    border: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
  }
  .neo-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(168, 85, 247, 0.5), transparent);
  }

  /* Glow pulse for featured elements */
  .glow-purple {
    box-shadow: 0 0 60px rgba(168, 85, 247, 0.08), 0 0 120px rgba(168, 85, 247, 0.04);
  }

  /* Mirror card shine effect */
  .mirror-card {
    position: relative;
    overflow: hidden;
  }
  .mirror-card::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      to bottom right,
      transparent 40%,
      rgba(255, 255, 255, 0.02) 45%,
      rgba(255, 255, 255, 0.04) 50%,
      rgba(255, 255, 255, 0.02) 55%,
      transparent 60%
    );
    transform: rotate(30deg);
    transition: transform 0.8s ease;
    pointer-events: none;
  }
  .mirror-card:hover::after {
    transform: rotate(30deg) translateY(-30%);
  }

  /* Scroll progress bar */
  #scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2.5px;
    background: linear-gradient(to right, #a855f7, #6d1e68, #34d399);
    z-index: 100;
    transition: width 75ms;
  }
</style>