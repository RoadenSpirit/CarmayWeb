---
import { woo } from '../api';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Carmay Outfit - Moda, Calzado y Tecnología en Cuba" } = Astro.props;

// Índice global del catálogo para el buscador del SubNavbar.
// Se resuelve en build (SSG) y se inyecta como JSON en cada página,
// para que la búsqueda esté disponible en TODO el sitio con un solo punto de definición.
const allProducts = await woo.products
  .getAll()
  .catch(() => []);

// Optimización: solo los campos estrictamente necesarios para la búsqueda rápida
const searchableData = allProducts
  .filter((p) => p.hasRealImage)
  .map((p) => ({
    name: p.name,
    slug: p.slug,
    category: p.categoryName || "General",
    primaryImage: p.primaryImage,
    priceUSD: p.price,
    priceCUP: p.priceCUP,
    tags: p.tags.map((t) => t.name),
  }));

const catalogJson = JSON.stringify(searchableData);
---

<!doctype html>
<html lang="es" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <slot name="head" />

    <!-- Google Fonts: Outfit & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#090b11] text-gray-100 antialiased selection:bg-purple-600 selection:text-white min-h-screen flex flex-col">
    <!-- Grid overlay sutil -->
    <div class="fixed inset-0 -z-10 bg-[linear-gradient(to_right,rgba(255,255,255,0.015)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.015)_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none opacity-40"></div>
    <slot />

    <!-- Índice global del catálogo para el buscador (SubNavbar) -->
    <script id="catalog-data" type="application/json" set:html={catalogJson}></script>

    <!-- Script de Animaciones de Entrada Suave (Scroll Reveal con Keyframes acelerados por GPU) -->
    <script is:inline>
      (function() {
        if (typeof window === 'undefined') return;

        let observer = null;

        function initAnimations() {
          if (observer) observer.disconnect();

          observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.08,
            rootMargin: '0px 0px -20px 0px'
          });

          const elements = document.querySelectorAll(
            '.reveal-on-scroll, .reveal-scale, .reveal-card, .reveal-pop, .reveal-slide-right, .reveal-slide-left, .reveal-blur-fade, .reveal-fade'
          );
          elements.forEach(el => {
            observer.observe(el);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initAnimations);
        } else {
          initAnimations();
        }

        // Re-observar cuando se filtren productos o cambie el contenido
        window.addEventListener('carmay-refresh-reveals', initAnimations);
      })();
    </script>
  </body>
</html>

<style is:global>
  html {
    color-scheme: dark;
    /* Corta el desbordamiento horizontal para que nunca aparezca scroll lateral
       que recorte el margen izquierdo. `clip` NO crea contenedor de scroll,
       por lo que el header sticky y los paneles fixed siguen funcionando. */
    overflow-x: clip;
  }
  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background-color: #090b11;
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: 'Outfit', sans-serif;
    text-wrap: balance;
  }

  /* ==========================================================================
     Sistema de Animaciones Especializadas Impeccable Motion (100% GPU)
     Distancias controladas para fluidez en escritorio y suavidad en móvil
     ========================================================================== */

  /* 1. Reveal Fade Up: Para textos, títulos y párrafos */
  @keyframes revealFadeUp {
    0% {
      opacity: 0;
      transform: translateY(28px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 2. Reveal Scale: Para logos, imágenes focales y categorías (profundidad 3D) */
  @keyframes revealScaleIn {
    0% {
      opacity: 0;
      transform: scale(0.92);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* 3. Reveal Card: Para tarjetas de producto (subida corta con escala sutil) */
  @keyframes revealCardIn {
    0% {
      opacity: 0;
      transform: translateY(20px) scale(0.98);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* 4. Reveal Pop: Para badges, pills, precios y botones de llamada a la acción */
  @keyframes revealPopIn {
    0% {
      opacity: 0;
      transform: scale(0.86);
    }
    70% {
      transform: scale(1.03);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* 5. Reveal Slide Right: Para items de valor (flujo direccional) */
  @keyframes revealSlideRightIn {
    0% {
      opacity: 0;
      transform: translateX(-24px);
    }
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* 6. Reveal Slide Left: Para testimonios intercalados */
  @keyframes revealSlideLeftIn {
    0% {
      opacity: 0;
      transform: translateX(24px);
    }
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* 7. Reveal Blur Fade: Enfoque cinematográfico para banners y visión */
  @keyframes revealBlurFadeIn {
    0% {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(16px);
    }
    100% {
      opacity: 1;
      filter: blur(0px);
      transform: translateY(0);
    }
  }

  @keyframes revealFadeIn {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  /* Estados iniciales (invisibles antes de llegar al viewport) */
  .reveal-on-scroll,
  .reveal-scale,
  .reveal-card,
  .reveal-pop,
  .reveal-slide-right,
  .reveal-slide-left,
  .reveal-blur-fade,
  .reveal-fade {
    opacity: 0;
  }

  /* Disparadores de animación al entrar al viewport */
  .reveal-on-scroll.is-revealed {
    animation: revealFadeUp 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
  }

  .reveal-scale.is-revealed {
    animation: revealScaleIn 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
  }

  .reveal-card.is-revealed {
    animation: revealCardIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
  }

  .reveal-pop.is-revealed {
    animation: revealPopIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
  }

  .reveal-slide-right.is-revealed {
    animation: revealSlideRightIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
  }

  .reveal-slide-left.is-revealed {
    animation: revealSlideLeftIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
  }

  .reveal-blur-fade.is-revealed {
    animation: revealBlurFadeIn 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
  }

  .reveal-fade.is-revealed {
    animation: revealFadeIn 0.5s ease-out forwards !important;
  }

  /* Retrasos escalonados armónicos (Stagger Cascade) */
  .reveal-delay-1.is-revealed { animation-delay: 60ms !important; }
  .reveal-delay-2.is-revealed { animation-delay: 130ms !important; }
  .reveal-delay-3.is-revealed { animation-delay: 200ms !important; }
  .reveal-delay-4.is-revealed { animation-delay: 270ms !important; }
  .reveal-delay-5.is-revealed { animation-delay: 340ms !important; }
  .reveal-delay-6.is-revealed { animation-delay: 410ms !important; }

  /* Ajustes para móviles: reducimos desplazamiento y desactivamos blur para 60fps constantes */
  @media (max-width: 640px) {
    @keyframes revealFadeUp {
      0% { opacity: 0; transform: translateY(14px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes revealCardIn {
      0% { opacity: 0; transform: translateY(12px) scale(0.99); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes revealSlideRightIn {
      0% { opacity: 0; transform: translateX(-12px); }
      100% { opacity: 1; transform: translateX(0); }
    }
    @keyframes revealSlideLeftIn {
      0% { opacity: 0; transform: translateX(12px); }
      100% { opacity: 1; transform: translateX(0); }
    }
    @keyframes revealBlurFadeIn {
      0% { opacity: 0; transform: translateY(10px); }
      100% { opacity: 1; transform: translateY(0); }
    }
  }

  /* Transición de carga suave para todas las imágenes de productos */
  img {
    transition: opacity 0.4s ease;
  }

  /* Neo-style glass cards */
  .neo-card {
    background: rgba(15, 17, 28, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }
  .neo-card:hover {
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  /* Neo glow line horizontal */
  .neo-line {
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(168, 85, 247, 0.4) 20%, rgba(109, 30, 104, 0.6) 50%, rgba(217, 119, 6, 0.4) 80%, transparent);
  }

  /* Neo glow section border */
  .neo-section {
    border: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
  }
  .neo-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(168, 85, 247, 0.5), transparent);
  }

  /* Glow pulse for featured elements */
  .glow-purple {
    box-shadow: 0 0 60px rgba(168, 85, 247, 0.08), 0 0 120px rgba(168, 85, 247, 0.04);
  }

  /* Mirror card shine effect */
  .mirror-card {
    position: relative;
    overflow: hidden;
  }
  .mirror-card::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      to bottom right,
      transparent 40%,
      rgba(255, 255, 255, 0.02) 45%,
      rgba(255, 255, 255, 0.04) 50%,
      rgba(255, 255, 255, 0.02) 55%,
      transparent 60%
    );
    transform: rotate(30deg);
    transition: transform 0.8s ease;
    pointer-events: none;
  }
  .mirror-card:hover::after {
    transform: rotate(30deg) translateY(-30%);
  }

  /* Scroll progress bar */
  #scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2.5px;
    background: linear-gradient(to right, #a855f7, #6d1e68, #34d399);
    z-index: 100;
    transition: width 75ms;
  }
</style>