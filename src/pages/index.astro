---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ValueProps from '../components/ValueProps.astro';
import Categories from '../components/Categories.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import CompanyVision from '../components/CompanyVision.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import { woo } from '../api';

const withFallback = <T,>(promise: Promise<T[]>, fallback: T[] = []): Promise<T[]> =>
  promise.catch(() => fallback);

const [bestSellersRaw, offersRaw] = await Promise.all([
  withFallback(woo.products.getBestSellers(4)),
  withFallback(woo.products.getOnSale(4)),
]);

// Se muestran solo productos con imagen real; los "más vendidos" deben tener ventas.
const bestSellers = bestSellersRaw
  .filter((product) => product.totalSales > 0 && product.hasRealImage)
  .map((product) => product.toCard());

const specialOffers = offersRaw
  .filter((product) => product.isInStock && product.hasRealImage)
  .map((product) => product.toCard());
---

<Layout title="Carmay Outfit • La tienda más completa de Camagüey">
  <Header />

  <!-- 1. Hero Principal con textos exactos de la web principal -->
  <Hero />

  <!-- 2. Banner de Valor Añadido con SVGs artesanales -->
  <div class="reveal-on-scroll">
    <ValueProps />
  </div>

  <!-- 3. Categorías Principales (5 Cards: Calzado, Ropa, Bolsos y Mochilas, Tecnología, Accesorios) -->
  <div class="reveal-on-scroll">
    <Categories />
  </div>

  <!-- 4. Muestra Intercalada 1: Productos Más Vendidos -->
  <div class="reveal-on-scroll">
    <ProductShowcase 
      subtitle="Los favoritos de nuestros clientes" 
      title="Productos Más Vendidos" 
      products={bestSellers} 
    />
  </div>

  <!-- 5. Visión y Proyecciones de la Empresa (Card elegante con logo sobre fondo de trazos morados) -->
  <div class="reveal-on-scroll">
    <CompanyVision />
  </div>

  <!-- 6. Muestra Intercalada 2: Ofertas Especiales -->
  <div class="reveal-on-scroll">
    <ProductShowcase 
      subtitle="Aprovecha antes que se agoten" 
      title="Rebajas y Ofertas Activas" 
      products={specialOffers} 
    />
  </div>

  <!-- 7. Opiniones de Clientes (Social Proof con Facebook) -->
  <div class="reveal-on-scroll">
    <Testimonials />
  </div>

  <!-- 8. Preguntas Frecuentes (FAQ) -->
  <div class="reveal-on-scroll">
    <FAQ />
  </div>

  <!-- 9. Footer Rediseñado -->
  <Footer />
</Layout>
