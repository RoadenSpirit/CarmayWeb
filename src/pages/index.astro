  <!-- 6. Muestra Intercalada 2: Ofertas Especiales -->
  <ProductShowcase 
    subtitle="Aprovecha antes que se agoten" 
    title="Rebajas y Ofertas Activas" 
    products={specialOffers} 
  />

  <!-- 7. Opiniones de Clientes (Social Proof con Facebook) -->
