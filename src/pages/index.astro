---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProductCard from '../components/ProductCard.astro';
import Footer from '../components/Footer.astro';

// Datos de prueba (Prototipo Frontend conectado a la identidad visual de Carmay)
const featuredProducts = [
  {
    title: "Chancleta de Baño Ipanema Classic Pro",
    price: "$18.00 USD",
    regularPrice: "$22.00 USD",
    image: "https://images.unsplash.com/photo-1603808033192-082d6919d3e1?auto=format&fit=crop&w=600&q=80",
    category: "Calzado",
    isTrending: true,
    permalink: "https://carmayoutfit.com/product/chancleta-de-bano-ipanema/"
  },
  {
    title: "Suscripción Oficial ChatGPT Plus (OpenAI)",
    price: "$25.00 USD",
    regularPrice: "",
    image: "https://images.unsplash.com/photo-1677442136019-21780efad99a?auto=format&fit=crop&w=600&q=80",
    category: "Inteligencia Artificial",
    isTrending: true,
    permalink: "https://ia.carmayn8n.cloud"
  },
  {
    title: "Zapatillas Deportivas Urban Style v4",
    price: "$45.00 USD",
    regularPrice: "$55.00 USD",
    image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=600&q=80",
    category: "Moda",
    isTrending: false,
    permalink: "https://carmayoutfit.com/products/"
  },
  {
    title: "Suscripción Claude Pro (Anthropic)",
    price: "$25.00 USD",
    regularPrice: "",
    image: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=600&q=80",
    category: "Tecnología",
    isTrending: true,
    permalink: "https://ia.carmayn8n.cloud"
  }
];

const faqs = [
  {
    question: "¿Cómo puedo comprar en Carmay Outfit desde Cuba?",
    answer: "Puedes seleccionar tus productos en la web o contactar directamente a nuestros gestores por WhatsApp. Aceptamos pagos en efectivo en nuestra tienda física en Camagüey, transferencia local CUP o USD."
  },
  {
    question: "¿Cómo funcionan las suscripciones de Inteligencia Artificial?",
    answer: "Te proporcionamos una cuenta de Google exclusiva y segura sobre la cual activamos la suscripción oficial premium que elijas (ChatGPT, Claude o Gemini) con renovación mensual flexible."
  },
  {
    question: "¿Dónde se encuentra la tienda física?",
    answer: "Estamos ubicados en Avellaneda No. 260 entre San Esteban y San Martín, Camagüey, Cuba. ¡Te esperamos!"
  }
];
---

<Layout title="Carmay Outfit • Moda, Calzado y Tecnología en Cuba">
  <Header />

  <!-- Hero Section con Gradientes Vivos y Estética IA Carmay -->
  <section class="relative overflow-hidden bg-gradient-to-br from-purple-950 via-purple-900 to-indigo-950 text-white py-24 sm:py-32">
    <!-- Círculos decorativos con gradiente difuminado -->
    <div class="absolute top-1/4 -left-32 w-96 h-96 bg-purple-600/30 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-10 -right-32 w-96 h-96 bg-amber-500/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold bg-white/10 backdrop-blur-md text-amber-300 border border-white/15 mb-6 shadow-inner">
        ✨ Nueva Era Digital en Cuba • E-commerce & IA
      </span>

      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-white mb-6 leading-tight">
        Moda, Estilo y el Futuro <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-amber-400 via-orange-400 to-rose-500 bg-clip-text text-transparent">
          de la Tecnología
        </span>
      </h1>

      <p class="max-w-2xl mx-auto text-lg sm:text-xl text-purple-200 mb-10 font-normal leading-relaxed">
        Descubre nuestro catálogo exclusivo de calzado, ropa y las herramientas de Inteligencia Artificial más potentes del mundo con pago local en Cuba.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#catalogo" class="w-full sm:w-auto bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-white font-extrabold px-8 py-4 rounded-2xl shadow-xl shadow-orange-600/30 hover:-translate-y-0.5 transition-all text-base">
          🛍️ Explorar Catálogo
        </a>
        <a href="https://ia.carmayn8n.cloud" target="_blank" class="w-full sm:w-auto bg-white/10 hover:bg-white/20 text-white font-bold px-8 py-4 rounded-2xl backdrop-blur-md border border-white/20 transition-all text-base">
          🤖 Ver Planes de IA
        </a>
      </div>
    </div>
  </section>

  <!-- Catálogo Destacado -->
  <section id="catalogo" class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <span class="text-purple-700 font-bold text-xs uppercase tracking-widest block mb-2">Lo más popular</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">
          Productos y Suscripciones Destacadas
        </h2>
      </div>
      <a href="https://carmayoutfit.com/products/" target="_blank" class="mt-4 md:mt-0 inline-flex items-center gap-2 text-purple-900 font-bold hover:text-purple-600 transition-colors">
        <span>Ver tienda completa en WordPress</span>
        <span>&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {featuredProducts.map(product => (
        <ProductCard {...product} />
      ))}
    </div>
  </section>

  <!-- Sección Destacada Carmay IA Banner -->
  <section class="py-16 bg-gradient-to-r from-purple-900 via-indigo-900 to-purple-950 text-white my-12 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center justify-between gap-10">
      <div class="space-y-4 max-w-xl text-center lg:text-left">
        <span class="bg-amber-400 text-gray-900 text-xs font-black uppercase px-3 py-1 rounded-full shadow-md">
          Plataforma Exclusiva
        </span>
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight">
          ¿Necesitas ChatGPT, Claude o Gemini en Cuba?
        </h2>
        <p class="text-purple-200 text-sm sm:text-base leading-relaxed">
          Integra la inteligencia artificial más avanzada en tu día a día para programación, marketing, estudios o negocios con cuentas oficiales y pago local.
        </p>
      </div>
      <div>
        <a href="https://ia.carmayn8n.cloud" target="_blank" class="inline-flex items-center gap-2 bg-white text-purple-950 hover:bg-amber-300 font-extrabold px-8 py-4 rounded-2xl shadow-2xl transition-all text-base hover:-translate-y-1">
          <span>Ver Portal de Inteligencia Artificial</span>
          <span>🚀</span>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="text-purple-700 font-bold text-xs uppercase tracking-widest block mb-2">Resolvemos tus dudas</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">
        Preguntas Frecuentes
      </h2>
    </div>

    <div class="space-y-6">
      {faqs.map(faq => (
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-purple-100 shadow-sm hover:shadow-md transition-shadow">
          <h3 class="text-lg font-bold text-gray-900 mb-3 flex items-start gap-3">
            <span class="text-purple-700 font-black">Q.</span>
            <span>{faq.question}</span>
          </h3>
          <p class="text-gray-600 text-sm sm:text-base pl-7 leading-relaxed">
            {faq.answer}
          </p>
        </div>
      ))}
    </div>
  </section>

  <Footer />
</Layout>
