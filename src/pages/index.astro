---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ValueProps from '../components/ValueProps.astro';
import Categories from '../components/Categories.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import CompanyVision from '../components/CompanyVision.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import ExtendedSearchBar from '../components/ExtendedSearchBar.astro';
import { woo } from '../api';

const withFallback = <T,>(promise: Promise<T[]>, fallback: T[] = []): Promise<T[]> =>
  promise.catch(() => fallback);

const [allRawProducts, bestSellersRaw, offersRaw] = await Promise.all([
  withFallback(woo.products.getAll(100)),
  withFallback(woo.products.getBestSellers(8)),
  withFallback(woo.products.getOnSale(8)),
]);

const validProducts = allRawProducts.filter(p => p.hasRealImage);
const searchableData = validProducts.map(p => ({
  id: p.id,
  name: p.name,
  slug: p.slug,
  category: p.categoryName || "General",
  categorySlug: p.categorySlug,
  primaryImage: p.primaryImage,
  priceUSD: p.price,
  priceCUP: p.priceCUP,
  regularPriceUSD: p.regularPrice,
  regularPriceCUP: p.regularPriceCUP,
  isOnSale: p.isOnSale,
  stockQuantity: p.stockQuantity,
  isInStock: p.isInStock,
  isTrending: p.isTrending,
  tags: p.tags.map(t => t.name),
}));

// Se muestran solo productos con imagen real; los "más vendidos" deben tener ventas.
const bestSellers = bestSellersRaw
  .filter((product) => product.totalSales > 0 && product.hasRealImage)
  .map((product) => product.toCard());

const specialOffers = offersRaw
  .filter((product) => product.isInStock && product.hasRealImage)
  .map((product) => product.toCard());
---

<Layout title="Carmay Outfit • La tienda más completa de Camagüey">
  <Header />

  <!-- Buscador Extendido integrado debajo del Header -->
  <ExtendedSearchBar 
    allProducts={searchableData} 
    recommendedProducts={bestSellers} 
  />

  <!-- 1. Hero Principal con textos exactos de la web principal -->
  <Hero />

  <!-- 2. Banner de Valor Añadido con SVGs artesanales -->
  <ValueProps />

  <!-- 3. Categorías Principales (5 Cards: Calzado, Ropa, Bolsos y Mochilas, Tecnología, Accesorios) -->
  <Categories />

  <!-- 4. Muestra Intercalada 1: Productos Más Vendidos -->
  <ProductShowcase 
    subtitle="Los favoritos de nuestros clientes" 
    title="Productos Más Vendidos" 
    products={bestSellers} 
  />

  <!-- 5. Visión y Proyecciones de la Empresa (Card elegante con logo sobre fondo de trazos morados) -->
  <CompanyVision />

  <!-- 6. Muestra Intercalada 2: Ofertas Especiales -->
  <ProductShowcase 
    subtitle="Aprovecha antes que se agoten" 
    title="Rebajas y Ofertas Activas" 
    products={specialOffers} 
  />

  <!-- 7. Opiniones de Clientes (Social Proof con Facebook) -->
  <Testimonials />

  <!-- 8. Preguntas Frecuentes (FAQ) -->
  <FAQ />

  <!-- 9. Footer Rediseñado -->
  <Footer />
</Layout>
