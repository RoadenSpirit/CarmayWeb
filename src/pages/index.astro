---

<Layout title="Carmay Outfit • La tienda más completa de Camagüey">
  <Header />

  <!-- 1. Hero Principal con textos exactos de la web principal -->
  <Hero />

  <!-- 2. Banner de Valor Añadido con SVGs artesanales -->
  <ValueProps />

  <!-- 3. Categorías Principales (5 Cards: Calzado, Ropa, Bolsos y Mochilas, Tecnología, Accesorios) -->
  <Categories />

  <!-- 4. Muestra Intercalada 1: Productos Más Vendidos -->
  <ProductShowcase 
    subtitle="Los favoritos de nuestros clientes" 
    title="Productos Más Vendidos" 
    products={bestSellers} 
  />

  <!-- 5. Visión y Proyecciones de la Empresa (Card elegante con logo sobre fondo de trazos morados) -->
  <CompanyVision />

  <!-- 6. Muestra Intercalada 2: Ofertas Especiales -->
  <ProductShowcase 
    subtitle="Aprovecha antes que se agoten" 
    title="Rebajas y Ofertas Activas" 
    products={specialOffers} 
  />

  <!-- 7. Opiniones de Clientes (Social Proof con Facebook) -->
  <Testimonials />

  <!-- 8. Preguntas Frecuentes (FAQ) -->
  <FAQ />

  <!-- 9. Footer Rediseñado -->
  <Footer />
</Layout>
