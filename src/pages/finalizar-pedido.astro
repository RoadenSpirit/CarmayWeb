---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Finalizar Pedido • Carmay Outfit">
  <Header />

  <!-- Breadcrumbs -->
  <div class="pt-28 sm:pt-36 pb-4 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="flex items-center gap-2 text-sm text-slate-400">
      <a href="/" class="hover:text-yellow-400 transition-colors inline-flex items-center justify-center min-w-[44px] min-h-[44px]">Inicio</a>
      <span class="text-slate-600">&rsaquo;</span>
      <a href="/tienda/" class="hover:text-yellow-400 transition-colors inline-flex items-center justify-center min-w-[44px] min-h-[44px]">Catálogo</a>
      <span class="text-slate-600">&rsaquo;</span>
      <span class="text-slate-200 font-medium">Finalizar Pedido</span>
    </nav>
  </div>

  <section class="pb-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Título principal -->
    <div class="mb-10 text-center sm:text-left">
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight" style="font-family: 'Outfit', sans-serif;">
        Finalizar Tu Pedido
      </h1>
      <p class="text-slate-400 text-sm sm:text-base mt-2">
        Completa tus datos para procesar tu orden y enviarte la confirmación por WhatsApp.
      </p>
    </div>

    <!-- Vista de Carrito Vacío (Oculta por defecto) -->
    <div id="checkout-empty" class="hidden bg-[#0f1120]/90 backdrop-blur-sm rounded-3xl p-10 border border-white/[0.08] text-center max-w-md mx-auto my-12 shadow-xl">
      <div class="w-20 h-20 rounded-full bg-purple-900/30 border border-purple-500/30 flex items-center justify-center mx-auto mb-4 text-purple-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l2.4 12.4a2 2 0 002 1.6h7.7a2 2 0 002-1.6L21 7H6" />
          <circle cx="9" cy="20" r="1.5" />
          <circle cx="17" cy="20" r="1.5" />
        </svg>
      </div>
      <h2 class="text-2xl font-extrabold text-white mb-2">Tu carrito está vacío</h2>
      <p class="text-slate-400 text-sm mb-6">No tienes productos seleccionados para finalizar la compra.</p>
      <a href="/tienda/" class="inline-block px-8 py-3.5 rounded-2xl bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-white font-extrabold text-sm uppercase tracking-wider shadow-lg shadow-orange-600/30 transition-all">
        Explorar Catálogo
      </a>
    </div>

    <!-- Vista Principal de Checkout (2 Columnas) -->
    <div id="checkout-content" class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      
      <!-- ============= COLUMNA IZQUIERDA: FORMULARIO (7 Cols) ============= -->
      <div class="lg:col-span-7 flex flex-col gap-6">
        
        <!-- Bloque 1: Datos del Cliente -->
        <div class="bg-[#0f1120]/90 backdrop-blur-sm rounded-3xl p-6 sm:p-8 border border-white/[0.08] shadow-[0_8px_32px_rgba(0,0,0,0.4)]">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-white/[0.06]">
            <div class="w-9 h-9 rounded-xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center text-amber-400 font-black text-sm">
              1
            </div>
            <h3 class="text-xl font-extrabold text-white">Datos del Cliente</h3>
          </div>

          <div class="space-y-4">
            <div>
              <label for="client-name" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
                Nombre y Apellidos <span class="text-red-400">*</span>
              </label>
              <input 
                type="text" 
                id="client-name"
                placeholder="Ej. Carlos Pérez Gómez" 
                class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all text-sm" 
                required 
              />
            </div>

            <div>
              <label for="client-phone" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
                Teléfono de WhatsApp <span class="text-red-400">*</span>
              </label>
              <div class="relative">
                <span class="absolute left-4 top-3.5 text-slate-400 font-bold text-sm">+53</span>
                <input 
                  type="tel" 
                  id="client-phone"
                  placeholder="5XXXXXXX" 
                  maxlength="8"
                  class="w-full bg-white/[0.04] border border-white/10 rounded-xl pl-14 pr-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all text-sm font-semibold tracking-wider" 
                  required 
                />
              </div>
              <span class="text-xs text-slate-400 mt-1 block">A este número te enviaremos la confirmación de tu compra.</span>
            </div>
          </div>
        </div>

        <!-- Bloque 2: Método de Entrega -->
        <div class="bg-[#0f1120]/90 backdrop-blur-sm rounded-3xl p-6 sm:p-8 border border-white/[0.08] shadow-[0_8px_32px_rgba(0,0,0,0.4)]">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-white/[0.06]">
            <div class="w-9 h-9 rounded-xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center text-amber-400 font-black text-sm">
              2
            </div>
            <h3 class="text-xl font-extrabold text-white">Forma de Entrega</h3>
          </div>

          <!-- Checkbox de Domicilio -->
          <label class="flex items-start gap-3.5 p-4 min-h-[44px] rounded-2xl bg-white/[0.03] border border-white/[0.08] cursor-pointer hover:border-amber-400/50 transition-all select-none">
            <input type="checkbox" id="delivery-checkbox" class="mt-1 w-5 h-5 rounded border-white/20 bg-white/5 text-amber-500 focus:ring-amber-400 focus:ring-offset-0 transition-all accent-amber-500 cursor-pointer" />
            <div>
              <span class="font-extrabold text-white text-sm block inline-flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0zM13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.6a1 1 0 01.9.6l1.4 2a1 1 0 01.1.7V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                </svg>
                Solicitar Entrega a Domicilio en Camagüey
              </span>
              <span class="text-xs text-slate-400 block mt-0.5">Te enviamos el producto directamente a la puerta de tu hogar.</span>
            </div>
          </label>

          <!-- Recogida en Tienda (cuando el checkbox no está marcado) -->
          <div id="pickup-info" class="mt-4 p-4 min-h-[44px] rounded-2xl bg-purple-900/20 border border-purple-500/20 flex items-center gap-3">
            <span class="text-purple-300 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 9l1.5-5h15L21 9M4 9v11h16V9M4 9h16M9 20v-6h6v6" />
              </svg>
            </span>
            <div>
              <span class="text-xs font-bold text-amber-300 uppercase tracking-wider block">Recogida Gratuita en Tienda</span>
              <span class="text-xs text-slate-300 font-medium">Avellaneda No. 260, Camagüey</span>
            </div>
          </div>

          <!-- Campos Desplegables de Domicilio -->
          <div id="delivery-fields" class="hidden mt-6 space-y-4 pt-4 border-t border-white/[0.06] transition-all">
            <div>
              <label for="delivery-address" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
                Dirección Completa de Entrega <span class="text-red-400">*</span>
              </label>
              <input 
                type="text" 
                id="delivery-address"
                placeholder="Calle, número, entrecalles y reparto" 
                class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all text-sm" 
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="recipient-name" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
                  Nombre del Receptor <span class="text-red-400">*</span>
                </label>
                <input 
                  type="text" 
                  id="recipient-name"
                  placeholder="Persona que recibe" 
                  class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all text-sm" 
                />
              </div>

              <div>
                <label for="recipient-phone" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
                  Teléfono del Receptor <span class="text-red-400">*</span>
                </label>
                <div class="relative">
                  <span class="absolute left-4 top-3.5 text-slate-400 font-bold text-sm">+53</span>
                  <input 
                    type="tel" 
                    id="recipient-phone"
                    placeholder="5XXXXXXX" 
                    maxlength="8"
                    class="w-full bg-white/[0.04] border border-white/10 rounded-xl pl-14 pr-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all text-sm font-semibold tracking-wider" 
                  />
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Bloque 3: Notas Adicionales -->
        <div class="bg-[#0f1120]/90 backdrop-blur-sm rounded-3xl p-6 sm:p-8 border border-white/[0.08] shadow-[0_8px_32px_rgba(0,0,0,0.4)]">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-white/[0.06]">
            <div class="w-9 h-9 rounded-xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center text-amber-400 font-black text-sm">
              3
            </div>
            <h3 class="text-xl font-extrabold text-white">Notas del Pedido (Opcional)</h3>
          </div>

          <div>
            <textarea 
              id="order-notes" 
              rows="3"
              placeholder="¿Alguna instrucción especial sobre tu pedido, horario o lugar?"
              class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all text-sm resize-none"
            ></textarea>
          </div>
        </div>

      </div>


      <!-- ============= COLUMNA DERECHA: TICKET Y PAGO (5 Cols - Sticky) ============= -->
      <div class="lg:col-span-5">
        <div class="bg-[#0f1120]/95 backdrop-blur-sm rounded-3xl p-6 sm:p-8 border border-white/[0.08] shadow-[0_12px_40px_rgba(0,0,0,0.6)] sticky top-28 space-y-6">
          
          <div class="pb-4 border-b border-white/[0.06] flex items-center justify-between">
            <h3 class="text-xl font-extrabold text-white">Resumen del Ticket</h3>
            <span id="ticket-items-count" class="text-xs font-bold text-amber-400 bg-amber-400/10 px-3 py-1 rounded-full border border-amber-400/20">
              0 ítems
            </span>
          </div>

          <!-- Lista de Ítems del Pedido -->
          <div id="ticket-items-list" class="space-y-3 max-h-60 overflow-y-auto pr-1 scrollbar-hide">
            <!-- Renderizado dinámico de ítems -->
          </div>

          <!-- Selector de Moneda de Pago -->
          <div class="pt-4 border-t border-white/[0.06]">
            <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2.5">
              Moneda de Pago
            </label>
            <div class="grid grid-cols-2 gap-3">
              <button 
                type="button" 
                data-currency="CUP"
                class="currency-btn min-h-[44px] py-3 px-4 rounded-xl border-2 font-black text-sm uppercase tracking-wider transition-all flex items-center justify-center gap-2 border-amber-400 bg-amber-400/10 text-amber-400 shadow-[0_0_15px_rgba(234,179,8,0.2)]"
              >
                <span>CUP</span>
              </button>
              <button 
                type="button" 
                data-currency="USD"
                class="currency-btn min-h-[44px] py-3 px-4 rounded-xl border-2 font-black text-sm uppercase tracking-wider transition-all flex items-center justify-center gap-2 border-white/10 bg-white/5 text-slate-400 hover:border-amber-400/50 hover:text-amber-400"
              >
                <span>USD</span>
              </button>
            </div>
          </div>

          <!-- Selector de Método de Pago -->
          <div class="pt-2">
            <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2.5">
              Método de Pago
            </label>
            
            <!-- Opciones para CUP -->
            <div id="payment-options-cup" class="space-y-2">
              <label class="flex items-center gap-3 p-3.5 min-h-[44px] rounded-xl bg-white/[0.03] border border-white/[0.08] cursor-pointer hover:border-amber-400/40 transition-all">
                <input type="radio" name="payment-method" value="Efectivo en CUP" checked class="text-amber-500 focus:ring-amber-400 accent-amber-500 cursor-pointer" />
                <div>
                  <span class="font-extrabold text-white text-xs block">Efectivo en CUP</span>
                  <span class="text-xs text-slate-400 block">Pago contra entrega en moneda nacional</span>
                </div>
              </label>
            </div>

            <!-- Opciones para USD -->
            <div id="payment-options-usd" class="space-y-2 hidden">
              <label class="flex items-center gap-3 p-3.5 min-h-[44px] rounded-xl bg-white/[0.03] border border-white/[0.08] cursor-pointer hover:border-amber-400/40 transition-all">
                <input type="radio" name="payment-method" value="Zelle" class="text-amber-500 focus:ring-amber-400 accent-amber-500 cursor-pointer" />
                <div>
                  <span class="font-extrabold text-white text-xs block">Zelle (Solo USD)</span>
                  <span class="text-xs text-slate-400 block">Transferencia rápida Zelle en USD</span>
                </div>
              </label>

              <label class="flex items-center gap-3 p-3.5 min-h-[44px] rounded-xl bg-white/[0.03] border border-white/[0.08] cursor-pointer hover:border-amber-400/40 transition-all">
                <input type="radio" name="payment-method" value="Efectivo en USD" class="text-amber-500 focus:ring-amber-400 accent-amber-500 cursor-pointer" />
                <div>
                  <span class="font-extrabold text-white text-xs block">Efectivo en USD</span>
                  <span class="text-xs text-slate-400 block">Pago directo en efectivo billete USD</span>
                </div>
              </label>
            </div>
          </div>

          <!-- Desglose de Totales -->
          <div class="pt-4 border-t border-white/[0.06] space-y-2 bg-black/20 p-4 rounded-2xl border border-white/[0.04]">
            <div class="flex justify-between items-center text-xs text-slate-400">
              <span>Subtotal:</span>
              <span id="ticket-subtotal" class="font-bold text-white">0 CUP</span>
            </div>
            <div class="flex justify-between items-center text-xs text-slate-400">
              <span>Entrega:</span>
              <span id="ticket-delivery" class="font-semibold text-slate-300">Recogida en Tienda</span>
            </div>
            <div class="flex justify-between items-center text-sm pt-2 border-t border-white/[0.06]">
              <span class="font-black text-white">TOTAL A PAGAR:</span>
              <span id="ticket-total" class="text-xl font-black text-orange-500 drop-shadow-[0_2px_10px_rgba(249,115,22,0.3)]">0 CUP</span>
            </div>
          </div>

          <!-- Mensajes de Error de Validación -->
          <div id="checkout-error" class="hidden p-3 rounded-xl bg-red-900/40 border border-red-500/30 text-red-300 text-xs font-semibold text-center">
            Por favor, completa todos los campos obligatorios.
          </div>

          <!-- Botón de Acción Principal -->
          <button
            type="button"
            id="submit-order-btn"
            class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-amber-500 via-orange-600 to-amber-600 hover:from-amber-400 hover:to-orange-500 text-white font-black text-base uppercase tracking-wider shadow-[0_6px_25px_rgba(249,115,22,0.35)] hover:shadow-[0_8px_35px_rgba(249,115,22,0.5)] transition-all transform hover:-translate-y-0.5 border border-white/10 cursor-pointer flex items-center justify-center gap-2"
          >
            <span class="inline-flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
              </svg>
              Realizar Pedido
            </span>
          </button>

          <!-- Aviso de Garantía -->
          <p class="text-xs text-slate-500 text-center leading-relaxed inline-flex items-start justify-center gap-2 w-full">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 mt-0.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect x="5" y="11" width="14" height="10" rx="2" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 11V7a4 4 0 018 0v4" />
            </svg>
            <span>Recibirás la confirmación de tu orden por WhatsApp. Carmay Outfit se pondrá en contacto para coordinar los detalles.</span>
          </p>

        </div>
      </div>

    </div>
  </section>

  <!-- Modal / Notificación de Éxito al Realizar Pedido -->
  <div id="success-modal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-[100] hidden items-center justify-center p-4">
    <div class="bg-[#0f1120] border border-white/10 rounded-3xl p-8 max-w-md w-full text-center space-y-5 shadow-2xl">
      <div class="w-20 h-20 rounded-full bg-green-500/20 border border-green-500/40 flex items-center justify-center mx-auto text-green-400">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.5 12.5l2.5 2.5 4.5-5" />
        </svg>
      </div>
      <h3 class="text-2xl font-black text-white" style="font-family: 'Outfit', sans-serif;">
        ¡Pedido Registrado!
      </h3>
      <p class="text-slate-300 text-sm leading-relaxed">
        Tu orden se ha enviado correctamente a nuestro sistema. Te hemos enviado un WhatsApp con la nota de tu pedido. En breve nos pondremos en contacto contigo.
      </p>
      <div class="pt-2">
        <a href="/tienda/" class="inline-block w-full py-3.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-600 text-white font-extrabold text-xs uppercase tracking-wider shadow-lg">
          Volver a la Tienda
        </a>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  import { CartCRUD } from '../utils/cartStore';

  document.addEventListener('DOMContentLoaded', () => {
    const deliveryCheckbox = document.getElementById('delivery-checkbox') as HTMLInputElement | null;
    const deliveryFields = document.getElementById('delivery-fields');
    const pickupInfo = document.getElementById('pickup-info');
    const checkoutContent = document.getElementById('checkout-content');
    const checkoutEmpty = document.getElementById('checkout-empty');
    const ticketItemsList = document.getElementById('ticket-items-list');
    const ticketItemsCount = document.getElementById('ticket-items-count');
    const ticketSubtotal = document.getElementById('ticket-subtotal');
    const ticketDelivery = document.getElementById('ticket-delivery');
    const ticketTotal = document.getElementById('ticket-total');
    const currencyBtns = document.querySelectorAll('.currency-btn');
    const paymentCup = document.getElementById('payment-options-cup');
    const paymentUsd = document.getElementById('payment-options-usd');
    const submitBtn = document.getElementById('submit-order-btn');
    const checkoutError = document.getElementById('checkout-error');
    const successModal = document.getElementById('success-modal');

    let selectedCurrency: 'CUP' | 'USD' = 'CUP';

    // 1. Toggle Domicilio / Recogida
    deliveryCheckbox?.addEventListener('change', () => {
      if (deliveryCheckbox.checked) {
        deliveryFields?.classList.remove('hidden');
        pickupInfo?.classList.add('hidden');
        if (ticketDelivery) ticketDelivery.textContent = 'Entrega a Domicilio';
      } else {
        deliveryFields?.classList.add('hidden');
        pickupInfo?.classList.remove('hidden');
        if (ticketDelivery) ticketDelivery.textContent = 'Recogida en Tienda';
      }
    });

    // 2. Toggle Moneda (CUP / USD)
    currencyBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const curr = btn.getAttribute('data-currency') as 'CUP' | 'USD';
        selectedCurrency = curr;

        currencyBtns.forEach(b => {
          b.classList.remove('border-amber-400', 'bg-amber-400/10', 'text-amber-400', 'shadow-[0_0_15px_rgba(234,179,8,0.2)]');
          b.classList.add('border-white/10', 'bg-white/5', 'text-slate-400');
        });
        btn.classList.remove('border-white/10', 'bg-white/5', 'text-slate-400');
        btn.classList.add('border-amber-400', 'bg-amber-400/10', 'text-amber-400', 'shadow-[0_0_15px_rgba(234,179,8,0.2)]');

        if (curr === 'CUP') {
          paymentCup?.classList.remove('hidden');
          paymentUsd?.classList.add('hidden');
          const cupRadio = paymentCup?.querySelector('input[type="radio"]') as HTMLInputElement | null;
          if (cupRadio) cupRadio.checked = true;
        } else {
          paymentUsd?.classList.remove('hidden');
          paymentCup?.classList.add('hidden');
          const usdRadio = paymentUsd?.querySelector('input[type="radio"]') as HTMLInputElement | null;
          if (usdRadio) usdRadio.checked = true;
        }

        renderTicketTotals();
      });
    });

    // 3. Renderizado de ítems del ticket
    function renderTicketItems() {
      const items = CartCRUD.read();
      const { totalUnits } = CartCRUD.getTotals();

      if (items.length === 0) {
        checkoutContent?.classList.add('hidden');
        checkoutEmpty?.classList.remove('hidden');
        return;
      }

      checkoutEmpty?.classList.add('hidden');
      checkoutContent?.classList.remove('hidden');

      if (ticketItemsCount) {
        ticketItemsCount.textContent = `${totalUnits} ${totalUnits === 1 ? 'ítem' : 'ítems'}`;
      }

      if (ticketItemsList) {
        ticketItemsList.innerHTML = items.map(item => `
          <div class="flex items-center gap-3 p-2.5 rounded-xl bg-white/[0.03] border border-white/[0.05]">
            <img src="${item.image}" alt="${item.name}" class="w-12 h-12 object-cover rounded-lg bg-black border border-white/10 shrink-0" />
            <div class="flex-1 min-w-0">
              <h4 class="text-xs font-bold text-white truncate">${item.name}</h4>
              <div class="text-xs text-slate-400 flex gap-2 mt-0.5">
                ${item.color ? `<span>Color: ${item.color}</span>` : ''}
                ${item.size ? `<span>Talla: ${item.size}</span>` : ''}
                <span>Cant: ${item.quantity}</span>
              </div>
            </div>
            <div class="text-xs font-extrabold text-orange-400 text-right shrink-0">
              ${selectedCurrency === 'CUP' 
                ? `${(item.priceCUP * item.quantity).toLocaleString('en-US')} CUP`
                : `${((item.priceUSD * item.quantity) % 1 === 0 ? `$${(item.priceUSD * item.quantity).toFixed(0)}` : `$${(item.priceUSD * item.quantity).toFixed(2)}`)} USD`}
            </div>
          </div>
        `).join('');
      }

      renderTicketTotals();
    }

    function renderTicketTotals() {
      const { totalCUP, totalUSD } = CartCRUD.getTotals();
      if (selectedCurrency === 'CUP') {
        if (ticketSubtotal) ticketSubtotal.textContent = `${totalCUP.toLocaleString('en-US')} CUP`;
        if (ticketTotal) ticketTotal.textContent = `${totalCUP.toLocaleString('en-US')} CUP`;
      } else {
        const usdFormatted = totalUSD % 1 === 0 ? `$${totalUSD.toFixed(0)} USD` : `$${totalUSD.toFixed(2)} USD`;
        if (ticketSubtotal) ticketSubtotal.textContent = usdFormatted;
        if (ticketTotal) ticketTotal.textContent = usdFormatted;
      }
    }

    // 4. Acción Realizar Pedido (API VPS Baileys + WhatsApp Backup)
    submitBtn?.addEventListener('click', async () => {
      const nameInput = document.getElementById('client-name') as HTMLInputElement | null;
      const phoneInput = document.getElementById('client-phone') as HTMLInputElement | null;
      const isDelivery = deliveryCheckbox?.checked ?? false;
      const addressInput = document.getElementById('delivery-address') as HTMLInputElement | null;
      const recipientNameInput = document.getElementById('recipient-name') as HTMLInputElement | null;
      const recipientPhoneInput = document.getElementById('recipient-phone') as HTMLInputElement | null;
      const notesInput = document.getElementById('order-notes') as HTMLTextAreaElement | null;
      const selectedPaymentRadio = document.querySelector('input[name="payment-method"]:checked') as HTMLInputElement | null;

      // Validación de campos
      let isValid = true;
      if (!nameInput?.value.trim()) isValid = false;
      if (!phoneInput?.value.trim() || phoneInput.value.trim().length < 8) isValid = false;

      if (isDelivery) {
        if (!addressInput?.value.trim()) isValid = false;
        if (!recipientNameInput?.value.trim()) isValid = false;
        if (!recipientPhoneInput?.value.trim() || recipientPhoneInput.value.trim().length < 8) isValid = false;
      }

      if (!isValid) {
        if (checkoutError) {
          checkoutError.classList.remove('hidden');
          checkoutError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return;
      }

      if (checkoutError) checkoutError.classList.add('hidden');

      // Formatear teléfono cliente (+53)
      const cleanPhone = phoneInput!.value.trim().replace(/\D/g, '');
      const fullClientPhone = cleanPhone.startsWith('53') ? cleanPhone : `53${cleanPhone}`;

      const clientName = nameInput!.value.trim();
      const paymentMethod = selectedPaymentRadio?.value || 'Efectivo';
      const notes = notesInput?.value.trim() || '';

      const items = CartCRUD.read();
      const { totalCUP, totalUSD } = CartCRUD.getTotals();

      // Construcción del Mensaje Único para el Cliente (Saludo + Confirmación + Ticket)
      let customerMsg = `👋 *¡Hola ${clientName}! Gracias por comprar en Carmay Outfit*\n\n`;
      customerMsg += `✅ Tu orden ha sido *registrada con éxito*. En breve un miembro de nuestro equipo se pondrá en contacto contigo a través de este número para definir los últimos detalles y coordinar la entrega.\n\n`;
      customerMsg += `📋 *RESUMEN DE TU COMPRA:*\n`;
      customerMsg += `━━━━━━━━━━━━━━━━━━━━━\n`;
      customerMsg += `👤 *DATOS DEL CLIENTE:*\n`;
      customerMsg += `• Nombre: ${clientName}\n`;
      customerMsg += `• WhatsApp: +${fullClientPhone}\n\n`;

      customerMsg += `📍 *FORMA DE ENTREGA:*\n`;
      if (isDelivery) {
        customerMsg += `• Tipo: Entrega a Domicilio 🚚\n`;
        customerMsg += `• Dirección: ${addressInput!.value.trim()}\n`;
        customerMsg += `• Receptor: ${recipientNameInput!.value.trim()} (+53${recipientPhoneInput!.value.trim()})\n\n`;
      } else {
        customerMsg += `• Tipo: Recogida en Tienda (Avellaneda #260) 🏪\n\n`;
      }

      customerMsg += `💵 *FORMA DE PAGO:*\n`;
      customerMsg += `• Moneda: ${selectedCurrency}\n`;
      customerMsg += `• Método: ${paymentMethod}\n\n`;

      if (notes) {
        customerMsg += `📝 *NOTAS DEL PEDIDO:*\n${notes}\n\n`;
      }

      customerMsg += `🛍️ *PRODUCTOS SELECCIONADOS:*\n`;
      items.forEach((i, idx) => {
        customerMsg += `${idx + 1}. *${i.name}*\n`;
        if (i.color) customerMsg += `   • Color: ${i.color}\n`;
        if (i.size) customerMsg += `   • Talla: ${i.size}\n`;
        customerMsg += `   • Cantidad: ${i.quantity}\n`;
        customerMsg += `   • Subtotal: ${ (i.priceCUP * i.quantity).toLocaleString('en-US') } CUP / $${ (i.priceUSD * i.quantity).toFixed(2) } USD\n\n`;
      });

      customerMsg += `━━━━━━━━━━━━━━━━━━━━━\n`;
      customerMsg += `💰 *TOTAL A PAGAR:* ${totalCUP.toLocaleString('en-US')} CUP / $${totalUSD.toFixed(2)} USD\n\n`;
      customerMsg += `📍 *Carmay Outfit* — Avellaneda No. 260, Camagüey.`;

      // Deshabilitar botón durante el proceso
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<span class="inline-flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" class="opacity-25"></circle>
            <path fill="currentColor" d="M4 12a8 8 0 018-8v3a5 5 0 00-5 5H4z"></path>
          </svg>
          Procesando Pedido...
        </span>`;
      }

      try {
        const API_URL = 'https://ia.carmayn8n.cloud/api/wa/send';
        const API_KEY = 'REDACTED_BAILEYS_API_KEY';

        // 1. Enviar Mensaje Único al cliente por WhatsApp (vía VPS Baileys API)
        await fetch(API_URL, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-api-key': API_KEY,
          },
          body: JSON.stringify({
            chatId: fullClientPhone,
            message: customerMsg,
          }),
        });

        // 2. Notificar también a la tienda (+REDACTED_PHONE_1)
        await fetch(API_URL, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-api-key': API_KEY,
          },
          body: JSON.stringify({
            chatId: 'REDACTED_PHONE_1',
            message: `🔔 *NUEVA ORDEN RECIBIDA DESDE LA WEB*\n\n` + customerMsg,
          }),
        });

      } catch (e) {
        console.error('Error enviando notificaciones por Baileys API:', e);
      }

      // Vaciar Carrito en localStorage
      CartCRUD.clear();

      // Mostrar modal de éxito
      if (successModal) {
        successModal.classList.remove('hidden');
        successModal.classList.add('flex');
      }
    });

    renderTicketItems();
  });
</script>
