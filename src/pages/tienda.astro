---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProductCard from '../components/ProductCard.astro';
import CatalogFilterBar from '../components/CatalogFilterBar.astro';
import StoreBanner from '../components/StoreBanner.astro';
import { woo } from '../api';
import { sortProductsByCuratedScore } from '../utils/productRanking';

// Categorías de la tienda
const storeCategories = [
  {
    name: "Calzado",
    image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=600&q=80",
    slug: "zapatos"
  },
  {
    name: "Ropa",
    image: "https://images.unsplash.com/photo-1489987707025-afc232f7ea0f?auto=format&fit=crop&w=600&q=80",
    slug: "ropa"
  },
  {
    name: "Bolsos y Mochilas",
    image: "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=600&q=80",
    slug: "jackets"
  },
  {
    name: "Tecnología",
    image: "https://images.unsplash.com/photo-1593359677879-a4bb92f829d1?auto=format&fit=crop&w=600&q=80",
    slug: "tecnologia"
  },
  {
    name: "Accesorios",
    image: "https://images.unsplash.com/photo-1523293182086-7651a899d37f?auto=format&fit=crop&w=600&q=80",
    slug: "accesorios"
  }
];

// Obtener catálogo completo para el motor de búsqueda y catálogo
const allRawProducts = await woo.products.getAll();
const validProducts = allRawProducts.filter(p => p.hasRealImage);

// Ordenamiento multicriterio precalculado en build:
// Combina alta demanda (ventas) + ofertas activas + escasez (bajo stock) + tendencias.
// Los productos en stock y de mayor impacto comercial van arriba; los agotados al final.
const sortedCatalogProducts = sortProductsByCuratedScore(validProducts);

// Calcular rango de precios CUP para el filtro
const pricesCUP = sortedCatalogProducts.map(p => p.priceCUP).filter(p => p > 0);
const rawMaxCUP = pricesCUP.length > 0 ? Math.max(...pricesCUP) : 350000;

// Redondear el máximo al millar superior limpio (ej. 49321 -> 50000)
function roundUpToCleanThousands(val: number): number {
  if (val <= 10000) return Math.ceil(val / 1000) * 1000;
  if (val <= 50000) return Math.ceil(val / 5000) * 5000;
  return Math.ceil(val / 10000) * 10000;
}

const minCatalogPriceCUP = 0;
const maxCatalogPriceCUP = roundUpToCleanThousands(rawMaxCUP);
---
<Layout title="Carmay Outfit - Tienda Online">
  <Fragment slot="head">
    <link rel="prefetch" href="/tienda/zapatos/" as="document">
    <link rel="prefetch" href="/tienda/ropa/" as="document">
    <link rel="prefetch" href="/tienda/jackets/" as="document">
    <link rel="prefetch" href="/tienda/tecnologia/" as="document">
    <link rel="prefetch" href="/tienda/accesorios/" as="document">
  </Fragment>

  <Header showCategoryBar={true} />

  <!-- ============= SECTION: HERO CATEGORÍAS ============= -->
  <section id="categorias-section" class="relative pt-14 pb-10 sm:pt-20 sm:pb-14 overflow-hidden">
    <!-- Glow background amarillo -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] md:w-[700px] md:h-[700px] rounded-full bg-gradient-to-tr from-yellow-500/5 via-yellow-600/3 to-yellow-400/5 blur-[150px] pointer-events-none -z-10"></div>

    <!-- Mensaje marketing en dorado con brillo metálico -->
    <div class="text-center mb-10 px-4">
      <h1 class="text-3xl sm:text-5xl font-black tracking-widest mb-3 text-white drop-shadow-[0_4px_20px_rgba(234,179,8,0.2)]">
        <span class="block">ENCUENTRA LO QUE BUSCAS</span>
      </h1>
      <p class="text-sm sm:text-lg text-slate-400 drop-shadow-[0_2px_8px_rgba(255,255,255,0.03)]">
        Explora nuestras principales categorías y encuentra lo que necesitas hoy mismo
      </p>
    </div>

    <!-- Cards de categoría con animación escalonada -->
    <div class="w-full max-w-6xl mx-auto grid grid-cols-2 sm:grid-cols-3 gap-4 sm:gap-6 px-4">
      {storeCategories.map((cat, idx) => (
        <a
          href={`/tienda/${cat.slug}/`}
          class={`group relative rounded-2xl overflow-hidden
            bg-[#0f1120]/80 backdrop-blur-sm
            border border-white/[0.08]
            shadow-[0_8px_32px_rgba(255,255,255,0.06),0_2px_60px_rgba(0,0,0,0.6)]
            hover:shadow-[0_12px_48px_rgba(234,179,8,0.12),0_2px_60px_rgba(0,0,0,0.6)]
            hover:-translate-y-1.5
            transition-[transform,box-shadow] duration-300 ease-out
            reveal-on-scroll reveal-delay-${(idx % 3) + 1}`}>
          <!-- Halo dorado en hover -->
          <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
            style="box-shadow: inset 0 0 0 1px rgba(234,179,8,0.15);"></div>
          <div class="relative overflow-hidden">
            <img
              src={cat.image}
              alt={cat.name}
              class="w-full h-44 object-cover object-center transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#090b11] via-transparent to-transparent opacity-60"></div>
          </div>
          <div class="p-4 border-t border-white/[0.04]">
            <h3 class="text-lg font-bold text-white group-hover:text-yellow-300 transition-colors drop-shadow-[0_2px_8px_rgba(255,255,255,0.05)]">{cat.name}</h3>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Banner de Tienda Física & Entrega Diaria Garantizada (Justo después de las cards de categorías) -->
  <StoreBanner />

  <!-- ============= SECTION: CATÁLOGO COMPLETO DE PRODUCTOS ============= -->
  <section id="productos-section" class="py-8 sm:py-12 border-t border-white/[0.04]">
    <div class="max-w-7xl mx-auto px-2 sm:px-4 lg:px-8">
      <!-- Header de sección -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-4 pb-3 border-b border-white/[0.06] reveal-on-scroll px-2 sm:px-0">
        <div>
          <h2 class="text-xl sm:text-3xl font-extrabold text-white tracking-tight drop-shadow-[0_4px_15px_rgba(255,255,255,0.05)]">
            Todos Nuestros Productos
          </h2>
          <p class="text-slate-400 text-xs sm:text-sm mt-1 drop-shadow-[0_2px_8px_rgba(255,255,255,0.03)]">
            Nuestros mejores productos destacados por alta demanda, ofertas activas y disponibilidad inmediata en Camagüey.
          </p>
        </div>
      </div>

      <!-- Barra Interactiva de Filtros: Tags (Rebaja/Tendencias) y Selector de Presupuesto con Slider Dual CUP -->
      <div class="reveal-on-scroll reveal-delay-1 px-1 sm:px-0">
        <CatalogFilterBar 
          minPriceCUP={minCatalogPriceCUP}
          maxPriceCUP={maxCatalogPriceCUP}
          totalProducts={sortedCatalogProducts.length}
        />
      </div>

      <!-- Grid de productos estilo Temu: Waterfall / Masonry de 2 columnas en móvil y 5 en desktop, sin espacios fantasma -->
      <div class="columns-2 sm:columns-3 md:columns-3 lg:columns-4 xl:columns-5 [column-gap:8px] sm:[column-gap:10px] lg:[column-gap:12px] w-full">
        {sortedCatalogProducts.map((product, idx) => (
          <ProductCard
            title={product.name}
            price={product.priceFormatted}
            regularPrice={product.regularPriceFormatted}
            priceUSD={product.price}
            priceCUP={product.priceCUP}
            cupRate={product.cupRate}
            regularPriceUSD={product.regularPrice}
            regularPriceCUP={product.regularPriceCUP}
            image={product.primaryImage}
            category={product.categoryName || "Sin categoría"}
            categorySlug={product.categorySlug}
            slug={product.slug}
            isTrending={product.isTrending}
            stockQuantity={product.stockQuantity}
            isInStock={product.isInStock}
            permalink={`/producto/${product.slug}/`}
            revealDelayClass={`reveal-delay-${(idx % 4) + 1}`}
          />
        ))}
      </div>

      <!-- Empty State amigable cuando nada coincide con los filtros (fuera del flujo de columnas) -->
      <div id="filter-empty-state" class="hidden py-16 px-4 text-center w-full">
        <div class="max-w-md mx-auto bg-[#0d0f1a] border border-white/[0.08] rounded-3xl p-8 sm:p-10 shadow-2xl space-y-4">
          <div class="w-16 h-16 rounded-2xl bg-purple-950/60 border border-purple-500/30 flex items-center justify-center mx-auto text-2xl shadow-inner">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <h3 class="text-xl sm:text-2xl font-black text-white tracking-tight">
            No encontramos productos en este rango
          </h3>
          <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">
            No hay artículos que coincidan con los filtros aplicados. Prueba ampliando tu presupuesto o limpiando los filtros para ver todo el catálogo.
          </p>
          <div class="pt-2">
            <button 
              type="button" 
              id="empty-state-reset-btn"
              class="inline-flex items-center gap-2 min-h-[44px] px-6 py-3.5 rounded-full bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-black font-extrabold text-xs tracking-wider uppercase transition-all shadow-[0_4px_20px_rgba(234,179,8,0.3)] hover:-translate-y-0.5 cursor-pointer"
            >
              Ver todos los productos
            </button>
          </div>
        </div>
      </div>

      {sortedCatalogProducts.length === 0 && (
        <p class="text-center text-slate-400 py-12">
          No hay productos disponibles.
        </p>
      )}
    </div>
  </section>
</Layout>

<!-- Eliminar script de opacidad obsoleta para navbar sticky natural -->