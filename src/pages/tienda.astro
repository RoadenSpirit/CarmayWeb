---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProductCard from '../components/ProductCard.astro';
import CatalogFilterBar from '../components/CatalogFilterBar.astro';
import { woo } from '../api';
import { sortProductsByCuratedScore } from '../utils/productRanking';

// Categorías de la tienda
const storeCategories = [
  {
    name: "Calzado",
    image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=600&q=80",
    slug: "zapatos"
  },
  {
    name: "Ropa",
    image: "https://images.unsplash.com/photo-1489987707025-afc232f7ea0f?auto=format&fit=crop&w=600&q=80",
    slug: "ropa"
  },
  {
    name: "Bolsos y Mochilas",
    image: "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=600&q=80",
    slug: "jackets"
  },
  {
    name: "Tecnología",
    image: "https://images.unsplash.com/photo-1593359677879-a4bb92f829d1?auto=format&fit=crop&w=600&q=80",
    slug: "tecnologia"
  },
  {
    name: "Accesorios",
    image: "https://images.unsplash.com/photo-1523293182086-7651a899d37f?auto=format&fit=crop&w=600&q=80",
    slug: "accesorios"
  }
];

// Obtener catálogo completo para el motor de búsqueda y catálogo
const allRawProducts = await woo.products.getAll();
const validProducts = allRawProducts.filter(p => p.hasRealImage);

// Ordenamiento multicriterio precalculado en build:
// Combina alta demanda (ventas) + ofertas activas + escasez (bajo stock) + tendencias.
// Los productos en stock y de mayor impacto comercial van arriba; los agotados al final.
const sortedCatalogProducts = sortProductsByCuratedScore(validProducts);

// Calcular rango de precios USD para el filtro
const pricesUSD = sortedCatalogProducts.map(p => p.price).filter(p => p > 0);
const minCatalogPriceUSD = pricesUSD.length > 0 ? Math.floor(Math.min(...pricesUSD)) : 0;
const maxCatalogPriceUSD = pricesUSD.length > 0 ? Math.ceil(Math.max(...pricesUSD)) : 500;
---
<Layout title="Carmay Outfit - Tienda Online">
  <Fragment slot="head">
    <link rel="prefetch" href="/tienda/zapatos/" as="document">
    <link rel="prefetch" href="/tienda/ropa/" as="document">
    <link rel="prefetch" href="/tienda/jackets/" as="document">
    <link rel="prefetch" href="/tienda/tecnologia/" as="document">
    <link rel="prefetch" href="/tienda/accesorios/" as="document">
  </Fragment>

  <Header />

  <!-- ============= SECTION: HERO CATEGORÍAS ============= -->
  <section id="categorias-section" class="relative py-12 sm:py-16 overflow-hidden">
    <!-- Glow background amarillo -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] md:w-[700px] md:h-[700px] rounded-full bg-gradient-to-tr from-yellow-500/5 via-yellow-600/3 to-yellow-400/5 blur-[150px] pointer-events-none -z-10"></div>

    <!-- Mensaje marketing en dorado con brillo metálico -->
    <div class="text-center mb-10 px-4">
      <h1 class="text-3xl sm:text-5xl font-black tracking-widest mb-3 drop-shadow-[0_4px_20px_rgba(234,179,8,0.2)]"
        style="background: linear-gradient(to right, #D4AF37, #F5D76B);
               -webkit-background-clip: text;
               -webkit-text-fill-color: transparent;
               text-fill-color: transparent;">
        <span class="block">ENCUENTRA LO QUE BUSCAS</span>
      </h1>
      <p class="text-sm sm:text-lg text-slate-400 drop-shadow-[0_2px_8px_rgba(255,255,255,0.03)]">
        Explora nuestras principales categorías y encuentra lo que necesitas hoy mismo
      </p>
    </div>

    <!-- Cards de categoría -->
    <div class="w-full max-w-6xl mx-auto grid grid-cols-2 sm:grid-cols-3 gap-4 sm:gap-6 px-4">
      {storeCategories.map((cat) => (
        <a
          href={`/tienda/${cat.slug}/`}
          class="group relative rounded-2xl overflow-hidden
            bg-[#0f1120]/80 backdrop-blur-sm
            border border-white/[0.08]
            shadow-[0_8px_32px_rgba(255,255,255,0.06),0_2px_60px_rgba(0,0,0,0.6)]
            hover:shadow-[0_12px_48px_rgba(234,179,8,0.12),0_2px_60px_rgba(0,0,0,0.6)]
            hover:-translate-y-1
            transition-[transform,box-shadow] duration-300 ease-out">
          <!-- Halo dorado en hover -->
          <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
            style="box-shadow: inset 0 0 0 1px rgba(234,179,8,0.15);"></div>
          <div class="relative overflow-hidden">
            <img
              src={cat.image}
              alt={cat.name}
              class="w-full h-44 object-cover object-center transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#090b11] via-transparent to-transparent opacity-60"></div>
          </div>
          <div class="p-4 border-t border-white/[0.04]">
            <h3 class="text-lg font-bold text-white mb-1 group-hover:text-yellow-300 transition-colors drop-shadow-[0_2px_8px_rgba(255,255,255,0.05)]">{cat.name}</h3>
            <p class="text-xs text-slate-400 line-clamp-2">Explora nuestra selección</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ============= LÍNEA SEPARADORA ============= -->
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    <div class="h-px bg-gradient-to-r from-transparent via-yellow-500/30 to-transparent"></div>
  </div>

  <!-- ============= NAVBAR CATEGORÍAS ============= -->
  <nav id="categorias-navbar" class="fixed left-0 right-0 z-40 backdrop-blur-2xl bg-[#090b11]/75 border-b border-white/[0.06] shadow-[0_8px_32px_rgba(0,0,0,0.5)]" style="top: var(--headerh, 0px); opacity: 0; pointer-events: none; transition: opacity 0.4s ease;">
    <!-- Línea inferior de acento amarillo -->
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-yellow-500/40 to-transparent"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-center gap-2 py-4">
        {storeCategories.map((cat, i) => (
          <div class="flex items-center">
            {i > 0 && <div class="h-6 mx-4" style="width: 1px; background: linear-gradient(to bottom, transparent, rgba(234,179,8,0.4), transparent);"></div>}
            <a
              href={`/tienda/${cat.slug}/`}
              class="text-base sm:text-lg font-semibold text-slate-300 hover:text-yellow-400 transition-colors whitespace-nowrap px-4 py-2"
            >
              {cat.name}
            </a>
          </div>
        ))}
      </div>
    </div>
  </nav>

  <!-- ============= SECTION: CATÁLOGO COMPLETO DE PRODUCTOS ============= -->
  <section id="productos-section" class="py-12 sm:py-20 border-t border-white/[0.04]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header de sección -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-6 border-b border-white/[0.06]">
        <div>
          <span class="text-xs font-black text-amber-400 uppercase tracking-widest block mb-2 drop-shadow-[0_2px_8px_rgba(234,179,8,0.2)]">CATÁLOGO CURADO</span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight drop-shadow-[0_4px_15px_rgba(255,255,255,0.05)]">
            Todos Nuestros Productos
          </h2>
          <p class="text-slate-400 text-xs sm:text-sm mt-2 drop-shadow-[0_2px_8px_rgba(255,255,255,0.03)]">
            Nuestros mejores productos destacados por alta demanda, ofertas activas y disponibilidad inmediata en Camagüey.
          </p>
        </div>
      </div>

      <!-- Barra Interactiva de Filtros: Tags (Rebaja/Tendencias) y Selector de Presupuesto con Slider -->
      <CatalogFilterBar 
        minPriceUSD={minCatalogPriceUSD}
        maxPriceUSD={maxCatalogPriceUSD}
        totalProducts={sortedCatalogProducts.length}
      />

      <!-- Grid de productos -->
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        {sortedCatalogProducts.map((product) => (
          <ProductCard
            title={product.name}
            price={product.priceFormatted}
            regularPrice={product.regularPriceFormatted}
            priceUSD={product.price}
            priceCUP={product.priceCUP}
            cupRate={product.cupRate}
            regularPriceUSD={product.regularPrice}
            regularPriceCUP={product.regularPriceCUP}
            image={product.primaryImage}
            category={product.categoryName || "Sin categoría"}
            categorySlug={product.categorySlug}
            slug={product.slug}
            isTrending={product.isTrending}
            stockQuantity={product.stockQuantity}
            isInStock={product.isInStock}
            permalink={`/producto/${product.slug}/`}
          />
        ))}

        {sortedCatalogProducts.length === 0 && (
          <p class="col-span-4 text-center text-slate-400 py-12">
            No hay productos disponibles.
          </p>
        )}
      </div>
    </div>
  </section>
</Layout>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const navbar = document.getElementById('categorias-navbar');
  const section = document.getElementById('categorias-section');
  
  function updateNavbar() {
    if (!section || !navbar) return;
    const sectionBottom = section.offsetTop + section.offsetHeight;
    const currentScroll = window.pageYOffset;
    
    if (currentScroll > sectionBottom - 120) {
      navbar.style.opacity = '1';
      navbar.style.pointerEvents = 'auto';
    } else {
      navbar.style.opacity = '0';
      navbar.style.pointerEvents = 'none';
    }
  }
  
  window.addEventListener('scroll', updateNavbar);
  updateNavbar();
});
</script>