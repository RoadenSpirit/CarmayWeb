---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const contactChannels = [
  {
    title: "WhatsApp Directo",
    subtitle: "Respuesta inmediata",
    value: "(+53) 63791924",
    link: "https://wa.me/5363791924?text=Hola%20Carmay%20Outfit,%20necesito%20asistencia",
    btnText: "Escribir al WhatsApp",
    badgeColor: "bg-emerald-500/10 text-emerald-400 border-emerald-500/30",
    accentGlow: "group-hover:border-emerald-500/50 group-hover:shadow-[0_8px_30px_rgba(16,185,129,0.15)]",
    iconBg: "bg-emerald-500/20 text-emerald-400 border-emerald-500/40",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" /></svg>`
  },
  {
    title: "Facebook Oficial",
    subtitle: "Comunidad y Novedades",
    value: "Carmay Outfit – Tienda Online",
    link: "https://www.facebook.com/carmayoutfittiendaonline",
    btnText: "Visitar en Facebook",
    badgeColor: "bg-blue-500/10 text-blue-400 border-blue-500/30",
    accentGlow: "group-hover:border-blue-500/50 group-hover:shadow-[0_8px_30px_rgba(59,130,246,0.15)]",
    iconBg: "bg-blue-500/20 text-blue-400 border-blue-500/40",
    icon: `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`
  },
  {
    title: "Línea Telefónica",
    subtitle: "Atención en horario comercial",
    value: "(+53) 63791924",
    link: "tel:+5363791924",
    btnText: "Llamar Ahora",
    badgeColor: "bg-amber-500/10 text-amber-400 border-amber-500/30",
    accentGlow: "group-hover:border-amber-500/50 group-hover:shadow-[0_8px_30px_rgba(234,179,8,0.15)]",
    iconBg: "bg-amber-500/20 text-amber-400 border-amber-500/40",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>`
  },
  {
    title: "Correo Electrónico",
    subtitle: "Consultas institucionales",
    value: "carmaytienda@gmail.com",
    link: "mailto:carmaytienda@gmail.com",
    btnText: "Enviar Mensaje",
    badgeColor: "bg-purple-500/10 text-purple-400 border-purple-500/30",
    accentGlow: "group-hover:border-purple-500/50 group-hover:shadow-[0_8px_30px_rgba(168,85,247,0.15)]",
    iconBg: "bg-purple-500/20 text-purple-400 border-purple-500/40",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`
  }
];
---

<Layout title="Contáctanos • Carmay Outfit Camagüey">
  <Header />

  <!-- Breadcrumbs -->
  <div class="pt-28 sm:pt-36 pb-4 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="flex items-center gap-2 text-sm text-slate-400">
      <a href="/" class="hover:text-yellow-400 transition-colors inline-flex items-center justify-center min-w-[44px] min-h-[44px]">Inicio</a>
      <span class="text-slate-600">&rsaquo;</span>
      <span class="text-slate-200 font-medium">Contáctanos</span>
    </nav>
  </div>

  <!-- ================= 1. HERO SECTION: Estamos aquí para ayudarte ================= -->
  <section class="pb-12 sm:pb-16 pt-4 sm:pt-6 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Columna 1 (Izquierda en desktop, OCULTA en móvil): Imagen de Atención al Cliente a Gran Escala -->
      <div class="hidden lg:flex lg:col-span-5 xl:col-span-5 justify-center items-center reveal-scale">
        <div class="relative w-full max-w-lg">
          <!-- Brillo de fondo sutil -->
          <div class="absolute inset-0 bg-gradient-to-tr from-amber-500/25 via-purple-600/20 to-transparent rounded-full blur-3xl -z-10 pointer-events-none"></div>
          
          <div class="relative rounded-3xl overflow-hidden border border-white/[0.12] bg-[#0e101a]/70 backdrop-blur-xl p-5 sm:p-7 shadow-[0_20px_60px_rgba(0,0,0,0.7)]">
            <img 
              src="/atencion-cliente.png" 
              alt="Atención al Cliente Carmay Outfit" 
              width="700" 
              height="700"
              class="w-full h-auto object-contain rounded-2xl filter drop-shadow-[0_12px_32px_rgba(0,0,0,0.5)] transition-transform duration-500 hover:scale-[1.02]"
              loading="eager"
            />
            <!-- Insignia flotante integrada -->
            <div class="mt-4 p-3.5 rounded-2xl bg-black/50 border border-white/10 flex items-center gap-3.5 backdrop-blur-md">
              <div class="w-11 h-11 rounded-xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z" />
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-white text-sm">Asesoría Cálida y Humana</h4>
                <p class="text-xs text-slate-300">Atención directa y personalizada en Camagüey</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna 2 (Derecha en desktop, ancho completo en móvil): Contenido Editorial & Acciones -->
      <div class="lg:col-span-7 xl:col-span-7 space-y-6 w-full">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30 reveal-pop">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span>Atención al Cliente Personalizada</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-5xl xl:text-6xl font-black text-white tracking-tight leading-[1.15] reveal-on-scroll reveal-delay-1" style="font-family: 'Outfit', sans-serif;">
          Estamos aquí para <br />
          <span class="text-amber-400">
            ayudarte siempre
          </span>
        </h1>

        <p class="text-slate-300 text-sm sm:text-base lg:text-lg leading-relaxed max-w-2xl reveal-on-scroll reveal-delay-2">
          Si tienes dudas sobre tu pedido, quieres conocer nuestras ofertas o necesitas asistencia personalizada, escríbenos. En <strong class="text-white font-bold">Carmay Outfit</strong> tu satisfacción es nuestra prioridad absoluta.
        </p>

        <!-- Píldoras de Beneficios Rápidos (2 columnas simétricas en desktop/tablet, apiladas cómodas en móvil) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 reveal-on-scroll reveal-delay-3">
          <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-white/[0.03] border border-white/[0.08]">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
            </svg>
            <span class="text-xs sm:text-sm font-semibold text-slate-200 leading-snug">Respuesta en menos de 15 minutos</span>
          </div>
          <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-white/[0.03] border border-white/[0.08]">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0zM13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.6a1 1 0 01.9.6l1.4 2a1 1 0 01.1.7V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
            </svg>
            <span class="text-xs sm:text-sm font-semibold text-slate-200 leading-snug">Coordinación de entregas el mismo día</span>
          </div>
        </div>

        <!-- Botones de Acción Directa con Simetría Idéntica a las Píldoras -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1 reveal-pop reveal-delay-4">
          <a 
            href="https://wa.me/5363791924?text=Hola%20Carmay%20Outfit,%20necesito%20asistencia" 
            target="_blank"
            class="w-full min-h-[48px] flex items-center justify-center gap-2 p-3.5 sm:p-4 rounded-2xl bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 active:scale-95 text-white font-extrabold text-xs sm:text-sm uppercase tracking-wider shadow-lg shadow-emerald-600/30 hover:shadow-emerald-600/40 hover:-translate-y-0.5 transition-all cursor-pointer text-center"
          >
            <span class="inline-flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
              </svg>
              Escribir por WhatsApp
            </span>
          </a>
          <a 
            href="#tienda-fisica" 
            class="w-full min-h-[48px] flex items-center justify-center gap-2 p-3.5 sm:p-4 rounded-2xl border border-white/15 bg-white/[0.04] hover:bg-white/[0.08] hover:border-amber-400/40 text-slate-200 hover:text-white active:scale-95 text-xs sm:text-sm font-bold hover:-translate-y-0.5 transition-all cursor-pointer text-center"
          >
            <span class="inline-flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              Visitar Tienda Física
            </span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ================= 2. CANALES DE CONTACTO DIRECTOS (4 CARDS) ================= -->
  <section class="py-14 bg-[#0a0c14] border-y border-white/[0.06]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12 reveal-on-scroll">
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight" style="font-family: 'Outfit', sans-serif;">
          Comunícate con Nosotros
        </h2>
        <p class="text-slate-400 text-sm mt-2">
          Elige la vía que te resulte más cómoda para recibir respuesta inmediata.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        {contactChannels.map((c, idx) => (
          <div class={`group relative rounded-3xl p-5 sm:p-7 bg-[#0f1220]/90 backdrop-blur-md border border-white/[0.08] flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 shadow-[0_8px_30px_rgba(0,0,0,0.4)] ${c.accentGlow} reveal-card reveal-delay-${idx + 1}`}>
            <div>
              <!-- Icono y Badge -->
              <div class="flex items-center justify-between gap-2 mb-4 sm:mb-5">
                <div class={`w-11 h-11 sm:w-12 sm:h-12 rounded-2xl border flex items-center justify-center shrink-0 ${c.iconBg}`} set:html={c.icon}>
                </div>
                <span class={`text-xs font-bold px-2.5 py-1 rounded-full border ${c.badgeColor}`}>
                  {c.subtitle}
                </span>
              </div>

              <!-- Textos -->
              <h3 class="text-base sm:text-xl font-extrabold text-white mb-1.5 group-hover:text-amber-300 transition-colors">
                {c.title}
              </h3>
              <p class="text-sm sm:text-base font-mono text-slate-200 font-bold break-all mb-5 sm:mb-6">
                {c.value}
              </p>
            </div>

            <!-- Botón CTA con mínimo 44px de área táctil -->
            <a 
              href={c.link} 
              target="_blank"
              class="w-full min-h-[44px] inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl border border-white/15 bg-white/[0.04] hover:bg-white/[0.12] hover:border-amber-400/50 text-white font-bold text-xs sm:text-sm transition-all cursor-pointer"
            >
              <span>{c.btnText}</span>
              <span class="text-amber-400">&nearr;</span>
            </a>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ================= 3. TIENDA FÍSICA + HORARIOS ================= -->
  <section id="tienda-fisica" class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-24">
    <div class="rounded-3xl p-6 sm:p-10 bg-gradient-to-br from-[#121524] to-[#0c0e18] border border-white/[0.1] shadow-2xl reveal-on-scroll">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Columna Izquierda: Información de Local y Horarios (5 cols) -->
        <div class="lg:col-span-5 flex flex-col justify-between gap-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30 w-fit">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V7l7-4 7 4v14M9 9h.01M12 9h.01M15 9h.01M9 13h.01M12 13h.01M15 13h.01M10 21v-4h4v4" />
            </svg>
            <span>Local Comercial</span>
          </div>

          <div>
            <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight mb-2" style="font-family: 'Outfit', sans-serif;">
              Visita Nuestra Tienda
            </h2>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
              Prueba personalmente cada prenda, calzado o comprueba el funcionamiento y calidad de los equipos de tecnología.
            </p>
          </div>

          <!-- Bloque Dirección Oficial con acceso a Google Maps -->
          <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/[0.08] space-y-1.5">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-400 inline-flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              Ubicación en Camagüey
            </span>
            <p class="text-sm sm:text-base font-semibold text-white leading-snug">
              <a 
                href="https://maps.google.com/?q=Avellaneda+260,+Camaguey,+Cuba" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="hover:text-amber-400 transition-colors inline-flex items-center gap-1.5 underline-offset-4 hover:underline min-h-[44px] py-1"
                title="Abrir ubicación en Google Maps"
              >
                <span>Avellaneda No. 260 entre San Esteban y San Martín</span>
                <span class="text-amber-400 text-sm font-mono">&nearr;</span>
              </a>
            </p>
          </div>

          <!-- Bloque Horarios Oficiales -->
          <div class="space-y-2.5">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-400 inline-flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="9" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2" />
              </svg>
              Horarios de Atención
            </span>
            
            <div class="flex items-center justify-between p-3 rounded-xl bg-white/[0.02] border border-white/[0.06] text-xs sm:text-sm">
              <span class="text-slate-300 font-medium">De Lunes a Viernes</span>
              <span class="text-white font-mono font-bold bg-purple-950/60 px-2.5 py-1 rounded-lg border border-purple-500/30">
                8:30 AM – 4:30 PM
              </span>
            </div>

            <div class="flex items-center justify-between p-3 rounded-xl bg-white/[0.02] border border-white/[0.06] text-xs sm:text-sm">
              <span class="text-slate-300 font-medium">Sábados</span>
              <span class="text-white font-mono font-bold bg-amber-950/60 px-2.5 py-1 rounded-lg border border-amber-500/30">
                8:30 AM – 2:00 PM
              </span>
            </div>
          </div>

          <!-- Acciones Directas: Teléfono y GPS Maps -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1">
            <a 
              href="tel:+5363791924"
              class="flex-1 min-h-[44px] inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/15 text-white text-xs font-bold transition-all text-center"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>(+53) 63791924</span>
            </a>
            <a 
              href="https://maps.google.com/?q=Avellaneda+260,+Camaguey,+Cuba" 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex-1 min-h-[44px] inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 text-xs font-bold transition-all text-center"
            >
              <span>Abrir en Google Maps &nearr;</span>
            </a>
          </div>
        </div>

        <!-- Columna Derecha: Foto de la Fachada de la Tienda Física (7 cols) -->
        <div class="lg:col-span-7 flex flex-col gap-4">
          <div class="relative rounded-3xl overflow-hidden border border-white/[0.12] aspect-[16/10] shadow-2xl group">
            <img 
              src="/tienda-fisica.png" 
              alt="Fachada e Interior de la Tienda Física Carmay Outfit en Calle Avellaneda" 
              width="900" 
              height="560" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
            
            <div class="absolute bottom-5 left-5 right-5 flex items-center justify-between gap-3 text-white">
              <div>
                <span class="inline-block px-3 py-1 rounded-full bg-amber-500/20 border border-amber-500/40 text-amber-300 text-xs font-bold mb-1">
                  Atención Presencial
                </span>
                <p class="text-xs sm:text-sm text-slate-300">Te esperamos en el corazón comercial de Camagüey</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

    </div>
  </section>

  <!-- ================= 4. CTA AL CATÁLOGO: CIENTOS DE PRODUCTOS DISPONIBLES ================= -->
  <section class="pt-14 pb-24 sm:pt-20 sm:pb-32 bg-gradient-to-r from-purple-950/80 via-[#131122] to-purple-950/80 border-t border-purple-900/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative rounded-3xl p-8 sm:p-12 lg:p-16 border border-amber-500/30 bg-[#0d0f1a]/95 backdrop-blur-2xl shadow-[0_20px_60px_rgba(0,0,0,0.7)] overflow-hidden reveal-blur-fade">
        
        <!-- Glows decorativos de fondo -->
        <div class="absolute -top-24 -left-24 w-72 h-72 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-purple-600/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 max-w-3xl mx-auto text-center space-y-6">
          
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30">
