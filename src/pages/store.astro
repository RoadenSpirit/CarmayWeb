---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProductCard from '../components/ProductCard.astro';
import { woo } from '../api';

// Categorías de la tienda
const storeCategories = [
  {
    name: "Calzado",
    image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=600&q=80",
    slug: "zapatos"
  },
  {
    name: "Ropa",
    image: "https://images.unsplash.com/photo-1489987707025-afc232f7ea0f?auto=format&fit=crop&w=600&q=80",
    slug: "ropa"
  },
  {
    name: "Bolsos y Mochilas",
    image: "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=600&q=80",
    slug: "jackets"
  },
  {
    name: "Tecnología",
    image: "https://images.unsplash.com/photo-1593359677879-a4bb92f829d1?auto=format&fit=crop&w=600&q=80",
    slug: "tecnologia"
  },
  {
    name: "Accesorios",
    image: "https://images.unsplash.com/photo-1523293182086-7651a899d37f?auto=format&fit=crop&w=600&q=80",
    slug: "accesorios"
  }
];

// Productos iniciales (más vendidos)
const initialProducts = await (async () => {
  const products = await woo.products.getBestSellers(24);
  return products.filter(p => p.hasRealImage && p.isInStock);
})();
---
<Layout title="Carmay Outfit - Tienda Online">
  <Fragment slot="head">
    <link rel="prefetch" href="/store/zapatos/" as="document">
    <link rel="prefetch" href="/store/ropa/" as="document">
    <link rel="prefetch" href="/store/jackets/" as="document">
    <link rel="prefetch" href="/store/tecnologia/" as="document">
    <link rel="prefetch" href="/store/accesorios/" as="document">
  </Fragment>

  <Header />

  <!-- ============= SECTION: CENTRAL DE CATEGORÍAS PRINCIPALES ============= -->
  <section id="categorias-section" 
    class="bg-[#13111c] py-12 overflow-hidden">
    
    <!-- Mensaje marketing en dorado con brillo metalico -->
    <div class="text-center mb-8 px-4">
      <h1 class="text-3xl sm:text-5xl font-black tracking-widest mb-4 title-font"
        style="background: linear-gradient(to right, #D4AF37, #F5D76B);
               -webkit-background-clip: text;
               -webkit-text-fill-color: transparent;
               text-fill-color: transparent;">
        <span class="block">ENCUENTRA</span>
        <span class="block">CUALQUIER COSA</span>
      </h1>
      <p class="text-sm sm:text-lg opacity-80 mt-4" style="color: #D4AF37;">
        Explora nuestras principales categorías y encuentra lo que necesitas
      </p>
    </div>

    <!-- Cards de categoría - 2 filas: 3 arriba, 2 abajo -->
    <div class="w-full max-w-6xl mx-auto grid grid-cols-2 sm:grid-cols-3 gap-4 sm:gap-6 px-4">
      {storeCategories.map((cat) => (
        <a
          href={`/store/${cat.slug}/`}
          key={cat.name}
          class="group rounded-3xl overflow-hidden bg-gray-900/50 backdrop-blur-xl transition-all duration-500 hover:opacity-100 hover:shadow-2xl hover:scale-105">
          <img
            src={cat.image}
            alt={cat.name}
            class="w-full h-48 object-cover object-center transition-transform duration-500 group-hover:scale-110 group-hover:opacity-80"
            loading="lazy"
          />

          <div class="p-5">
            <h3 class="text-xl font-bold text-white mb-2">{cat.name}</h3>
            <p class="text-sm text-gray-400 line-clamp-2">Explora nuestra selección</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ============= NAVBAR CATEGORÍAS (aparece al hacer scroll) ============= -->
  <nav id="categorias-navbar" class="fixed left-0 right-0 z-40 backdrop-blur-xl" style="top: 64px; opacity: 0; pointer-events: none; transition: opacity 0.4s ease; background: linear-gradient(to bottom, #13111c 0%, rgba(19,17,28,0.95) 100%);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-center gap-0 py-3">
        {storeCategories.map((cat, i) => (
          <div class="flex items-center">
            {i > 0 && <div class="h-5 mx-3" style="width: 1px; background: linear-gradient(to bottom, transparent, rgba(168,85,247,0.6), transparent);"></div>}
            <a
              href={`/store/${cat.slug}/`}
              class="text-sm sm:text-base font-medium text-white hover:text-amber-400 transition-colors whitespace-nowrap px-3 py-1"
            >
              {cat.name}
            </a>
          </div>
        ))}
      </div>
    </div>
    <div class="h-px w-full" style="background: linear-gradient(to right, transparent, rgba(168,85,247,0.5) 30%, rgba(217,119,6,0.4) 70%, transparent);"></div>
  </nav>

  <!-- ============= SECTION: PRODUCTOS CON GRID RESPONSIVE ============= -->
  <section id="productos-section" class="bg-[#13111c] py-8 sm:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8 sm:mb-12">
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
        Productos Más Vendidos
      </h2>

      <p class="text-center text-gray-400 text-xs sm:text-sm mt-2">
        Los productos más vendidos de nuestra tienda
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {initialProducts.map((product) => (
        <ProductCard
          title={product.name}
          price={product.priceFormatted}
          regularPrice={product.regularPriceFormatted}
          priceUSD={product.price}
          priceCUP={product.priceCUP}
          cupRate={product.cupRate}
          regularPriceUSD={product.regularPrice}
          regularPriceCUP={product.regularPriceCUP}
          image={product.primaryImage}
          category={product.categoryName || "Sin categoría"}
          isTrending={product.isTrending}
          permalink={product.permalink}
        />
      ))}

      {initialProducts.length === 0 && (
        <p class="col-span-4 text-center text-gray-400">
          No hay productos disponibles.
        </p>
      )}
    </div>
  </section>
</Layout>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const navbar = document.getElementById('categorias-navbar');
  const section = document.getElementById('categorias-section');
  
  function updateNavbar() {
    const sectionBottom = section.offsetTop + section.offsetHeight;
    const currentScroll = window.pageYOffset;
    
    if (currentScroll > sectionBottom - 120) {
      navbar.style.opacity = '1';
      navbar.style.pointerEvents = 'auto';
    } else {
      navbar.style.opacity = '0';
      navbar.style.pointerEvents = 'none';
    }
  }
  
  window.addEventListener('scroll', updateNavbar);
  updateNavbar();
});
</script>