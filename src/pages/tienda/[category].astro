---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ProductCard from '../../components/ProductCard.astro';
import ExtendedSearchBar from '../../components/ExtendedSearchBar.astro';
import { woo } from '../../api';

// Categorías de la tienda
const storeCategories = [
  { name: "Calzado", slug: "zapatos", image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=600&q=80" },
  { name: "Ropa", slug: "ropa", image: "https://images.unsplash.com/photo-1489987707025-afc232f7ea0f?auto=format&fit=crop&w=600&q=80" },
  { name: "Bolsos y Mochilas", slug: "jackets", image: "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=600&q=80" },
  { name: "Tecnología", slug: "tecnologia", image: "https://images.unsplash.com/photo-1593359677879-a4bb92f829d1?auto=format&fit=crop&w=600&q=80" },
  { name: "Accesorios", slug: "accesorios", image: "https://images.unsplash.com/photo-1523293182086-7651a899d37f?auto=format&fit=crop&w=600&q=80" }
];

// Mapeo de IDs de categoría (WooCommerce real)
const categoryIdMap: any = { zapatos: 36, ropa: 37, jackets: 35, tecnologia: 54, accesorios: 34 };

// Generar paths estáticos para cada categoría
export async function getStaticPaths() {
  return [
    { params: { category: 'zapatos' } },
    { params: { category: 'ropa' } },
    { params: { category: 'jackets' } },
    { params: { category: 'tecnologia' } },
    { params: { category: 'accesorios' } }
  ];
}

// Obtener categoría actual
const { category } = Astro.params;
const catId = categoryIdMap[category] || 0;

// Obtener productos filtrados
const allCatProducts = catId > 0 ? await woo.products.getByCategory(catId, 100) : [];
const validCatProducts = allCatProducts.filter(p => p.hasRealImage);

// Ordenamiento estricto: productos en stock PRIMERO, agotados AL FINAL
const sortedProducts = [...validCatProducts].sort((a, b) => {
  if (a.isInStock !== b.isInStock) {
    return a.isInStock ? -1 : 1;
  }
  return 0;
});

// JSON plano para buscador
const searchableData = validCatProducts.map(p => ({
  id: p.id,
  name: p.name,
  slug: p.slug,
  category: p.categoryName || "General",
  categorySlug: p.categorySlug,
  primaryImage: p.primaryImage,
  priceUSD: p.price,
  priceCUP: p.priceCUP,
  regularPriceUSD: p.regularPrice,
  regularPriceCUP: p.regularPriceCUP,
  isOnSale: p.isOnSale,
  stockQuantity: p.stockQuantity,
  isInStock: p.isInStock,
  isTrending: p.isTrending,
  tags: p.tags.map(t => t.name),
}));

// Recomendados
const recommendedCards = validCatProducts.filter(p => p.isInStock).slice(0, 3).map(p => p.toCard());

// Nombre de la categoría actual
const currentCategory = storeCategories.find(c => c.slug === category);
const categoryName = currentCategory ? currentCategory.name : category;
---
<Layout title={`${categoryName} - Carmay Outfit`}>
  <Header />

  <!-- Buscador Extendido -->
  <ExtendedSearchBar 
    allProducts={searchableData} 
    recommendedProducts={recommendedCards} 
  />

  <!-- ============= NAVBAR CATEGORÍAS (siempre visible) ============= -->
  <nav class="fixed left-0 right-0 z-40 backdrop-blur-2xl bg-[#090b11]/75 border-b border-white/[0.06] shadow-[0_8px_32px_rgba(0,0,0,0.5)]" style="top: 80px;">
    <!-- Línea inferior de acento amarillo -->
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-yellow-500/40 to-transparent"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-center gap-2 py-4">
        {storeCategories.map((cat, i) => (
          <div class="flex items-center">
            {i > 0 && <div class="h-6 mx-4" style="width: 1px; background: linear-gradient(to bottom, transparent, rgba(234,179,8,0.4), transparent);"></div>}
            <a
              href={`/tienda/${cat.slug}/`}
              class={`text-base sm:text-lg font-semibold transition-colors whitespace-nowrap px-4 py-2 ${cat.slug === category ? 'text-yellow-400 drop-shadow-[0_2px_8px_rgba(234,179,8,0.3)]' : 'text-slate-300 hover:text-yellow-400'}`}
            >
              {cat.name}
            </a>
          </div>
        ))}
      </div>
    </div>
  </nav>

  <!-- ============= SECTION: PRODUCTOS FILTRADOS ============= -->
  <section id="productos-section" class="pt-24 pb-16 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header de sección -->
      <div class="text-center mb-10 sm:mb-14 pb-8 border-b border-white/[0.06]">
        <span class="text-xs font-black text-yellow-500/80 uppercase tracking-widest block mb-3 drop-shadow-[0_2px_8px_rgba(234,179,8,0.2)]">{categoryName}</span>
        <h1 class="text-3xl sm:text-5xl font-black tracking-widest mb-4 drop-shadow-[0_4px_20px_rgba(234,179,8,0.15)]"
          style="background: linear-gradient(to right, #D4AF37, #F5D76B);
                 -webkit-background-clip: text;
                 -webkit-text-fill-color: transparent;
                 text-fill-color: transparent;">
          {categoryName}
        </h1>
        <p class="text-sm sm:text-lg text-slate-400 drop-shadow-[0_2px_8px_rgba(255,255,255,0.03)]">
          Productos disponibles en la categoría {categoryName}
        </p>
      </div>

      <!-- Grid de productos -->
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        {sortedProducts.map((product) => (
          <ProductCard
            title={product.name}
            price={product.priceFormatted}
            regularPrice={product.regularPriceFormatted}
            priceUSD={product.price}
            priceCUP={product.priceCUP}
            cupRate={product.cupRate}
            regularPriceUSD={product.regularPrice}
            regularPriceCUP={product.regularPriceCUP}
            image={product.primaryImage}
            category={product.categoryName || "Sin categoría"}
            categorySlug={product.categorySlug}
            slug={product.slug}
            isTrending={product.isTrending}
            stockQuantity={product.stockQuantity}
            isInStock={product.isInStock}
            permalink={`/producto/${product.slug}/`}
          />
        ))}

        {sortedProducts.length === 0 && (
          <p class="col-span-2 sm:col-span-4 text-center text-slate-400 py-12">
            No hay productos disponibles en esta categoría.
          </p>
        )}
      </div>
    </div>
  </section>
</Layout>