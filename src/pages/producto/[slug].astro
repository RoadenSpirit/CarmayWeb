---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ProductCard from '../../components/ProductCard.astro';
import { woo } from '../../api';
import type { ProductData } from '../../api/models/Product.js';

interface Props {
  product: ProductData;
}

// Generar paths estáticos para cada producto
export async function getStaticPaths() {
  const products = await woo.products.getAll();
  return products
    .filter(p => p.hasRealImage)
    .map((product) => ({
      params: { slug: product.slug },
      props: { product: product.toJSON() },
    }));
}

const { product } = Astro.props;

// Productos relacionados de la misma categoría
const relatedProducts = await woo.products.getByCategory(product.categories[0]?.id ?? 0, 20);
const relatedFiltered = relatedProducts
  .filter(p => p.hasRealImage && p.isInStock && p.slug !== product.slug)
  .slice(0, 4);

const formatCUP = (n: number) => `${(n || 0).toLocaleString('en-US')} CUP`;
const formatUSD = (n: number) => {
  const val = n || 0;
  return val % 1 === 0 ? `$${val.toFixed(0)} USD` : `$${val.toFixed(2)} USD`;
};
const savingsCUP = product.isOnSale ? (product.regularPriceCUP || 0) - (product.priceCUP || 0) : 0;
const savingsUSD = product.isOnSale ? (product.regularPrice || 0) - (product.price || 0) : 0;
---
<Layout title={`${product.name} - Carmay Outfit`}>
  <Header />

  <!-- Breadcrumbs -->
  <div class="pt-24 pb-4 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="flex items-center gap-2 text-sm text-slate-400">
      <a href="/" class="hover:text-yellow-400 transition-colors">Inicio</a>
      <span class="text-slate-600">&rsaquo;</span>
      <a href="/tienda/" class="hover:text-yellow-400 transition-colors">Tienda</a>
      <span class="text-slate-600">&rsaquo;</span>
      {product.categories[0] && (
        <>
          <a href={`/tienda/${product.categorySlug}/`} class="hover:text-yellow-400 transition-colors">{product.categoryName}</a>
          <span class="text-slate-600">&rsaquo;</span>
        </>
      )}
      <span class="text-slate-200 font-medium truncate max-w-[200px]">{product.name}</span>
    </nav>
  </div>

  <!-- ===== SECCIÓN PRINCIPAL: 2 columnas ===== -->
  <section class="pb-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">

      <!-- ============= COLUMNA IZQUIERDA: GALERÍA DE IMÁGENES ============= -->
      <div class="flex flex-col gap-4">
        <!-- Imagen Principal -->
        <div class="relative rounded-3xl overflow-hidden border border-white/[0.08] bg-[#0f1120]/80 backdrop-blur-sm shadow-[0_8px_32px_rgba(255,255,255,0.06),0_2px_60px_rgba(0,0,0,0.6)]">
          <!-- Badges sobre imagen -->
          <div class="absolute top-4 left-4 z-10 flex flex-col gap-2">
            {product.isOnSale && (
              <span class="inline-flex items-center gap-1 bg-red-600/90 text-white text-xs font-black uppercase px-3 py-1.5 rounded-full shadow-[0_4px_15px_rgba(220,38,38,0.3)]">
                -{product.discountPercent}% OFF
              </span>
            )}
          </div>

          <!-- Imagen grande -->
          <img
            id="main-image"
            src={product.primaryImage}
            alt={product.name}
            width="800"
            height="800"
            class="w-full aspect-square object-cover object-center"
          />
        </div>

        <!-- Miniaturas (solo si hay más de 1 imagen) -->
        {product.hasMultipleImages && (
          <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-hide">
            {product.images.map((img, i) => (
              <button
                data-thumb={img}
                class={`thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border-2 transition-all duration-300 ${i === 0 ? 'border-amber-400 shadow-[0_0_15px_rgba(234,179,8,0.3)]' : 'border-white/10 hover:border-amber-400/50'}`}
              >
                <img
                  src={img}
                  alt={`${product.name} ${i + 1}`}
                  width="80"
                  height="80"
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- ============= COLUMNA DERECHA: INFORMACIÓN DEL PRODUCTO ============= -->
      <div class="flex flex-col gap-6">
        <!-- Categoría -->
        {(product.categoryName || product.categories[0]?.name) && (
          <a href={`/tienda/${product.categorySlug || product.categories[0]?.slug || 'general'}/`}
             class="inline-flex items-center gap-2 bg-amber-400/10 border border-amber-400/20 text-amber-400 text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-full w-fit hover:bg-amber-400/20 transition-colors">
            {product.categoryName || product.categories[0]?.name}
          </a>
        )}

        <!-- Título -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white leading-tight"
            style="font-family: 'Outfit', sans-serif;">
          {product.name}
        </h1>

        <!-- Rating (si hay) -->
        {product.ratingCount > 0 && (
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-1">
              {[...Array(5)].map((_, i) => (
                <svg class={`w-5 h-5 ${i < Math.round(product.rating) ? 'text-amber-400' : 'text-slate-600'}`} fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <span class="text-sm text-slate-400">({product.ratingCount} opiniones)</span>
          </div>
        )}

        <!-- Bloque de Precios -->
        <div class="bg-[#0f1120]/80 backdrop-blur-sm rounded-2xl p-6 border border-white/[0.08] shadow-[0_4px_20px_rgba(0,0,0,0.4)]">
          <div class="grid grid-cols-2 gap-4">
            <!-- Precio CUP -->
            <div class="text-center">
              <span class="text-xs text-slate-500 uppercase tracking-wider block mb-1">CUP</span>
              <span class="text-2xl sm:text-3xl font-black text-orange-500 drop-shadow-[0_2px_10px_rgba(249,115,22,0.2)]">
                {formatCUP(product.priceCUP)}
              </span>
            </div>
            <!-- Precio USD -->
            <div class="text-center">
              <span class="text-xs text-slate-500 uppercase tracking-wider block mb-1">USD</span>
              <span class="text-2xl sm:text-3xl font-black text-orange-500 drop-shadow-[0_2px_10px_rgba(249,115,22,0.2)]">
                {formatUSD(product.price)}
              </span>
            </div>
          </div>

          <!-- Precios anteriores (si está en oferta) -->
          {product.isOnSale && (
            <div class="grid grid-cols-2 gap-4 mt-3 pt-3 border-t border-white/[0.04]">
              <div class="text-center">
                <span class="text-sm text-gray-500 font-medium line-through">
                  {formatCUP(product.regularPriceCUP)}
                </span>
              </div>
              <div class="text-center">
                <span class="text-sm text-gray-500 font-medium line-through">
                  {formatUSD(product.regularPrice)}
                </span>
              </div>
            </div>
          )}

          <!-- Ahorro -->
          {product.isOnSale && (
            <div class="mt-3 pt-3 border-t border-white/[0.04] text-center">
              <span class="text-green-400 text-sm font-bold">
                Ahorras {formatCUP(savingsCUP)} / {formatUSD(savingsUSD)}
              </span>
            </div>
          )}
        </div>

        <!-- Stock Status -->
        <div class="flex items-center gap-2">
          {product.isInStock ? (
            <>
              <span class="w-3 h-3 rounded-full bg-green-500 shadow-[0_0_10px_rgba(34,197,94,0.4)]"></span>
              <span class="text-green-400 font-semibold text-sm">
                {product.isLowStock ? `¡Últimas ${product.stockQuantity} unidades!` : 'En Stock'}
              </span>
            </>
          ) : (
            <>
              <span class="w-3 h-3 rounded-full bg-red-500 shadow-[0_0_10px_rgba(239,68,68,0.4)]"></span>
              <span class="text-red-400 font-semibold text-sm">Agotado</span>
            </>
          )}
        </div>

        <!-- Selector de Color (solo si hay opciones) -->
        {product.colorOptions.length > 0 && (
          <div>
            <label class="text-sm font-bold text-slate-300 uppercase tracking-wider mb-3 block">Color</label>
            <div class="flex flex-wrap gap-3">
              {product.colorOptions.map((color, i) => (
                <button
                  data-color={color}
                  class={`color-btn px-4 py-2 rounded-xl border-2 font-semibold text-sm transition-all duration-200 ${i === 0 ? 'border-amber-400 bg-amber-400/10 text-amber-400 shadow-[0_0_15px_rgba(234,179,8,0.2)]' : 'border-white/10 bg-white/5 text-slate-300 hover:border-amber-400/50 hover:text-amber-400'}`}
                >
                  {color}
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- Selector de Talla (solo si hay opciones) -->
        {product.sizeOptions.length > 0 && (
          <div>
            <label class="text-sm font-bold text-slate-300 uppercase tracking-wider mb-3 block">Talla</label>
            <div class="flex flex-wrap gap-3">
              {product.sizeOptions.map((size, i) => (
                <button
                  data-size={size}
                  class={`size-btn px-4 py-2 rounded-xl border-2 font-semibold text-sm transition-all duration-200 ${i === 0 ? 'border-amber-400 bg-amber-400/10 text-amber-400 shadow-[0_0_15px_rgba(234,179,8,0.2)]' : 'border-white/10 bg-white/5 text-slate-300 hover:border-amber-400/50 hover:text-amber-400'}`}
                >
                  {size}
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- Selector de Cantidad -->
        <div>
          <label class="text-sm font-bold text-slate-300 uppercase tracking-wider mb-3 block">Cantidad</label>
          <div class="flex items-center gap-4">
            <button id="qty-minus" class="w-12 h-12 rounded-xl border-2 border-white/10 bg-white/5 text-white font-bold text-xl hover:border-amber-400/50 hover:text-amber-400 transition-all duration-200 flex items-center justify-center">
              &minus;
            </button>
            <span id="qty-value" class="text-xl font-bold text-white min-w-[40px] text-center">1</span>
            <button id="qty-plus" class="w-12 h-12 rounded-xl border-2 border-white/10 bg-white/5 text-white font-bold text-xl hover:border-amber-400/50 hover:text-amber-400 transition-all duration-200 flex items-center justify-center">
              +
            </button>
          </div>
        </div>

        <!-- Botón Agregar al Carrito -->
        <button
          id="add-to-cart"
          disabled={!product.isInStock}
          class={`w-full py-4 px-6 rounded-2xl font-extrabold text-lg uppercase tracking-wider transition-all duration-300 border border-white/[0.06]
            ${product.isInStock
              ? 'bg-gradient-to-r from-purple-700 to-purple-900 hover:from-yellow-600 hover:to-yellow-800 text-white shadow-[0_4px_20px_rgba(168,85,247,0.3)] hover:shadow-[0_6px_30px_rgba(234,179,8,0.3)] cursor-pointer'
              : 'bg-slate-700 text-slate-500 cursor-not-allowed shadow-none'}`}
        >
          {product.isInStock ? '🛒 Agregar al Carrito' : 'Agotado'}
        </button>

        <!-- Sellos de Confianza -->
        <div class="grid grid-cols-3 gap-3 pt-4 border-t border-white/[0.06]">
          <div class="flex flex-col items-center text-center gap-2">
            <span class="text-2xl">🚚</span>
            <span class="text-xs text-slate-400 leading-tight">Envíos a<br/>Camagüey</span>
          </div>
          <div class="flex flex-col items-center text-center gap-2">
            <span class="text-2xl">🏪</span>
            <span class="text-xs text-slate-400 leading-tight">Recogida en<br/>Avellaneda 260</span>
          </div>
          <div class="flex flex-col items-center text-center gap-2">
            <span class="text-2xl">💵</span>
            <span class="text-xs text-slate-400 leading-tight">Pagos en<br/>CUP y USD</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== DESCRIPCIÓN ===== -->
  <section class="pb-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-[#0f1120]/80 backdrop-blur-sm rounded-3xl p-6 sm:p-10 border border-white/[0.08] shadow-[0_8px_32px_rgba(255,255,255,0.06),0_2px_60px_rgba(0,0,0,0.6)]">
      <h2 class="text-2xl font-extrabold text-white mb-6" style="font-family: 'Outfit', sans-serif;">
        Descripción del Producto
      </h2>
      {product.hasDescription ? (
        <div class="prose prose-invert max-w-none text-slate-300 leading-relaxed" set:html={product.cleanDescription} />
      ) : (
        <p class="text-slate-300 leading-relaxed">
          Producto de alta calidad disponible en <strong class="text-amber-400">Carmay Outfit</strong>, Camagüey. Visítanos en nuestra tienda física en <em>Avellaneda No. 260</em> o consulta con nuestro equipo para conocer más detalles sobre disponibilidades e inventario en tiempo real.
        </p>
      )}
    </div>
  </section>

  <!-- ===== PRODUCTOS RELACIONADOS ===== -->
  {relatedFiltered.length > 0 && (
    <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-white/[0.06]">
      <div class="mb-10">
        <span class="text-amber-400 font-bold text-xs uppercase tracking-widest block mb-2">También te puede interesar</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Productos Relacionados</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        {relatedFiltered.map((p) => (
          <ProductCard
            title={p.name}
            price={p.priceFormatted}
            regularPrice={p.regularPriceFormatted}
            priceUSD={p.price}
            priceCUP={p.priceCUP}
            cupRate={p.cupRate}
            regularPriceUSD={p.regularPrice}
            regularPriceCUP={p.regularPriceCUP}
            image={p.primaryImage}
            category={p.categoryName}
            categorySlug={p.categorySlug}
            slug={p.slug}
            isTrending={p.isTrending}
            permalink={`/producto/${p.slug}/`}
          />
        ))}
      </div>
    </section>
  )}

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Galería de imágenes
      const mainImage = document.getElementById('main-image');
      const thumbBtns = document.querySelectorAll('.thumb-btn');

      thumbBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const thumb = btn.getAttribute('data-thumb');
          if (thumb && mainImage) {
            mainImage.src = thumb;
            thumbBtns.forEach(b => {
              b.classList.remove('border-amber-400', 'shadow-[0_0_15px_rgba(234,179,8,0.3)]');
              b.classList.add('border-white/10');
            });
            btn.classList.remove('border-white/10');
            btn.classList.add('border-amber-400', 'shadow-[0_0_15px_rgba(234,179,8,0.3)]');
          }
        });
      });

      // Selectores de color
      const colorBtns = document.querySelectorAll('.color-btn');
      colorBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          colorBtns.forEach(b => {
            b.classList.remove('border-amber-400', 'bg-amber-400/10', 'text-amber-400', 'shadow-[0_0_15px_rgba(234,179,8,0.2)]');
            b.classList.add('border-white/10', 'bg-white/5', 'text-slate-300');
          });
          btn.classList.remove('border-white/10', 'bg-white/5', 'text-slate-300');
          btn.classList.add('border-amber-400', 'bg-amber-400/10', 'text-amber-400', 'shadow-[0_0_15px_rgba(234,179,8,0.2)]');
        });
      });

      // Selectores de talla
      const sizeBtns = document.querySelectorAll('.size-btn');
      sizeBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          sizeBtns.forEach(b => {
            b.classList.remove('border-amber-400', 'bg-amber-400/10', 'text-amber-400', 'shadow-[0_0_15px_rgba(234,179,8,0.2)]');
            b.classList.add('border-white/10', 'bg-white/5', 'text-slate-300');
          });
          btn.classList.remove('border-white/10', 'bg-white/5', 'text-slate-300');
          btn.classList.add('border-amber-400', 'bg-amber-400/10', 'text-amber-400', 'shadow-[0_0_15px_rgba(234,179,8,0.2)]');
        });
      });

      // Cantidad
      const qtyValue = document.getElementById('qty-value');
      const qtyMinus = document.getElementById('qty-minus');
      const qtyPlus = document.getElementById('qty-plus');
      let qty = 1;
      const maxQty = 10;

      if (qtyMinus && qtyPlus && qtyValue) {
        qtyMinus.addEventListener('click', () => {
          if (qty > 1) {
            qty--;
            qtyValue.textContent = qty;
          }
        });
        qtyPlus.addEventListener('click', () => {
          if (qty < maxQty) {
            qty++;
            qtyValue.textContent = qty;
          }
        });
      }

      // Agregar al Carrito (Demo)
      const addToCart = document.getElementById('add-to-cart');
      if (addToCart) {
        addToCart.addEventListener('click', () => {
          const selectedColor = document.querySelector('.color-btn[class*="border-amber-400"]');
          const selectedSize = document.querySelector('.size-btn[class*="border-amber-400"]');
          const message = [
            '🛒 ¡Agregado al carrito! (Demo)',
            selectedColor ? `Color: ${selectedColor.getAttribute('data-color')}` : '',
            selectedSize ? `Talla: ${selectedSize.getAttribute('data-size')}` : '',
            `Cantidad: ${qty}`
          ].filter(Boolean).join('\n');
          alert(message);
        });
      }
    });
  </script>
</Layout>
