---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductGallery from '../../components/product/ProductGallery.astro';
import ProductStockStatus from '../../components/product/ProductStockStatus.astro';
import ProductTrustBadges from '../../components/product/ProductTrustBadges.astro';
import { woo } from '../../api';
import type { ProductData } from '../../api/models/Product.js';

interface Props {
  product: ProductData;
}

// Generar paths estáticos para cada producto
export async function getStaticPaths() {
  const products = await woo.products.getAll();
  return products
    .filter(p => p.hasRealImage)
    .map((product) => ({
      params: { slug: product.slug },
      props: { product: product.toJSON() },
    }));
}

const { product } = Astro.props;

// Productos relacionados de la misma categoría
const relatedProducts = await woo.products.getByCategory(product.categories[0]?.id ?? 0, 20);
const relatedFiltered = relatedProducts
  .filter(p => p.hasRealImage && p.isInStock && p.slug !== product.slug)
  .slice(0, 4);

const formatCUP = (n: number) => `${(n || 0).toLocaleString('en-US')} CUP`;
const formatUSD = (n: number) => {
  const val = n || 0;
  return val % 1 === 0 ? `$${val.toFixed(0)} USD` : `$${val.toFixed(2)} USD`;
};
const savingsCUP = product.isOnSale ? (product.regularPriceCUP || 0) - (product.priceCUP || 0) : 0;
const savingsUSD = product.isOnSale ? (product.regularPrice || 0) - (product.price || 0) : 0;
const maxPhysicalStock = product.stockQuantity && product.stockQuantity > 0 ? product.stockQuantity : 10;
---
<Layout title={`${product.name} - Carmay Outfit`}>
  <Header />

  <!-- Breadcrumbs -->
  <div class="pt-20 sm:pt-28 pb-3 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-slate-400">
      <a href="/" class="hover:text-yellow-400 transition-colors inline-flex items-center justify-center min-w-[44px] min-h-[44px]">Inicio</a>
      <span class="text-slate-600">&rsaquo;</span>
      <a href="/tienda/" class="hover:text-yellow-400 transition-colors inline-flex items-center justify-center min-w-[44px] min-h-[44px]">Catálogo</a>
      <span class="text-slate-600">&rsaquo;</span>
      {product.categories[0] && (
        <>
          <a href={`/tienda/${product.categorySlug}/`} class="hover:text-yellow-400 transition-colors inline-flex items-center justify-center min-w-[44px] min-h-[44px]">{product.categoryName}</a>
          <span class="text-slate-600">&rsaquo;</span>
        </>
      )}
      <span class="text-slate-200 font-medium truncate max-w-[200px]">{product.name}</span>
    </nav>
  </div>

  <!-- ===== SECCIÓN PRINCIPAL: 2 columnas ===== -->
  <section class="pb-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">

      <!-- ============= COLUMNA IZQUIERDA: GALERÍA DE IMÁGENES (Módulo Atómico) ============= -->
      <ProductGallery 
        name={product.name}
        primaryImage={product.primaryImage}
        images={product.images}
        hasMultipleImages={product.hasMultipleImages}
        isOnSale={product.isOnSale}
        discountPercent={product.discountPercent}
      />

      <!-- ============= COLUMNA DERECHA: INFORMACIÓN DEL PRODUCTO ============= -->
      <div class="flex flex-col gap-6 reveal-on-scroll reveal-delay-1">
        <!-- Categoría -->
        {(product.categoryName || product.categories[0]?.name) && (
          <a href={`/tienda/${product.categorySlug || product.categories[0]?.slug || 'general'}/`}
             class="inline-flex items-center min-h-[44px] gap-2 bg-amber-400/10 border border-amber-400/20 text-amber-400 text-xs font-bold uppercase tracking-widest px-4 py-3 rounded-full w-fit hover:bg-amber-400/20 transition-colors">
            {product.categoryName || product.categories[0]?.name}
          </a>
        )}

        <!-- Título -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white leading-tight"
            style="font-family: 'Outfit', sans-serif;">
          {product.name}
        </h1>

        <!-- Rating (si hay) -->
        {product.ratingCount > 0 && (
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-1">
              {[...Array(5)].map((_, i) => (
                <svg class={`w-5 h-5 ${i < Math.round(product.rating) ? 'text-amber-400' : 'text-slate-600'}`} fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <span class="text-sm text-slate-400">({product.ratingCount} opiniones)</span>
          </div>
        )}

        <!-- Bloque de Precios -->
        <div class="bg-[#0f1120]/80 backdrop-blur-sm rounded-2xl p-6 border border-white/[0.08] shadow-[0_4px_20px_rgba(0,0,0,0.4)]">
          <div class="grid grid-cols-2 gap-4">
            <!-- Precio CUP -->
            <div class="text-center">
              <span class="text-xs text-slate-500 uppercase tracking-wider block mb-1">CUP</span>
              <span class="text-2xl sm:text-3xl font-black text-orange-500 drop-shadow-[0_2px_10px_rgba(249,115,22,0.2)]">
                {formatCUP(product.priceCUP)}
              </span>
            </div>
            <!-- Precio USD -->
            <div class="text-center">
              <span class="text-xs text-slate-500 uppercase tracking-wider block mb-1">USD</span>
              <span class="text-2xl sm:text-3xl font-black text-orange-500 drop-shadow-[0_2px_10px_rgba(249,115,22,0.2)]">
                {formatUSD(product.price)}
              </span>
            </div>
          </div>

          <!-- Precios anteriores (si está en oferta) -->
          {product.isOnSale && (
            <div class="grid grid-cols-2 gap-4 mt-3 pt-3 border-t border-white/[0.04]">
              <div class="text-center">
                <span class="text-sm text-gray-500 font-medium line-through">
                  {formatCUP(product.regularPriceCUP)}
                </span>
              </div>
              <div class="text-center">
                <span class="text-sm text-gray-500 font-medium line-through">
                  {formatUSD(product.regularPrice)}
                </span>
              </div>
            </div>
          )}

          <!-- Ahorro -->
          {product.isOnSale && (
            <div class="mt-3 pt-3 border-t border-white/[0.04] text-center">
              <span class="text-green-400 text-sm font-bold">
                Ahorras {formatCUP(savingsCUP)} / {formatUSD(savingsUSD)}
              </span>
            </div>
          )}
        </div>

        <!-- Stock Status (Módulo Atómico) -->
        <ProductStockStatus 
          isInStock={product.isInStock}
          isLowStock={product.isLowStock}
          stockQuantity={product.stockQuantity}
        />

        <!-- Selector de Color (Opcional, solo si hay opciones) -->
        {product.colorOptions.length > 0 && (
          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="text-sm font-bold text-slate-300 uppercase tracking-wider">
                Color <span class="text-xs font-normal text-slate-400 normal-case">(opcional)</span>
              </label>
              <span id="selected-color-label" class="text-xs font-mono font-bold text-amber-400"></span>
            </div>
            <div class="flex flex-wrap gap-2.5">
              {product.colorOptions.map((color, i) => (
                <button
                  type="button"
                  data-color={color}
                  data-selected="false"
                  data-color-index={i}
                  class="color-btn px-4 py-2 rounded-xl border-2 border-white/10 bg-white/5 text-slate-300 hover:border-amber-400/50 hover:text-amber-400 font-semibold text-sm transition-all duration-200 cursor-pointer select-none"
                  aria-label={`Seleccionar color ${color}`}
                >
                  {color}
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- Selector de Talla (Opcional, solo si hay opciones) -->
        {product.sizeOptions.length > 0 && (
          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="text-sm font-bold text-slate-300 uppercase tracking-wider">
                Talla <span class="text-xs font-normal text-slate-400 normal-case">(opcional)</span>
              </label>
              <span id="selected-size-label" class="text-xs font-mono font-bold text-amber-400"></span>
            </div>
            <div class="flex flex-wrap gap-2.5">
              {product.sizeOptions.map((size) => (
                <button
                  type="button"
                  data-size={size}
                  data-selected="false"
                  class="size-btn px-4 py-2 rounded-xl border-2 border-white/10 bg-white/5 text-slate-300 hover:border-amber-400/50 hover:text-amber-400 font-semibold text-sm transition-all duration-200 cursor-pointer select-none"
                  aria-label={`Seleccionar talla ${size}`}
                >
                  {size}
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- Selector de Cantidad Interactivo con Validación de Stock Físico -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="qty-input" class="text-sm font-bold text-slate-300 uppercase tracking-wider block">Cantidad</label>
            {product.stockQuantity && product.stockQuantity > 0 && (
              <span class="text-xs text-amber-400 font-mono font-bold">
                {product.stockQuantity === 1 ? '¡Solo 1 disponible!' : `${product.stockQuantity} disponibles en stock`}
              </span>
            )}
          </div>
          <div class="flex items-center gap-3">
            <button id="qty-minus" type="button" class="w-12 h-12 rounded-xl border-2 border-white/10 bg-white/5 text-white font-bold text-xl hover:border-amber-400/50 hover:text-amber-400 active:scale-90 transition-all duration-150 flex items-center justify-center cursor-pointer" aria-label="Restar una unidad">
              &minus;
            </button>
            <input
              type="number"
              id="qty-input"
              min="1"
              max={maxPhysicalStock}
              value="1"
              data-max-stock={maxPhysicalStock}
              class="w-20 min-w-[48px] h-12 min-h-[48px] rounded-xl border-2 border-white/15 bg-black/40 text-center font-mono font-bold text-xl text-white focus:outline-none focus:border-amber-400"
              aria-label="Cantidad de unidades a comprar"
            />
            <button id="qty-plus" type="button" class="w-12 h-12 rounded-xl border-2 border-white/10 bg-white/5 text-white font-bold text-xl hover:border-amber-400/50 hover:text-amber-400 active:scale-90 transition-all duration-150 flex items-center justify-center cursor-pointer" aria-label="Sumar una unidad">
              +
            </button>
          </div>
          <!-- Aviso contextual si se supera el stock disponible -->
          <div id="qty-stock-warning" class="hidden mt-2.5 p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-xs text-amber-300 flex items-start gap-2 leading-relaxed">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 text-amber-400 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span>Solo disponemos de <strong>{maxPhysicalStock}</strong> unidades para entrega inmediata. ¿Necesitas más? <a href={`https://wa.me/REDACTED_PHONE_1?text=${encodeURIComponent(`Hola Carmay Outfit 👋, me interesa encargar más de ${maxPhysicalStock} unidades del producto *"${product.name}"*. ¿Podrían gestionármelo?`)}`} target="_blank" class="underline font-bold text-amber-200 hover:text-white">Encárgalas por WhatsApp</a>.</span>
          </div>
        </div>

        <!-- Botón Agregar al Carrito con micro-interacción de pulsación -->
        <button
          id="add-to-cart"
          disabled={!product.isInStock}
          data-product={JSON.stringify({
            productId: product.id,
            slug: product.slug,
            name: product.name,
            image: product.primaryImage,
            priceUSD: product.price,
            priceCUP: product.priceCUP,
          })}
          class={`w-full py-4 px-6 rounded-2xl font-extrabold text-lg uppercase tracking-wider transition-all duration-300 border border-white/[0.06] active:scale-[0.98]
            ${product.isInStock
              ? 'bg-gradient-to-r from-purple-700 to-purple-900 hover:from-yellow-600 hover:to-yellow-800 hover:scale-[1.01] text-white shadow-[0_4px_20px_rgba(168,85,247,0.3)] hover:shadow-[0_8px_32px_rgba(234,179,8,0.35)] cursor-pointer'
              : 'bg-slate-700 text-slate-500 cursor-not-allowed shadow-none'}`}
        >
          <span class="inline-flex items-center justify-center gap-2.5">
            {product.isInStock ? (
              <>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l2.4 12.4a2 2 0 002 1.6h7.7a2 2 0 002-1.6L21 7H6" />
                  <circle cx="9" cy="20" r="1.5" />
                  <circle cx="17" cy="20" r="1.5" />
                </svg>
                <span>Agregar al Carrito</span>
              </>
            ) : (
              <span>Agotado</span>
            )}
          </span>
        </button>

        <!-- Sellos de Confianza (Módulo Atómico) -->
        <ProductTrustBadges />
      </div>
    </div>
  </section>

  <!-- ===== DESCRIPCIÓN (Solo se renderiza si el producto tiene información técnica real) ===== -->
  {product.hasDescription && (
    <section class="pb-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 reveal-on-scroll">
      <div class="bg-[#0f1120]/80 backdrop-blur-sm rounded-3xl p-6 sm:p-10 border border-white/[0.08] shadow-[0_8px_32px_rgba(255,255,255,0.06),0_2px_60px_rgba(0,0,0,0.6)]">
        <h2 class="text-2xl font-extrabold text-white mb-6" style="font-family: 'Outfit', sans-serif;">
          Descripción y Detalles del Producto
        </h2>
        <div class="prose prose-invert max-w-none text-slate-300 leading-relaxed" set:html={product.cleanDescription} />
      </div>
    </section>
  )}

  <!-- ===== PRODUCTOS RELACIONADOS ===== -->
  {relatedFiltered.length > 0 && (
    <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-white/[0.06] reveal-on-scroll">
      <div class="mb-10">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Productos Relacionados</h2>
        <span class="text-amber-400 font-bold text-xs uppercase tracking-widest block mt-2">También te puede interesar</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-3 lg:gap-4 items-start">
        {relatedFiltered.map((p, idx) => (
          <ProductCard
            title={p.name}
            price={p.priceFormatted}
            regularPrice={p.regularPriceFormatted}
            priceUSD={p.price}
            priceCUP={p.priceCUP}
            cupRate={p.cupRate}
            regularPriceUSD={p.regularPrice}
            regularPriceCUP={p.regularPriceCUP}
            image={p.primaryImage}
            category={p.categoryName}
            categorySlug={p.categorySlug}
            slug={p.slug}
            isTrending={p.isTrending}
            permalink={`/producto/${p.slug}/`}
            revealDelayClass={`reveal-delay-${(idx % 4) + 1}`}
          />
        ))}
      </div>
    </section>
  )}

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Galería de imágenes
      const mainImage = document.getElementById('main-image');
      const thumbBtns = document.querySelectorAll('.thumb-btn');

      thumbBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const thumb = btn.getAttribute('data-thumb');
          if (thumb && mainImage) {
            mainImage.src = thumb;
            thumbBtns.forEach(b => {
              b.classList.remove('border-amber-400', 'shadow-[0_0_15px_rgba(234,179,8,0.3)]');
              b.classList.add('border-white/10');
            });
            btn.classList.remove('border-white/10');
            btn.classList.add('border-amber-400', 'shadow-[0_0_15px_rgba(234,179,8,0.3)]');
          }
        });
      });

      // Selectores de color con toggle interactivo y sincronización a imagen
      const colorBtns = document.querySelectorAll('.color-btn');
      const selectedColorLabel = document.getElementById('selected-color-label');
      colorBtns.forEach((btn, index) => {
        btn.addEventListener('click', () => {
          const isAlreadySelected = btn.getAttribute('data-selected') === 'true';

          // Deseleccionar todos los botones de color
          colorBtns.forEach(b => {
            b.setAttribute('data-selected', 'false');
            b.classList.remove('border-amber-400', 'bg-amber-400/10', 'text-amber-400', 'shadow-[0_0_15px_rgba(234,179,8,0.2)]');
            b.classList.add('border-white/10', 'bg-white/5', 'text-slate-300');
          });

          if (!isAlreadySelected) {
            // Seleccionar este color
            btn.setAttribute('data-selected', 'true');
            btn.classList.remove('border-white/10', 'bg-white/5', 'text-slate-300');
            btn.classList.add('border-amber-400', 'bg-amber-400/10', 'text-amber-400', 'shadow-[0_0_15px_rgba(234,179,8,0.2)]');
            if (selectedColorLabel) {
              selectedColorLabel.textContent = btn.getAttribute('data-color') || '';
            }

            // Si el producto dispone de varias imágenes para representar variantes, cambiar a la imagen correspondiente
            if (thumbBtns && thumbBtns.length > index) {
              thumbBtns[index].click();
            }
          } else {
            // Si ya estaba seleccionado, queda deseleccionado (vuelve a default)
            if (selectedColorLabel) {
              selectedColorLabel.textContent = '';
            }
          }
        });
      });

      // Selectores de talla con toggle interactivo
      const sizeBtns = document.querySelectorAll('.size-btn');
      const selectedSizeLabel = document.getElementById('selected-size-label');
      sizeBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const isAlreadySelected = btn.getAttribute('data-selected') === 'true';

          // Deseleccionar todos los botones de talla
          sizeBtns.forEach(b => {
            b.setAttribute('data-selected', 'false');
            b.classList.remove('border-amber-400', 'bg-amber-400/10', 'text-amber-400', 'shadow-[0_0_15px_rgba(234,179,8,0.2)]');
            b.classList.add('border-white/10', 'bg-white/5', 'text-slate-300');
          });

          if (!isAlreadySelected) {
            // Seleccionar esta talla
            btn.setAttribute('data-selected', 'true');
            btn.classList.remove('border-white/10', 'bg-white/5', 'text-slate-300');
            btn.classList.add('border-amber-400', 'bg-amber-400/10', 'text-amber-400', 'shadow-[0_0_15px_rgba(234,179,8,0.2)]');
            if (selectedSizeLabel) {
              selectedSizeLabel.textContent = `Talla ${btn.getAttribute('data-size') || ''}`;
            }
          } else {
            // Si ya estaba seleccionado, queda deseleccionado (vuelve a default)
            if (selectedSizeLabel) {
              selectedSizeLabel.textContent = '';
            }
          }
        });
      });

      // Cantidad interactiva con validación estricta de stock
      const qtyInput = document.getElementById('qty-input');
      const qtyMinus = document.getElementById('qty-minus');
      const qtyPlus = document.getElementById('qty-plus');
      const stockWarning = document.getElementById('qty-stock-warning');
      const maxStockAttr = parseInt(qtyInput ? (qtyInput.getAttribute('data-max-stock') || '10') : '10', 10);
      const maxQty = !isNaN(maxStockAttr) && maxStockAttr > 0 ? maxStockAttr : 10;
      let qty = 1;

      function updateQty(newQty) {
        if (newQty > maxQty) {
          qty = maxQty;
          if (stockWarning) stockWarning.classList.remove('hidden');
        } else {
          qty = Math.max(1, newQty);
          if (stockWarning) stockWarning.classList.add('hidden');
        }

        if (qtyInput) {
          qtyInput.value = String(qty);
        }
      }

      qtyMinus?.addEventListener('click', () => {
        updateQty(qty - 1);
      });

      qtyPlus?.addEventListener('click', () => {
        updateQty(qty + 1);
      });

      qtyInput?.addEventListener('input', () => {
        const val = parseInt(qtyInput.value, 10);
        if (isNaN(val) || val < 1) {
          updateQty(1);
        } else {
          updateQty(val);
        }
      });

      // Agregar al Carrito
      const addToCart = document.getElementById('add-to-cart');

      if (addToCart) {
        addToCart.addEventListener('click', () => {
          try {
            const rawProduct = JSON.parse(addToCart.getAttribute('data-product') || '{}');
            const activeColorBtn = document.querySelector('.color-btn[data-selected="true"]');
            const activeSizeBtn = document.querySelector('.size-btn[data-selected="true"]');
            
            const selectedColor = activeColorBtn ? activeColorBtn.getAttribute('data-color') : undefined;
            const selectedSize = activeSizeBtn ? activeSizeBtn.getAttribute('data-size') : undefined;

            if (window.CarmayCart) {
              window.CarmayCart.create({
                productId: rawProduct.productId,
                slug: rawProduct.slug,
                name: rawProduct.name,
                image: rawProduct.image,
                priceUSD: rawProduct.priceUSD,
                priceCUP: rawProduct.priceCUP,
                color: selectedColor || undefined,
                size: selectedSize || undefined,
                quantity: qty,
              });

              // Abrir panel del carrito
              window.dispatchEvent(new CustomEvent('open-carmay-cart'));
            }
          } catch (err) {
            console.error('Error al agregar al carrito:', err);
          }
        });
      }
    });
  </script>
</Layout>
