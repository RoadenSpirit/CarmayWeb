      "id": "google-sheets-1",
      "name": "Obtener Inventario Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.6,
      "position": [460, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google-sheets-credential",
          "name": "Google Sheets Credencial"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst processed = [];\n\nfor (const item of items) {\n  let driveUrl = item.json.imagen || item.json.IMAGE || item.json.Imagen || \"\";\n  let fileId = \"\";\n\n  // Extraer ID de la fórmula =HYPERLINK(..., IMAGE(\"...\")) o URL directa de Drive\n  const match = driveUrl.match(/\\/d\\/([a-zA-Z0-9_-]+)/) || driveUrl.match(/id=([a-zA-Z0-9_-]+)/);\n  if (match && match[1]) {\n    fileId = match[1];\n    // Construir URL de descarga directa / miniatura de alta resolución de Google Drive\n    item.json.clean_image_url = `https://drive.google.com/uc?export=view&id=${fileId}`;\n  } else {\n    item.json.clean_image_url = driveUrl;\n  }\n\n  processed.push(item);\n}\n\nreturn processed;"
      },
      "id": "code-clean-images-1",
      "name": "Limpiar y Formatear Enlaces de Drive",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
